-- 35b · SPINS + FAMILY ROLL  ·  the job once the prestige target is reached
--
--     Read out of the game's own UI code (2026-10-16), not guessed:
--       buy    GET("S_Market","Buy","Spins", pack, qty)            [Buying.lua]
--              Storage.Shop.Spins[pack] = { Currency="Gems", Amount, Cost },
--              qty 1..99. Reply: nil = not enough gems, a string = the
--              refusal text, a table = the new save.
--       roll   GET("Family","Roll") -> spins, extra, family, pity, anim
--              [Customisation.Rolling]. ~3.30s per-player cooldown; a roll
--              inside it answers nil and costs nothing (measured 2026-08-27).
--       store  GET("Family","Store") -> ok, storedName, newCurrentFamily
--       count  Data.Spins + Data.Extra -- exactly what "ROLL (n)" shows.
--       rarity Storage.Families[rarity][name]
--     The game asks "are you sure?" before rerolling an Epic or better; here
--     the same job is done by FamilyWant / FamilyWantRarity, checked before
--     EVERY roll, so a wanted family is never rolled away.
--
--     WHERE. The roll button lives on the title screen, but the save reads and
--     the market both answer in the lobby. The lobby is tried first; if it
--     refuses rolls with spins in hand, the verdict is written to disk and the
--     rolls move to the menu (one teleport), after buying in the lobby.
-- ═══════════════════════════════════════════════════════════════════════════
K.FAM = {
    RANK = { common = 1, uncommon = 2, rare = 3, epic = 4, legendary = 5,
             mythic = 6, exclusive = 7, secret = 8 },
    rarity   = nil,     -- lower(name) -> rarity, from Storage.Families
    lastRoll = 0,
    cooldown = 1,
    -- Disk, because the verdict has to cross the teleport to the menu.
    WHERE_FILE = ("VCPlus_FamilyWhere_%s_%s.txt"):format(tostring(game.GameId), tostring(plr.UserId)),
    MENU_FILE  = ("VCPlus_FamilyMenu_%s_%s.txt"):format(tostring(game.GameId), tostring(plr.UserId)),
}

-- InvokeServer with a deadline that keeps EVERY return value. The shared
-- invoke() hands back only the first, and a roll answers with five.
function K.invokeAll(timeout, ...)
    local args = table.pack(...)
    local done, out = false, nil
    task.spawn(function()
        local r = table.pack(pcall(function()
            return GET:InvokeServer(EXEC.unpack(args, 1, args.n))
        end))
        if r[1] then out = table.pack(EXEC.unpack(r, 2, r.n)) end
        done = true
    end)
    local deadline = os.clock() + (timeout or 5)
    while not done and os.clock() < deadline do task.wait() end
    return out
end

function K.famRarityOf(name)
    if not K.FAM.rarity then
        local map = {}
        local F = MOD.Families
        if type(F) == "table" then
            for rar, t in pairs(F) do
                if type(t) == "table" then
                    for fam, def in pairs(t) do
                        if type(def) == "table" then map[tostring(fam):lower()] = tostring(rar) end
                    end
                end
            end
        end
        K.FAM.rarity = map
    end
    return K.FAM.rarity[tostring(name or ""):lower()]
end

function K.famWanted(name)
    if name == nil or name == "" then return false end
    local n = tostring(name):lower()
    if type(CFG.FamilyWant) == "table" then
        for _, w in ipairs(CFG.FamilyWant) do
            if tostring(w):lower() == n then return true end
        end
    end
    local floor = CFG.FamilyWantRarity and K.FAM.RANK[tostring(CFG.FamilyWantRarity):lower()]
    if floor then
        local r = K.famRarityOf(name)
        local rank = r and K.FAM.RANK[r:lower()]
        if rank and rank >= floor then return true end
    end
    return false
end

-- Prestige goal reached and at least one half of the feature switched on.
function K.famPhase()
    if CFG.AutoFamilyRoll == false and CFG.AutoBuySpins == false then return false end
    local at = tonumber(CFG.FamilyAtPrestige) or num(CFG.PrestigeTarget, 5)
    return num(STATE.prestige) >= at
end

-- Everything one decision needs, from a FRESH save: the roll count is the
-- root Spins + Extra (what the ROLL button shows), the family is the
-- avatar's, and the storage cap mirrors Customisation.Store.
function K.famRead()
    local d = getSave(true)
    if type(d) ~= "table" or type(d.Slots) ~= "table" then return nil end
    local slot = d.Slots[d.Current_Slot or slotKey()] or d.Slots[slotKey()]
    if type(slot) ~= "table" then return nil end
    local av  = type(slot.Avatar) == "table" and slot.Avatar or {}
    local inv = type(slot.Inventory) == "table" and slot.Inventory or {}
    local cap = 1 + num(type(slot.Extra_Slots) == "table" and slot.Extra_Slots.Family or 0)
    pcall(function()
        local gp = plr:FindFirstChild("Gamepasses")
        local bag = gp and gp:FindFirstChild("Family_Bag")
        if (bag and bag.Value == true)
           or (type(d.Gamepasses) == "table" and d.Gamepasses.Family_Bag == true) then
            cap = cap + 10
        end
    end)
    return {
        spins  = num(rawget(d, "Spins")) + num(rawget(d, "Extra")),
        family = av.Family and tostring(av.Family) or nil,
        pity   = num(av.Pity),
        gems   = num(type(slot.Currency) == "table" and slot.Currency.Gems or 0),
        stored = type(inv.Families) == "table" and #inv.Families or 0,
        cap    = cap,
    }
end

-- Turn gems into spins: SpinBuyQty packs (default ONE) of the configured
-- pack, stepping down to smaller packs when it is out of reach. One at a time
-- on purpose -- this only runs when the spins are gone, so nothing is lost, and
-- a wanted family landing never leaves a pile of gems already converted.
function K.famBuySpins(gems)
    if CFG.AutoBuySpins == false then return false end
    local shop  = MOD.Shop
    local packs = type(shop) == "table" and shop.Spins
    if type(packs) ~= "table" then
        log("FAMILY", "Storage.Shop.Spins is missing — cannot buy spins")
        return false
    end
    local budget = num(gems) - num(CFG.SpinGemReserve, 0)
    local first  = math.clamp(math.floor(num(CFG.SpinPack, 5)), 1, #packs)
    for idx = first, 1, -1 do
        local p    = packs[idx]
        local cost = type(p) == "table" and num(p.Cost) or 0
        if cost > 0 and tostring(p.Currency) == "Gems" then
            local qty = math.min(math.max(1, math.floor(num(CFG.SpinBuyQty, 1))), 99,
                                 math.floor(budget / cost))
            if qty >= 1 then
                setAction("Buying %d x %s spins (%s gems)", qty, comma(num(p.Amount)), comma(qty * cost))
                local res = invoke(8, "S_Market", "Buy", "Spins", idx, qty)
                if type(res) == "table" then
                    log("FAMILY", ("bought %s spins for %s gems (pack %d x%d)")
                        :format(comma(qty * num(p.Amount)), comma(qty * cost), idx, qty))
                    return true, qty * num(p.Amount), qty * cost
                end
                log("FAMILY", ("spin purchase refused: %s")
                    :format(type(res) == "string" and res or "not enough gems"))
                return false
            end
        end
    end
    return false
end

-- One roll. Sleeps out most of the cooldown, then polls: a nil inside the
-- cooldown costs nothing, so polling is free. Returns nil only when the
-- server keeps refusing past FamilyRefuseSeconds -- i.e. not allowed HERE.
function K.famRollOnce()
    local F = K.FAM
    local wake = F.lastRoll + F.cooldown - 0.15
    if os.clock() < wake then task.wait(wake - os.clock()) end
    local deadline = os.clock() + num(CFG.FamilyRefuseSeconds, 10)
    while alive() and os.clock() < deadline do
        local r = K.invokeAll(4, "Family", "Roll")
        if r and r[3] ~= nil then
            F.lastRoll = os.clock()
            return { spins = num(r[1]) + num(r[2]), family = tostring(r[3]), pity = num(r[4]) }
        end
        task.wait(0.06)
    end
    return nil
end

function K.famStore()
    local r = K.invokeAll(5, "Family", "Store")
    if r and r[1] == true then return tostring(r[2]), r[3] and tostring(r[3]) or nil end
    return nil
end

-- Buy and roll until a wanted family is equipped, the spins and gems run out,
-- or FamilyMaxRolls. Returns why it stopped:
--   "wanted" | "nogems" | "nospins" | "cap" | "refused" | "nosave" | "off"
function K.familySession(where)
    local st = K.famRead()
    if not st then return "nosave" end
    -- A full session is up to ~27 minutes standing still (500 rolls x 3.3s),
    -- past Roblox's 20-minute idle kick. The farm never needed this because it
    -- teleports every mission.
    if not K.FAM.afk then
        K.FAM.afk = plr.Idled:Connect(function()
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end)
    end
    local rolled, maxRolls = 0, num(CFG.FamilyMaxRolls, 0)
    log("FAMILY", ("%s: %s (%s), %s spins, %s gems")
        :format(where, tostring(st.family), tostring(K.famRarityOf(st.family) or "?"),
                comma(st.spins), comma(st.gems)))
    -- What this session did, for the Discord summary (§41d).
    local ctx = { where = where, rolled = 0, bought = 0, spent = 0, best = nil, bestRank = 0,
                  t0 = os.clock() }
    local postFloor = K.FAM.RANK[tostring(CFG.WebhookRollRarity or "legendary"):lower()] or 99
    K.FAMUI = K.FAMUI or { history = {}, total = 0 }
    K.FAMUI.sessionRolls, K.FAMUI.sessionSpent = 0, 0
    if K.FAMUI.refs and K.FAMUI.refs.gui then K.FAMUI.refs.gui.Enabled = true end
    K.famUIRefresh(st, "Đang bắt đầu · " .. tostring(where), 0, 0)
    local function finish(why)
        local finishLabels = {
            wanted = "Đã tìm thấy Family mục tiêu", nogems = "Dừng: không đủ Gems mua Spin",
            nospins = "Dừng: hết Spin", cap = "Dừng: đạt giới hạn lượt quay",
            refused = "Dừng: server từ chối lượt quay", nosave = "Dừng: không đọc được save",
            off = "Đã tắt Family Roll",
        }
        K.famUIRefresh(K.famRead() or st, finishLabels[why] or ("Đã dừng: " .. tostring(why)), rolled, ctx.spent)
        if ctx.rolled > 0 or ctx.bought > 0 then
            st = K.famRead() or st
            K.whRollSummary(ctx, st, why)
            K.whFlush(6)
        end
        return why
    end

    while alive() do
        -- 1. A wanted family is on: keep it (or bank it and roll on).
        if K.famWanted(st.family) then
            if CFG.FamilyStoreWanted and st.stored < st.cap then
                local storedName, newFam = K.famStore()
                if storedName then
                    log("FAMILY", ("stored %s (%d/%d) — rolling on for more")
                        :format(storedName, st.stored + 1, st.cap))
                    K.whRoll("stored", storedName, st, rolled, where)
                    st.stored = st.stored + 1
                    st.family = newFam or st.family
                    task.wait(0.6)
                    continue
                end
            end
            log("FAMILY", ("%s (%s) is a wanted family — rolling stops here")
                :format(st.family, tostring(K.famRarityOf(st.family) or "?")))
            STATE.family = st.family
            -- Only when THIS session rolled it -- not on every lobby visit
            -- that finds the kept family still equipped.
            if rolled > 0 then K.whRoll("wanted", st.family, st, rolled, where) end
            if CFG.FamilyDoneHandoff and not K.FAM.doneSent and _G.Horst_AccountChangeDone then
                K.FAM.doneSent = true
                pcall(_G.Horst_AccountChangeDone)
                log("FAMILY", "handed the account back to the host")
            end
            return finish("wanted")
        end

        if maxRolls > 0 and rolled >= maxRolls then return finish("cap") end

        -- 2. Out of spins: buy, or stop.
        if st.spins <= 0 then
            if CFG.AutoBuySpins == false then return finish("nospins") end
            local okBuy, nSpins, nGems = K.famBuySpins(st.gems)
            if not okBuy then return finish("nogems") end
            ctx.bought = ctx.bought + num(nSpins)
            ctx.spent  = ctx.spent + num(nGems)
            K.FAMUI.sessionSpent = ctx.spent
            K.famUIRefresh(st, ("Đã mua %s Spin · đang cập nhật save"):format(comma(num(nSpins))), rolled, ctx.spent)
            task.wait(0.5)
            st = K.famRead() or st
            K.famUIRefresh(st, "Đang quay Family", rolled, ctx.spent)
            if st.spins <= 0 then return finish("nogems") end
            continue
        end
        if CFG.AutoFamilyRoll == false then return finish("off") end

        -- 3. Roll.
        setAction("Family roll — %s · %s spins left", tostring(st.family), comma(st.spins))
        local r = K.famRollOnce()
        if not r then return finish("refused") end
        rolled    = rolled + 1
        ctx.rolled = rolled
        st.spins  = r.spins
        st.family = r.family
        st.pity   = r.pity
        STATE.family, STATE.spins = r.family, r.spins
        local rar  = K.famRarityOf(r.family)
        K.famUIAddHistory(r.family, rar or "?", r.spins, r.pity)
        K.FAMUI.sessionRolls = rolled
        K.famUIRefresh(st, "Đang quay Family", rolled, ctx.spent)
        local rank = rar and (K.FAM.RANK[rar:lower()] or 0) or 0
        if rank > ctx.bestRank then ctx.best, ctx.bestRank = r.family, rank end
        if rank >= K.FAM.RANK.epic then
            log("FAMILY", ("rolled %s (%s) — %s spins left, pity %d")
                :format(r.family, rar, comma(r.spins), r.pity))
        end
        -- A wanted one gets its own card at the top of the loop; this is for
        -- the rest that are still worth seeing.
        if rank >= postFloor and not K.famWanted(r.family) then
            K.whRoll("roll", r.family, st, rolled, where)
        end
        -- Gems only matter again once the spins run out; re-read then.
        if st.spins <= 0 then st = K.famRead() or st end
    end
    return finish("off")
end

function K.famWhere()
    local v = nil
    pcall(function()
        if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.FAM.WHERE_FILE) then
            v = EXEC.readfile(K.FAM.WHERE_FILE)
        end
    end)
    return v
end

function K.famSetWhere(v)
    pcall(function() if EXEC.writefile then EXEC.writefile(K.FAM.WHERE_FILE, v) end end)
end

-- Ask the title screen to roll before it clicks Play.
function K.famGoMenu()
    pcall(function()
        if EXEC.writefile then EXEC.writefile(K.FAM.MENU_FILE, tostring(os.time())) end
    end)
    setAction("Family roll — going to the menu")
    log("FAMILY", "rolls happen on the title screen — teleporting to the menu")
    pcall(function() game:GetService("TeleportService"):Teleport(PLACE.TITLE, plr) end)
end

function K.famMenuPending()
    local pending = false
    pcall(function()
        if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.FAM.MENU_FILE) then
            local t = tonumber(EXEC.readfile(K.FAM.MENU_FILE)) or 0
            pending = (os.time() - t) < 1800
        end
    end)
    return pending
end

function K.famMenuClear()
    pcall(function()
        if EXEC.writefile then EXEC.writefile(K.FAM.MENU_FILE, "0") end
    end)
end

-- The lobby side. Runs once per lobby visit; returns true when the lobby
-- should hold here instead of staging a mission.
function K.famLobby()
    if K.FAM.hold then return true end
    if K.FAM.visitDone or not K.famPhase() then return false end
    K.FAM.visitDone = true

    local where = K.famWhere()
    -- Refused in the lobby AND on the title screen: something about this
    -- account or build blocks rolls. Farm on and look again in six hours
    -- rather than bouncing between the two places every visit.
    if where and where:sub(1, 5) == "none:" then
        if os.time() - (tonumber(where:sub(6)) or 0) < 21600 then return false end
        where = nil
    end

    local why
    if where == "menu" then
        -- Rolls are known not to work here: buy here, roll there.
        local st = K.famRead()
        if not st or K.famWanted(st.family) then
            why = st and "wanted" or "nosave"
        else
            if st.spins <= 0 and CFG.AutoBuySpins ~= false then
                local okBuy, nSpins, nGems = K.famBuySpins(st.gems)
                if okBuy then
                    st = K.famRead() or st
                    K.whCard(("🛒 Bought %s spins for %s gems"):format(comma(num(nSpins)), comma(num(nGems))),
                        nil, 0x38BDF8, "rolling on the title screen next")
                end
            end
            if st.spins > 0 and CFG.AutoFamilyRoll ~= false then
                K.FAM.hold, K.FAM.menuAt = "menu", os.clock()
                K.whFlush(6)
                K.famGoMenu()
                return true
            end
            why = "nogems"
        end
    else
        why = K.familySession("lobby")
        if why == "refused" then
            K.famSetWhere("menu")
            log("FAMILY", "the lobby refuses rolls — they will be done on the title screen")
            K.FAM.hold, K.FAM.menuAt = "menu", os.clock()
            K.famGoMenu()
            return true
        end
        K.famSetWhere("lobby")
    end
    log("FAMILY", "lobby session ended: " .. tostring(why))
    refreshState(true)
    if CFG.FamilyKeepFarming == false and why ~= "nosave" then
        K.FAM.hold = "idle"
    end
    return K.FAM.hold ~= nil
end

-- The title-screen side: roll here when the lobby asked for it.
function K.famTitle()
    if not K.famMenuPending() then return end
    K.famMenuClear()
    refreshState(true)
    if not K.famPhase() then return end
    local why = K.familySession("menu")
    log("FAMILY", "title-screen session ended: " .. tostring(why))
    if why == "refused" then
        K.famSetWhere("none:" .. tostring(os.time()))
        log("FAMILY", "rolls are refused on the title screen too — not trying again for 6h")
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 36 · QUESTS
--     v9 fired ~90 accept calls every five minutes from a hardcoded tag list,
--     regardless of whether those quests existed or were already claimed. v10
--     reads the save's own quest tables and only touches what is actually
--     there and actually unclaimed.
-- ═══════════════════════════════════════════════════════════════════════════
K.QUEST_DONE = {}

local function runQuests()
    if not CFG.AutoQuest then return end
    local slot = STATE.slot or getSlot()
    if not slot or type(slot.Quests) ~= "table" then return end

    setAction("Claiming quests")
    local claimed = 0

    for category, entries in pairs(slot.Quests) do
        if type(entries) == "table" then
            for k, q in pairs(entries) do
                if type(q) == "table" and q.Rewarded ~= true then
                    local tag = tostring(q.Tag or k)
                    local cur = num(q.Current)
                    local req = tonumber(q.Required or q.Requirement or q.Goal)
                    -- Claim when complete, or when we cannot tell (some
                    -- categories omit the requirement and the server decides).
                    if (req and cur >= req) or (not req and cur > 0) then
                        local ck = category .. "/" .. tag
                        if not K.QUEST_DONE[ck] then
                            if invoke(3, "Functions", "Quest", tag, tostring(category)) ~= nil then
                                claimed = claimed + 1
                                K.QUEST_DONE[ck] = true
                            end
                            jwait(0.1, 0.06)
                        end
                    end
                end
            end
        end
    end

    -- Daily/Weekly slots still need an explicit accept to appear at all.
    for i = 1, 4 do
        for _, cat in ipairs({ "Daily", "Weekly" }) do
            local ck = cat .. " " .. i
            if not K.QUEST_DONE[ck] then
                invoke(2, "Functions", "Quest", ck, cat)
                K.QUEST_DONE[ck] = true
                jwait(0.08, 0.05)
            end
        end
    end

    if claimed > 0 then
        log("QUEST", ("claimed %d"):format(claimed))
        getSave(true)
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 37 · BOOSTS
--     Consume from inventory first, buy with gems only when configured to.
-- ═══════════════════════════════════════════════════════════════════════════
K.BOOST_SHOP = {
    XP   = { { 3, "2x XP Boost [2h]",   13999 }, { 2, "2x XP Boost [1h]",   7999 }, { 1, "2x XP Boost [30m]",   4499 } },
    Gold = { { 9, "2x Gold Boost [2h]", 13999 }, { 8, "2x Gold Boost [1h]", 7999 }, { 7, "2x Gold Boost [30m]", 4499 } },
}

-- THE THROTTLE HAS TO OUTLIVE THE VM.
--
-- K.LAST_BOOST used to be a bare module-level number. Every teleport wipes this
-- VM and a mission is ~25 seconds, so it was reset to 0 several times a minute
-- and the "do not check again yet" rule never once survived to be honoured:
-- every single lobby visit re-ran the purchase check from scratch. Combined
-- with the two bugs below that is an account's whole gem balance.
K.BOOST_FILE = ("VCPlus_Boost_%s_%s.txt"):format(tostring(game.GameId), tostring(plr.UserId))
K.LAST_BOOST = 0
pcall(function()
    if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.BOOST_FILE) then
        K.LAST_BOOST = tonumber(EXEC.readfile(K.BOOST_FILE)) or 0
    end
end)

K.boostHold = function(untilWhen, why)
    K.LAST_BOOST = untilWhen
    pcall(function()
        if EXEC.writefile then EXEC.writefile(K.BOOST_FILE, tostring(math.floor(untilWhen))) end
    end)
    if why then
        log("BOOST", ("next check in %ds — %s"):format(math.max(0, untilWhen - os.time()), why))
    end
end

-- Seconds left on a boost, not just whether one is running.
--
-- The folder value IS the remaining time (measured: plr.Boosts.XP = 7189 right
-- after a 2h purchase), which is exactly what the re-check should be scheduled
-- from. Asking only "is it on" threw that away and left the cadence to a
-- constant that had nothing to do with the boost.
K.boostRemaining = function(kind)
    local left = 0
    pcall(function()
        local folder = plr:FindFirstChild("Boosts")
        if not folder then return end
        -- FindFirstChild is case-sensitive and the live folder is Luck/XP/Gold,
        -- so a config that wrote "GOLD" matched nothing and the bot believed the
        -- boost was never running. Normalise instead of trusting the caller.
        local want = tostring(kind):lower()
        if want == "xp" then want = "experience" end
        for _, v in ipairs(folder:GetChildren()) do
            local n = v.Name:lower()
            if n == want or (want == "experience" and n == "xp") then
                left = num(v.Value)
                return
            end
        end
    end)
    return left
end

local function boostActive(kind) return K.boostRemaining(kind) > 0 end

K.boostsPass = function()
    if not CFG.AutoBoost or _G.IsPrestigeing then return end
    local now = os.time()
    if now < K.LAST_BOOST then return end

    -- An XP boost buys nothing once the bar cannot move. At the level cap with
    -- the bar full, every 2x XP Boost is 13,999 gems set on fire -- and with
    -- BoostTypes pinned to {"XP","Gold"} the pair was being re-bought every time
    -- it expired, on every account, forever. Gold still matters (prestige cost,
    -- upgrades), so drop only the XP half.
    --
    -- This un-skips itself: prestiging drops the level below the new cap, so
    -- isMaxed() goes false and XP boosts resume for the climb.
    local skipXp = CFG.SkipXpBoostWhenMaxed ~= false and isMaxed()

    local wanted = {}
    if CFG.BoostTypes then
        for _, b in ipairs(CFG.BoostTypes) do
            if not (skipXp and tostring(b):upper() == "XP") then
                wanted[#wanted + 1] = b
            end
        end
        if skipXp and #wanted < #CFG.BoostTypes and not K.xpSkipNoted then
            K.xpSkipNoted = true
            log("BOOST", "level and xp both capped — buying Gold only, XP boosts "
                      .. "would be spent on a bar that cannot move")
        end
    else
        if not skipXp
           and (STATE.prestige <= 3 or (STATE.prestige >= 5 and STATE.level <= 130)) then
            wanted[#wanted + 1] = "XP"
        end
        if STATE.prestige <= 4 then wanted[#wanted + 1] = "Gold" end
    end

    local acted = false
    -- MEASURED on this build (lobby, patch 2208): the inventory has exactly three
    -- categories -- Cosmetics, Families, Items -- and consumables live in Items
    -- (Emperor's Key was sitting there). An audit pass claimed this line reads a
    -- nonexistent category; it does not. Left as a single-category read on
    -- purpose: flattening all three would also match a COSMETIC whose name
    -- happens to contain the kind and the word "boost", and fire S_Inventory/Item
    -- at something that is not a consumable.
    local items = (STATE.inventory and STATE.inventory.Items) or {}

    for _, kind in ipairs(wanted) do
        if acted then break end
        if not boostActive(kind) then
            -- Inventory first: free.
            local lower = kind:lower()
            for name, qty in pairs(items) do
                if num(qty) > 0 then
                    local n = tostring(name):lower()
                    if n:find(lower, 1, true) and n:find("boost", 1, true) then
                        setAction("Using %s", tostring(name))
                        if invoke(3, "S_Inventory", "Item", name) ~= nil then
                            -- Free, but not free enough to spend a whole stack
                            -- on a Use that is not taking. Same confirmation as
                            -- the paid path.
                            if waitUntil(function()
                                return K.boostRemaining(kind) > 0
                            end, 6, 0.25) then
                                acted = true
                                break
                            end
                            K.boostHold(now + 1800,
                                ("%s did not activate — holding off"):format(tostring(name)))
                            return
                        end
                    end
                end
            end
            if acted then break end

            -- From the family phase on (§35b) gems are for spins: a 2h boost
            -- is 13,999 gems, i.e. ~155 rolls. Inventory boosts above still run.
            if K.famPhase() and CFG.FamilyStopGemBoosts ~= false then break end

            -- Then gems, if the user opted in.
            --
            -- MinGemsToBuyBoosts is a RESERVE, not a trigger: the balance must
            -- still clear it AFTER the purchase. Read as a trigger it did the
            -- opposite of what the name promises -- at 4599 it happily spent
            -- 13,999 a time until the balance fell under 4,599.
            local reserve = num(CFG.MinGemsToBuyBoosts, 999999)
            -- Match the shop key however the config spelled the kind. Written
            -- as "GOLD" it used to miss K.BOOST_SHOP.Gold entirely, so the
            -- purchase silently did nothing while the inventory path kept
            -- firing -- a config typo that reads as a broken feature.
            local shop = K.BOOST_SHOP[kind]
            if not shop then
                for k, v in pairs(K.BOOST_SHOP) do
                    if tostring(k):lower() == tostring(kind):lower() then shop = v break end
                end
            end
            for _, entry in ipairs(shop or {}) do
                local idx, name, price = entry[1], entry[2], entry[3]
                if STATE.gems - price >= reserve then
                    setAction("Buying %s", name)
                    local res = invoke(5, "S_Market", "Buy", "1_Boosts", idx, 1)
                    if res ~= nil and type(res) ~= "string" then
                        task.wait(0.4)
                        invoke(3, "S_Inventory", "Item", name)

                        -- CONFIRM IT ACTUALLY STARTED BEFORE CALLING IT DONE.
                        --
                        -- Buy and Use are two separate remotes and only the
                        -- first one takes the gems. `acted = true` used to be
                        -- set on the strength of the Buy alone, so a Use that
                        -- silently failed left the gems gone AND the boost off
                        -- -- and the next check, seeing no boost, bought
                        -- another one. That is the drain, and it compounds.
                        local live = waitUntil(function()
                            return K.boostRemaining(kind) > 0
                        end, 6, 0.25)
                        if live then
                            acted = true
                            log("BOOST", ("%s active — %dm left, %s gems remaining")
                                :format(name, math.floor(K.boostRemaining(kind) / 60),
                                        shortNum(STATE.gems)))
                        else
                            -- Do not try again in a hurry: something in the
                            -- Buy/Use pair is not working and repeating it is
                            -- how the balance disappears.
                            K.boostHold(now + 1800,
                                ("%s was bought but never activated — holding off"):format(name))
                            return
                        end
                        break
                    end
                end
            end
        end
    end

    -- SCHEDULE FROM THE BOOST, NOT FROM A CONSTANT.
    --
    -- This used to be `now + (acted and BoostCheckInterval(15) or 300)`, which
    -- is backwards: having just bought a TWO HOUR boost it came back in fifteen
    -- seconds, and having bought nothing it waited five minutes. The only
    -- honest next-check time is when the longest running boost actually runs
    -- out, so read it off the live timer.
    local soonest, missing = nil, false
    for _, kind in ipairs(wanted) do
        local left = K.boostRemaining(kind)
        if left > 0 and (soonest == nil or left < soonest) then soonest = left end
        if left <= 0 then missing = true end
    end
    if missing then
        -- SOMETHING IN BoostTypes IS STILL UNBOOSTED, SO COME BACK SOON.
        --
        -- The purchase loop breaks after ONE buy per pass (`if acted then break
        -- end`), and that is deliberate -- two Buy/Use pairs back to back is how
        -- the old gem drain compounded. But the schedule below then read the
        -- boost we had just bought and parked for its FULL two hours, so with
        -- the usual BoostTypes = { "XP", "Gold" } the second entry was never
        -- bought at all: XP went up, Gold was queued behind a 7200-second wait,
        -- and by the time that elapsed XP had lapsed too and won the next pass
        -- again. Forever. Re-check on the short cadence while any wanted type
        -- is still missing; the disk throttle and the re-entry guard keep this
        -- from turning back into a spend loop.
        K.boostHold(now + math.max(60, num(CFG.BoostCheckInterval, 15) * 4))
    elseif soonest then
        -- A small margin so the re-buy lands as the old one lapses rather than
        -- a tick before it, which would read as "still active" and skip.
        K.boostHold(now + math.max(30, soonest - 15))
    else
        K.boostHold(now + math.max(60, num(CFG.BoostCheckInterval, 15) * 20))
    end
end

-- ONE PASS AT A TIME.
--
-- The lobby brain does `task.spawn(runBoosts)` on every iteration of a loop
-- whose body is `task.wait(1)` -- so a new pass starts every second. A pass
-- that decides to buy then stays open for roughly seven: Buy, 0.4s to settle,
-- Use, and up to 6s of waitUntil confirming the boost actually started.
-- K.LAST_BOOST is only written at the far end of that window.
--
-- So every pass that starts inside the window reads the stale throttle, finds
-- `not boostActive(kind)` still true (the boost has not started yet -- that is
-- precisely what the first pass is waiting for) and buys the SAME boost again.
-- STATE.gems is a cached read that has not dropped yet either, so the reserve
-- check waves it through. Seven passes, 13,999 gems each: that is the drain.
--
-- The disk file guards the throttle ACROSS VMs. This guards WITHIN one, which
-- is where the overlap actually happens. pcall so an error inside the pass
-- cannot leave the flag stuck and disable boosts for the rest of the session.
local function runBoosts()
    if K.boostBusy then return end
    K.boostBusy = true
    local ok, err = pcall(K.boostsPass)
    K.boostBusy = false
    if not ok then log("BOOST", "pass errored: " .. tostring(err)) end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 38 · MISSION CREATION
--
--     v9's default MissionDifficulty was "Aberrant++", a tier the game does
--     not have. Create rejected it, and the fallback list it then walked
--     started at Severe — so every mission ran a tier below what the account
--     could clear, for the entire lifetime of that build. On the live values
--     that is 35-43 spawns instead of 44-57, and Aberrant pays 38,615 gold on
--     completion against Severe's much lower band, plus 695 gold per titan.
--
--     v10 probes downward from the top of the real ladder once, caches the
--     tier that worked, and re-probes one rung higher after a prestige (which
--     is the only thing that meaningfully raises what the account can clear).
--     Steady state is one Create call per mission.
-- ═══════════════════════════════════════════════════════════════════════════
local MISSION = {
    knownGood   = nil,   -- difficulty name that Create last accepted
    probeUpAt   = 0,     -- next mission count at which to try one tier higher
    created     = 0,
    escalated   = false, -- modifier profile currently bumped by the governor
}

local function difficultyLadderNames()
    local ladder = buildDifficultyLadder()
    local names = {}
    for i = #ladder, 1, -1 do names[#names + 1] = ladder[i].name end
    return names   -- hardest first
end

local function chooseStartDifficulty()
    local floorName = tostring(CFG.MissionDifficulty or "Aberrant")
    if not CFG.AutoDifficulty then return floorName end

    -- A cached tier is trusted until it is time to try climbing again.
    if MISSION.knownGood and MISSION.created < MISSION.probeUpAt then
        return MISSION.knownGood
    end

    -- Potential, when we can read it, answers the question outright and skips
    -- the probe entirely. Difficulty unlock is gated on it: 0/2/5/9/12 for
    -- Easy/Normal/Hard/Severe/Aberrant, derived from the sum of weapon
    -- upgrades (Maximum_Upgrades is 15, so 12 is reachable but not free).
    local potential = STATE.potential
        or (STATE.slot and STATE.slot.Progression and tonumber(STATE.slot.Progression.Potential))
        or tonumber(plr:GetAttribute("Potential"))

    -- Modules.Utilities.Shared.Get_Potential computes it the way the game
    -- does. Its exact signature is not documented, so try the plausible arg
    -- shapes under pcall and accept only a sane number — anything else falls
    -- through to probing, which needs no formula at all.
    if not potential then
        pcall(function()
            local mods = ReplicatedStorage:FindFirstChild("Modules")
            local utils = mods and mods:FindFirstChild("Utilities")
            local shared = utils and utils:FindFirstChild("Shared")
            if not shared then return end
            local S = require(shared)
            if type(S) ~= "table" or type(S.Get_Potential) ~= "function" then return end
            local slot = STATE.slot
            if not slot then return end
            for _, args in ipairs({
                { slot, "Blades" }, { slot }, { slot.Upgrades, "Blades" },
            }) do
                local ok, v = pcall(S.Get_Potential, table.unpack(args))
                if ok and tonumber(v) and tonumber(v) >= 0 and tonumber(v) <= 200 then
                    potential = math.floor(tonumber(v))
                    return
                end
            end
        end)
        if potential then STATE.potential = potential end
    end

    if potential then return bestDifficulty(potential) end

    -- Otherwise start from the top and let Create tell us.
    local names = difficultyLadderNames()
    return names[1] or floorName
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 38b · MODIFIERS  ·  free XP and gold that v9 never collected
--
--     Modifiers are NOT part of the Create payload. The live Create table is
--     exactly { Name, Difficulty, Type, Objective, Minimum } — there is no
--     Modifiers key at all, so the twelve-name list v9 passed there was read
--     by nobody.
--
--     They are toggled one at a time, after Create, against the selected
--     mission object:
--         GET:InvokeServer("S_Missions", "Modify", <modifierTag>) -> boolean
--     The boolean is the modifier's NEW state, which is how the game's own UI
--     drives its checkmark. It is a toggle, not a setter, so the state has to
--     be read back rather than assumed. Only the party leader may call it,
--     which for a solo farm is always us.
--
--     v9 also called Modify(<difficulty>) believing it set the difficulty. It
--     does not — difficulty comes from Create — so that call was toggling a
--     modifier named "Severe" that does not exist, and did nothing.
--
--     The full live table (Modules.Storage.Modifiers, ordered 1-12):
--        1 No Perks          +5%  per equipped perk
--        2 No Skills         +3%  per equipped skill
--        3 No Memories       +2.5% per unlocked memory
--        4 Nightmare        +20%  only abnormals/crawlers spawn
--        5 Oddball          +25%  every titan has +50% stats
--        6 Injury Prone     +10%  higher injury chance
--        7 Chronic Injuries +10%  injuries cannot be healed
--        8 Fog              +7.5% cannot see far
--        9 Glass Cannon     +25%  you have 1 HP
--       10 Time Trial       +15%  ONLY if beaten in time, otherwise a penalty
--       11 Boring           -20%  PENALTY
--       12 Simple           -20%  PENALTY
--
--     v9's hardcoded list contained both penalties.
--
--     The "safe" profile takes the four whose downside a hovering bot simply
--     does not experience — it never gets hit, so injuries and 1 HP are free,
--     and it reads titan positions from the DataModel, so fog is free too.
--     That is +52.5% XP and gold for nothing.
-- ═══════════════════════════════════════════════════════════════════════════
K.MODIFIER_PROFILES = {
    -- Downside is irrelevant to an airborne bot. +52.5%.
    safe = { "Fog", "Injury Prone", "Chronic Injuries", "Glass Cannon" },
    -- Adds tougher and faster titans: +97.5% reward, slower clears. Worth it
    -- only once kill speed is comfortably ahead of spawn rate.
    max  = { "Fog", "Injury Prone", "Chronic Injuries", "Glass Cannon",
             "Nightmare", "Oddball" },
    -- For maps where the objective makes the bot LAND. Only the modifier whose
    -- downside a bot on the ground still does not experience. +7.5%.
    spear = { "Fog" },
    none = {},
}

-- Never enable these automatically: 11/12 are outright penalties, 1-3 only pay
-- if you strip your build (which makes every kill slower), and 10 pays only if
-- the run beats a timer and penalises you when it does not.
K.MODIFIER_DENY = {
    ["Boring"] = true, ["Simple"] = true,
    ["No Perks"] = true, ["No Skills"] = true, ["No Memories"] = true,
    ["Time Trial"] = true,
}

K.MODIFIER_TAGS = nil   -- tag -> {boost=, positive=}

local function loadModifiers()
    if K.MODIFIER_TAGS then return K.MODIFIER_TAGS end
    local out = {}
    local M = MOD.Modifiers
    if type(M) == "table" then
        for i = 1, 32 do
            local d = M[i]
            if type(d) ~= "table" then break end
            local tag = d.Tag or d.Name
            if tag then
                local desc = tostring(d.Description or "")
                out[tostring(tag)] = {
                    boost    = tonumber(d.Boost) or 0,
                    -- Boost is stored unsigned; the sign lives in the
                    -- description template ("+{x}%" vs "-{x}%").
                    positive = desc:sub(1, 1) ~= "-",
                    order    = i,
                }
            end
        end
    end
    K.MODIFIER_TAGS = out
    return out
end

-- Which modifiers we want on. Explicit config wins; otherwise a profile.
local function wantedModifiers()
    local tags = loadModifiers()
    local wanted = {}

    local cfg = CFG.Modifiers

    -- THE MISSION BEING STAGED IS A SPEAR RUN.
    --
    -- K.TS.stagingMap is set by runLobby immediately before Create/Start, and
    -- only when runMission on that map would actually switch the spear
    -- objectives on -- so this mirrors what the run is about to do rather than
    -- guessing from the map name alone.
    -- nil or false both mean "no spear override" -- nil because the key was
    -- never set, false because someone deliberately turned the override off and
    -- would not expect that to select a profile named "false".
    if K.TS.stagingMap and CFG.SpearModifierProfile then
        local sp = CFG.SpearModifierProfile
        if type(sp) == "table" then
            -- An explicit tag list: hand it to the normal validation path below
            -- so a penalty or a renamed tag still gets caught.
            cfg = sp
        else
            local prof = K.MODIFIER_PROFILES[tostring(sp)] or K.MODIFIER_PROFILES.spear
            local out2, tot2 = {}, 0
            for _, t in ipairs(prof) do
                local info = next(tags) and tags[t] or { positive = true, boost = 0 }
                if next(tags) and not tags[t] then
                    log("MOD", ("'%s' is not a modifier in this game — skipped"):format(t))
                elseif not info.positive then
                    log("MOD", ("'%s' is a %d%% PENALTY — skipped"):format(t, info.boost))
                elseif K.MODIFIER_DENY[t] then
                    -- Same deny list the normal profiles honour. A profile name
                    -- is not an explicit user tag list, so it does not get to
                    -- opt into the penalties.
                    log("MOD", ("'%s' is on the deny list — skipped"):format(t))
                else
                    out2[#out2 + 1] = t
                    tot2 = tot2 + (info.boost or 0)
                end
            end
            -- Latched per map, not per session: one lobby VM stages many
            -- missions, and the line should reappear if the map changes.
            if K.TS.modNoted ~= K.TS.stagingMap then
                K.TS.modNoted = K.TS.stagingMap
                log("MOD", ("spear map %s — using the '%s' profile (%s) instead of '%s': "
                    .. "the watchtower pad has to be STOOD IN, and Glass Cannon makes that "
                    .. "one touch from dead")
                    :format(tostring(K.TS.stagingMap), tostring(sp),
                            #out2 > 0 and table.concat(out2, ", ") or "nothing",
                            tostring(CFG.ModifierProfile or "safe")))
            end
            return out2, tot2
        end
    end

    if type(cfg) == "table" then
        for _, t in ipairs(cfg) do wanted[#wanted + 1] = tostring(t) end
    else
        local name = tostring(CFG.ModifierProfile or "safe")

        -- Spawn-limited means time-per-run is set by the map, not by us, so the
        -- tougher-titan modifiers cost nothing we were using anyway — Oddball's
        -- +50% titan stats only matters while kills are the bottleneck. Trade
        -- the headroom for +97.5% reward instead of +52.5%.
        -- Read through disk, not _G: this runs in the lobby VM and the mission
        -- VM that formed the verdict is already gone. See K.govSpawnLimited.
        local spawnLimited = K.govSpawnLimited()
        if CFG.AutoModifierEscalate and spawnLimited and name == "safe" then
            name = "max"
            if not MISSION.escalated then
                MISSION.escalated = true
                log("MOD", "spawn-limited — escalating modifiers to 'max' (+97.5% vs +52.5%)")
            end
        elseif MISSION.escalated and not spawnLimited then
            MISSION.escalated = false
            log("MOD", "kill-limited again — back to the 'safe' profile")
        end

        local profile = K.MODIFIER_PROFILES[name] or K.MODIFIER_PROFILES.safe
        for _, t in ipairs(profile) do wanted[#wanted + 1] = t end
    end

    -- Validate against the live table so a renamed or removed modifier is
    -- dropped instead of being fired at the server as a bad argument, and so
    -- a penalty can never sneak in through a hand-written list.
    local out, total = {}, 0
    for _, tag in ipairs(wanted) do
        local info = next(tags) and tags[tag] or { positive = true, boost = 0 }
        if next(tags) and not tags[tag] then
            log("MOD", ("'%s' is not a modifier in this game — skipped"):format(tag))
        elseif not info.positive then
            log("MOD", ("'%s' is a %d%% PENALTY — skipped"):format(tag, info.boost))
        elseif K.MODIFIER_DENY[tag] and type(cfg) ~= "table" then
            -- only auto-profiles are denied; an explicit list is the user's call
        else
            out[#out + 1] = tag
            total = total + (info.boost or 0)
        end
    end
    return out, total
end

-- Toggle one modifier to `on`. Modify is a toggle returning the new state, so
-- a single call can land on the wrong side; read it back and correct once.
local function setModifier(tag, on)
    for _ = 1, 2 do
        local res = invoke(3, "S_Missions", "Modify", tag)
        if res == nil then return false end
        if (res == true) == on then return true end
        jwait(0.1, 0.06)
    end
    return false
end

local function applyModifiers()
    local wanted, total = wantedModifiers()
    if #wanted == 0 then return 0 end
    local applied = {}
    for _, tag in ipairs(wanted) do
        if setModifier(tag, true) then applied[#applied + 1] = tag end
        jwait(0.12, 0.08)
    end
    if #applied > 0 then
        log("MOD", ("+%.1f%% XP/Gold from %s"):format(total, table.concat(applied, ", ")))
    end
    return #applied
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 38c · OBJECTIVES  ·  validated per map
--
--     Modules.Storage.Objectives is keyed [Type][MapName] -> ordered list.
--     Live on 2193, for Type = "Missions":
--         Shiganshina  Skirmish · Breach  · Random
--         Outskirts    Skirmish · Escort  · Random
--         Trost        Skirmish · Protect · Random
--         Docks        Skirmish · Stall   · Random
--         Utgard       Skirmish · Defend  · Random
--         Forest       Skirmish · Guard   · Random
--         Chapel       Skirmish · Random
--         Stohess      Skirmish · Random
--     Other types exist too: "Raids" (Shiganshina/Stohess/Trost) and "Waves"
--     (Trost only).
--
--     Asking Chapel for "Escort" is a silently failed Create, which the old
--     difficulty-descent logic would then misread as "difficulty too high" and
--     answer by dropping a tier. Validating first removes that whole failure
--     mode.
-- ═══════════════════════════════════════════════════════════════════════════
local function objectivesFor(mapName, missionType)
    local O = MOD.Objectives
    if type(O) ~= "table" then return nil end
    local byType = O[missionType or "Missions"]
    local list = type(byType) == "table" and byType[mapName]
    if type(list) ~= "table" then return nil end
    return list
end

local function resolveObjective(mapName, wanted, missionType)
    local list = objectivesFor(mapName, missionType)
    if not list then return wanted end          -- table unreadable; trust config
    for _, o in ipairs(list) do
        if tostring(o) == tostring(wanted) then return wanted end
    end
    -- Skirmish exists on every mission map; it is the safe universal fallback.
    local fallback = "Skirmish"
    for _, o in ipairs(list) do
        if tostring(o) == fallback then
            log("MISSION", ("'%s' is not an objective on %s (%s) — using Skirmish")
                :format(tostring(wanted), mapName, table.concat(list, "/")))
            return fallback
        end
    end
    return list[1] and tostring(list[1]) or wanted
end

-- Returns: success, difficultyUsed
-- forceDiff pins a single tier and disables the descent ladder. Used by the
-- Thunder Spear router: those quests only credit on one difficulty, so a
-- mission that quietly lands a tier lower is wasted time rather than a
-- graceful degradation.
local function createMission(mapName, objective, forceDiff)
    local floorRank = diffRank(CFG.MissionDifficulty)
    local names     = difficultyLadderNames()   -- hardest first
    local start     = chooseStartDifficulty()

    if forceDiff and diffRank(forceDiff) > 0 then
        start     = tostring(forceDiff)
        names     = { start }
        floorRank = 0
    end

    -- Descent order: the chosen tier, then everything below it that still
    -- clears the configured floor, and only then — as a genuine last resort —
    -- the tiers beneath the floor, so a temporarily-weak account still gets a
    -- mission rather than spinning in the lobby.
    local atOrAbove, below, seen = {}, {}, {}
    local startIdx = 1
    for i, n in ipairs(names) do
        if n:lower() == start:lower() then startIdx = i break end
    end
    for i = startIdx, #names do
        local n = names[i]
        if not seen[n:lower()] then
            seen[n:lower()] = true
            if floorRank == 0 or diffRank(n) >= floorRank then
                atOrAbove[#atOrAbove + 1] = n
            else
                below[#below + 1] = n
            end
        end
    end
    local order = atOrAbove
    for _, n in ipairs(below) do order[#order + 1] = n end
    if #order == 0 then order = { start } end

    for _, difficulty in ipairs(order) do
        -- Exactly the shape the game's own Missions UI sends. Nothing else:
        -- an unknown key is at best ignored and at worst a rejected call.
        local payload = {
            Name      = mapName,
            Type      = CFG.StartType or "Missions",
            Objective = objective,
            Difficulty= difficulty,
        }

        setAction("Creating %s · %s · %s", mapName, objective, difficulty)
        -- Deadline trimmed from 6s: with the timeout now handled properly, a
        -- shorter one gets the same-tier retry away sooner instead of spending
        -- twelve seconds finding out the box is busy.
        local res, why = invoke(4, "S_Missions", "Create", payload)

        -- A DEADLINE IS NOT A REJECTION.
        --
        -- invoke used to return a bare nil for both, and this loop read that as
        -- "the account cannot run this tier": it descends, succeeds one tier
        -- lower, and then PERSISTS the downgrade to K.DIFF_FILE. Retry replays
        -- that tier for the whole run, and the mission-side difficulty guard
        -- compares against the same file — so it agrees the run is on target
        -- and never makes the corrective lobby trip. One slow round trip pins
        -- the account a tier low for up to LobbyEvery missions, at roughly a
        -- fifth of the gold per run by this file's own measurements. With
        -- twenty to forty clients on one box at a 200ms frame period, a Create
        -- that overruns its deadline is ordinary rather than exotic.
        --
        -- So: re-issue the SAME tier once, and if the server still will not
        -- answer, abandon the whole ladder rather than walking it on no
        -- evidence. The caller retries, and chooseStartDifficulty recomputes
        -- from Potential, so the next attempt starts at the top again with
        -- nothing written to disk.
        if res == nil and why == "timeout" then
            jwait(0.5, 0.2)
            res, why = invoke(4, "S_Missions", "Create", payload)
            if res == nil and why == "timeout" then
                log("MISSION", ("Create timed out twice at %s — that is a stalled box, "
                    .. "not an unavailable tier. Not descending."):format(difficulty))
                return false, nil
            end
        end

        if res ~= nil then
            MISSION.knownGood = difficulty
            MISSION.created   = MISSION.created + 1
            MISSION.probeUpAt = MISSION.created + 25
            STATE.diffRank    = diffRank(difficulty)
            -- Persist it: every mission is a fresh server, so this is the only
            -- thing the rewards screen can compare a replayed run against.
            rememberDifficulty(difficulty)
            return true, difficulty
        end

        jwait(0.3, 0.2)
    end

    return false, nil
end

local function startMission(difficulty)
    -- Modifiers must be toggled on the created mission, before Start.
    -- (v9 called Modify(difficulty) here, believing it set the difficulty. It
    --  does not — Modify toggles a modifier by name — so that call always
    --  missed and v9 ran every mission with no modifiers at all.)
    applyModifiers()
    invoke(3, "S_Missions", "Start")
    setAction("Teleporting to mission")
    -- Poll for the actual place change instead of sleeping a flat 10s.
    local placeBefore = game.PlaceId
    waitUntil(function() return game.PlaceId ~= placeBefore end, 20, 0.25)
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 39 · LOBBY BRAIN
-- ═══════════════════════════════════════════════════════════════════════════
local function runLobby()
    setAction("Lobby")
    applyAntiLag()

    -- We are here, so the upkeep debt is paid. Recorded against the mission
    -- count rather than the clock, and persisted, because the counter has to
    -- survive the teleport back out.
    K.lobbyAtMission = STATE.missions
    if K.sessionSave then K.sessionSave() end

    -- Fail loudly on a bad map name. An unknown map makes every Create call
    -- return nil, which is indistinguishable at runtime from "difficulty too
    -- high" — so the bot would quietly grind the easiest tier forever.
    if not isKnownMap(tostring(CFG.MissionMap)) then
        log("CONFIG", ("MissionMap '%s' is not a map in this game — falling back to Chapel")
            :format(tostring(CFG.MissionMap)))
        CFG.MissionMap = "Chapel"
    end

    local lastUpgradeGold  = -1
    local lastUpgradeLevel = -1
    local lastQuest        = 0
    local nextSpearClaim   = 0

    -- Thunder Spear claim sweep, but only while there is something to claim.
    --
    -- Guarded against a SECOND copy. The brain now restarts runLobby after a
    -- caught error, and this thread gates on alive() rather than on the
    -- invocation that spawned it, so it survives the restart — a re-entry
    -- without this flag leaves two sweeps claiming on the same 10s cadence.
    if CFG.AutoThunderSpearQuest and not K.tsSweepRunning then
        K.tsSweepRunning = true
        task.spawn(function()
            K.stagger(10)
            task.wait(3)
            while alive() and not isMissionPlace() do
                refreshState()
                if spearsComplete(STATE.inventory) then
                    log("TS", "questline complete — claim sweep stopped")
                    break
                end
                claimSpears()
                task.wait(0.3)
                clickClaimButtons()
                task.wait(10)
            end
        end)
    end

    while alive() do
        task.wait(1)
        if placeKind() ~= "Lobby" then return end   -- teleported out

        refreshState()

        -- Decide the account-status verdict here, where the save and attributes
        -- are fully replicated, and persist it. A mission reports this value
        -- rather than recomputing it from data it does not have.
        if K.checkStatusLobby then K.checkStatusLobby() end

        -- ── housekeeping on their own cadences ────────────────────────────
        if os.time() - lastQuest > 300 then
            lastQuest = os.time()
            task.spawn(runQuests)
        end
        task.spawn(runBoosts)

        -- ── sell perks ────────────────────────────────────────────────────
        local sellTarget = 30
        if STATE.diffRank >= 4 then
            sellTarget = tonumber(CFG.PerkSellTarget)
            if not sellTarget or sellTarget <= 0 then sellTarget = 1000 end
        end
        -- The sell that used to stand HERE is gone, and that is the whole fix
        -- for perks never getting equipped.
        --
        -- equipPerks() is 100 lines below and its own comment says it runs
        -- "BEFORE the sell pass on purpose". That was true of the pre-mission
        -- sell at the bottom -- and false of this one, which ran first and
        -- deleted every UNEQUIPPED perk in storage. equipPerks then scored a
        -- storage holding only the already-equipped uuids, found nothing left
        -- to promote, and returned. Perks could only ever be equipped on a
        -- pass where selling happened to be broken.
        --
        -- And it always won the race: STATE.diffRank is 0 in a fresh lobby VM
        -- (it is assigned mission-side, and inside createMission, which runs at
        -- the very end of the pass just before the teleport that destroys the
        -- VM), so sellTarget here was ALWAYS 30 -- while the mission-side leave
        -- rule sends the bot back to the lobby at exactly 30 sellable. That is
        -- how an account sits at 118 perks owned and 0/6 slots equipped.
        --
        -- Nothing is lost by dropping it: the identical "never enter a mission
        -- with a full perk storage" sell still runs just after equipPerks(),
        -- and every `continue` between here and there skips mission staging.

        -- ── prestige ──────────────────────────────────────────────────────
        if CFG.AutoPrestige and isMaxed() and STATE.prestige < num(CFG.PrestigeTarget, 5) then
            local key = "P" .. (STATE.prestige + 1)
            local ps  = (CFG.VCPlusPrestige and CFG.VCPlusPrestige[key]) or { RequiredGold = 0 }
            local need = num(ps.RequiredGold) * 1000000
            if STATE.gold >= need then
                -- BOUNDED RETRY. A rejected Prestige used to re-enter here on the
                -- next pass with every input identical -- still maxed, still rich
                -- enough -- so it called doPrestige again, and again, forever.
                -- doPrestige opens with a 1.5-3s pace wait, so it is not a tight
                -- spin, but the bot never stages another mission either: the farm
                -- simply stops at the level cap.
                --
                -- The counter lives in the LOBBY VM, which is the one doing the
                -- looping, so it counts what it needs to. A teleport resets it,
                -- which is correct: leaving the lobby means the wedge broke, and
                -- a later visit should try again in case the rejection was
                -- transient. Reset immediately on success too.
                if STATE.prestige ~= K.prestigeTriedAt then
                    K.prestigeTriedAt, K.prestigeTries = STATE.prestige, 0
                end
                K.prestigeTries = (K.prestigeTries or 0) + 1
                if K.prestigeTries <= num(CFG.PrestigeMaxTries, 5) then
                    doPrestige()
                    lastUpgradeGold, lastUpgradeLevel = -1, -1
                    MISSION.knownGood = nil      -- re-probe: the account changed
                    continue
                end
                setAction("Prestige refused %dx — farming on", K.prestigeTries)
                log("PRESTIGE", ("refused %d times at P%d — continuing to farm "
                    .. "instead of wedging in the lobby"):format(K.prestigeTries, STATE.prestige))
            else
                setAction("Maxed — banking gold for prestige (%s/%s)",
                    shortNum(STATE.gold), shortNum(need))
            end
        end

        -- ── after the prestige target: spins + family roll (§35b) ─────────
        -- Once per lobby visit. Blocks while it buys and rolls; true means
        -- hold here (a menu teleport is in flight, or FamilyKeepFarming=false).
        if K.famLobby() then
            if K.FAM.hold == "menu" then
                -- The teleport normally lands within seconds. If it has not,
                -- drop the hold and farm rather than idle in the lobby.
                if os.clock() - (K.FAM.menuAt or 0) > 45 then
                    K.FAM.hold = nil
                    K.famSetWhere("none:" .. tostring(os.time()))
                    log("FAMILY", "menu teleport did not happen — farming on, rolls paused 6h")
                else
                    setAction("Family roll — waiting for the menu teleport")
                    task.wait(2)
                    continue
                end
            else
                setAction("Family goal done — holding in the lobby (FamilyKeepFarming = false)")
                task.wait(10)
                continue
            end
        end

        -- ── do not route on a save that has not arrived ───────────────────
        --
        -- Every Thunder Spear gate reads the save: isMaxed() needs maxXp, and
        -- nextSpearMap needs the inventory. Before the save lands maxXp is 0 and
        -- the inventory is empty, so isMaxed() is false and every part reads as
        -- missing -- the router silently concludes "not maxed, farm normally"
        -- and stages Chapel. Observed exactly that: an account at 225/225 with
        -- xp full and Escort outstanding took a Chapel run instead of Outskirts,
        -- with no line in the breadcrumb because logSpears suppresses an empty
        -- inventory rather than reporting nonsense about it.
        --
        -- Waiting is bounded: after SaveWaitSeconds the run proceeds on whatever
        -- is known, so an unreadable save degrades to normal farming instead of
        -- wedging the bot in the lobby.
        if CFG.AutoThunderSpearQuest then
            local invReady = type(STATE.inventory) == "table"
                and next(STATE.inventory) ~= nil
            if (not invReady or num(STATE.maxXp) <= 0) then
                K.saveWaitAt = K.saveWaitAt or os.clock()
                if os.clock() - K.saveWaitAt < num(CFG.SaveWaitSeconds, 20) then
                    setAction("Waiting for the save before routing")
                    refreshState(true)
                    task.wait(1)
                    continue
                end
            else
                K.saveWaitAt = nil
            end
        end

        -- ── Thunder Spear routing ─────────────────────────────────────────
        local tsMap = nil
        if not CFG.AutoThunderSpearQuest then
            -- silent: the feature is off, there is nothing to report
        elseif STATE.prestige < num(CFG.ThunderSpearAtPrestige, 2) then
            K.logSpears(("prestige %s < %s")
                :format(tostring(STATE.prestige), tostring(CFG.ThunderSpearAtPrestige)))
        elseif not isMaxed() then
            K.logSpears(("level %s/%s, xp %s/%s — spears only run while maxed")
                :format(tostring(STATE.level), tostring(levelCap()),
                        shortNum(STATE.xp), shortNum(STATE.maxXp)))
        elseif K.TS.handleDone and spearsComplete(STATE.inventory) then
            K.logSpears("Handle budget spent this session")
        elseif spearsComplete(STATE.inventory) then
            K.logSpears(nil)
        else
            if os.clock() >= nextSpearClaim then
                nextSpearClaim = os.clock() + 5
                claimSpears()
                refreshState(true)
            end
            if not spearsComplete(STATE.inventory) then
                tsMap = nextSpearMap(STATE.inventory)
            end
            K.logSpears(nil)
        end

        -- ── character must exist before we can stage a mission ────────────
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            setAction("Waiting for character")
            continue
        end

        -- ── upgrades / skills ─────────────────────────────────────────────
        -- Only when there is new gold or a new level to spend. v9 re-ran the
        -- whole block on a 20s timer whether or not anything had changed.
        local goldMoved  = STATE.gold > lastUpgradeGold * 1.02 or lastUpgradeGold < 0
        local levelMoved = STATE.level ~= lastUpgradeLevel
        if CFG.AutoUpgrade and (goldMoved or levelMoved) then
            lastUpgradeGold, lastUpgradeLevel = STATE.gold, STATE.level
            runUpgrades()
            if CFG.SmartSkills then runSkills() end
            refreshState(true)
        end

        -- ── equip perks ───────────────────────────────────────────────────
        -- Cheap and idempotent: it returns immediately unless a Type slot is
        -- actually empty, so it is safe to attempt on every lobby pass. It runs
        -- BEFORE the sell pass on purpose — a perk that just got equipped is
        -- excluded from the sellable list, so equipping first is what stops the
        -- bot from deleting its own best perk.
        equipPerks()

        -- ── safety: never enter a mission with a full perk storage ────────
        if CFG.AutoDeletePerk and STATE.perksSellable >= sellTarget then
            sellPerks("pre-mission safety")
        end

        -- ── stage and launch ──────────────────────────────────────────────
        -- AutoFarm = false means "do the housekeeping but do not start runs",
        -- which is also what makes a dry-run smoke test safe.
        if not CFG.AutoFarm then
            setAction("Idle in lobby (AutoFarm off)")
            task.wait(4)
            continue
        end

        pcall(function()
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            root.CFrame = CFrame.new(233.395, 8.865, 37.525)
            root.Anchored = true
            task.wait(0.6)
            root.Anchored = false
        end)

        setAction("Leaving old group")
        invoke(3, "S_Missions", "Leave")

        local mapName   = tsMap or tostring(CFG.MissionMap or "Chapel")
        local objective = tostring(CFG.MissionObjective or "Skirmish")

        -- TELL THE MODIFIER PASS THAT THIS IS A SPEAR RUN.
        --
        -- It matters whenever the run might chase a part -- which is NOT the
        -- same as the router having picked the map. A hand-set MissionMap =
        -- "Outskirts" lands on a spear map too, because runMission switches the
        -- tower objective on from the PLACE alone.
        --
        -- The test is deliberately the loose one (questline not complete)
        -- rather than the exact one runMission makes (this map's part is
        -- missing), because the two decisions read the save at different
        -- moments and the save lags. Observed live within one minute of picking
        -- up the last part: the lobby staged Utgard as a normal run while the
        -- mission that started from it announced "chasing Thruster" and went
        -- looking for the objective -- i.e. a run that intended to land, staged
        -- with Glass Cannon on. Being wrong the safe way costs ~45% of the
        -- reward on one short run that then leaves; being wrong the other way
        -- costs the run.
        K.TS.stagingMap = nil
        if CFG.AutoThunderSpearQuest and TS_PART_OF[mapName]
           and not spearsComplete(STATE.inventory) then
            K.TS.stagingMap = mapName
        end

        -- Every Thunder Spear quest credits on SKIRMISH, including Escort and
        -- Defend Missing Supplies. Picking the map's like-named objective
        -- ("Escort" on Outskirts, "Guard" on Forest) runs a different mission
        -- that the questline never sees — which is what made Escort look like
        -- it had no server-side handler. The Escort/Defend halves auto-start
        -- inside the Skirmish run once their retrieval half is done.
        local tsDiff = nil
        -- Whether THIS pass is staging the Handle run. The attempt itself is
        -- not counted here -- see the createMission result below.
        K.TS.handleStaged = false
        if tsMap then
            objective = "Skirmish"

            -- THE ESCORT HALF NEEDS ITS OWN OBJECTIVE.
            --
            -- Skirmish is right for Towers -- it took this account from 0/3 to
            -- 3/3. It is NOT producing anything for Escort: with Towers claimed,
            -- a full RequestStreamAroundAsync sweep of the map (X 1500..7700,
            -- Z -1200..900, 36 probes) found no trigger circle, no carriage, and
            -- an empty Unclimbable.Objective / Spears / Cutscene. Nothing spawns.
            --
            -- v9's note that Escort "has no server-side handler" was written
            -- while Towers was still incomplete, i.e. while Escort was LOCKED --
            -- so it proves nothing about the state we are in now. Run the map's
            -- own Escort objective and let the breadcrumb say whether carts
            -- appear; resolveObjective below drops back to Skirmish if the map
            -- does not offer it.
            if tsMap == "Outskirts" and spearQuestClaimed("Towers")
               and not spearQuestClaimed("Escort") then
                objective = tostring(CFG.EscortObjective or "Escort")
            end
            -- Towers and Retrieve Missing Supplies only credit on Aberrant, so
            -- pin the tier instead of letting the ladder descend past it.
            if tsMap == "Outskirts" or tsMap == "Forest" then tsDiff = "Aberrant" end
            if tsMap == "Outskirts" then
                K.TS.handleStaged = true
                K.tsBreadcrumb(("staging Outskirts %s (Towers claimed=%s, Escort claimed=%s)")
                    :format(objective, tostring(spearQuestClaimed("Towers")),
                            tostring(spearQuestClaimed("Escort"))))
            end
        end

        objective = resolveObjective(mapName, objective, CFG.StartType or "Missions")

        local ok, difficulty = createMission(mapName, objective, tsDiff)
        if ok then
            -- Count the Handle attempt only once the mission actually EXISTS.
            -- Counted at staging time, a Create the SERVER REJECTED still spent
            -- one of the ten -- and K.TS.tries is persisted to disk and latches
            -- K.TS.handleDone at the cap, so a run of rejected Creates could
            -- burn the entire budget without the bot ever standing on Outskirts
            -- once, permanently abandoning the Handle for that account. With the
            -- tier pinned to Aberrant just above, rejection is the expected
            -- failure mode here, not a hypothetical one.
            if K.TS.handleStaged then K.noteHandleAttempt() end
            log("MISSION", ("created %s · %s · %s"):format(mapName, objective, difficulty))
            startMission(difficulty)
        else
            log("MISSION", ("could not create %s — retrying"):format(mapName))
            task.wait(2)
        end
    end
end

