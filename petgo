-- Stand on a hitbox until it registers. The offset walk exists because a
-- perfectly static touch sometimes never fires TouchTransmitter; nudging the
-- root re-triggers it. Exits as soon as the world confirms, instead of always
-- burning the full hold like v9 did.
local function touchHitbox(hitbox, holdTime, doneCheck)
    holdTime = holdTime or 1.2
    if not hitbox or not hitbox.Parent then return false end
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    hrp.Anchored = false
    hrp.CFrame = CFrame.new(hitbox.Position + Vector3.new(0, 5, 0))
    task.wait(0.15)

    local offsets = {
        Vector3.new(0, 0, 0), Vector3.new(2, 0, 0), Vector3.new(-2, 0, 0),
        Vector3.new(0, 0, 2), Vector3.new(0, 0, -2), Vector3.new(0, -2, 0),
    }
    local deadline, i = os.clock() + holdTime, 1
    while os.clock() < deadline and hrp.Parent do
        hrp.CFrame = CFrame.new(hitbox.Position + offsets[i])
        if EXEC.firetouch then
            pcall(EXEC.firetouch, hrp, hitbox, 0)
            pcall(EXEC.firetouch, hrp, hitbox, 1)
        end
        if doneCheck then
            local ok, done = pcall(doneCheck)
            if ok and done then return true end
        end
        task.wait(0.12)
        i = i % #offsets + 1
    end
    return true
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 27 · WATCHTOWERS  (Outskirts / Thunder Spear "Handle")
--     Standing inside the circle builds the tower. The character must be
--     re-placed periodically because a respawn invalidates the root, and it
--     must be un-anchored afterwards or the combat loop inherits a frozen
--     character.
-- ═══════════════════════════════════════════════════════════════════════════
-- Measured live in Outskirts on 2026-08-23, because every assumption the old
-- code made about this objective was wrong:
--
--   * There is NO "Towers" entry in ReplicatedStorage.Objectives. That folder
--     holds only the Skirmish counters (Slay, Blind_Titans). Tower progress
--     lives in the SAVE, under slot.Quests.Spears.
--   * The towers do NOT all exist at mission start. Only WatchTower_1 is
--     present; WatchTower_2 appears after the first is built. The old loop
--     indexed 1..3 up front, found 2 and 3 missing, and burned all three slots
--     in a single frame — which is why this quest sat at 0/3 forever.
--   * A BUILT tower keeps its Circle and Hitbox. So "the circle went away" is
--     not a completion signal either.
--
-- What IS reliable: the save counter moving, or the next tower spawning.
K.towerCount = function()
    local n = 0
    for _, c in ipairs(Workspace:GetChildren()) do
        if c.Name:match("^WatchTower_%d+$") then n = n + 1 end
    end
    return n
end

K.towersQuestCurrent = function()
    local cur = nil
    pcall(function()
        local slot = getSlot(true)          -- forced: only the server moves this
        local sp = slot and type(slot.Quests) == "table" and slot.Quests.Spears
        if type(sp) ~= "table" then return end
        for _, q in pairs(sp) do
            if type(q) == "table" and tostring(q.Tag or "") == "Towers" then
                cur = num(q.Current)
            end
        end
    end)
    return cur
end

-- Pick whichever watchtower the map is currently offering.
--
-- The map does NOT expose WatchTower_1..3 up front and does NOT start at 1. It
-- shows exactly the next uncompleted tower, numbered by the save's quest
-- progress — an account at 1/3 sees WatchTower_2 with no WatchTower_1 anywhere.
-- v10 indexed 1,2,3, waited 25s for a WatchTower_1 that was never going to
-- exist, failed three times and abandoned the objective. Scan instead.
-- A BUILT tower keeps its Circle and its Hitbox -- measured live, the finished
-- WatchTower_1 still had both. So a circle being present says nothing about
-- whether it still needs building, and standing in a finished one parks the bot
-- next to a completed tower forever. K.TS.skip holds the ones that have been
-- written off this mission for producing no credit.
-- Measured on WatchTower_3: the circle's Hitbox is 7.25 x 220 x 220 studs, and
-- the Floor beside it is 0.004 x 220 x 220 -- so the part is rotated with its
-- thin axis vertical. The trigger is a 220-stud-WIDE pad only about 7 studs
-- tall, sitting at y ~= 3.4.
--
-- Two consequences, both load-bearing:
--   * Hovering above it is impossible. Building means being at ground level,
--     inside titan reach, whatever else the code would prefer.
--   * But the pad is 110 studs in radius, so the CENTRE is not the only place
--     that counts. Standing on the far edge from the nearest titan buys most of
--     a titan's approach for free, every tick, at no cost to the objective.
K.circleRadius = function(hitbox)
    local sz = hitbox.Size
    local a, b, c = sz.X, sz.Y, sz.Z
    -- Drop the thin (vertical) axis; the remaining pair is the pad's footprint.
    local thin = math.min(a, math.min(b, c))
    local flat = {}
    for _, v in ipairs({ a, b, c }) do
        if v ~= thin or #flat >= 2 then flat[#flat + 1] = v end
    end
    local r = math.min(flat[1] or thin, flat[2] or thin) / 2
    return math.max(0, r * num(CFG.TowerEdgeUse, 0.75))
end

-- HOW CLOSE IS THE NEAREST TITAN, REALLY.
--
-- The tower branch used to read this out of TITANS.set alone, and skipped any
-- entry whose `root` had not resolved yet. Under StreamingEnabled that is a
-- blind spot with teeth: a titan streams in AS A MODEL first and its
-- HumanoidRootPart lands a replication step later, so for that window it is
-- invisible to the threat scan -- and at a 5 fps frame cap the window is long
-- enough to walk. A death was recorded "grounded in WatchTower_2, nearest 722"
-- with the character dragged 9 studs below the pad it was commanded to hold,
-- i.e. grabbed by something the scan swore was 722 studs away.
--
-- So scan the folder itself, and fall back to the model's pivot when the root
-- is not there yet. A titan that cannot be measured is treated as being AT the
-- circle rather than absent, because those are not the same risk.
K.nearestTitanTo = function(pos, set)
    -- Memoised on a short TTL. The folder walk touches every titan model on the
    -- map and the callers below sit in the combat loop, which on a busy box runs
    -- this several times a second per client; the answer cannot meaningfully
    -- change inside 150ms, since a titan walks a few studs in that time.
    local now = os.clock()
    local c = K.ntCache
    if c and (now - c.at) < 0.15 and (c.pos - pos).Magnitude < 5 then
        return c.val
    end

    local nearest = math.huge
    for _, te in pairs(set or {}) do
        local tr, thm = te.root, te.hum
        if tr and tr.Parent and thm and thm.Health > 0 then
            local d = (tr.Position - pos).Magnitude
            if d < nearest then nearest = d end
        end
    end
    local folder = Workspace:FindFirstChild("Titans")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            local h = m:FindFirstChildWhichIsA("Humanoid")
            if h and h.Health > 0 then
                local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                local p = r and r.Position
                if not p then
                    -- No root yet: the model streamed in ahead of it. Its parts
                    -- still place it, and GetPivot reads them.
                    local ok, cf = pcall(function() return m:GetPivot() end)
                    if ok and cf and cf.Position.Magnitude > 1 then p = cf.Position end
                end
                -- Still nothing: a model with a live Humanoid and no parts at
                -- all. Skip it rather than calling it adjacent -- a titan with
                -- no parts has no reach either, and "unmeasurable means on top
                -- of us" is a rule that can never clear, which is exactly the
                -- kind of permanent veto this whole change exists to remove.
                if p then
                    local d = (p - pos).Magnitude
                    if d < nearest then nearest = d end
                end
            end
        end
    end

    K.ntCache = { at = now, pos = pos, val = nearest }
    return nearest
end

-- Pick the point on that pad that is furthest from the nearest live titan.
K.safeCirclePoint = function(hitbox, titans)
    local centre = hitbox.Position
    local r = K.circleRadius(hitbox)
    if r <= 1 then return centre end

    local best, bestScore = centre, -1
    for i = 0, 7 do
        local a = (math.pi / 4) * i
        local cand = centre + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
        local nearest = math.huge
        for _, e in pairs(titans) do
            local tr, th = e.root, e.hum
            if tr and tr.Parent and th and th.Health > 0 then
                local d = (tr.Position - cand).Magnitude
                if d < nearest then nearest = d end
            end
        end
        if nearest > bestScore then best, bestScore = cand, nearest end
    end
    return best, bestScore
end

-- ANY trigger circle, not just a watchtower.
--
-- The Escort half of the questline works the same way as Towers: a circle has
-- to be stood in before the carriage will spawn. Its model is not called
-- WatchTower_N, and the map only exposes it while that objective is live -- an
-- empty Unclimbable.Spears / Unclimbable.Objective on a finished run says
-- nothing about what appears during one. So match on the SHAPE that both
-- objectives share (a "Circle" model holding a "Hitbox" part) rather than on a
-- name this code would have to guess.
--
-- The search is deliberately shallow: the roots below are where the map puts
-- objective geometry, and a full GetDescendants() walk every combat tick at a
-- 200ms frame period is not affordable.
-- "" means Workspace itself. A literal nil first element would end ipairs
-- on the first step and silently search nothing.
K.CIRCLE_ROOTS = { "", "Unclimbable.Spears", "Unclimbable.Objective",
                   "Unclimbable.Cutscene" }

-- ignoreSkip matters for the escort half. The carriage is called from the SAME
-- circle the tower was built in -- it is not a separate object -- but by then
-- that circle has usually been written off by K.TS.skip precisely BECAUSE it
-- stopped crediting, which is what a finished tower does. Honouring the skip
-- list here would blacklist the one circle the escort needs.
--
-- Highest index first for the same reason: the last tower built is the live one,
-- and the lower-numbered circles are leftovers that still carry their geometry.
-- FIND THE CIRCLE INSTEAD OF WAITING FOR IT.
--
-- Workspace.StreamingEnabled is true, so a GetDescendants() walk only ever sees
-- what is already near the character -- "no circle in the map" and "the circle
-- is 5000 studs away" are the same observation. Measured: Borders put this map
-- at roughly X 293..7701, Z -3028..1921, the spawn points sit at X ~= 1936 and
-- the watchtower was at X ~= 7290, so the playable strip is thousands of studs
-- long. The bot hovered at the spawn end waiting for geometry that was never
-- going to come to it.
--
-- Player:RequestStreamAroundAsync pulls a region in without moving the
-- character, which is both faster and safer than flying the strip.
K.sweepForCircle = function()
    if K.TS.sweeping then return end
    K.TS.sweeping = true

    task.spawn(function()
        local step   = num(CFG.CircleSweepStep, 500)
        local budget = num(CFG.CircleSweepPoints, 80)
        local ch     = plr.Character
        local hrp    = ch and ch:FindFirstChild("HumanoidRootPart")
        local here   = hrp and hrp.Position or Vector3.new(0, 0, 0)

        -- Sweep outward from where we are: the circle is more likely near the
        -- objective we were just working than at the far corner of the box.
        local ring = 0
        local tried = 0
        K.tsBreadcrumb("circle sweep: starting")

        while alive() and tried < budget do
            local pts = {}
            if ring == 0 then
                pts[1] = here
            else
                local d = ring * step
                for i = -ring, ring do
                    pts[#pts + 1] = here + Vector3.new(i * step, 0, -d)
                    pts[#pts + 1] = here + Vector3.new(i * step, 0,  d)
                end
                for i = -ring + 1, ring - 1 do
                    pts[#pts + 1] = here + Vector3.new(-d, 0, i * step)
                    pts[#pts + 1] = here + Vector3.new( d, 0, i * step)
                end
            end

            for _, pt in ipairs(pts) do
                if not alive() or tried >= budget then break end
                tried = tried + 1
                pcall(function() plr:RequestStreamAroundAsync(pt) end)
                local m, hb = K.anyTriggerCircle(true)
                if m and hb then
                    K.TS.escortPos = hb.Position
                    K.TS.escortR   = K.circleRadius(hb)
                    K.tsBreadcrumb(("circle sweep: FOUND %s at %s after %d probes")
                        :format(m:GetFullName(), tostring(hb.Position), tried))
                    K.TS.sweeping = false
                    return
                end
                task.wait(0.15)
            end
            ring = ring + 1
            if ring > 12 then break end
        end

        K.tsBreadcrumb(("circle sweep: nothing found in %d probes"):format(tried))
        K.TS.sweeping = false
        K.TS.sweptAt  = os.clock()
    end)
end

-- Last-resort circle search: anywhere in the map, at any depth.
--
-- K.anyTriggerCircle only looks at four known roots, which is right for a hot
-- loop but wrong as the only answer -- the Escort circle is not guaranteed to
-- live where the tower circles did, and a missed circle means the convoy is
-- never summoned at all. Walk the whole tree, but rarely: this is called at
-- most once every DeepCircleEvery seconds, and only while actually waiting on
-- the carriage.
K.deepFindCircle = function()
    local best, bestHb = nil, nil
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d.Name == "Hitbox" and d:IsA("BasePart") then
                local circle = d.Parent
                if circle and circle.Name == "Circle" and circle.Parent then
                    -- Ignore the titans' own internal Circle parts.
                    local owner = circle.Parent
                    if not owner:FindFirstChildWhichIsA("Humanoid")
                       and owner.Parent ~= Workspace:FindFirstChild("Titans") then
                        best, bestHb = owner, d
                        return
                    end
                end
            end
        end
    end)
    return best, bestHb
end

K.anyTriggerCircle = function(ignoreSkip)
    local skip = (not ignoreSkip) and (K.TS.skip or {}) or {}
    local seen = {}
    local bestTower, bestHb, bestIdx = nil, nil, -1
    local firstOther, firstOtherHb = nil, nil

    local function circleOf(model)
        if not model or seen[model] then return nil end
        seen[model] = true
        if skip[model.Name] then return nil end
        local circle = model:FindFirstChild("Circle")
        local hitbox = circle and circle:FindFirstChild("Hitbox")
        if hitbox and hitbox:IsA("BasePart") then return hitbox end
        return nil
    end

    for _, path in ipairs(K.CIRCLE_ROOTS) do
        local node = Workspace
        for part in path:gmatch("[^%.]+") do
            node = node and node:FindFirstChild(part)
        end
        if node then
            for _, c in ipairs(node:GetChildren()) do
                local hb = circleOf(c)
                if hb then
                    local idx = tonumber(c.Name:match("^WatchTower_(%d+)$"))
                    if idx then
                        if idx > bestIdx then bestTower, bestHb, bestIdx = c, hb, idx end
                    elseif not firstOther then
                        firstOther, firstOtherHb = c, hb
                    end
                end
            end
        end
    end

    if bestTower then return bestTower, bestHb end
    return firstOther, firstOtherHb
end

K.nextTowerModel = function()
    -- The tower index tracks the SAVE, not the map: an account at 2/3 is shown
    -- WatchTower_2 (already built, still carrying its circle) alongside
    -- WatchTower_3 (the real one). Picking the lowest visible index therefore
    -- parked the bot on a finished tower with the live one in plain sight --
    -- measured, with q = {base = 1, last = 2} and towers = {2, 3}.
    --
    -- So aim at quest.Current + 1 when the save can be read, and only fall back
    -- to the lowest unskipped circle when it cannot.
    local skip = K.TS.skip or {}
    local q = K.TS.q or {}
    local want = (q.last or q.base)
    if want then want = want + 1 end

    local best, bestIdx = nil, math.huge
    for _, c in ipairs(Workspace:GetChildren()) do
        local idx = tonumber(c.Name:match("^WatchTower_(%d+)$"))
        if idx and not skip[c.Name] then
            local circle = c:FindFirstChild("Circle")
            if circle and circle:FindFirstChild("Hitbox") then
                if want and idx == want then return c, idx end
                if idx < bestIdx then best, bestIdx = c, idx end
            end
        end
    end
    -- Nothing matched the wanted index. If the save says a lower-numbered
    -- circle is already done, it is not worth standing in.
    if want and best and bestIdx < want then return nil, nil end
    return best, (best and bestIdx or nil)
end


