--  6 · LOGGING
--     print/warn are dead by design (section 0). Everything routes through a
--     bounded ring buffer that the telemetry reporter and the optional
--     rconsole mirror read from. Zero allocation when Debug is off.
-- ═══════════════════════════════════════════════════════════════════════════
local LOG = { ring = table.create and table.create(160) or {}, n = 0, max = 160 }

-- Console mirroring is OFF by default. Calling rconsoleprint auto-opens a
-- console window on most executors, which is the opposite of headless — the
-- log ring and _G.VCP_TAIL() give you the same lines without a window.
-- Set Console = true to get the window back.
local CONSOLE = CFG.Console == true

if not CONSOLE then
    -- Close one we opened on a previous run before this default existed.
    pcall(function() if rconsoleclose then rconsoleclose() end end)
    pcall(function() if rconsoledestroy then rconsoledestroy() end end)
end

local function log(tag, msg)
    LOG.n = LOG.n + 1
    LOG.ring[(LOG.n % LOG.max) + 1] = ("[%s] %s"):format(tag, msg)
    if CONSOLE and rconsoleprint then
        pcall(rconsoleprint, ("[VC+][%s] %s\n"):format(tag, msg))
    end
end

local function dbg(tag, msg)
    if CFG.Debug then log(tag, msg) end
end

-- Exposed so an external tool (or the executor console) can read recent
-- activity without print() being alive.
_G.VCP_LOG = LOG
_G.VCP_TAIL = function(n)
    n = math.min(tonumber(n) or 20, LOG.max)
    local out = {}
    for i = math.max(1, LOG.n - n + 1), LOG.n do
        out[#out + 1] = LOG.ring[(i % LOG.max) + 1]
    end
    return out
end

