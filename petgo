                action = action, map = mapLbl, tier = tier, tierTxt = tierTxt,
                tierStroke = tierStroke, fill = fill, slay = slay,
                vStatus = vStatus, vFamily = vFamily, vLevel = vLevel,
                vPrest = vPrest, vGold = vGold, vGems = vGems, vSpins = vSpins,
                vRuns = vRuns, vKills = vKills, vGoldHr = vGoldHr,
                vRunHr = vRunHr, vKillHr = vKillHr, vDiff = vDiff,
                vSpear = vSpear, itemRows = itemRows,
            }

            ------------------------------------------------------------ hotkey
            if type(CFG.StatusUIKey) == "string" then
                local code = Enum.KeyCode[CFG.StatusUIKey]
                if code then
                    UserInputService.InputBegan:Connect(function(input, typed)
                        if typed then return end
                        if input.KeyCode == code then gui.Enabled = not gui.Enabled end
                    end)
                end
            end

            ------------------------------------------------------ toggle button
            -- With a button to open it, the panel boots hidden: the near-opaque
            -- veil is not left over the view, AND the redraw loop below sees
            -- `not gui.Enabled` and early-outs every tick, so a client nobody is
            -- watching pays nothing for having the UI compiled in.
            if CFG.ToggleButton then
                if CFG.StatusUIStartHidden then gui.Enabled = false end
                K.buildToggle(gui)
            end

            ------------------------------------------------------------- pulse
            -- One looping tween rather than a per-frame heartbeat.
            pcall(function()
                local TS = game:GetService("TweenService")
                TS:Create(dot,
                    TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut,
                                  -1, true),
                    { BackgroundTransparency = 0.55 }):Play()
            end)
        end)

        if not ok then
            log("UI", "status panel failed to build: " .. tostring(buildErr))
            return
        end

        ------------------------------------------------------------ the redraw
        -- Redraw budget.
        --
        -- Roblox GUI work runs on the same thread as the combat loop, so every
        -- millisecond spent here is a millisecond the pulse is not firing. Four
        -- times a second was chosen when this was the only way to watch the
        -- farm; twice is indistinguishable to a human reading numbers that
        -- mostly change on a mission boundary. A hidden panel costs nothing.
        --
        -- The genuinely expensive reads run on a slower clock of their own:
        -- spearParts() and invCount() walk the inventory table, and nothing in
        -- an inventory changes between frames.
        local slowAt, slowSpear, slowItems = 0, nil, nil
        task.spawn(function()
            while alive() do
                task.wait(num(CFG.StatusUIInterval, 0.5))
                pcall(function()
                    local R = K.UI.refs
                    if not R.root or not R.root.Parent then return end
                    if R.gui and not R.gui.Enabled then return end

                    local kind = placeKind() or "?"
                    U.put("action", R.action, "Text", tostring(STATE.action or ""))

                    local mood = (STATE.accountOk == false) and U.C.bad
                              or (kind == "Mission") and U.C.ok
                              or U.C.warn
                    U.put("dot", R.dot, "BackgroundColor3", mood)

                    -------------------------------------------------- contract
                    local diff, obj
                    pcall(function()
                        diff = Workspace:GetAttribute("Difficulty")
                        obj  = Workspace:GetAttribute("Objective")
                    end)
                    U.put("place", R.place, "Text",
                        ("%s   ·   %s"):format(kind:upper(),
                            tostring(CFG.MissionMap or "?"):upper()))

                    if kind == "Mission" and diff then
                        U.put("map", R.map, "Text",
                            ("%s  ·  %s"):format(tostring(CFG.MissionMap or "?"),
                                                 tostring(obj or "--")))
                        local tc = U.TIER[tostring(diff):lower()] or U.C.dim
                        U.put("tier", R.tierTxt, "Text", tostring(diff):upper())
                        U.put("tierc", R.tierTxt, "TextColor3", tc)
                        U.put("tiers", R.tierStroke, "Color", tc)
                        U.put("difr", R.vDiff, "Text", tostring(diff))
                        U.put("difrc", R.vDiff, "TextColor3", tc)

                        local cur, req = objectiveValue("Slay")
                        if cur and req and req > 0 then
                            U.put("slay", R.slay, "Text", ("%d / %d"):format(cur, req))
                            U.put("fill", R.fill, "Size",
                                UDim2.new(math.clamp(cur / req, 0, 1), 0, 1, 0))
                        else
                            U.put("slay", R.slay, "Text", ("%d alive"):format(TITANS.count))
                            U.put("fill", R.fill, "Size", UDim2.new(0, 0, 1, 0))
                        end
                    else
                        U.put("map", R.map, "Text", "Between contracts")
                        U.put("tier", R.tierTxt, "Text", "IDLE")
                        U.put("tierc", R.tierTxt, "TextColor3", U.C.dim)
                        U.put("tiers", R.tierStroke, "Color", U.C.dim)
                        U.put("slay", R.slay, "Text", "--")
                        U.put("fill", R.fill, "Size", UDim2.new(0, 0, 1, 0))
                    end

                    --------------------------------------------------- account
                    local status = (STATE.accountOk == nil) and "Unknown"
                                or (STATE.accountOk and "Active" or "Banned")
                    U.put("status", R.vStatus, "Text", status)
                    U.put("statusc", R.vStatus, "TextColor3",
                        (STATE.accountOk == false) and U.C.bad
                        or (STATE.accountOk == true) and U.C.ok or U.C.dim)
                    U.put("family", R.vFamily, "Text", tostring(STATE.family or "None"))
                    U.put("level",  R.vLevel,  "Text", tostring(STATE.level))
                    U.put("prest",  R.vPrest,  "Text", tostring(STATE.prestige))
                    U.put("gold",   R.vGold,   "Text", comma(STATE.gold))
                    U.put("gems",   R.vGems,   "Text", comma(STATE.gems))
                    U.put("spins",  R.vSpins,  "Text", comma(STATE.spins))

                    --------------------------------------------------- session
                    local r = rates()
                    U.put("up",    R.uptime, "Text", fmtDur(r.elapsed))
                    U.put("runs",  R.vRuns,  "Text", comma(STATE.missions))
                    U.put("kills", R.vKills, "Text", comma(STATE.kills))

                    -- A per-hour figure extrapolated from the first few seconds
                    -- is noise wearing a number's clothes: seven seconds in, one
                    -- finished mission reads as "514 / hour". Say nothing until
                    -- the window is long enough to mean something.
                    local warm = r.elapsed >= num(CFG.StatusUIRateAfter, 120)
                    U.put("goldhr", R.vGoldHr, "Text",
                        warm and shortNum(r.goldHr) or "measuring")
                    U.put("runhr",  R.vRunHr,  "Text",
                        warm and ("%.0f"):format(r.missionHr) or "measuring")
                    U.put("killhr", R.vKillHr, "Text",
                        warm and ("%.0f"):format(r.killsHr) or "measuring")
                    for _, k in ipairs({ "goldhr", "runhr", "killhr" }) do
                        local o = (k == "goldhr" and R.vGoldHr)
                               or (k == "runhr" and R.vRunHr) or R.vKillHr
                        U.put(k .. "c", o, "TextColor3", warm and U.C.text or U.C.faint)
                        U.put(k .. "s", o, "TextSize", warm and 16 or 11)
                    end

                    ------------------------------------------------- inventory
                    -- Table walks, so they get their own clock. The numbers in
                    -- them move once a mission at most.
                    local nowc = os.clock()
                    if nowc - slowAt >= num(CFG.StatusUISlowInterval, 4) then
                        slowAt = nowc
                        local h, t = spearParts()
                        slowSpear = { have = h, total = t }
                        if type(CFG.TrackItems) == "table" then
                            local l = {}
                            for itemName, lbl in pairs(CFG.TrackItems) do
                                l[#l + 1] = { label = tostring(lbl), n = invCount(itemName) }
                            end
                            table.sort(l, function(a, b) return a.label < b.label end)
                            slowItems = l
                        end
                    end

                    if slowSpear then
                        local have, total = slowSpear.have, slowSpear.total
                        local spearTxt = (have >= total) and "Ready"
                                      or (have > 0) and ("%d / %d"):format(have, total)
                                      or "--"
                        U.put("spear",  R.vSpear, "Text", spearTxt)
                        U.put("spearc", R.vSpear, "TextColor3",
                            (have >= total) and U.C.accent or U.C.text)
                    end

                    if slowItems then
                        local list = slowItems
                        for i = 1, #R.itemRows do
                            local slot, e = R.itemRows[i], list[i]
                            if e then
                                U.put("itn" .. i, slot.row:FindFirstChildOfClass("TextLabel"),
                                    "Text", e.label)
                                U.put("itv" .. i, slot.val, "Text", comma(e.n))
                                U.put("itc" .. i, slot.val, "TextColor3",
                                    e.n > 0 and U.C.text or U.C.faint)
                                U.put("itr" .. i, slot.row, "Visible", true)
                            else
                                U.put("itr" .. i, slot.row, "Visible", false)
                            end
                        end
                    end
                end)
            end
        end)
    end

    -- ───────────────────────────────────────────────────────────────────────
    --  Floating logo toggle — the button that shows/hides the panel.
    --  Draggable, so it never sits over something you want to see, and it tells
    --  a click from a drag by distance so dragging it does not also toggle.
    --  One-shot slide-in tween; the two UIS connections it opens both early-out
    --  in one comparison when idle, so it is not on any hot path.
    -- ───────────────────────────────────────────────────────────────────────
    function K.buildToggle(panelGui)
        if not panelGui or CFG.ToggleButton == false then return end
        pcall(function()
            local TS   = game:GetService("TweenService")
            local host = panelGui.Parent
            if not host then return end

            local tgl = U.new("ScreenGui", {
                Name = "VCP_Toggle",
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                DisplayOrder = 1001,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            }, host)

            local btn = U.new("ImageButton", {
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, -60),   -- parked above the screen
                Size = UDim2.new(0, 44, 0, 44),
                BackgroundColor3 = U.C.panel,
                BackgroundTransparency = 0.1,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Image = "",
            }, tgl)
            U.corner(btn, 10)
            U.new("UIStroke", { Color = U.C.accent, Transparency = 0.35, Thickness = 1 }, btn)
            local icon = U.new("ImageLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.new(0.78, 0, 0.78, 0),
                Image = tostring(CFG.StatusUILogo or ""),
                ScaleType = Enum.ScaleType.Fit,
                Active = false,
            }, btn)
            U.new("UIAspectRatioConstraint", { AspectRatio = 1 }, icon)

            -- slide down into view once, then it just sits there
            TS:Create(btn,
                TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { Position = UDim2.new(0.5, 0, 0, 12) }):Play()

            local dragging, moved, dragFrom, posFrom = false, false, nil, nil
            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging, moved = true, false
                    dragFrom = input.Position
                    posFrom  = btn.Position
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                    local d = input.Position - dragFrom
                    if math.abs(d.X) + math.abs(d.Y) > 6 then moved = true end
                    btn.Position = UDim2.new(
                        posFrom.X.Scale, posFrom.X.Offset + d.X,
                        posFrom.Y.Scale, posFrom.Y.Offset + d.Y)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging and not moved then
                        panelGui.Enabled = not panelGui.Enabled
                    end
                    dragging = false
                end
            end)
        end)
    end

    -- ───────────────────────────────────────────────────────────────────────
    --  Boot intro — a one-shot logo wipe that confirms the script loaded and
    --  then removes itself entirely. Runs in its own thread so the farm boots
    --  underneath it; it is pure tween work plus a ~1.6s status echo, and it
    --  Destroys its ScreenGui when done, so nothing about it is resident once
    --  the wipe clears. Nothing here is Active/clickable, so the synthesised
    --  input that drives the title screen passes straight through it.
    -- ───────────────────────────────────────────────────────────────────────
    function K.playIntro()
        -- introDone is per-VM and the VM dies every teleport; K.introSuppress is
        -- the disk-backed half that makes this actually once per sitting.
        if K.UI.introDone or K.introSuppress then return end
        K.UI.introDone = true
        K.introAt = os.time()
        if K.sessionSave then pcall(K.sessionSave) end
        if CFG.StatusUI == false or CFG.IntroTransition == false then return end
        task.spawn(function()
            pcall(function()
                local TS = game:GetService("TweenService")
                local host
                if typeof(gethui) == "function" then host = gethui() end
                host = host or plr:FindFirstChildOfClass("PlayerGui")
                if not host then return end

                local gui = U.new("ScreenGui", {
                    Name = "VCP_Intro",
                    ResetOnSpawn = false,
                    IgnoreGuiInset = true,
                    DisplayOrder = 1000,
                    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
                }, host)
                local veil = U.new("Frame", {
                    BackgroundColor3 = U.C.veil,
                    BackgroundTransparency = 0,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 1, 0),
                    Active = false,
                }, gui)
                U.new("UIGradient", {
                    Rotation = 90,
                    Color = ColorSequence.new(U.C.panelTop, U.C.veil),
                }, veil)

                local logo = U.new("ImageLabel", {
                    BackgroundTransparency = 1,
                    Image = tostring(CFG.StatusUILogo or ""),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, 0, 0.42, 0),
                    Size = UDim2.new(0, 126, 0, 126),
                    ImageTransparency = 1,
                    ScaleType = Enum.ScaleType.Fit,
                    Active = false,
                }, veil)
                U.new("UIAspectRatioConstraint", { AspectRatio = 1 }, logo)

                local title = U.label(veil, {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, 0, 0.58, 0),
                    Size = UDim2.new(0, 560, 0, 34),
                    Font = Enum.Font.Oswald,
                    Text = U.spaced("VC+") .. "   ·   " .. U.spaced("AOTR"),
                    TextSize = 27,
                    TextColor3 = U.C.text,
                    TextTransparency = 1,
                })
                local who = U.label(veil, {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, 0, 0.635, 0),
                    Size = UDim2.new(0, 560, 0, 18),
                    Font = Enum.Font.Gotham,
                    Text = tostring(plr.Name),
                    TextSize = 13,
                    TextColor3 = U.C.accent,
                    TextTransparency = 1,
                })
                local stat = U.label(veil, {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, 0, 0.69, 0),
                    Size = UDim2.new(0, 560, 0, 16),
                    Font = Enum.Font.RobotoMono,
                    Text = "Status: Booting",
                    TextSize = 12,
                    TextColor3 = U.C.dim,
                    TextTransparency = 1,
                })

                local function tw(o, t, props)
                    TS:Create(o,
                        TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                        props):Play()
                end

                tw(logo,  0.5, { ImageTransparency = 0, Size = UDim2.new(0, 148, 0, 148) })
                tw(title, 0.5, { TextTransparency = 0 })
                task.wait(0.15)
                tw(who,  0.4, { TextTransparency = 0 })
                tw(stat, 0.4, { TextTransparency = 0 })

                -- echo live boot progress for a beat, then clear
                local t0 = os.clock()
                while os.clock() - t0 < 1.6 do
                    stat.Text = "Status: " .. tostring(STATE.action or "Booting")
                    task.wait(0.1)
                end

                tw(logo,  0.45, { ImageTransparency = 1, Size = UDim2.new(0, 188, 0, 188) })
                tw(title, 0.45, { TextTransparency = 1 })
                tw(who,   0.45, { TextTransparency = 1 })
                tw(stat,  0.45, { TextTransparency = 1 })
                tw(veil,  0.6,  { BackgroundTransparency = 1 })
                task.wait(0.68)
                gui:Destroy()
            end)
        end)
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 42 · BOOT ROUTER
--     Place type comes from the game's own Friends.Places table, so new maps
--     are handled automatically. The id constants are only a fallback for when
--     that module cannot be read.
-- ═══════════════════════════════════════════════════════════════════════════

-- Session totals first, so the panel opens with the real numbers rather than
-- zeroes it then has to correct a beat later.
K.sessionLoad()
K.sessionSave()
task.spawn(function()
    K.stagger(8)
    while alive() do
        task.wait(8)
        K.sessionSave()
    end
end)

-- Intro first (its own thread; the farm boots underneath), then the panel.
-- DisplayOrder keeps them layered right regardless of creation order: intro
-- 1000 over panel 999, toggle 1001 over both.
K.playIntro()
K.buildStatusUI()
K.buildFamilyRollUI()

log("BOOT", ("v10 starting · place %d · %s")
    :format(game.PlaceId, placeKind() or "unknown"))

-- Report anything switched off at boot. getgenv() survives between script
-- executions and the config merge only fills keys that are nil, so a `false`
-- left behind by an earlier run persists silently — which looks exactly like
-- "the script is broken" when in fact it is doing as it was told. Say so.
do
    local off = {}
    for _, k in ipairs({
        "AutoFarm", "AutoUpgrade", "AutoDeletePerk", "AutoPrestige",
        "AutoQuest", "AutoThunderSpearQuest", "AutoAntiLag", "AutoLift",
    }) do
        if CFG[k] == false then off[#off + 1] = k end
    end
    if #off > 0 then
        log("BOOT", ("DISABLED: %s — set them true in getgenv().VCPlus_Config")
            :format(table.concat(off, ", ")))
    end
    if CFG.AutoFarm == false then
        log("BOOT", "AutoFarm is OFF — no missions will be created. This is a config value, not a fault.")
    end
end

-- CRASH CONTAINMENT FOR THE BRAIN ITSELF.
--
-- The combat loop got this treatment and the comment there is right about why:
-- unattended, across many clients, a thread that dies silently is the single
-- most expensive failure there is. The same reasoning was never applied one
-- level up, and this is the level that matters more — runLobby is the ONLY
-- thing in the file that can create a mission, and it walks runUpgrades,
-- runSkills, equipPerks, sellPerks, doPrestige and createMission in sequence,
-- all of which index nested save tables that a partial replication can leave in
-- an unexpected shape. One throw and the client sits in Town Central forever
-- while the panel keeps repainting: alive on the dashboard, earning nothing.
--
-- Recovery differs by place. In a MISSION, do not re-enter runMission: it
-- spawns background threads at the top which gate on alive() rather than on the
-- invocation, so they survive the throw and a second call would leave two
-- rewards handlers racing over the Retry toggle and two watchdogs firing Leave.
-- Leaving is both simpler and correct, because the lobby re-executes the script
-- from clean. Everywhere else, retry with a backoff.
--
-- The counters live inside the closure on purpose: the main chunk is at Luau's
-- 200-simultaneously-live-locals ceiling (see K, above), so a new top-level
-- local here can push the file past it and it will simply refuse to compile.
task.spawn(function()
    local kind, fails, window = nil, 0, 0
    while alive() do
        local ok, err = pcall(function()
            -- Prime the save once so every subsystem starts with real numbers.
            refreshState(true)

            kind = placeKind()

            if kind == "Menu" then
                runTitle()
            elseif kind == "Lobby" then
                runLobby()
            elseif kind == "Mission" then
                runMission()
            else
                -- Trade / Training / anything unrecognised: sit still, but keep
                -- telemetry alive and get back to the lobby if we can.
                setAction("Idle in %s", tostring(kind or "unknown place"))
                while alive() do
                    task.wait(15)
                    if kind == "Trade" or kind == "Training" then
                        invoke(4, "Functions", "Teleport", "Lobby")
                        waitUntil(function() return game.PlaceId ~= STATE.placeId end, 15, 0.5)
                    end
                end
            end
        end)
        if ok then break end

        local t = os.clock()
        if t - window > 60 then fails, window = 0, t end
        fails = fails + 1
        log("BOOT", ("brain error in %s (%d this minute) — %s")
            :format(tostring(kind), fails, tostring(err)))

        if kind == "Mission" then
            setAction("Brain fault — leaving")
            pcall(invoke, 4, "S_Missions", "Leave")
            task.wait(10)
        else
            task.wait(math.min(5, 0.25 * fails))
        end
    end
end)
