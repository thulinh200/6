    perksTotal  = 0, perksSellable = 0, perkUUIDs = {}, perksEquipped = 0,
    diffRank    = 0,
    missions    = 0, kills = 0,
    goldAtStart = nil, xpAtStart = nil,
    family      = "None", spins = 0,
    -- nil = the server has not told us yet. true = fine, false = flagged.
    -- Deliberately not called `banned`: a nil-vs-false mix-up on a name like
