-- 28 · ANTI-FALL WATCHDOG
--     Independent of the combat loop so it still recovers the character while
--     combat is blocked on an objective step.
-- ═══════════════════════════════════════════════════════════════════════════
task.spawn(function()
    K.stagger(0.5)
    while alive() do
        task.wait(0.5)
        if isMissionPlace() then
            pcall(function()
                local ch  = plr.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                local hum = ch and ch:FindFirstChildWhichIsA("Humanoid")
                if not (hrp and hum and hum.Health > 0) then return end
                if hrp.Position.Y >= -50 then return end

                -- Fell out of the world: aim for a live titan if there is one,
                -- otherwise a safe altitude over the origin.
                local dest = Vector3.new(0, 300, 0)
                for _, e in pairs(TITANS.set) do
                    if e.root and e.root.Parent and e.root.Position.Y > 0 then
                        dest = e.root.Position + Vector3.new(0, 250, 0)
                        break
                    end
                end
                snapTo(hrp, dest)
            end)
        end
    end
end)

