-- 29 · MISSION RUNTIME
--     Everything below only runs on a real mission map. Lobby and title screen
--     return long before this point.
-- ═══════════════════════════════════════════════════════════════════════════
-- WHAT TO DO WHEN MISSION SETUP CANNOT COMPLETE.
--
-- Every recovery mechanism in this file — the combat loop, the no-progress
-- watchdog, the dead-run detector, the rewards/retry handler — is spawned
-- INSIDE runMission, below its setup guards. So a bare `return` from one of
-- those guards left the client with no live logic at all: it would never
-- fight, never notice it was stuck, and never leave. It sat in that mission
-- server until a human closed the window, while the status panel kept
-- repainting and telemetry kept reporting, so from the dashboard it looked
-- alive. On a box loading thirty clients at once a 30s WaitForChild for a
-- streamed instance is not an exotic failure.
--
-- Leaving is the correct recovery: the lobby re-executes the script clean, and
-- every mission is a fresh server anyway. Both exits are fired because the two
-- ways of getting here need different ones — S_Missions/Leave for a real
-- mission, and the plain Teleport for a hub that placeKind() misclassified as
-- one (there is no mission group to leave there).
local function missionBailout(why)
    log("MISSION", ("setup failed (%s) — leaving so the lobby can restart us"):format(why))
    setAction("Setup failed — leaving")
    while alive() do
        pcall(invoke, 4, "S_Missions", "Leave")
        pcall(invoke, 4, "Functions", "Teleport", "Lobby")
        local before = game.PlaceId
        waitUntil(function() return game.PlaceId ~= before end, 20, 0.5)
        -- Jittered: a bailout loop is a fixed-period loop like any other, and
        -- thirty clients retrying a Leave in lockstep is the thing K.stagger
        -- exists to prevent.
        task.wait(10 + math.random() * 10)
    end
end

local function runMission()
    setAction("Mission starting")

    local char = plr.Character
    if not char then
        waitUntil(function() char = plr.Character; return char end, 30)
    end
    if not char then
        return missionBailout("character never spawned")
    end

    -- Retry the acquisition before giving up on the run. The common cause is
    -- transient — instance streaming missed a deadline while thirty clients
    -- loaded at once — and it is recoverable in place, whereas leaving forfeits
    -- the completion bonus this file treats as expensive everywhere else.
    local root, actorInst, titans, pGui, interface
    for attempt = 1, 3 do
        -- Re-read the character every attempt. If it respawned between them the
        -- old reference is a destroyed instance, and waitChild would then sit
        -- out its whole timeout waiting for a child that can never arrive.
        if plr.Character then char = plr.Character end
        -- Both the root AND the actor belong to the character model. If it
        -- respawned between attempts, a reference from the old model is a
        -- destroyed instance — drop it so it is re-acquired from the live
        -- character rather than short-circuited past by the `or`.
        if root      and root.Parent      ~= char then root = nil end
        if actorInst and actorInst.Parent ~= char then actorInst = nil end
        root      = root      or waitChild(char, "HumanoidRootPart", attempt == 1 and 30 or 8)
        actorInst = actorInst or waitChild(char, "Actor", attempt == 1 and 20 or 5)
        titans    = titans    or waitChild(Workspace, "Titans", attempt == 1 and 30 or 8)
        pGui      = pGui      or waitChild(plr, "PlayerGui", attempt == 1 and 15 or 5)
        interface = interface or (pGui and waitChild(pGui, "Interface", attempt == 1 and 30 or 8))
        if root and titans then break end
        if attempt < 3 then
            log("MISSION", ("setup incomplete (root=%s titans=%s) — retrying")
                :format(tostring(root ~= nil), tostring(titans ~= nil)))
            task.wait(3)
        end
    end

    if not root   then return missionBailout("no HumanoidRootPart") end
    if not titans then return missionBailout("no Titans folder")    end

    -- The character can be replaced once more between the loop and here, and
    -- setupBridge latches BRIDGE.started, so handing it a stale Actor turns the
    -- combat-actor path and local save reads off for the WHOLE mission with no
    -- error in the log (runOnActor fails inside a pcall, but it still logs
    -- "combat actor attached"). Re-resolve against the live character; nil makes
    -- setupBridge skip the branch cleanly.
    local liveChar = plr.Character or char
    if not (actorInst and actorInst.Parent == liveChar) then
        actorInst = liveChar and liveChar:FindFirstChild("Actor") or nil
    end
    setupBridge(actorInst)
    bindTitans(titans)
    applyAntiLag()
    K.whStart()

    -- ── Thunder Spear mission detection ────────────────────────────────────
    local TS_MAP, TS_PART = currentTSMap()
    local TS_ACTIVE  = false
    local TS_STATE   = "INIT"
    local TS_TOWER   = 1
    local TS_FAILS   = 0
    local TS_WATCH    = nil     -- name of the circle we are currently standing in
    local TS_BUILD_START = nil
    local TS_LAST_SEEN   = nil
    local TS_DIP    = true      -- start airborne; earn the descent
    local TS_DIP_AT = nil
    local TS_CLEAR_SINCE = nil
    local TS_IDLE_SINCE  = nil
    local TS_RESPAWNED   = false
    local TS_SAW_CART    = false
    local TS_ESCORT_CIRCLE = nil
    K.TS.q = { base = nil, last = nil, nextAt = 0 }
    K.TS.skip = {}
    K.TS.escortPos, K.TS.escortR = nil, nil
    K.TS.convoyAt, K.TS.convoyAtT, K.TS.cartCount = nil, nil, nil
    K.TS.mainWarned = false
    K.TS.waitFrom, K.TS.waitNoted = nil, false
    _G.VCP_TSEscortWait = false
    K.TS.deepAt, K.TS.deepName = nil, nil
    K.TS.triggerNoted = false
    _G.VCP_TSEscorting = false
    _G.VCP_TSBuilding = false
    local TS_ICE     = 0
    local TS_CRATES  = 0
    local TS_VISITED = {}
    local MUST_LEAVE = false

    _G.VCP_MustLeave = false

    if TS_MAP and CFG.AutoThunderSpearQuest then
        task.spawn(function()
            task.wait(2)
            claimSpears()
            local inv = (getSlot(true) or {}).Inventory or STATE.inventory
            K.TS.lastLine = nil            -- fresh place: reprint for this log
            K.logSpears(nil, inv)
            if not hasSpearPart(TS_PART, inv) then
                TS_ACTIVE = true
                log("TS", ("mission mode: %s → %s"):format(TS_MAP, TS_PART))
                K.tsBreadcrumb(("IN MAP %s — chasing %s"):format(TS_MAP, TS_PART))
                -- Dump the names this map actually exposes. If WatchTower_N or
                -- the objective counter is named differently here, that is the
                -- whole bug and it is otherwise invisible from outside the VM.
                pcall(function()
                    local objs = {}
                    local of = ReplicatedStorage:FindFirstChild("Objectives")
                    if of then
                        for _, v in ipairs(of:GetChildren()) do
                            objs[#objs + 1] = ("%s=%s/%s"):format(v.Name,
                                tostring(v.Value), tostring(v:GetAttribute("Requirement")))
                        end
                    end
                    local towers = {}
                    for _, c in ipairs(Workspace:GetChildren()) do
                        if c.Name:lower():find("tower") then towers[#towers + 1] = c.Name end
                    end
                    K.tsBreadcrumb(("map probe · objectives[%s] · towers[%s]")
                        :format(table.concat(objs, ","), table.concat(towers, ",")))
                end)
            elseif not spearsComplete(inv) then
                -- This part is already owned but another is outstanding: bail
                -- out rather than farm a map that awards nothing new.
                TS_ACTIVE  = true
                MUST_LEAVE = true
                _G.VCP_MustLeave = true
                log("TS", ("%s already owned → leaving for %s")
                    :format(TS_PART, tostring(nextSpearMap(inv))))
                K.tsBreadcrumb(("IN MAP %s — %s already owned, leaving for %s")
                    :format(TS_MAP, TS_PART, tostring(nextSpearMap(inv))))
            else
                log("TS", "questline complete — running this map as a normal mission")
            end
        end)
    end

    -- CUTSCENE SKIPPER.
    --
    -- The Escort half opens with a cutscene (Cutscenes.Missions.Escort_Start).
    -- While it plays the camera is Scriptable and the character is not under our
    -- control, so every second of it is dead mission time -- and the escort is
    -- on a clock, because the carriage has to reach the Wall.
    --
    -- The prompt is PlayerGui.Interface.Skip (a CanvasGroup) whose Main.Title
    -- reads "SKIP [E]". Press E through VirtualInputManager rather than firing
    -- the button's connections: the RETRY button on the summary screen taught
    -- this file that some of this game's prompts only answer to real synthetic
    -- input (see the summary click path), and a keypress costs nothing to send.
    if CFG.AutoSkipCutscene ~= false then
        task.spawn(function()
            K.stagger(0.4)
            local lastPress = 0
            while alive() do
                task.wait(0.3)
                pcall(function()
                    local gui = plr:FindFirstChild("PlayerGui")
                    local face = gui and gui:FindFirstChild("Interface")
                    local skip = face and face:FindFirstChild("Skip")
                    if not skip then return end

                    -- A CanvasGroup hides by transparency as often as by
                    -- Visible, so treat either as "not showing".
                    local showing = true
                    if skip:IsA("GuiObject") and not skip.Visible then showing = false end
                    local alpha = skip:IsA("CanvasGroup") and skip.GroupTransparency or 0
                    if alpha and alpha > 0.95 then showing = false end
                    if not showing then return end

                    local now = os.clock()
                    if now - lastPress < num(CFG.SkipRepeat, 1.0) then return end
                    lastPress = now

                    VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
                    task.wait(0.06)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    log("SKIP", "cutscene skip prompt up — pressed E")
                end)
            end
        end)
    end

    -- GRAB BREAKER.
    --
    -- Both escort deaths recorded by the instrumentation below read:
    --     last hp 100% at y=128 | nearest titan now 83 | ragdoll=true
    --     last hp 100% at y=137 | nearest titan now 93 | ragdoll=true
    -- Full health to dead inside one 0.25s sample, while ragdolled, 128-137
    -- studs up. So a grab is not a damage event to be out-healed or out-ranged
    -- by a bit more altitude -- it is instant, and the reach that matters is a
    -- titan's grab arc, not its footprint.
    --
    -- Nothing in this file ever reacted to the Ragdoll attribute outside the
    -- tower branch. Watch it everywhere, and break upward hard the moment it
    -- goes true: a discrete reposition is the only move fast enough, and the
    -- map even scores an Avoid_Grabs objective, so being grabbed is a state the
    -- game expects players to escape rather than a death sentence.
    if CFG.AutoBreakGrab ~= false then
        task.spawn(function()
            K.stagger(0.2)
            local lastBreak = 0
            while alive() do
                task.wait(0.1)
                pcall(function()
                    if not isMissionPlace() then return end
                    local ch  = plr.Character
                    local hum = ch and ch:FindFirstChildWhichIsA("Humanoid")
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    if not (ch and hum and hrp and hum.Health > 0) then return end
                    if ch:GetAttribute("Ragdoll") ~= true then return end

                    local now = os.clock()
                    if now - lastBreak < 0.25 then return end
                    lastBreak = now

                    -- Straight up, well past any grab arc, and hold there.
                    local up = hrp.Position + Vector3.new(0, num(CFG.GrabBreakRise, 400), 0)
                    snapTo(hrp, up)
                    K.tsBreadcrumb(("GRABBED at y=%d — breaking upward")
                        :format(math.floor(hrp.Position.Y)))
                end)
            end
        end)
    end

    -- DEATH INSTRUMENTATION.
    --
    -- Every survivability fix so far has been aimed at a guess about when the
    -- character dies -- standing in the circle, in transit, while grabbed. The
    -- breadcrumb file survives the teleport that wipes this VM, so record the
    -- actual moment: phase, altitude, health before the drop, nearest titan.
    if TS_MAP then
        task.spawn(function()
            local wasAlive, lastHp, lastY = false, 100, 0
            while alive() do
                task.wait(0.25)
                local ch = plr.Character
                local hum = ch and ch:FindFirstChildWhichIsA("Humanoid")
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                if not (hum and hrp) then continue end

                if hum.Health > 0 then
                    wasAlive = true
                    if hum.MaxHealth > 0 then
                        lastHp = math.floor(hum.Health / hum.MaxHealth * 100)
                    end
                    lastY = math.floor(hrp.Position.Y)
                elseif wasAlive then
                    wasAlive = false

                    -- GET BACK IN THE AIR BEFORE THE RESPAWN LANDS.
                    --
                    -- TS_DIP had no writer for death, and the combat loop
                    -- cannot supply one: it bails at `hum.Health > 0` long
                    -- before the tower branch, so the TS_RESPAWNED assignment
                    -- that lives in there was unreachable code. The result was
                    -- a death loop with a mechanism: die grounded, TS_DIP stays
                    -- false, and the first tick after the respawn parks the
                    -- brand-new character back on the exact pad that killed the
                    -- last one -- by snapTo, so it arrives instantly and with
                    -- no clear check, because the clear check only runs on the
                    -- way DOWN. This thread is the only one that runs while the
                    -- character is a corpse, so the reset belongs here.
                    -- These four assignments come FIRST and outside the pcall.
                    -- They are the safety half of this block; the reporting
                    -- below is the diagnostic half, and a diagnostic that throws
                    -- must not be able to take the safety with it.
                    TS_DIP, TS_DIP_AT = true, os.clock()
                    TS_CLEAR_SINCE, TS_RESPAWNED = nil, true

                    -- Scan through the shared helper: the old inline walk
                    -- skipped any titan model whose HumanoidRootPart had not
                    -- replicated yet, which is exactly the blind spot that
                    -- makes a death report read "nearest titan 722" while
                    -- something is standing on us.
                    pcall(function()
                        local nearest = K.nearestTitanTo(hrp.Position, TITANS.set)
                        K.tsBreadcrumb(("DIED -- %s | last hp %d%% at y=%d | nearest titan now %d | ragdoll=%s")
                            :format(tostring(_G.VCP_TSWhere or "unknown"), lastHp, lastY,
                                    nearest < math.huge and math.floor(nearest) or -1,
                                    tostring(ch:GetAttribute("Ragdoll"))))
                    end)
                end
            end
        end)
    end

    -- Ice Burst tracking for the Utgard objective.
    if TS_MAP == "Utgard" then
        local seen = {}
        for _, t in ipairs(titans:GetChildren()) do
            if isIceBurst(t) then seen[t] = true end
        end
        titans.ChildAdded:Connect(function(t)
            task.spawn(function()
                for _ = 1, 20 do
                    if not t.Parent then return end
                    if t:FindFirstChild("Fake") then
                        if isIceBurst(t) then seen[t] = true end
                        return
                    end
                    task.wait(0.1)
                end
            end)
        end)
        titans.ChildRemoved:Connect(function(t)
            if seen[t] then
                seen[t] = nil
                TS_ICE = TS_ICE + 1
                log("TS", ("Ice Burst %d/3"):format(TS_ICE))
            end
        end)
    end

    -- ══════════════════════════════════════════════════════════════════════
    -- 30 · REWARDS SCREEN — event driven
    --
    --     v9 polled every 2s, then slept 1.5s, then slept another 3s after
    --     clicking: up to ~6.5s of dead air after every single mission. Over a
    --     few hundred missions that alone is most of an hour.
    --
    --     v10 reacts to the Visible property change, then polls the button's
    --     Active flag at 100ms and clicks the instant the game enables it.
    --     Retry is a toggle, so the click path stays UI-only — firing the
    --     remote as well would toggle it straight back off, which is the
    --     mistake v9's comments warn about.
    -- ══════════════════════════════════════════════════════════════════════
    -- Fire exactly ONE activation, then check whether it took.
    --
    -- The previous version fired seven independent paths at the same button:
    -- connections on MouseButton1Click, on Activated, on MouseButton1Down,
    -- firesignal on two of those, VirtualUser:ClickButton1, and a
    -- VirtualInputManager down/up pair. The last two are real synthetic input,
    -- so the engine re-raises Activated and MouseButton1Click on top of the
    -- manual ones — a handler bound to either sees roughly four activations.
    --
    -- On an ordinary button N activations behave as one. On a TOGGLE they
    -- behave as N mod 2, and since VirtualUser and VirtualInputManager only
    -- land depending on executor and window focus, the parity is undefined and
    -- differs run to run. Retry is a toggle. That is the whole mechanism
    -- behind "sometimes the retry doesn't take".
    --
    -- So: one path at a time, verify, escalate only if it did nothing.
    -- CLICKING THE SUMMARY BUTTONS
    --
    -- Everything below was measured on the live screen rather than reasoned
    -- about, because every prior guess here was wrong:
    --
    --   · getconnections(btn.Activated)         -> 0 connections. Firing it is
    --                                              a no-op, always.
    --   · getconnections(btn.MouseButton1Click) -> 1 connection, and it IS the
    --                                              game's handler, so forging it
    --                                              really does toggle ready.
    --   · VirtualInputManager down/up           -> also toggles ready.
    --
    -- Retry is a READY CHECK, not a button: the label reads "RETRY (0/1)",
    -- ready over total, and clicking marks this client ready, which arms a 5s
    -- countdown. So firing two paths at it readies and then un-readies, and the
    -- run falls back to the game's own 21s idle timer. Old ladder: 26-28s of
    -- turnaround. One landed click: 7.5s, of which 5s is the countdown itself.
    --
    -- And the first click usually misses. The summary panel animates in, so at
    -- t+0.1s the button is not yet where AbsolutePosition says it will be —
    -- measured: click at 0.63s did nothing, the retry at 1.23s landed.
    --
    -- Hence: ONE path, fired repeatedly at a slow cadence, verified between
    -- attempts, stopping the instant it takes.
    local function clickButton(btn, verify)
        if not btn then return false end
        if verify and verify() then return true end
        pcall(function() GuiService.SelectedObject = btn end)

        -- The ONLY thing that activates this build's Retry button. Verified live
        -- on Chapel: firing the button's MouseButton1Click connections (2 of
        -- them) does nothing, firesignal does nothing, but a real
        -- SendMouseButtonEvent at the button centre took it straight to
        -- "STARTING (5s)". The button reacts to actual input, not to its signal.
        -- The last arg is 0 (the value proven to work); the button is selected
        -- first so a selection-aware handler also sees it.
        local function realClick()
            return pcall(function()
                pcall(function() GuiService.SelectedObject = btn end)
                local inset = GuiService:GetGuiInset()
                local cx = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
                local cy = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2 + inset.Y
                VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true,  game, 0)
                task.wait(0.06)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            end)
        end

        -- Fire the connections on ONE of the button's signals. The index
        -- `btn[name]` is inside the pcall because btn may not be a GuiButton on
        -- every build, and an unprotected index would throw out of the worker.
        local function fireConns(name)
            local n = 0
            pcall(function()
                for _, c in ipairs(safeConns(btn[name])) do
                    pcall(function() c:Fire() end); n = n + 1
                end
            end)
            return n > 0
        end
        local function fireSig(name)
            if not EXEC.firesignal then return false end
            return (pcall(function() EXEC.firesignal(btn[name]) end))
        end

        -- realClick FIRST: it is the only method proven to activate this build's
        -- button (see above). The forged/firesignal paths are kept as later
        -- fallbacks in case a future build wires the button differently, but they
        -- are known no-ops here, so realClick is fired on every ODD attempt and a
        -- fallback on the evens — the loop stops the instant `verify` sees the
        -- ready take, so on this build it returns after the first realClick.
        -- Repeating realClick is safe: it drives the button toward STARTING and
        -- the top-of-loop verify() stops us before any redundant input.
        local fallbacks = {
            function() return fireConns("MouseButton1Click") end,
            function() return fireConns("Activated") end,
            function() return fireSig("MouseButton1Click") end,
        }

        local tries = math.max(6, math.floor(num(CFG.ClickAttempts, 5)))
        local fbIdx = 0
        for i = 1, tries do
            if verify and verify() then return true end
            if i % 2 == 1 then
                realClick()
            else
                fbIdx = fbIdx + 1
                fallbacks[((fbIdx - 1) % #fallbacks) + 1]()
            end
            if not verify then return true end
            if waitUntil(verify, math.max(0.6, num(CFG.ClickVerifyWindow, 0.5)), 0.05) then
                return true
            end
        end
        return (verify and verify()) or false
    end

    -- How many sellable perks justify leaving the mission. Leaving costs a
    -- lobby round-trip, so on high difficulty it is worth hoarding far more
    -- before making the trip; on low difficulty perks accumulate slowly and
    -- selling early keeps the account moving.
    local function perkSellTarget()
        pcall(function()
            local d = Workspace:GetAttribute("Difficulty")
            if d then
                local r = diffRank(d)
                if r > 0 then STATE.diffRank = r end
            end
        end)
        local rank = STATE.diffRank
        if rank == 0 then return 30 end
        if rank >= 4 then          -- Severe and above
            local override = tonumber(CFG.PerkSellTarget)
            return (override and override > 0) and override or 1000
        end
        return 30
    end

    local function decideEndOfMission()
        -- No forced fetch here. The caller kicks one off the moment the rewards
        -- screen appears and it lands while we wait for the button to become
        -- Active — so by now the state is fresh. Forcing it here instead put a
        -- blocking server round-trip (up to a 5s deadline) at the very front of
        -- the turnaround, before the Active poll had even started.
        refreshState()

        -- MUST_LEAVE means this map cannot award anything: the part it gives is
        -- already owned and another one is outstanding. That has to go through
        -- the lobby so the router can pick a different map.
        if MUST_LEAVE then return "leave", "thunder spear — wrong map" end

        -- ALWAYS LEAVE ON A THUNDER SPEAR RUN.
        --
        -- Retry looked like free throughput -- it replays the map, objective and
        -- difficulty exactly as created, skipping the lobby round-trip. But the
        -- objective is exactly what must be allowed to change: the questline
        -- moves from Outskirts SKIRMISH (Towers) to Outskirts ESCORT the moment
        -- Towers is claimed, and only the lobby router re-reads the save and
        -- re-decides. A retry replays the objective this run was CREATED with,
        -- so a run that entered on Skirmish keeps producing Skirmish for as long
        -- as it keeps retrying -- and the Escort half would never be staged at
        -- all. The same trap applies to the map itself once a part lands.
        --
        -- The lobby trip is a few seconds against a questline step that can
        -- otherwise never start. Take the trip.
        if TS_ACTIVE then
            local inv = (getSlot() or {}).Inventory or STATE.inventory
            if TS_PART and hasSpearPart(TS_PART, inv) then
                return "leave", ("thunder spear — %s obtained"):format(TS_PART)
            end
            return "leave", ("thunder spear — re-routing for %s")
                :format(tostring(TS_PART))
        end

        -- OFF-MAP AFTER THE QUESTLINE.
        --
        -- Retry replays the map this run was CREATED with, and TS_ACTIVE is
        -- decided once at mission start. The moment the last spear part lands,
        -- the next Outskirts run starts with TS_ACTIVE false, so the block above
        -- no longer forces a lobby trip -- and the ordinary path says "retry,
        -- keep farming", which replays OUTSKIRTS. Observed exactly that: the
        -- questline finished and the account kept farming Outskirts with
        -- MissionMap set to Chapel, only drifting back on the LobbyEvery timer.
        --
        -- A Thunder Spear map we have no business on is worth one lobby trip.
        if TS_MAP and not TS_ACTIVE then
            local want = tostring(CFG.MissionMap or "Chapel")
            if want:lower() ~= tostring(TS_MAP):lower() then
                return "leave", ("off-map — on %s, want %s"):format(TS_MAP, want)
            end
        end

        local ready = false
        if CFG.AutoPrestige and isMaxed() and STATE.prestige < num(CFG.PrestigeTarget, 5) then
            local key = "P" .. (STATE.prestige + 1)
            local ps  = CFG.VCPlusPrestige and CFG.VCPlusPrestige[key] or { RequiredGold = 0 }
            if STATE.gold >= (num(ps.RequiredGold) * 1000000) then ready = true end
        end
        if ready then return "leave", "ready to prestige" end

        -- Skip this once the lobby has proven it cannot actually sell — leaving
        -- to do something impossible just costs a lobby round-trip per run.
        if CFG.AutoDeletePerk and not K.perkSellBlocked()
        and STATE.perksSellable >= perkSellTarget() then
            return "leave", ("perk storage %d/%d"):format(STATE.perksSellable, perkSellTarget())
        end

        -- ECONOMY UPKEEP.
        --
        -- runUpgrades, runSkills and equipPerks only exist in the LOBBY, and
        -- weapon upgrades are the only thing that raises Potential, which is
        -- the only thing that unlocks a higher difficulty tier
        -- (Easy 0 · Normal 2 · Hard 5 · Severe 9 · Aberrant 12). Retry never
        -- goes there, and it replays the tier it was created at.
        --
        -- That used to be self-correcting by accident: perk selling failed and
        -- the retry click missed, so the bot was forced back to the lobby
        -- constantly. With both of those fixed it stopped going at all —
        -- measured over 130 minutes, 264 missions against 11 lobby visits, and
        -- none in the final 18. Gold piles up unspent and the account is pinned
        -- to whatever tier it happened to reach.
        --
        -- So make the trip deliberate rather than accidental. It costs a lobby
        -- round-trip roughly every LobbyEvery missions, against runs that take
        -- ~13s, which is a few percent of throughput for the thing that moves
        -- the account up a tier.
        if CFG.AutoUpgrade and num(CFG.LobbyEvery, 35) > 0 then
            local since = STATE.missions - (K.lobbyAtMission or 0)
            if since >= num(CFG.LobbyEvery, 35) then
                return "leave", ("economy upkeep — %d missions since the lobby"):format(since)
            end
        end

        -- Retry replays THIS mission, difficulty and all. If the run we are
        -- about to repeat is below the tier Create last accepted, repeating it
        -- locks the account onto the wrong tier for as long as the bot keeps
        -- retrying — which is forever. One lobby round-trip fixes it.
        -- Damped, and only on remembered knowledge. Leaving costs a lobby
        -- round-trip, so it may only fire when a PERSISTED tier — one Create
        -- actually accepted — is strictly better than what we are replaying,
        -- and then at most once every few minutes. If the lobby cannot in fact
        -- produce that tier any more, the next successful Create rewrites the
        -- memory downward and this stops firing on its own.
        if CFG.AutoDifficulty ~= false and not _G.VCP_DiffLeaveAt then
            local cur
            pcall(function() cur = Workspace:GetAttribute("Difficulty") end)
            local want = targetDifficulty()
            if cur and want then
                local rCur, rWant = diffRank(tostring(cur)), diffRank(tostring(want))
                if rCur > 0 and rWant > 0 and rCur < rWant then
                    _G.VCP_DiffLeaveAt = os.time()
                    return "leave", ("difficulty %s below %s"):format(tostring(cur), tostring(want))
                end
            end
        end

        return "retry", "keep farming"
    end

    if interface then
        task.spawn(function()
            local rewards = waitChild(interface, "Rewards", 45)
            if not rewards then
                log("MISSION", "Rewards UI never appeared — retry system disabled")
                return
            end

            local handling  = false
            local lastClickAt = 0
            local function onRewards()
                if handling or not rewards.Visible then return end
                -- The summary stays up for the whole countdown AFTER a
                -- successful click, so "still visible" is not evidence the
                -- click failed. Re-entering here and clicking again would
                -- un-ready the player and hand the run back to the game's slow
                -- fallback timer — the exact bug this handler exists to avoid.
                if os.clock() - lastClickAt < num(CFG.RewardsReclickGuard, 15) then return end
                handling = true

                -- Start the save refresh NOW, concurrently. The rewards just
                -- landed so gold/xp/perks all just changed, and the leave-vs-
                -- retry decision needs the new numbers — but it must not block
                -- on them. This lands while we wait for the button anyway.
                task.spawn(function() pcall(refreshState, true) end)

                task.spawn(function()
                    -- Everything below runs in its own thread, and an error in
                    -- it used to leave `handling` true forever — which silently
                    -- disables the retry system for the rest of the mission and
                    -- parks the bot on the summary screen. One pcall and one
                    -- guaranteed reset is the whole fix.
                    local okWorker, workerErr = pcall(function()
                    local buttons
                    waitUntil(function()
                        local main = rewards:FindFirstChild("Main")
                        local info = main and main:FindFirstChild("Info")
                        local m2   = info and info:FindFirstChild("Main")
                        buttons = m2 and m2:FindFirstChild("Buttons")
                        return buttons ~= nil
                    end, 8, 0.1)

                    if not buttons then return end

                    -- Thunder Spear credit lands a beat after the summary
                    -- appears, so claim during the window we are waiting
                    -- anyway rather than adding a dedicated sleep.
                    if TS_ACTIVE then
                        for _ = 1, 3 do
                            claimSpears()
                            clickClaimButtons()
                            task.wait(1.2)
                        end
                    end

                    local choice, why = decideEndOfMission()
                    local retry = buttons:FindFirstChild("Retry")
                    local leave = buttons:FindFirstChild("Leave_2") or buttons:FindFirstChild("Leave")
                    local btn   = (choice == "retry") and retry or leave
                    if not btn then btn = leave or retry end
                    if not btn then return end

                    -- The game arms its own restart: the Retry button relabels
                    -- itself "STARTING (4s)" and fires on its own. Read the
                    -- label, and confirm it is a live countdown by checking the
                    -- number actually decrements — a static number is cosmetic
                    -- or stalled and still needs a click.
                    local function labelOf(b)
                        local t = ""
                        pcall(function()
                            if b:IsA("TextButton") then t = tostring(b.Text) end
                            if t == "" then
                                for _, d in ipairs(b:GetDescendants()) do
                                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                                        t = tostring(d.Text)
                                        break
                                    end
                                end
                            end
                        end)
                        return t
                    end

                    local function countdownSeconds(b)
                        local t = labelOf(b):upper()
                        if not (t:find("STARTING", 1, true) or t:find("STARTED", 1, true)) then
                            return nil
                        end
                        return tonumber(t:match("(%d+)")) or 0
                    end

                    -- DO NOT wait out the game's own countdown.
                    --
                    -- The previous version detected the "STARTING (4s)" relabel
                    -- and deliberately let it run, on the theory that clicking a
                    -- toggle mid-countdown would cancel it. Timed on the live
                    -- screen, that theory cost 9.0 seconds on EVERY mission —
                    -- summary visible to summary hidden was 8.99, 9.00, 8.99,
                    -- 9.00s, run after run, because the countdown is what closed
                    -- it. A real VirtualInputManager click at t+0.06s closed the
                    -- same screen at t+0.93s and the next mission started
                    -- normally. Nine seconds a run, on a run that now takes ten.
                    --
                    -- The Active poll stays, because clicking a disabled button
                    -- does nothing, but 12s was sized for a button that in
                    -- practice is already Active when the screen appears.
                    local budget = num(CFG.RewardsActiveTimeout, 4)
                    waitUntil(function()
                        return not btn:IsA("GuiButton") or btn.Active == true
                    end, budget, 0.03)

                    log("MISSION", ("%s — %s"):format(choice:upper(), why))
                    STATE.missions = STATE.missions + 1
                    -- Flush the counter here as well as on the 8s heartbeat.
                    -- The heartbeat (boot router) is what actually carries
                    -- missions/kills across the teleport, so they are NOT lost --
                    -- but the click below arms a five-second countdown and then
                    -- destroys this VM, and a mission that ends just after a
                    -- heartbeat has up to 8 seconds of unsaved counter racing a
                    -- 5 second teleport. One extra write per run closes that.
                    if K.sessionSave then pcall(K.sessionSave) end
                    -- Post BEFORE the click. Retry arms a five-second countdown
                    -- and then teleports, which destroys this VM — a report
                    -- queued after the click is racing the teleport for its
                    -- network round trip, and loses often enough to matter.
                    K.whMission(choice, why)

                    -- WHAT COUNTS AS "THE CLICK TOOK" IS NOT "THE SCREEN CLOSED".
                    --
                    -- The Retry button is a READY CHECK: its label reads
                    -- "RETRY (0/1)" — ready players over total — and clicking it
                    -- marks this client ready, which arms a countdown. The screen
                    -- closes when the countdown ends, not when the click lands.
                    --
                    -- Verifying against `not rewards.Visible` therefore reported
                    -- failure on a click that had just succeeded, and the
                    -- escalation ladder then fired a SECOND path at the same
                    -- toggle — un-readying us. Caught live: label went (0/0) ->
                    -- (0/1) and then sat there for 19.8 seconds until the game's
                    -- own fallback timer fired, for a 27s turnaround against a
                    -- 9s do-nothing baseline. One correctly-verified click closes
                    -- the same screen in 0.93s.
                    --
                    -- So verify on the ready count going up, or the label turning
                    -- into a countdown, or the screen closing — any of the three.
                    -- "(ready/total)". Watch BOTH halves: a landed click has
                    -- been seen to jump straight to "STARTING", and the one
                    -- transition actually recorded on a fresh screen was
                    -- (0/0) -> (0/1), which moves only the right-hand number.
                    -- Keying on the left number alone would miss both.
                    local function readyOf(b)
                        local a, c = labelOf(b):match("(%d+)%s*/%s*(%d+)")
                        return tonumber(a), tonumber(c)
                    end
                    local ready0, total0 = readyOf(btn)
                    ready0, total0 = ready0 or 0, total0 or 0
                    local clicked = clickButton(btn, function()
                        if not rewards.Visible then return true end
                        local t = labelOf(btn):upper()
                        if t:find("STARTING", 1, true) or t:find("STARTED", 1, true) then
                            return true
                        end
                        local r, tot = readyOf(btn)
                        if r == nil then return false end
                        return r > ready0 or (tot ~= nil and tot > total0 and r >= ready0 and r > 0)
                    end)

                    local function tookVerify()
                        if not rewards.Visible then return true end
                        local t = labelOf(btn):upper()
                        if t:find("STARTING", 1, true) or t:find("STARTED", 1, true) then
                            return true
                        end
                        local r = readyOf(btn)
                        return r ~= nil and r > 0
                    end

                    if clicked then
                        -- The click armed the restart; the screen still closes on
                        -- its own countdown. Wait for that, then arm the reclick
                        -- guard so the 5s safety poll does not re-enter and click
                        -- again mid-countdown (which would un-ready us).
                        --
                        -- Arm the guard ONLY if the screen actually closed. A
                        -- verified ready that then toggled back off, or a
                        -- countdown longer than the wait, leaves us still on the
                        -- summary — and arming the 15s guard there would block the
                        -- safety poll from re-entering a window that is still
                        -- stuck. `clicked` means "ready registered", not "closed".
                        if waitUntil(function() return not rewards.Visible end, 12, 0.05) then
                            lastClickAt = os.clock()
                        end
                    else
                        -- NEITHER retry NOR leave restarts on its own without a
                        -- landed ready-click — the game's "auto-restart" is just
                        -- the countdown that a ready arms, so a client whose click
                        -- never took sits here forever. Keep driving the button.
                        -- Do NOT arm the reclick guard on failure, so the safety
                        -- poll can re-enter promptly and try again.
                        log("MISSION", ("%s click did not take — retrying the button")
                            :format(choice:upper()))
                        local ok = false
                        for _ = 1, 4 do
                            if not rewards.Visible then ok = true break end
                            if clickButton(btn, tookVerify) then ok = true break end
                        end
                        if ok then
                            waitUntil(function() return not rewards.Visible end, 12, 0.05)
                            lastClickAt = os.clock()
                        end
                        -- Still stuck: leave lastClickAt as it was so onRewards
                        -- re-enters on the next 5s safety tick and tries again.
                    end

                    task.wait(num(CFG.RewardsSettle, 1.0))
                    end)
                    if not okWorker then
                        log("MISSION", "rewards handler errored: " .. tostring(workerErr))
                    end
                    handling = false
                end)
            end

            rewards:GetPropertyChangedSignal("Visible"):Connect(onRewards)
            if rewards.Visible then onRewards() end

            -- Safety net: if the property signal is ever missed, this notices.
            K.stagger(5)
            while alive() do
                task.wait(5)
                if rewards.Visible and not handling then onRewards() end
            end
        end)
    end

    -- ══════════════════════════════════════════════════════════════════════
    -- 30b · STALLED-MISSION DETECTOR
    --
    --     Aberrant grants only 2 Refills (Values.Refills: Easy 10, Normal 8,
    --     Hard 6, Severe 3, Aberrant 2). Once blades are broken with no sets
    --     left and no refills to spend, the client cannot deal damage at all —
    --     the mission can never complete and every second spent hovering in it
    --     is pure loss. v9 had no notion of this and would idle until the map
    --     timed out.
    --
    --     Leaving forfeits the completion bonus, so the threshold is
    --     deliberately generous: only bail once it is unambiguous, and only if
    --     another player is not still clearing the map for us (titans dying
    --     while we are stalled means the run may still finish).
    -- ══════════════════════════════════════════════════════════════════════
    -- ══════════════════════════════════════════════════════════════════════
    -- 30c · NO-PROGRESS WATCHDOG
    --
    --     The blade detector below only notices ONE way of being stuck: no
    --     blades, no sets, no refills. It is blind to the more general failure,
    --     which is "we are sending and the server is crediting nothing".
    --
    --     Seen live while A/B testing: with the Slash remote disabled, every
    --     nape Register was silently refused — 1,112 sends over 33 seconds with
    --     the alive count frozen at 22 and the Slay counter frozen at 5. Blades
    --     were fine, so nothing noticed, and the run would have burned its whole
    --     timer. (That also proves Slash is not cosmetic: the server only
    --     credits a nape hit while a swing is live.)
    --
    --     Any cause has the same signature — titans alive, sends going out,
    --     objective not moving — so watch the signature rather than the causes.
    -- ══════════════════════════════════════════════════════════════════════
    task.spawn(function()
        K.stagger(3)
        local lastSlay, since = nil, os.clock()
        local grace = num(CFG.NoProgressTimeout, 45)
        -- BLADE.busy USED TO RESET THIS CLOCK, which quietly disabled the only
        -- general stall detector in the file. Any single sample with the flag
        -- up put `since` back to now, so the 45s grace could only ever
        -- accumulate across an unbroken 45s window with blades idle — and a
        -- reload ladder at a 200ms frame period is long by construction, so the
        -- flag is up often. If it ever latched, the watchdog was off for good:
        -- the one mechanism meant to catch "we are stuck" was gated on the flag
        -- whose stuck state is the likeliest stall there is.
        --
        -- So EXTEND, do not reset, and cap the extension. Twenty-five seconds
        -- covers one worst-case ladder at 5 fps; an endless repair loop still
        -- trips, just later than a plainly dead run does.
        local bladeCredit = 0
        while alive() do
            task.wait(3)
            if not isMissionPlace() then since = os.clock() end
            local slay = K.objectiveSignature()
            local aliveTitans = TITANS.count > 0
            local rewards = interface and interface:FindFirstChild("Rewards")
            local onSummary = rewards ~= nil and rewards.Visible

            if BLADE.busy then bladeCredit = math.min(bladeCredit + 3, 25) end

            -- Building a tower is deliberate standing still: the Slay
            -- counter cannot move while the character is parked in a circle,
            -- and the watchdog was abandoning Outskirts runs mid-objective.
            if _G.VCP_TSBuilding then since = os.clock() end

            -- Escorting is progress even when no counter moves: the carriage
            -- ticks over only once, at the Wall. Abandoning the run because the
            -- number has not changed yet is abandoning the objective itself.
            if _G.VCP_TSEscorting or _G.VCP_TSEscortWait then since = os.clock() end

            if slay ~= lastSlay or not aliveTitans or onSummary then
                lastSlay = slay
                since = os.clock()
                bladeCredit = 0
            elseif os.clock() - since > grace + bladeCredit then
                log("MISSION", ("no objective progress in %ds with %d titans alive — "
                    .. "abandoning"):format(math.floor(os.clock() - since), TITANS.count))
                K.whAlert("stall", "⛔ Run abandoned — no progress",
                    ("%ds with %d titans alive and the objective frozen, so the run was "
                     .. "left. If this repeats, the map or the blades are the problem.")
                    :format(math.floor(os.clock() - since), TITANS.count))
                setAction("Stuck run — restarting")
                invoke(4, "S_Missions", "Leave")
                since = os.clock()
                task.wait(10)
            end
        end
    end)

    task.spawn(function()
        K.stagger(5)
        local stalledSince = nil
        local lastKills = STATE.kills
        while alive() do
            task.wait(5)
            local dead = bladeBroken()
                     and (readSets() or 0) == 0
                     and num(plr:GetAttribute("Refills")) <= 0
            local othersProgressing = STATE.kills > lastKills
            lastKills = STATE.kills

            if dead and not othersProgressing then
                stalledSince = stalledSince or os.clock()
                if os.clock() - stalledSince > 60 then
                    log("MISSION", "no blades, no sets, no refills — abandoning a dead run")
                    setAction("Dead run — restarting")
                    invoke(4, "S_Missions", "Leave")
                    stalledSince = nil
                    task.wait(10)
                end
            else
                stalledSince = nil
            end
        end
    end)

    -- ══════════════════════════════════════════════════════════════════════
    -- 31 · MAIN COMBAT LOOP
    -- ══════════════════════════════════════════════════════════════════════
    if not CFG.AutoFarm then return end

    -- HIT_RANGE is the client-side filter deciding which napes are worth
    -- spending a send on. The radius the SERVER actually credits a hit inside
    -- is NOT knowable from the client on this build — `Hitboxes` (the namespace
    -- sendHit posts to) appears in none of the 310 client scripts, so there is
    -- nothing to read it off. The old CREDITED_RANGE = 400 was a guess that
    -- every later decision then treated as fact.
    --
    -- WORK_RANGE starts at HitRange and is widened by live calibration (below)
    -- whenever a probe proves the server credited a hit further out. Sends past
    -- the real radius are wasted and still cost a slot out of the shared ~100/s
    -- budget, so this only ever widens on evidence, never on assumption.
    local HIT_RANGE  = num(CFG.HitRange, 380)
    local WORK_RANGE = HIT_RANGE
    local CALIB = {
        on      = CFG.AutoCalibrateHitRange ~= false,
        next    = 0,
        pending = nil,
        fails   = 0,
    }
    -- Cluster scoring is deliberately NOT tied to HIT_RANGE. With a very large
    -- HIT_RANGE every titan counts as every other titan's neighbour, every
    -- candidate scores the same, and the "densest cluster" choice collapses into
    -- an arbitrary pick — which is the opposite of what parking is for.
    -- Capped independently of HIT_RANGE: past ~380 studs every titan counts as
    -- every other titan's neighbour, every candidate scores the same, and the
    -- densest-cluster pick degenerates into an arbitrary one.
    local CLUSTER_RANGE = math.min(HIT_RANGE, 380)
    if HIT_RANGE == math.huge then
        -- Infinite range is not reach, it is just an unfiltered pool: every
        -- send past the real radius is discarded by the server and still burns
        -- a slot a reachable titan could have used.
        HIT_RANGE, WORK_RANGE, CLUSTER_RANGE = 380, 380, 380
        log("RATE", "HitRange was infinite — clamped to 380 and calibration enabled instead")
    end
    -- One jittered hover height per mission (see FloatJitter). Clamped so a
    -- hand-set FloatJitter cannot drop the character into grab range or push it
    -- absurdly high; FLOAT is function-scoped, so this adds no top-level local.
    local FLOAT     = num(CFG.FloatHeight, 140)
                      + (math.random() * 2 - 1) * math.clamp(num(CFG.FloatJitter, 20), 0, 60)
    if FLOAT < 90 then FLOAT = 90 end
    local DEADZONE  = num(CFG.CombatTeleportDeadzone, 120)

    local buf        = {}          -- reused alive-titan buffer, never reallocated
    local lockedT    = nil
    local lockedHP   = nil
    local stuck      = 0
    local stuckSince = 0   -- os.clock() when the lock first stopped losing health
    local nextSlash  = 0
    local nextCluster= 0
    local clusterPos = nil
    local lastTPTarget = nil
    -- Last measured in-range nape count. The pool is only rebuilt on the hit
    -- interval, so ticks in between reuse this — the governor aggregates over
    -- 15 seconds, which is far coarser than the staleness introduced here.
    local lastInRange = 0
    -- When the ordinary pulse last had something inside the working radius.
    -- The tour is a FALLBACK for a pack that is not coming to us, not a
    -- replacement for the pulse -- it runs inline, so touring while the pulse
    -- has targets is trading a kill a second for a tour that credits a quarter
    -- of its sends.
    local pulseIdleAt = os.clock()

    -- BLADE DISPLAY DESYNC.
    --
    -- bladeCount() infers durability from the Transparency of Blade_1..7 on the
    -- rig, and the rig sometimes does not redraw after a reload — the blades are
    -- full server-side while the client still shows them spent. Reported from
    -- the seat, and confirmed by the shape of the bug: pressing the grapple,
    -- which has nothing to do with reloading, brings them back.
    --
    -- Left alone this is worse than cosmetic. The gate below stops the pulse
    -- when the rig reads empty, so a stale rig stops the run dead while the
    -- character is holding a full set of blades.
    --
    -- The lie is cheap to detect: if the Slay counter keeps moving while the rig
    -- claims we have nothing to swing, the rig is wrong and the server is right.
    local bladeBrokenSlay, bladeLie = nil, false

    -- ── Gather state ──────────────────────────────────────────────────────
    -- Measured live on Chapel Aberrant: 16 titans alive, exactly ONE inside the
    -- ~400-stud radius the server credits, median distance 2,489 studs. Over a
    -- 3-second window 8 of 16 were closing on the player, some at 440 studs/sec
    -- (WalkSpeed 60-160). They come to you.
    --
    -- Chasing therefore fights itself: every kill snaps the character hundreds
    -- of studs away, and the fifteen titans converging on that spot are left
    -- pathing at a point the player no longer occupies. The pack can never
    -- close, so the in-range count stays pinned at one and `cap` slots go
    -- unused no matter how high the send rate is set.
    --
    -- Holding station instead lets them arrive together. Anchor is the centroid
    -- of everything alive, which is the point that minimises their mean travel.
    local GATHER      = CFG.GatherMode ~= false
    local GATHER_WAIT = num(CFG.GatherTimeout, 8)
    local gatherOkAt  = os.clock()

    -- Park where the most napes are reachable at once. Aura farming is limited
    -- by how many targets sit inside the register radius, not by how close the
    -- single nearest titan is — v9 always chased the nearest, which on a spread
    -- map means hovering at the edge of the pack instead of inside it.
    local function pickCluster(n)
        local best, bestScore = nil, -1
        for i = 1, n do
            local a = buf[i]
            local score = 0
            for j = 1, n do
                if (a.root.Position - buf[j].root.Position).Magnitude <= CLUSTER_RANGE then
                    score = score + 1
                end
            end
            -- Break ties toward the weakest titan so a kill lands sooner.
            if score > bestScore or (score == bestScore and best and a.hp < best.hp) then
                best, bestScore = a, score
            end
        end
        return best, bestScore
    end

    -- Desync the fleet. Every client starts its combat loop on the same tick
    -- otherwise, so all of them build their alive list, sort, and burst sends on
    -- the same frame — which is what makes one box running 30 bots stutter in
    -- lockstep rather than averaging out.
    if CFG.MultiInstance then
        local j = num(CFG.MultiInstanceJitter, 3)
        if j > 0 then task.wait(math.random() * j) end
    end

    -- Crash containment. The loop below is the whole farm: one uncaught error
    -- inside it (a streamed-out part, a nil humanoid mid-despawn, a GUI that
    -- changed shape between builds) killed the thread outright and the client
    -- then sat in the mission doing nothing until someone noticed. Unattended
    -- across many clients that is the single most expensive failure there is.
    -- Every piece of loop state is declared ABOVE this point, so a restart
    -- resumes rather than re-learning.
    if K.focusOn() then K.focusHook() end
    local crashes, crashWindow = 0, 0
    while alive() do
        local ok, err = pcall(function()

        while alive() do
            task.wait(COMBAT.loop)
            if not CFG.AutoFarm then continue end

            -- Never fight over the summary screen; the click handler owns that.
            local rewards = interface and interface:FindFirstChild("Rewards")
            if rewards and rewards.Visible then continue end

            local ch  = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChildWhichIsA("Humanoid")
            if not (hrp and hum and hum.Health > 0) then continue end

            -- Hand the reloader the previous pulse's in-range count so it knows
            -- whether we are fighting or travelling. Reloading during travel is
            -- free; reloading mid-fight costs the whole animation.
            local broken = bladeBroken()
            -- Swinging and never credited: spent server-side, whatever the rig
            -- draws. (Focus fire only -- it is the mode that can tell.)
            if not broken and not BLADE.busy and K.focusOn() and K.focusStarved(os.clock()) then
                broken = true
                BLADE.trustUntil = nil
                BLADE.forceUntil = os.clock() + 4
                BLADE.nextTry = 0
            end
            if broken then
                local sl = objectiveValue("Slay")
                if bladeBrokenSlay == nil then
                    bladeBrokenSlay, bladeLie = sl or -1, false
                elseif sl and bladeBrokenSlay >= 0 and sl > bladeBrokenSlay then
                    if not bladeLie then
                        bladeLie = true
                        log("BLADE", "rig reads empty while kills keep landing — "
                            .. "the blade display is stale, ignoring it")
                    end
                end
            else
                bladeBrokenSlay, bladeLie = nil, false
            end

            -- Volley fire has no use for the stale-display override: a swap
            -- is half a second there, and every volley sent through a reload
            -- makes the server refuse that swap (measured: 9s of refused
            -- swaps while "kills kept landing" held the gate open).
            if K.focusOn() then bladeLie = false end
            local bladesOk = (not broken) or bladeLie
            ensureBlade(lastInRange, broken)
            -- A reload is an ANIMATION, and firing during it cancels it — so a
            -- pulse thrown mid-swap costs the swap as well as the sends. Both
            -- the broken case and the in-progress case are bounded by
            -- ensureBlade's own timeouts, so this can never wedge the loop.
            -- Unless the break is the display lying, in which case there is no
            -- animation to protect and stopping would be the whole bug.
            if BLADE.busy and not bladeLie then bladesOk = false end

            -- Exported for the rate probe: a pulse only fires while bladesOk is
            -- true, so blade downtime is send downtime and it is invisible from
            -- outside without this.
            _G.VCP_BladesOk = bladesOk
            _G.VCP_BladeBroken = broken
            _G.VCP_BladeBusy = BLADE.busy

            -- ── Thunder Spear objective steering ──────────────────────────────
            -- parkSnap marks a park target that does NOT move. moveTo drifts
            -- there on a BodyPosition, which is right for the escort convoy but
            -- wrong for a watchtower circle: the approach took many seconds of
            -- physics travel through titan reach. A static target should be
            -- taken with snapTo, which repositions discretely -- the same
            -- mechanism the titan-lock already uses across the whole map.
            local filterFn, parkOverride, parkSnap = nil, nil, false

            if TS_ACTIVE and TS_MAP == "Outskirts" then
                if TS_STATE == "INIT" then
                    local isEscort = false
                    pcall(function()
                        local o = Workspace:GetAttribute("Objective")
                        isEscort = o ~= nil and tostring(o):upper() == "ESCORT"
                    end)
                    TS_STATE = isEscort and "KILL_ALL" or "KILL_TO_5"
                end

                if TS_STATE == "KILL_TO_5" then
                    -- Nothing to thin any more: the character now keeps firing
                    -- while it stands in the circle, so waiting for a quiet
                    -- field only wastes mission time. Go straight to building.
                    TS_STATE = "BUILD_TOWERS"
                elseif TS_STATE == "BUILD_TOWERS" then
                    -- Build by PARKING, not by blocking, and take CREDIT ONLY
                    -- FROM THE SAVE.
                    --
                    -- Earlier revisions inferred credit from the WatchTower
                    -- models: a model disappearing, or the lowest visible index
                    -- changing, was counted as a tower built. Workspace.
                    -- StreamingEnabled is true here, so both observations are
                    -- produced by the character simply moving, by a respawn, or
                    -- by ordinary replication churn -- with no credit at all.
                    -- The only authority is slot.Quests.Spears[Towers].Current.
                    -- The models now decide only WHERE to stand.
                    TS_BUILD_START = TS_BUILD_START or os.clock()
                    local Q = K.TS.q
                    if os.clock() >= (Q.nextAt or 0) then
                        Q.nextAt = os.clock() + 5
                        local qc = K.towersQuestCurrent()
                        if qc then
                            Q.base = Q.base or qc
                            if Q.last and qc > Q.last then
                                TS_FAILS, K.TS.groundAcc = 0, 0
                                K.TS.skip = {}
                                K.tsBreadcrumb(("TOWER CREDITED -- quest %s -> %s")
                                    :format(Q.last, qc))
                            end
                            Q.last = qc
                        end
                    end
                    TS_TOWER = Q.last or Q.base or 0     -- towers actually credited

                    local wt = K.nextTowerModel()

                    if wt then
                        TS_LAST_SEEN = os.clock()
                        if wt.Name ~= TS_WATCH then
                            TS_WATCH, K.TS.groundAcc = wt.Name, 0
                        end

                        _G.VCP_TSBuilding = true

                        -- Standing in the circle means standing on the GROUND,
                        -- and normal combat only survives because it hovers at
                        -- FLOAT (>=90 studs) where titans cannot reach. Parking
                        -- in the circle removed that protection entirely and the
                        -- account was repeatedly grabbed and eaten.
                        --
                        -- So dip, do not squat. The wiki is explicit that
                        -- stepping out of the circle briefly does NOT reset
                        -- progress, so alternate: hold the circle until the
                        -- health or the timer says otherwise, then climb to
                        -- FLOAT directly above it -- still close enough to keep
                        -- the model streamed in and to drop back in at once.
                        local circlePos = K.safeCirclePoint(wt.Circle.Hitbox, TITANS.set)
                        local hpFrac = 1
                        if hum and hum.MaxHealth > 0 then
                            hpFrac = hum.Health / hum.MaxHealth
                        end
                        local now2 = os.clock()
                        TS_DIP_AT = TS_DIP_AT or now2

                        -- DESCEND ONLY INTO A CLEARED CIRCLE.
                        --
                        -- Health was the wrong trigger: a grab takes the
                        -- character from full health to dead well inside one
                        -- loop tick at a 200ms frame period, so by the time the
                        -- bar reads low the run is already over. Deaths kept
                        -- happening with the health guard in place.
                        --
                        -- Use distance instead, which is knowable in advance.
                        -- Titans have to WALK to the circle while our hits
                        -- reach 6000 studs, so the safe play is to hold FLOAT
                        -- directly above it, kill everything that approaches,
                        -- and touch down only once nothing is close enough to
                        -- reach us. Hysteresis stops it oscillating on the
                        -- boundary.
                        -- A grab sets the character's Ragdoll attribute -- the
                        -- map even scores an Avoid_Grabs objective on it. Nothing
                        -- in this file ever looked at it, so being caught was a
                        -- silent death sentence. Treat it as an emergency: get
                        -- off the ground immediately and let the normal combat
                        -- loop take over until it clears.
                        -- (The `hum.Health <= 0 -> TS_RESPAWNED` line that used
                        --  to be here was unreachable: the combat loop returns
                        --  at `hum.Health > 0` several hundred lines above, so
                        --  this branch only ever runs on a live character. The
                        --  death watcher sets it now, because that thread is
                        --  the only one that runs while we are a corpse.)
                        if ch and ch:GetAttribute("Ragdoll") == true
                           and hum and hum.Health > 0 then
                            if not TS_DIP then
                                K.tsBreadcrumb(("%s: GRABBED -- breaking off")
                                    :format(wt.Name))
                            end
                            TS_DIP, TS_DIP_AT, TS_CLEAR_SINCE = true, os.clock(), nil
                        end

                        local threat = K.nearestTitanTo(circlePos, TITANS.set)

                        -- COMMIT, DO NOT COMMUTE.
                        --
                        -- The first distance rule flew in and straight back out
                        -- again: on a 44-titan Aberrant map something is nearly
                        -- always inside a 300-stud ring, so the character spent
                        -- its time in transit -- which is exactly where it was
                        -- getting grabbed, since the descent passes through
                        -- reach height.
                        --
                        -- So make the two states sticky and asymmetric:
                        --   * Descend only after the approach has been CLEAR
                        --     for a sustained window, not for one sampled tick.
                        --   * Once down, hold the circle and kill what comes
                        --     instead of fleeing from it. Leave only on real
                        --     damage or on something already at grab distance.
                        local clearR = num(CFG.TowerClearRadius, 600)
                        local panicR = num(CFG.TowerPanicRadius, 130)
                        local settle = num(CFG.TowerClearSeconds, 2.5)

                        -- ONE-HIT-KILL GUARD.
                        --
                        -- Every health test here was a FRACTION, which is exactly
                        -- wrong under the modifier profile this bot used to run
                        -- on these maps: Glass Cannon drops MaxHealth to 1, so
                        -- 1 HP reads as hpFrac = 1.0 = "perfectly healthy" and
                        -- the bot cheerfully parked itself on the pad at ground
                        -- level, one touch from death. So gate on ABSOLUTE
                        -- headroom too.
                        --
                        -- But an absolute floor has a failure mode of its own,
                        -- and it is worse than the one it fixes. If MaxHealth is
                        -- 1, then "one hit kills" is not a warning, it is the
                        -- run's permanent state -- so the veto never lifts and
                        -- the tower is never built. Measured live: three minutes
                        -- holding altitude over WatchTower_1 with the nearest
                        -- titan 1300 studs away, zero kills, zero gold, and the
                        -- run then times out at 420s having done nothing.
                        --
                        -- Modifier selection now keeps Glass Cannon off spear
                        -- maps entirely (see SpearModifierProfile), so this is
                        -- the belt to that pair of braces: when the whole health
                        -- bar is smaller than the floor, stop treating the floor
                        -- as a veto and tighten the CLEARANCE instead. Landing
                        -- in a field that is empty for 1400 studs is a risk;
                        -- never landing is a certainty.
                        local absHp, absMax = 0, 0
                        pcall(function()
                            absHp  = (hum and hum.Health) or 0
                            absMax = (hum and hum.MaxHealth) or 0
                        end)
                        local floorHp = num(CFG.TowerMinAbsHP, 2)
                        local ghost = absMax > 0 and absMax <= floorHp
                        local oneHitKill = (absHp <= floorHp) and not ghost

                        if ghost then
                            -- RELAX IT IF IT NEVER COMES TRUE.
                            --
                            -- 1400 studs of empty field is a lot to ask of a
                            -- 44-titan Aberrant map, and a clearance that is
                            -- never satisfied is just the original deadlock
                            -- wearing a different number. So decay it back to
                            -- the ordinary radius over GhostRelaxSeconds of
                            -- failing to land: the bot always prefers the safest
                            -- window available, but it will eventually take the
                            -- ordinary one rather than build nothing at all.
                            local ghostR = num(CFG.GhostClearRadius, 1400)
                            local relax  = num(CFG.GhostRelaxSeconds, 120)
                            local waited = now2 - (TS_BUILD_START or now2)
                            if relax > 0 and waited > 0 then
                                local t = math.min(waited / relax, 1)
                                ghostR = ghostR + (clearR - ghostR) * t
                            end
                            clearR = math.max(clearR, ghostR)
                            settle = math.max(settle, num(CFG.GhostClearSeconds, 4))
                            panicR = math.max(panicR, num(CFG.GhostPanicRadius, 420))
                            if not K.TS.ghostNoted then
                                K.TS.ghostNoted = true
                                K.tsBreadcrumb(("1-HP RUN (max %d) -- a modifier is making every "
                                    .. "landing lethal. Tightening clearance to %d studs / %ds "
                                    .. "instead of refusing to build.")
                                    :format(absMax, clearR, settle))
                            end
                        end

                        -- THE MAP IS STILL ARRIVING.
                        --
                        -- Measured at spawn on Outskirts: Workspace carries no
                        -- Objective attribute, the Titans folder is empty, and
                        -- the character reads 100/100 -- and then, 2.8 seconds
                        -- later, the mission's modifiers land and MaxHealth
                        -- drops to 1. Every number the descent decision reads is
                        -- therefore provisional for the first seconds of a run,
                        -- and the clear-window is only 2.5s long, so a touch-down
                        -- could be committed at 100 HP and completed at 1.
                        --
                        -- An empty Titans folder is the same trap from the other
                        -- side: "nothing within 600 studs" during streaming
                        -- means "nothing has replicated yet", not "the field is
                        -- clear". So re-arm the clear window whenever MaxHealth
                        -- moves, and hold off entirely until the map says a
                        -- mission is actually running.
                        if K.TS.maxHp ~= absMax then
                            K.TS.maxHp, K.TS.maxHpAt = absMax, now2
                            TS_CLEAR_SINCE = nil
                            K.tsBreadcrumb(("health baseline changed -> %d/%d — "
                                .. "re-arming the descent window"):format(absHp, absMax))
                        end
                        -- Three independent ways to know the map is up, ORed on
                        -- purpose: a gate that only one map satisfies is a
                        -- deadlock waiting for the next map. The elapsed-time
                        -- arm makes it impossible for this to hold the bot off
                        -- the pad indefinitely on a map that names none of them.
                        local mapLive = false
                        pcall(function()
                            local tf = Workspace:FindFirstChild("Titans")
                            mapLive = Workspace:GetAttribute("Objective") ~= nil
                                or (tf ~= nil and #tf:GetChildren() > 0)
                                or (TS_BUILD_START ~= nil and (now2 - TS_BUILD_START) > 20)
                        end)
                        local settled = mapLive
                            and (now2 - (K.TS.maxHpAt or now2)) >= num(CFG.SpearSettleSeconds, 6)

                        if threat > clearR then
                            TS_CLEAR_SINCE = TS_CLEAR_SINCE or now2
                        else
                            TS_CLEAR_SINCE = nil
                        end

                        if TS_DIP then
                            -- Airborne: touch down once the approach has stayed
                            -- clear long enough and we are healthy enough to
                            -- absorb a surprise.
                            local grabbed = ch and ch:GetAttribute("Ragdoll") == true
                            -- Freshly respawned: earn the descent again rather
                            -- than dropping back into the pack that just won.
                            if hpFrac >= 0.999 and TS_RESPAWNED then
                                TS_RESPAWNED, TS_CLEAR_SINCE = false, nil
                            end
                            if TS_CLEAR_SINCE and (now2 - TS_CLEAR_SINCE) >= settle
                               and settled
                               and hpFrac >= num(CFG.TowerDescendHP, 0.90)
                               and not oneHitKill and not grabbed then
                                TS_DIP, TS_DIP_AT = false, now2
                                K.tsBreadcrumb(("%s: touching down (clear %ds, nearest %d, hp %d/%d)")
                                    :format(wt.Name, math.floor(now2 - TS_CLEAR_SINCE),
                                            math.floor(threat), math.floor(absHp),
                                            math.floor(absMax)))
                            end
                        else
                            -- Grounded: only a genuine emergency is worth the
                            -- transit back up -- or being one hit from dead.
                            if hpFrac < num(CFG.TowerLiftHP, 0.75)
                               or oneHitKill or threat < panicR then
                                TS_DIP, TS_DIP_AT = true, now2
                                K.tsBreadcrumb(("%s: lifting off (nearest %d, hp %d/%d%s)")
                                    :format(wt.Name, math.floor(threat),
                                            math.floor(absHp), math.floor(absMax),
                                            oneHitKill and " ONE-HIT" or ""))
                            end
                        end

                        -- KILL WHAT IS CLOSE, SPARE WHAT IS FAR.
                        --
                        -- HitRange is 6000 studs, so parked in the circle the
                        -- bot can reach the entire map and was clearing the
                        -- Slay objective -- which ENDS the mission -- long
                        -- before the towers were up. Titans near the circle are
                        -- the ones that actually kill us, so they are always
                        -- fair game; distant ones are the objective's fuel and
                        -- stay alive while there is no headroom to spare.
                        -- Standing in the circle, anything that can walk to us
                        -- is a threat, so defend a wide ring; from the air the
                        -- job is to CLEAR the approach, wider still. Distant
                        -- titans outside these rings are still spared, which is
                        -- what keeps the Slay objective from ending the run.
                        local guard = num(CFG.TowerGuardRadius, 500)
                        if TS_DIP then guard = clearR + 300 end
                        -- Never flee from something we were not willing to shoot
                        -- at. On a 1-HP run panicR is widened to 420 while the
                        -- grounded guard ring stays at 260, which leaves a band
                        -- where an approaching titan is ignored right up until
                        -- it forces a lift-off -- so the bot bounces instead of
                        -- clearing. The Slay headroom clamp below still has the
                        -- final say, so this cannot end the run early.
                        if guard < panicR then guard = panicR + 60 end
                        -- Parked on a circle with every titan out past the guard
                        -- ring, the bot went 99% idle and killed nothing at all.
                        -- Titans do not come to a stationary target, so once the
                        -- ring has been empty for a while, let it reach out --
                        -- the Slay reserve below still protects the objective.
                        -- Drive this off `threat`, NOT off `lastInRange`.
                        --
                        -- `guard` is a per-tick local, so the widening below
                        -- lasts exactly one tick and is recomputed from the
                        -- config on the next one. `lastInRange` is precisely the
                        -- thing the widening moves: the moment the wider ring
                        -- lets the pulse reach something, lastInRange goes above
                        -- zero, this test flips to the else branch, TS_IDLE_SINCE
                        -- is cleared -- and the reach-out has cancelled itself one
                        -- tick after it opened. The bot then got ONE pulse every
                        -- TowerIdleGrace seconds instead of sustained engagement,
                        -- which is barely different from the 99%-idle deadlock
                        -- this block exists to break.
                        --
                        -- `threat` is the distance to the nearest titan measured
                        -- over the unfiltered TITANS.set, so it does NOT move when
                        -- the guard ring widens. The latch therefore holds until a
                        -- titan genuinely walks inside the normal ring, which is
                        -- the condition that should close it.
                        if TITANS.count > 0 and threat > guard then
                            TS_IDLE_SINCE = TS_IDLE_SINCE or os.clock()
                            if os.clock() - TS_IDLE_SINCE > num(CFG.TowerIdleGrace, 12) then
                                guard = math.max(guard, num(CFG.HitRange, 6000))
                            end
                        else
                            TS_IDLE_SINCE = nil
                        end
                        local slayCur, slayReq = objectiveValue("Slay")
                        local headroom = 999
                        if slayCur and slayReq then headroom = slayReq - slayCur end
                        if headroom <= num(CFG.SlayReserve, 5) then
                            -- Out of headroom: immediate threats only, so the
                            -- objective cannot end the run out from under us.
                            guard = 90
                        end
                        filterFn = function(e)
                            local r = e.root or e.nape
                            if not r then return false end
                            return (r.Position - circlePos).Magnitude <= guard
                        end

                        if TS_DIP then
                            -- WELL clear of the arc, not just above it.
                            --
                            -- The old note here said 110 was "just above reach"
                            -- and that altitude costs transit time. Both halves
                            -- were wrong. parkSnap is true on this branch, so
                            -- the move is a snapTo -- a discrete reposition --
                            -- and altitude therefore costs nothing at all. And
                            -- 110 was not above reach: a death was recorded at
                            -- y=108 "airborne over WatchTower_2", matching the
                            -- escort deaths at y=128 and y=137 that pushed
                            -- ConvoyGuardHeight to 320. Hold at the same height
                            -- the escort had to be raised to.
                            parkOverride = circlePos
                                + Vector3.new(0, num(CFG.TowerHoldHeight, 320), 0)
                            parkSnap = true
                            _G.VCP_TSWhere = ("airborne over %s, nearest %d")
                                :format(wt.Name, threat < math.huge and math.floor(threat) or -1)
                            setAction("%s -- holding altitude (%d/%d, nearest %d)",
                                wt.Name, math.floor(absHp), math.floor(absMax),
                                threat < math.huge and math.floor(threat) or -1)
                        else
                            parkOverride = circlePos
                            parkSnap = true
                            _G.VCP_TSWhere = ("grounded in %s, nearest %d")
                                :format(wt.Name, threat < math.huge and math.floor(threat) or -1)
                            setAction("Building %s (%d/3 done, %d%%, slay %s/%s)",
                                wt.Name, TS_TOWER, math.floor(hpFrac * 100),
                                tostring(slayCur), tostring(slayReq))
                        end

                        -- A circle that will not credit is almost always one
                        -- that is ALREADY BUILT -- the finished tower keeps its
                        -- Circle and Hitbox, so it looks identical to an unbuilt
                        -- one. Write it off and let the scan move to the next,
                        -- rather than parking beside a completed tower for the
                        -- rest of the mission.
                        --
                        -- MEASURE TIME SPENT STANDING IN IT, NOT WALL TIME.
                        --
                        -- This used to be `os.clock() - TS_WATCH_AT`, stamped
                        -- when the model first came into replication range -- so
                        -- every second the bot spent holding altitude, waiting
                        -- for the map to settle, or bouncing off an approaching
                        -- titan counted against the circle as if it had been
                        -- standing there doing nothing. Measured live:
                        -- "WatchTower_2: no credit in 45s -- already built,
                        -- skipping", and ONE SECOND LATER "TOWER CREDITED --
                        -- quest 1 -> 2" for the circle it had just written off.
                        -- Restamping on each touch-down fixes that but breaks
                        -- the rule the other way: a bot that oscillates never
                        -- accumulates 45s and would sit beside a finished tower
                        -- for the whole run. Accumulating grounded seconds is
                        -- the thing the rule actually means, and it survives any
                        -- number of trips back into the air.
                        if not TS_DIP then
                            K.TS.groundAcc = (K.TS.groundAcc or 0)
                                + math.min(now2 - (K.TS.groundTick or now2), 1)
                        end
                        K.TS.groundTick = now2

                        if (K.TS.groundAcc or 0) > num(CFG.TowerStaleSeconds, 45) then
                            K.TS.skip[wt.Name] = true
                            TS_FAILS = TS_FAILS + 1
                            K.tsBreadcrumb(("%s: no credit in %ds STOOD IN IT -- already built, skipping (quest %s)")
                                :format(wt.Name, math.floor(K.TS.groundAcc),
                                        tostring(Q.last)))
                            TS_WATCH, K.TS.groundAcc = nil, 0
                        end
                    else
                        -- No circle in replication range. Fight normally, which
                        -- is also what moves us around and brings the next one
                        -- into range. No credit is inferred from this.
                        _G.VCP_TSBuilding = false
                        TS_WATCH = nil
                        _G.VCP_TSWhere = "searching (no circle in range)"
                        setAction("Searching for watchtower (%ds, %d/3 done)",
                            math.floor(os.clock() - TS_BUILD_START), TS_TOWER)
                    end

                    -- End the phase on the SAVE saying the quest is done, on
                    -- every visible circle having been written off, on repeated
                    -- no-credit circles, or on an overall timeout. Ending it
                    -- drops the kill throttle: KILL_ALL sets no filterFn, so the
                    -- run goes back to clearing the map at full rate.
                    local sinceSeen = os.clock() - (TS_LAST_SEEN or TS_BUILD_START)
                    local questDone = (Q.last ~= nil and Q.last >= 3)
                    local giveUp = questDone
                        or TS_FAILS >= 3
                        or (os.clock() - TS_BUILD_START > 420)
                    if giveUp then
                        _G.VCP_TSBuilding = false
                        TS_STATE = "KILL_ALL"
                        stuck, lockedT, lockedHP = 0, nil, nil
                        pcall(function() hrp.Anchored = false end)
                        K.tsBreadcrumb(("towers phase over: quest %s (from %s), %d fails, %ds elapsed, last circle %ds ago")
                            :format(tostring(Q.last), tostring(Q.base), TS_FAILS,
                                    math.floor(os.clock() - TS_BUILD_START),
                                    TS_LAST_SEEN and math.floor(sinceSeen) or -1))
                    end
                elseif TS_STATE == "KILL_ALL" then
                    local carts = findCarts()
                    if not objectiveDone("Escort") and #carts > 0 then
                        -- Guard phase: stay on the convoy and only engage what
                        -- threatens it. Chasing a distant titan lets the carts die
                        -- and the objective can then never complete.
                        -- GUARD FROM ABOVE.
                        --
                        -- Six studs put the character level with the cart and
                        -- inside every titan's reach, which is how the escort
                        -- run was taking damage it had no reason to take. Hits
                        -- credit out past 6000 studs, so altitude costs nothing
                        -- and removes the only way a titan can touch us. Physics
                        -- follow (not snap) stays correct here: the convoy moves.
                        _G.VCP_TSEscorting, _G.VCP_TSEscortWait = true, false
                        local guardY = num(CFG.ConvoyGuardHeight, 320)

                        -- COVER THE WHOLE CONVOY, NOT ONE CART.
                        --
                        -- Measured mid-run: the three Escort models drift up to
                        -- ~1500 studs apart, and two of the three were already
                        -- carrying Dead=true while the bot sat over the third.
                        -- nearConvoy would happily engage the titans mauling the
                        -- far carts, but it never gets the chance: under
                        -- StreamingEnabled those titans are not replicated to a
                        -- client parked 1500 studs away, so they are not in
                        -- TITANS.set and cannot be shot at all. Hovering over the
                        -- centroid keeps the most carts inside streaming range,
                        -- which is the only way the guard can reach their
                        -- attackers.
                        -- SAVE THE ONE THAT COUNTS.
                        --
                        -- Measured: the carts carry 21, 41 and 21 max HP, and a
                        -- run lost two of them within 90 seconds of the convoy
                        -- spawning. They cannot all be held. But they are not
                        -- equal -- the 41-HP model is the MORTAL CONVOY, the
                        -- one "Escort Convoy 0/1" (and therefore the questline)
                        -- depends on; the 21-HP pair only feed the optional
                        -- "Escort Supplies 0/2". findCarts already sorts main
                        -- first, so guard that one directly instead of a
                        -- centroid that pulls the guard away from it, and point
                        -- every pulse at what threatens IT.
                        --
                        -- Spreading fire over three separate clusters was
                        -- diluting the damage across carts we do not need.
                        local main = nil
                        for _, c in ipairs(carts) do
                            if c.isMain then main = c break end
                        end
                        local centre = main and main.part.Position
                            or convoyCentre(carts) or carts[1].part.Position

                        -- Lead the convoy. AssemblyLinearVelocity reads 0 on
                        -- these carts -- they are moved by CFrame, not physics
                        -- (attribute Lerp=true) -- so derive the velocity from
                        -- how the centroid itself has moved.
                        local lead = Vector3.new(0, 0, 0)
                        local nowC = os.clock()
                        local prev, prevAt = K.TS.convoyAt, K.TS.convoyAtT
                        if prev and prevAt and nowC > prevAt then
                            local dt = nowC - prevAt
                            if dt > 0.05 and dt < 3 then
                                lead = ((centre - prev) / dt) * num(CFG.ConvoyLead, 0.8)
                                if lead.Magnitude > 300 then lead = lead.Unit * 300 end
                            end
                        end
                        K.TS.convoyAt, K.TS.convoyAtT = centre, nowC

                        parkOverride = centre + Vector3.new(0, guardY, 0) + lead
                        if main then
                            local mainPart = main.part
                            local r = num(CFG.MainCartRadius, 500)
                            filterFn = function(e)
                                local root = e.root or e.nape
                                if not root then return false end
                                return (root.Position - mainPart.Position).Magnitude <= r
                            end
                        else
                            filterFn = function(e) return nearConvoy(e, carts) end
                        end

                        -- Report losses: a cart dying is the failure mode this
                        -- objective actually has, and it was invisible before.
                        if K.TS.cartCount and #carts < K.TS.cartCount then
                            K.tsBreadcrumb(("CART LOST — %d left of %d")
                                :format(#carts, K.TS.cartCount))
                        end
                        K.TS.cartCount = #carts

                        if main then
                            setAction("Guarding MAIN convoy %d/%d hp (%d carts up)",
                                math.floor(main.curHP), math.floor(main.maxHP), #carts)
                            if main.maxHP > 0 then
                                local frac = main.curHP / main.maxHP
                                if not K.TS.mainWarned and frac < 0.5 then
                                    K.TS.mainWarned = true
                                    K.tsBreadcrumb(("MAIN CONVOY below half: %d/%d")
                                        :format(math.floor(main.curHP), math.floor(main.maxHP)))
                                end
                            end
                        else
                            setAction("Guarding convoy (%d carts, y=%d) — no main cart",
                                #carts, guardY)
                        end
                        _G.VCP_TSWhere = ("guarding convoy (%d carts)"):format(#carts)
                        if not TS_SAW_CART then
                            TS_SAW_CART = true
                            K.tsBreadcrumb(("convoy spawned: %d carts at %s")
                                :format(#carts, tostring(carts[1].part.Position)))
                        end
                    elseif TS_PART == "Handle" then
                        _G.VCP_TSEscorting = false
                        -- ESCORT IS STILL OUTSTANDING.
                        --
                        -- The carriage spawns partway through the run and then
                        -- has to travel the length of the map. Measured on this
                        -- account with Towers already claimed: Slay hit 42/42
                        -- while Unclimbable.Objective was still empty, so the
                        -- run ended before the convoy had even appeared. The
                        -- Slay counter is the clock here -- stop winding it.
                        local slayCur, slayReq = objectiveValue("Slay")
                        local headroom = 999
                        if slayCur and slayReq then headroom = slayReq - slayCur end

                        -- The carriage does not appear on its own: a circle has
                        -- to be stood in first, exactly like the towers. Take
                        -- any circle the map is offering.
                        local em, ehb = K.anyTriggerCircle(true)

                        -- REMEMBER WHERE IT WAS.
                        --
                        -- Observed live: the circle was found and logged, the
                        -- character lifted to y=153 to clear the approach, and
                        -- on the next tick the model was gone -- streamed out.
                        -- With no model there was no parkOverride, so the combat
                        -- loop went back to roaming, which kept the circle out of
                        -- range: a deadlock that ends the run at "Waiting for
                        -- titans" with the objective untouched.
                        --
                        -- The POSITION survives what the model does not, and
                        -- parking on it pulls the model back into replication.
                        if ehb then
                            K.TS.escortPos = ehb.Position
                            K.TS.escortR   = K.circleRadius(ehb)
                        end
                        local ePosCentre, eRadius = K.TS.escortPos, K.TS.escortR

                        if em and ehb then
                            if TS_ESCORT_CIRCLE ~= em.Name then
                                TS_ESCORT_CIRCLE = em.Name
                                K.tsBreadcrumb(("escort trigger circle found: %s at %s")
                                    :format(em:GetFullName(), tostring(ehb.Position)))
                            end
                            local ePos = K.safeCirclePoint(ehb, TITANS.set)
                            local eThreat = K.nearestTitanTo(ePos, TITANS.set)
                            local eHp = 1
                            if hum and hum.MaxHealth > 0 then
                                eHp = hum.Health / hum.MaxHealth
                            end
                            local eGrabbed = ch and ch:GetAttribute("Ragdoll") == true

                            -- Same one-hit-kill guard as the tower pad above, and
                            -- the same escape hatch. The eHp FRACTION reads 1.0
                            -- at 1 HP under Glass Cannon, so a fraction alone
                            -- happily parks the bot on the ground one touch from
                            -- death -- but an absolute floor that the whole
                            -- health bar sits under is a permanent refusal, and
                            -- the carriage is only summoned by STANDING here. So
                            -- on a 1-HP run swap the veto for a much wider
                            -- clearance, exactly as the tower branch does.
                            local eAbs, eMax = 0, 0
                            pcall(function()
                                eAbs = (hum and hum.Health) or 0
                                eMax = (hum and hum.MaxHealth) or 0
                            end)
                            local eFloor = num(CFG.TowerMinAbsHP, 2)
                            local eGhost = eMax > 0 and eMax <= eFloor
                            local ePanic = eGhost
                                and num(CFG.GhostPanicRadius, 420)
                                or num(CFG.TowerPanicRadius, 130)

                            -- Same pad, same ground-level exposure that killed
                            -- this account repeatedly while building. Only stand
                            -- in it when nothing can reach us.
                            if eGrabbed or eHp < 0.8
                               or (eAbs <= eFloor and not eGhost)
                               or eThreat < ePanic then
                                parkOverride = ehb.Position
                                    + Vector3.new(0, num(CFG.TowerHoldHeight, 320), 0)
                                setAction("%s -- clearing before the carriage (%d/%d, nearest %d)",
                                    em.Name, math.floor(eAbs), math.floor(eMax),
                                    eThreat < math.huge and math.floor(eThreat) or -1)
                                _G.VCP_TSWhere = ("airborne over escort circle %s"):format(em.Name)
                            else
                                parkOverride = ePos
                                setAction("Standing in %s to call the carriage (slay %s/%s)",
                                    em.Name, tostring(slayCur), tostring(slayReq))
                                _G.VCP_TSWhere = ("in escort circle %s"):format(em.Name)
                            end
                            parkSnap = true

                        elseif not ePosCentre then
                            -- Nowhere to go yet. Do not hover at the spawn end
                            -- of a 5000-stud map hoping the circle walks over;
                            -- pull the map in and look for it.
                            -- ...unless the convoy has already spawned this
                            -- run. The sweep exists to find the trigger circle;
                            -- once the carts are out the trigger has done its
                            -- job, and the carts merely streaming out for a tick
                            -- was restarting an 80-probe sweep every 20s.
                            -- Waiting for the carriage after clearing the map
                            -- is the objective, not a stall. Without this the
                            -- watchdog abandons the run before it can appear.
                            _G.VCP_TSEscortWait = true

                            -- The carriage is summoned by standing in a circle,
                            -- so finding one is the whole job here. Cheap roots
                            -- first (already tried above), then a full-tree walk
                            -- on a slow timer, then a streaming sweep for one
                            -- that is simply too far away to be replicated.
                            if not TS_SAW_CART
                               and os.clock() - (K.TS.deepAt or 0) > num(CFG.DeepCircleEvery, 8) then
                                K.TS.deepAt = os.clock()
                                local dm, dhb = K.deepFindCircle()
                                if dm and dhb then
                                    K.TS.escortPos = dhb.Position
                                    K.TS.escortR   = K.circleRadius(dhb)
                                    if K.TS.deepName ~= dm:GetFullName() then
                                        K.TS.deepName = dm:GetFullName()
                                        K.tsBreadcrumb(("escort circle (deep scan): %s at %s")
                                            :format(dm:GetFullName(), tostring(dhb.Position)))
                                    end
                                end
                            end

                            if not TS_SAW_CART and not K.TS.sweeping
                               and not K.TS.escortPos
                               and os.clock() - (K.TS.sweptAt or -1e9) > 20 then
                                K.sweepForCircle()
                            end

                            -- Nothing found in the map: go stand on the reported
                            -- summon point. The convoy is not spawned by killing
                            -- -- a run was seen with the carts already up at Slay
                            -- 0/40 -- it is spawned by being in the right place,
                            -- so being anywhere else is waiting for nothing.
                            if not TS_SAW_CART and not K.TS.escortPos then
                                local tp = CFG.EscortTriggerPos
                                if type(tp) == "table" and #tp >= 3 then
                                    local target = Vector3.new(num(tp[1]), num(tp[2]), num(tp[3]))
                                    -- Same ground-level exposure as the tower
                                    -- circles, so approach the same way: high
                                    -- while anything is near, down once it is not.
                                    local near = K.nearestTitanTo(target, TITANS.set)
                                    local hpF = 1
                                    if hum and hum.MaxHealth > 0 then
                                        hpF = hum.Health / hum.MaxHealth
                                    end
                                    local panic4 = num(CFG.TowerPanicRadius, 130)
                                    if hum and hum.MaxHealth > 0
                                       and hum.MaxHealth <= num(CFG.TowerMinAbsHP, 2) then
                                        panic4 = num(CFG.GhostPanicRadius, 420)
                                    end
                                    if near < panic4 or hpF < 0.8
                                       or (ch and ch:GetAttribute("Ragdoll") == true) then
                                        parkOverride = target
                                            + Vector3.new(0, num(CFG.ConvoyGuardHeight, 320), 0)
                                    else
                                        parkOverride = target
                                    end
                                    parkSnap = true
                                    setAction("Standing on the convoy summon point (%d,%d,%d)",
                                        math.floor(target.X), math.floor(target.Y),
                                        math.floor(target.Z))
                                    _G.VCP_TSWhere = "on the convoy summon point"
                                    if not K.TS.triggerNoted then
                                        K.TS.triggerNoted = true
                                        K.tsBreadcrumb(("moving to the reported summon point %s")
                                            :format(tostring(target)))
                                    end
                                end
                            end
                            setAction("Sweeping for the escort circle (slay %s/%s)",
                                tostring(slayCur), tostring(slayReq))
                            _G.VCP_TSWhere = "sweeping for escort circle"
                            if os.clock() - (K.TS.reportAt or 0) > 30 then
                                K.TS.reportAt = os.clock()
                                local names = {}
                                local uf = Workspace:FindFirstChild("Unclimbable")
                                local of2 = uf and uf:FindFirstChild("Objective")
                                if of2 then
                                    for _, c2 in ipairs(of2:GetChildren()) do
                                        names[#names + 1] = c2.Name
                                    end
                                end
                                K.tsBreadcrumb(("escort hunt: slay %s/%s, objective folder [%s]")
                                    :format(tostring(slayCur), tostring(slayReq),
                                            table.concat(names, ",")))
                            end
                        end

                        if ePosCentre and not em then
                            -- Model not replicated right now. Hold its position
                            -- anyway; that is what brings it back.
                            local eThreat2 = K.nearestTitanTo(ePosCentre, TITANS.set)
                            local eHp2 = 1
                            if hum and hum.MaxHealth > 0 then
                                eHp2 = hum.Health / hum.MaxHealth
                            end
                            local ePanic2 = num(CFG.TowerPanicRadius, 130)
                            if hum and hum.MaxHealth > 0
                               and hum.MaxHealth <= num(CFG.TowerMinAbsHP, 2) then
                                ePanic2 = num(CFG.GhostPanicRadius, 420)
                            end
                            if eThreat2 < ePanic2 or eHp2 < 0.8
                               or (ch and ch:GetAttribute("Ragdoll") == true) then
                                parkOverride = ePosCentre
                                    + Vector3.new(0, num(CFG.TowerHoldHeight, 320), 0)
                            else
                                parkOverride = ePosCentre
                            end
                            parkSnap = true
                            setAction("Returning to the escort circle (slay %s/%s)",
                                tostring(slayCur), tostring(slayReq))
                            _G.VCP_TSWhere = "returning to remembered escort circle"
                        end

                        -- The reserve exists to keep the run alive long
                        -- enough for the carriage to appear and travel. If it
                        -- has not appeared at all after EscortWaitSeconds, there
                        -- is nothing left to hold the run open FOR: spending the
                        -- reserve ends the run and gets us back to the lobby for
                        -- a fresh attempt, which beats hovering at 34/37 doing
                        -- nothing (measured: four dead minutes in one run).
                        K.TS.waitFrom = K.TS.waitFrom or os.clock()
                        local waited = os.clock() - K.TS.waitFrom
                        local giveUpWait = (not TS_SAW_CART)
                            and waited > num(CFG.EscortWaitSeconds, 120)
                        if giveUpWait and not K.TS.waitNoted then
                            K.TS.waitNoted = true
                            K.tsBreadcrumb(("no convoy after %ds — finishing the run instead of idling")
                                :format(math.floor(waited)))
                        end

                        if not giveUpWait and headroom <= num(CFG.EscortSlayReserve, 8) then
                            -- Self-defence only from here: anything further out
                            -- is the mission timer, not a threat.
                            local mePos = hrp.Position
                            filterFn = function(e)
                                local r = e.root or e.nape
                                if not r then return false end
                                return (r.Position - mePos).Magnitude
                                    <= num(CFG.EscortSelfDefence, 220)
                            end
                            if not em and not ePosCentre then
                                setAction("Holding for the escort carriage (slay %s/%s)",
                                    tostring(slayCur), tostring(slayReq))
                            end
                        elseif not em and not ePosCentre then
                            setAction("Clearing before the escort (slay %s/%s)",
                                tostring(slayCur), tostring(slayReq))
                        end
                        _G.VCP_TSWhere = ("waiting for convoy (slay %s/%s)")
                            :format(tostring(slayCur), tostring(slayReq))
                    else
                        _G.VCP_TSEscorting = false
                        setAction("Escort clear — cleaning up")
                    end
                end

            elseif TS_ACTIVE and TS_MAP == "Utgard" then
                setAction("Ice Burst %d/3", TS_ICE)

            elseif TS_ACTIVE and TS_MAP == "Forest" then
                if TS_STATE == "INIT" then TS_STATE = "KILL_TO_MARGIN" end
                local slay, slayReq = objectiveValue("Slay")
                local defend = objectiveValue("Defend_Supplies")

                if defend and TS_STATE ~= "KILL_ALL" then
                    TS_STATE = "KILL_ALL"
                    stuck, lockedT, lockedHP = 0, nil, nil
                end

                if TS_STATE == "KILL_TO_MARGIN" then
                    -- Stop short of the slay requirement: completing it early ends
                    -- the mission before the crates can be delivered.
                    --
                    -- The old margin was a flat 5, which ONE pulse can cross.
                    -- The pulse is paced by the token bucket, and a single tick
                    -- may cash out up to K.BUCKET.burst sends -- floored at
                    -- COMBAT.cap and, at the 5 fps cap, measured around 30. Five
                    -- kills of headroom against a thirty-kill burst means the
                    -- Slay objective can complete on the tick BEFORE the state
                    -- machine ever reaches COLLECT, so the crates are never
                    -- picked up and the Forest "Base" spear part -- the FIRST
                    -- part in the questline -- is never earned.
                    --
                    -- Reserve a whole burst instead. Reading burst before the
                    -- first K.budget call yields 0, hence the COMBAT.cap floor.
                    -- A margin that lands at or below 0 is fine and self-
                    -- correcting: it just means collect immediately.
                    local reserve = num(CFG.SlayReserve, 5)
                        + math.ceil(math.max(num(K.BUCKET.burst, 0), num(COMBAT.cap, 0)))
                    local margin = (slayReq or 40) - reserve
                    setAction("Slay %d/%d before collecting", slay or 0, margin)
                    if (slay or 0) >= margin then TS_STATE = "COLLECT" end

                elseif TS_STATE == "COLLECT" then
                    local circle = findDropCircle()
                    if not circle then
                        TS_STATE = "KILL_ALL"
                    else
                        local avail = {}
                        for _, c in ipairs(scanCrates()) do
                            if not TS_VISITED[c.model] then avail[#avail + 1] = c end
                        end
                        if #avail == 0 then
                            TS_STATE = "KILL_ALL"
                        else
                            -- A crate run is the same exposure as a watchtower
                            -- pad: touchHitbox parks the character 5 studs off
                            -- the ground for 1.4s at the crate and 1.4s again
                            -- at the drop circle, and it did so with no regard
                            -- for what was standing there. The tower branch
                            -- learned this the expensive way, so apply the same
                            -- rule -- go when the ground is clear, otherwise
                            -- fall through and let the combat loop make it
                            -- clear. Nothing is marked visited until the trip
                            -- is actually taken.
                            local safeR = num(CFG.CratePanicRadius,
                                              num(CFG.TowerPanicRadius, 130))
                            local dropClear =
                                K.nearestTitanTo(circle.hitbox.Position, TITANS.set) > safeR
                            table.sort(avail, function(a, b)
                                return (a.hitbox.Position - hrp.Position).Magnitude
                                     < (b.hitbox.Position - hrp.Position).Magnitude
                            end)
                            local target = nil
                            if dropClear then
                                for _, c in ipairs(avail) do
                                    if K.nearestTitanTo(c.hitbox.Position, TITANS.set) > safeR then
                                        target = c
                                        break
                                    end
                                end
                            end
                            if target then
                                TS_VISITED[target.model] = true
                                setAction("Crate %d — pickup", TS_CRATES + 1)
                                touchHitbox(target.hitbox, 1.4)
                                setAction("Crate %d — delivery", TS_CRATES + 1)
                                touchHitbox(circle.hitbox, 1.4)
                                TS_CRATES = TS_CRATES + 1
                                continue
                            end
                            setAction("Crate run held — clearing the ground first (%d left)",
                                #avail)
                        end
                    end
                end
            end

            -- ── Station run ───────────────────────────────────────────────────
            -- K.stationRefill is holding the character over a Refill station.
            -- Park there too, or the anchor logic below snaps it straight back
            -- into the fight halfway through the refill.
            if BLADE.tripTo then
                parkOverride, parkSnap, filterFn = BLADE.tripTo, true, nil
            end

            -- ── Build the alive list ──────────────────────────────────────────
            -- Blacklist entries are timestamps now, not booleans, so they age
            -- out on their own rather than surviving until the map is empty.
            local now0 = os.clock()
            local n, totalHealth = 0, 0
            for model, e in pairs(TITANS.set) do
                if not model.Parent then
                    TITANS.set[model] = nil
                elseif not (TITANS.blacklist[model]
                            and (now0 - TITANS.blacklist[model]) < num(CFG.BlacklistSeconds, 8)) then
                    local hpv = e.hum and e.hum.Health or nil
                    if e.nape and e.root and hpv and hpv > 0 and e.root.Parent then
                        if not filterFn or filterFn(e) then
                            n = n + 1
                            local slot = buf[n]
                            if not slot then slot = {}; buf[n] = slot end
                            slot.model = model
                            slot.nape  = e.nape
                            slot.root  = e.root
                            slot.hp    = hpv
                            slot.hum   = e.hum
                            slot.dist  = (hrp.Position - e.root.Position).Magnitude
                            totalHealth = totalHealth + hpv
                        end
                    end
                end
            end

            -- ── Nothing to fight: hold station ────────────────────────────────
            if n == 0 then
                govObserve(0, 0)
                -- Nothing alive means nothing in range. `lastInRange` is only
                -- ever assigned deep inside the fighting path, which this
                -- branch never reaches -- so without this the last non-zero
                -- count stays latched for the rest of the run and everything
                -- downstream that asks "is anything in range?" keeps reading a
                -- number that stopped being true: the ensureBlade reload
                -- sizing, the gather-stall clock (which refreshes gatherOkAt
                -- while lastInRange > 0, so the stall never trips), and the
                -- tower guard-ring reach-out.
                lastInRange = 0
                if next(TITANS.blacklist) ~= nil then TITANS.blacklist = {} end
                lockedT, lockedHP = nil, nil

                local park = parkOverride
                if not park then
                    -- "Nothing in range" is a snapshot, not a promise. Under
                    -- StreamingEnabled the reason nothing is in range is often
                    -- that nothing has replicated YET, and this branch is where
                    -- the bot sits still for as long as that lasts -- so it has
                    -- to idle at the same altitude the rest of the file treats
                    -- as out of reach. Six studs above a cart was the height
                    -- the escort guard was explicitly raised to 320 to get away
                    -- from; it had simply been left behind here.
                    if TS_ACTIVE and TS_MAP == "Forest" then
                        local circle = findDropCircle()
                        if circle then
                            park = circle.hitbox.Position
                                 + Vector3.new(0, num(CFG.TowerHoldHeight, 320), 0)
                        end
                    elseif TS_ACTIVE and TS_MAP == "Outskirts" then
                        local carts = findCarts()
                        if carts[1] then
                            park = carts[1].part.Position
                                 + Vector3.new(0, num(CFG.ConvoyGuardHeight, 320), 0)
                        end
                    end
                end
                if not park then
                    park = Vector3.new(hrp.Position.X, math.max(hrp.Position.Y, 100), hrp.Position.Z)
                    setAction("Waiting for titans")
                end

                if hrp.Anchored then hrp.Anchored = false end
                ensureHover(hrp)
                local dead = parkOverride and 2 or 10
                if (hrp.Position - park).Magnitude > dead then
                    if parkSnap then
                        snapTo(hrp, park)
                    else
                        K.followTo(hrp, park, num(CFG.ConvoySnapAt, 150))
                    end
                end
                continue
            end

            -- ── Choose where to park ──────────────────────────────────────────
            local now = os.clock()
            local anchor = nil

            -- Gathering only counts as working while something is actually arriving.
            -- If nothing reaches us for GATHER_WAIT seconds the pack is either dead,
            -- stuck on geometry, or not aggroed — fall back to chasing so the run
            -- cannot stall waiting for titans that are never coming.
            if lastInRange > 0 then gatherOkAt = now end
            local gatherStalled = (now - gatherOkAt) > GATHER_WAIT

            if parkOverride then
                anchor = parkOverride
            elseif GATHER and not gatherStalled then
                if now >= nextCluster then
                    nextCluster = now + 1.0
                    local sx, sy, sz = 0, 0, 0
                    for i = 1, n do
                        local p = buf[i].root.Position
                        sx, sy, sz = sx + p.X, sy + p.Y, sz + p.Z
                    end
                    clusterPos = Vector3.new(sx / n, sy / n, sz / n)
                    -- Keep a lock for the stuck-detector, but pick it by lowest
                    -- health so the watchdog follows whatever is about to die
                    -- rather than an arbitrary member of the pack.
                    local weakest = nil
                    for i = 1, n do
                        if buf[i].dist <= WORK_RANGE
                        and (not weakest or buf[i].hp < weakest.hp) then
                            weakest = buf[i]
                        end
                    end
                    if weakest then lockedT, lockedHP = weakest.model, weakest.hp end
                end
                if clusterPos then
                    anchor = Vector3.new(clusterPos.X, clusterPos.Y + FLOAT, clusterPos.Z)
                end
                setAction("Gathering — %d in range of %d alive", lastInRange, n)
            else
                -- Re-solve the cluster when the lock is gone or on a slow cadence;
                -- an O(n^2) scan every tick would cost more than it saves.
                local lockValid = false
                if lockedT and lockedT.Parent and TITANS.set[lockedT] then
                    for i = 1, n do
                        if buf[i].model == lockedT then
                            clusterPos = buf[i].root.Position
                            lockValid = true
                            break
                        end
                    end
                end

                if not lockValid or now >= nextCluster then
                    nextCluster = now + 1.0
                    local best = nil
                    if CFG.TargetPriority == "nearest" then
                        for i = 1, n do
                            if not best or buf[i].dist < best.dist then best = buf[i] end
                        end
                    else
                        best = pickCluster(n)
                    end
                    if best then
                        lockedT, lockedHP = best.model, best.hp
                        clusterPos = best.root.Position
                    end
                end

                if clusterPos then
                    anchor = Vector3.new(clusterPos.X, clusterPos.Y + FLOAT, clusterPos.Z)
                end
            end

            if anchor then
                if hrp.Anchored then hrp.Anchored = false end
                ensureHover(hrp)
                if parkOverride then
                    if (hrp.Position - anchor).Magnitude > 2 then
                        if parkSnap then
                            -- Static target: get there at once. Drifting in on
                            -- physics spent the whole approach inside titan
                            -- reach for no benefit.
                            snapTo(hrp, anchor)
                        else
                            -- Moving target: re-command every tick so we ride
                            -- the convoy rather than trailing it.
                            K.followTo(hrp, anchor, num(CFG.ConvoySnapAt, 150))
                        end
                    end
                else
                    -- While gathering, a dead target must NOT drag the character
                    -- off the anchor — that is the exact behaviour that stops the
                    -- pack from ever closing. Only the deadzone may move us, and
                    -- the centroid drifts slowly, so in practice we hold still.
                    local switched = (not GATHER or gatherStalled)
                                     and (lockedT ~= lastTPTarget)
                    if switched or (hrp.Position - anchor).Magnitude > DEADZONE then
                        snapTo(hrp, anchor)
                        lastTPTarget = lockedT
                    end
                end
            end

            govObserve(n, lastInRange)

            -- ── Stuck detection ───────────────────────────────────────────────
            -- Watching the locked target's own health is far more precise than v9's
            -- map-wide total, which never moved while other players were killing
            -- things and so could mask a genuinely unreachable target.
            -- The sweep advances ONE NAPE PER FRAME by design (repeated CFrame
            -- writes inside one frame replicate only the last one, so yielding
            -- is what makes each position real to the server). At the 5 fps cap
            -- that is 0.2s per nape: a 40-nape tour would need 8 seconds against
            -- a 2.5s budget, i.e. it would visit five titans and stop, having
            -- blocked the pulse the whole time. Below ~20 fps it is strictly a
            -- loss, so it turns itself off rather than half-running.
            local sweepOn = ONE_SHOT and CFG.HitAllSweep
            if sweepOn and K.FRAME.dt > 0.05 then
                sweepOn = false
                if not K.sweepFpsNoted then
                    K.sweepFpsNoted = true
                    log("SWEEP", ("frame period %.0fms — the tour advances one nape "
                        .. "per frame, so it is disabled below ~20fps")
                        :format(K.FRAME.dt * 1000))
                end
            end
            local lockedDist = nil
            if lockedT then
                local cur = nil
                for i = 1, n do
                    if buf[i].model == lockedT then
                        cur = buf[i].hp
                        lockedDist = buf[i].dist
                        break
                    end
                end
                -- A locked titan the sweep has not visited yet is not STUCK, it
                -- is merely far — which on this map is the normal state, not the
                -- exception (median titan sits 2,489 studs out). Counting it as
                -- stuck was silencing the entire fire block for 10 of every 14
                -- ticks, and the fire block is where the sweep lives: the one
                -- mechanism that fixes distance was gated behind not having a
                -- distance problem.
                local farNotStuck = sweepOn and lockedDist and lockedDist > WORK_RANGE
                if cur and lockedHP and cur >= lockedHP and not farNotStuck then
                    stuck = stuck + 1
                    if stuckSince == 0 then stuckSince = now end
                else
                    stuck, stuckSince = 0, 0
                end
                lockedHP = cur or lockedHP
            end

            -- SECONDS, NOT ITERATIONS. `stuck` counts loop passes and one pass
            -- is one FRAME: 16ms at 60fps, 200ms at the 5fps cap. `stuck == 4`
            -- therefore meant 66ms on one machine and 800ms on another, which is
            -- not a threshold at all. Both gates below are wall-clock now, and
            -- the client-state nudge is separately rate-limited so it fires at
            -- most once a second whatever the frame rate.
            if stuckSince > 0 and (now - stuckSince) >= 0.5
               and (now - (K.lastNudge or 0)) >= 1.0 then
                K.lastNudge = now
                actorCmd("reset")
            end
            if stuckSince > 0
               and (now - stuckSince) >= num(CFG.StuckSeconds, 2.5) then
                -- SECONDS, not ticks. `stuck` counts loop iterations, and one
                -- iteration resolves on the 60fps Heartbeat grid at ~33ms, so
                -- the old `stuck >= 14` condemned a titan after 0.47s of flat
                -- health. On Aberrant the locked titan is the weakest nape in
                -- range and receives one send per park (0.20s), whose effect
                -- takes about a round trip to replicate back — so flat health
                -- for half a second is the NORMAL case, not evidence of
                -- anything. The list is also only ever flushed when the alive
                -- count reaches zero, so a titan wrongly condemned stays out of
                -- the pool for the rest of the run and the objective waits on a
                -- titan we are refusing to shoot.
                --
                -- Blacklist only a titan we could actually REACH and still
                -- failed to hurt. A far one is not unreachable, and blacklisting
                -- it drops it from the alive buffer entirely — which would take
                -- it off the sweep's candidate list too, hiding exactly the
                -- titans the sweep exists to visit.
                -- NO BENCHING. This is a rotation timer, not a stuck detector.
                --
                -- The condition that got us here is `cur >= lockedHP`, and both
                -- sides are Humanoid.Health on a build that never replicates
                -- titan health -- 100 >= 100, true on every tick a lock exists.
                -- The far-target escape (farNotStuck) cannot clear it either,
                -- because it needs sweepOn = ONE_SHOT and CFG.HitAllSweep, and
                -- HitAllSweep ships false. So this branch fires every
                -- StuckSeconds for the whole run, on a perfectly healthy target.
                --
                -- Blacklisting there is the harmful half: TITANS.blacklist drops
                -- the model out of the alive buffer for BlacklistSeconds, and the
                -- buffer is the only source of the send pool -- so a live titan
                -- standing next to the character receives ZERO sends for 8s.
                -- With a 44-titan pack that is invisible, the send budget binds
                -- first; but on the tower guard ring and escort self-defence,
                -- where the filter shrinks the pool to a handful, it means
                -- refusing to shoot the thing that is about to kill us.
                --
                -- Rotating the lock is still worth doing, and stuckSince is left
                -- to drive the actorCmd("reset") nudge above, which is the real
                -- unwedge path. If a genuine unreachable signal is wanted later,
                -- gate it on something that actually replicates -- STATE.kills
                -- (fed from Objectives.Slay) or TITANS.count failing to move.
                lockedT, lockedHP, stuck, stuckSince = nil, nil, 0, 0
                setAction("Rotating target — %d in range of %d alive", lastInRange, n)
            end

            -- ── Fire ──────────────────────────────────────────────────────────
            -- `stuck` gates the pulse, never the sweep: a stuck counter means
            -- "what we are shooting at is not dying", and the sweep is the
            -- answer to that, not another symptom of it.
            -- `stuck` counts TICKS, not seconds, and the Nitro loop ticks every
            -- 0.02s -- so a locked titan whose health does not move reaches 4 in
            -- 80ms and blocks the fire block for the 200ms it takes to reach 14
            -- and reset. That gate was written for a loop an order of magnitude
            -- slower. Worse, it is meaningless in one-shot mode: a pulse spreads
            -- one send across many different napes, so the LOCKED titan not
            -- dying says nothing about whether the pulse is working. Measured
            -- live it was silencing roughly four seconds out of every ten.
            -- Same correction as above: this gate used to read `stuck < 4`,
            -- four loop iterations, which at 5 fps is 0.8s of silence and at
            -- 60 fps is 66ms. Seconds are the only unit that means the same
            -- thing on both.
            if not bladesOk then K.FOCUS.armed = nil end
            if stuckSince == 0 or (now - stuckSince) < 0.75 or sweepOn or ONE_SHOT
               or K.focusOn() then
                -- Focus fire sends its own Slash with every hit (K.focusPulse),
                -- and never while the blades are down: a swing that is still
                -- live is exactly what makes the server refuse the reload.
                if now >= nextSlash and not K.focusOn() then
                    nextSlash = now + COMBAT.slash + math.random() * 0.06
                    sendSlash()
                end

                -- A broken blade means the server credits NOTHING, so every
                -- send made while it is broken is thrown away — and worse, the
                -- adaptive tuner reads the resulting silence as "the server has
                -- stopped crediting" and slows the real rate down afterwards.
                -- Caught live on Hard: 146 sends over three seconds with the
                -- alive count and the Slay counter both frozen, immediately
                -- before a "Blade swap (sets 3)". Wait for the swap instead.
                -- No `nextHit` deadline any more. The bucket in §21a is the
                -- pacer: it hands out sends in wall-clock seconds, so the pulse
                -- may run on EVERY loop pass and simply spends whatever has
                -- accrued. That is what makes throughput identical at 5 fps and
                -- at 60 — a frame-quantised deadline could only ever round the
                -- intended pace UP to the next frame, and at 200ms frames that
                -- rounding was costing a third of the send budget.
                if bladesOk and K.budget(now) >= 1 then

                    -- Only spend rate budget on napes the server can actually
                    -- credit. Sorting by health ascending finishes kills instead of
                    -- spreading chip damage across the whole pack, which is what
                    -- turns hits into completed objectives.
                    -- How long a nape stays parked after we hit it.
                    --
                    -- While the pack is large this is just the server's
                    -- per-target cooldown and there is nothing to gain by
                    -- re-hitting sooner — the pool itself supplies enough fresh
                    -- targets to spend the whole budget. Measured on Hard, the
                    -- opening second of a run puts out 89 sends against an 86/s
                    -- budget: saturated.
                    --
                    -- The TAIL is the opposite. With five titans left the pool
                    -- can only offer 5/0.30 = 17 sends a second and the other
                    -- ~70 go unused, which measured as 7 of the run's 22 seconds
                    -- spent finishing the last five. So shorten the park as the
                    -- pool shrinks and let the extra sends race the cooldown:
                    -- they are free, the budget is idle either way, and the
                    -- limiter still caps the rolling second.
                    local park = K.STRUCK_TTL
                    if lastInRange > 0 and lastInRange < 8 then
                        park = math.max(num(CFG.HitCooldownMin, 0.15),
                                        K.STRUCK_TTL * (lastInRange / 8))
                    end

                    local pool, pn = {}, 0
                    local fresh = 0
                    -- ONE property read for the whole pass, and the distances
                    -- are rewritten as we go.
                    --
                    -- buf[i].dist was measured at the top of this tick, BEFORE
                    -- the anchor logic above possibly snapped the character
                    -- somewhere else. The filter here was already recomputing it
                    -- against the new position for exactly that reason, but it
                    -- threw the fresh number away — so the sort below, the
                    -- sweep's candidate list and the calibration probe all went
                    -- on judging reachability by where we used to be. Store it.
                    --
                    -- `hrp.Position` is a property read across the C++ boundary
                    -- and it was being made once per titan; against a 40-titan
                    -- pool that is 40 reads a pulse for a value that cannot
                    -- change inside one tick.
                    local hp = hrp.Position
                    for i = 1, n do
                        local e = buf[i]
                        local d = (hp - e.root.Position).Magnitude
                        e.dist = d
                        if d <= WORK_RANGE then
                            pn = pn + 1
                            pool[pn] = e
                            -- In one-shot mode a nape hit within the park window
                            -- is already dead in all but replication; mark it so
                            -- the sort pushes it behind every untouched titan.
                            local t = ONE_SHOT and STRUCK[e.model] or nil
                            e.spent = (t ~= nil) and (now - t) < park
                            if not e.spent then fresh = fresh + 1 end
                        end
                    end
                    lastInRange = pn
                    if pn > 0 then pulseIdleAt = now end
                    local vel  = swingVelocity()
                    local td   = timeDifference()
                    local fired = 0

                    if K.focusOn() then
                        -- 21c: one Slash + up to VolleySize Registers on distinct
                        -- titans, timed to when the server can accept a slash.
                        fired = K.focusPulse(pool, pn, now, vel, td)
                        K.spend(fired)
                    else
                        -- HOW MANY SENDS THIS PULSE MAY MAKE.
                        --
                        -- `avail` is the wall-clock allowance that has accrued since
                        -- the last pulse, whole tokens only — the fraction stays in
                        -- the bucket and carries, so the long-run average is exact
                        -- rather than rounded down once per frame. At 5 fps that is
                        -- ≈17 sends once per 200ms frame; at 60 fps it is ≈1.5 sends
                        -- sixty times a second. Same sends per second, and that is
                        -- the entire point.
                        local avail = math.floor(K.budget(now))
                        local limit = CFG.HitAll and COMBAT.cap or math.min(COMBAT.cap, 6)
                        -- Never spend the pulse re-hitting spent napes while fresh ones
                        -- are waiting: the spread IS the damage in one-shot mode.
                        if ONE_SHOT then
                            -- fresh == 0 means every reachable nape was already hit
                            -- inside the park window: they are dead and awaiting
                            -- removal, so the honest limit is ZERO.
                            --
                            -- OneShotBurst is now a per-pulse CEILING and nothing
                            -- more — the bucket is the rate control. It has to sit
                            -- ABOVE one frame's allowance or it becomes the binding
                            -- constraint at a low frame rate: at 5 fps a frame is
                            -- worth ~17 sends, and the old default of 24 was close
                            -- enough to that to start clipping on a slow frame.
                            limit = math.min(math.floor(num(CFG.OneShotBurst, 48)), fresh)
                        end
                        if limit > avail then limit = avail end
                        if limit < 0 then limit = 0 end

                        -- Order only matters when we cannot afford everything in the
                        -- pool. `limit >= pn` means every nape gets a send regardless
                        -- of position, so the sort is pure cost — which at 60 fps was
                        -- an O(n log n) pass and a fresh closure sixty times a second.
                        if pn > 1 and limit < pn then
                            -- Reachable napes take every slot before an unreachable one
                            -- gets any, and only then does the one-shot / lowest-health
                            -- ordering apply. Sorting purely by health is correct while
                            -- the pool is all reachable, but with HitRange opened up it
                            -- would hand the whole pulse to the weakest titans ANYWHERE
                            -- on the map — the ones most likely to be out of reach.
                            K.SORT.range = WORK_RANGE
                            -- Drop out of breadth-spreading the moment shotObserve
                            -- reports the current titans are not dying to one hit.
                            -- That detector used to only LOG "multi-hit titans" and
                            -- change nothing, so the pulse kept chipping every nape
                            -- and finishing none.
                            K.SORT.mode  = (ONE_SHOT and not SHOT.grind) and "oneshot" or "grind"
                            table.sort(pool, K.poolLess)
                        end

                        local hitList, hn = {}, 0
                        for i = 1, math.min(pn, limit) do
                            if sendHit(pool[i].nape, vel, td) then
                                fired = fired + 1
                                hn = hn + 1
                                hitList[hn] = pool[i]
                                if ONE_SHOT then STRUCK[pool[i].model] = now end
                            end
                        end
                        -- Charge the bucket for what actually left the client, not
                        -- for what the pulse intended: rateAllow() can refuse a send
                        -- at the ceiling, and paying for a refused send would slow
                        -- the next pulse for traffic that never happened.
                        K.spend(fired)
                        shotObserve(hitList, hn)
                        if ONE_SHOT then
                            -- Bounded sweep: entries only live K.STRUCK_TTL, and models
                            -- that left the folder must not pin a reference.
                            for m, t in pairs(STRUCK) do
                                if (now - t) >= park or not m.Parent then STRUCK[m] = nil end
                            end
                        end

                    end

                    -- ── HitAll sweep ──────────────────────────────────────
                    -- Everything the pulse above could not reach. Rather than
                    -- picking a cluster and flying to it -- which is where the
                    -- 53 seconds went -- visit every remaining nape directly,
                    -- one frame each, and come back to the anchor.
                    --
                    -- Not during objective steering: on Thunder Spear and
                    -- Escort maps the character's position IS the objective, so
                    -- leaving the convoy to tour the map fails the mission.
                    if sweepOn and not parkOverride and not filterFn
                       and now >= SWEEP.next and n > pn
                       and pn == 0
                       and (now - pulseIdleAt) >= num(CFG.HitAllSweepIdle, 1.5) then
                        local out, oc = {}, 0
                        for i = 1, n do
                            local e = buf[i]
                            local t = STRUCK[e.model]
                            if e.dist > WORK_RANGE
                               and (t == nil or (now - t) >= K.STRUCK_TTL) then
                                oc = oc + 1
                                out[oc] = e
                            end
                        end
                        if oc > 0 then
                            -- Nearest first: the sweep can be cut short by a
                            -- death, a respawn, or the mission ending, and the
                            -- near ones are the ones the next pulse would have
                            -- reached anyway.
                            table.sort(out, function(a, b) return a.dist < b.dist end)
                            local maxT = math.min(oc, math.floor(num(CFG.HitAllSweepMax, 40)))
                            local home = hrp.Position
                            local swept = hitAllSweep(hrp, hum, out, maxT, vel, td, home,
                                                      WORK_RANGE)
                            -- Only the ones it actually reached. A sweep can
                            -- return early (dead, running, blade break, budget,
                            -- damage taken) having sent nothing, and stamping
                            -- the whole candidate list then hides untouched
                            -- titans from the next pulse for a full cooldown.
                            maxT = math.min(maxT, swept)
                            -- os.clock() again, not `now`: the sweep yielded for
                            -- a frame per nape, so `now` is a second stale here.
                            local after = os.clock()
                            for i = 1, maxT do
                                if out[i] and out[i].model then STRUCK[out[i].model] = after end
                            end
                            -- A sweep that ended in damage gets a longer leash:
                            -- the character needs the normal loop to pull it back
                            -- to a safe anchor before touring again.
                            SWEEP.next = after + (SWEEP.hurt and 3
                                                  or num(CFG.HitAllSweepInterval, 0.3))
                            SWEEP.hurt = false
                            -- Deliberately NOT added to `fired`. `fired` feeds
                            -- tunerObserve below, which hill-climbs on
                            -- damage-per-hit; handing it 40 sweep sends whose
                            -- credit we cannot observe trains it to SLOW the
                            -- normal pulse in response to the sweep. The sweep
                            -- already paid its cost in wall-clock, so it needs
                            -- no pacing charge on top.
                            SWEEP.visited = swept
                            if swept > 0 then
                                setAction("HitAll sweep — %d napes visited", swept)
                            end
                        else
                            SWEEP.next = now + num(CFG.HitAllSweepInterval, 0.3)
                        end
                    end

                    -- Pace the NEXT pulse by what this one actually cost, not by a
                    -- fixed interval.
                    --
                    -- The interval was sized for a full pulse — cap targets every
                    -- COMBAT.hit seconds. But measured live, only ONE titan is
                    -- inside the credited radius at a time (16 alive, median 2,489
                    -- studs away), so a pulse fires once and then waits out an
                    -- interval budgeted for ten. That spends ~10 sends/sec out of
                    -- ~100 available and leaves 90% of the budget unused.
                    --
                    -- Charging only for what was sent lets a one-target pulse come
                    -- back as soon as the loop can serve it, while a full pulse
                    -- still paces exactly as before. Nothing here raises the
                    -- ceiling; rateAllow still caps the total.
                    -- (The pace calculation that used to live here is gone. It
                    -- charged the next pulse `fired / hitBudget` seconds of delay
                    -- and then rounded that up to the next frame boundary, which
                    -- is where a third of the send budget was going at 5 fps. The
                    -- bucket in §21a does the same accounting in wall-clock
                    -- seconds, is charged above by K.spend(fired), and cannot be
                    -- rounded up by the frame rate.)

                    -- ── Hit-range calibration ─────────────────────────────────
                    -- CREDITED_RANGE was never measured. It arrived as "~400" and
                    -- every later decision inherited it, including the refusal to
                    -- raise HitRange. But `Hitboxes` appears in NONE of this build's
                    -- client scripts, so there is nothing client-side to read the
                    -- real radius off, and the number was only ever a guess.
                    --
                    -- It matters more than it looks. Sampled live on Chapel, the
                    -- distance histogram of 30 alive titans is:
                    --     0-199:99  200-399:50  400-599:122  600-799:80 ...
                    -- Only ~1.75 titans sit inside 380 studs, but the 400-599 shell
                    -- holds MORE titans than the whole interior. If the true radius
                    -- is 600 rather than 400, reachable targets go 1.75 -> ~3.3 and
                    -- the shared send budget finally has somewhere to go.
                    --
                    -- So measure it instead of assuming. Pick one ISOLATED titan
                    -- just beyond the current working range, send only to it, and
                    -- watch its own health. Isolation plus solo-only means a health
                    -- drop can only have come from our probe.
                    if CALIB.on and now >= CALIB.next and pn > 0 then
                        if CALIB.pending then
                            -- Resolve the previous probe.
                            local t = CALIB.pending
                            local hpNow = (t.hum and t.hum.Parent) and t.hum.Health or nil
                            if hpNow == nil then
                                -- Target died or despawned: unusable, not a failure.
                                CALIB.pending = nil
                                CALIB.next = now + 3
                            elseif hpNow < t.hp0 - 0.5 then
                                WORK_RANGE = math.min(num(CFG.HitRangeCeiling, 1200),
                                              math.max(WORK_RANGE, math.floor(t.dist) + 20))
                                CALIB.fails = 0
                                CALIB.pending = nil
                                CALIB.next = now + 4
                                log("RANGE", ("credited at %.0f studs — working range now %d")
                                    :format(t.dist, WORK_RANGE))
                            else
                                CALIB.fails = CALIB.fails + 1
                                CALIB.pending = nil
                                CALIB.next = now + 4
                                if CALIB.fails >= 3 then
                                    -- Settle here for now, but do NOT give up for the
                                    -- session: the radius that matters is per-map and
                                    -- per-build, and a bot that ran its three probes
                                    -- inside one bad map would keep a wrong number for
                                    -- hours. Sleep it off and re-measure.
                                    CALIB.fails = 0
                                    CALIB.next  = now + 90
                                    log("RANGE", ("no credit past %d studs after 3 probes — "
                                        .. "settling there, re-measuring in 90s"):format(WORK_RANGE))
                                end
                            end
                        else
                            -- Only trust a probe when nobody else can be damaging it.
                            if #Players:GetPlayers() > 1 then
                                -- Another player's damage is indistinguishable from
                                -- ours, so a probe now proves nothing. They leave;
                                -- re-check rather than disabling for the session.
                                CALIB.next = now + 30
                                if not CALIB.warned then
                                    CALIB.warned = true
                                    log("RANGE", "not solo — hit-range calibration paused")
                                end
                            else
                                local lo, hi = WORK_RANGE * 1.05, WORK_RANGE * 1.55
                                local pick = nil
                                for i = 1, n do
                                    local e = buf[i]
                                    if e.dist > lo and e.dist < hi and e.hp > 0 then
                                        -- Isolated: no other live titan near it, so a
                                        -- splash or a stray pulse cannot be credited here.
                                        local lonely = true
                                        for j = 1, n do
                                            if j ~= i then
                                                local o = buf[j]
                                                if o.hp > 0
                                                   and (o.root.Position - e.root.Position).Magnitude < 250 then
                                                    lonely = false
                                                    break
                                                end
                                            end
                                        end
                                        if lonely and (not pick or e.dist < pick.dist) then pick = e end
                                    end
                                end
                                if pick then
                                    if pick.hum then
                                        CALIB.pending = { hum = pick.hum, hp0 = pick.hum.Health,
                                                          dist = pick.dist }
                                        for _ = 1, 3 do sendHit(pick.nape, vel, td) end
                                        CALIB.next = now + 0.7
                                    end
                                else
                                    CALIB.next = now + 3
                                end
                            end
                        end
                    end

                    tunerObserve(totalHealth, fired)
                    if K.focusOn() then
                        if pn > 0 then
                            setAction("Volley — %d alive · %.1f hits/s · %d kills",
                                pn, K.focusRate(now), K.FOCUS.kills)
                        end
                    elseif fired > 0 then
                        setAction("Aura kill — %d in range, %d hit", pn, fired)
                    end
                    actorCmd("reset")
                end
            end
        end
        end)
        if ok then break end
        -- Back off on repeats so a persistently broken frame cannot spin the
        -- CPU at loop rate across the whole fleet.
        local t = os.clock()
        if t - crashWindow > 60 then crashes, crashWindow = 0, t end
        crashes = crashes + 1
        log("COMBAT", ("loop error (%d in this minute) — restarting: %s")
            :format(crashes, tostring(err)))
        task.wait(math.min(5, 0.25 * crashes))
    end

end

-- ═══════════════════════════════════════════════════════════════════════════
-- 32 · PERK STORAGE
--     Bulk delete first, verify against the local save, and only fall back to
--     one-at-a-time for whatever survived. v9 always ran the per-UUID loop
--     after the bulk call, which on a full storage was ~1000 extra remotes for
--     nothing.
-- ═══════════════════════════════════════════════════════════════════════════
-- Circuit breaker. If the delete call demonstrably does nothing, stop calling
-- it: the observed failure mode was "selling 30 / bulk left 30 / done — 30
-- remaining", then the pre-mission safety pass repeating the same thing, every
-- lobby visit forever. That is 60+ rejected remotes per cycle and it never
-- converges, so the bot re-enters the mission with storage still full.
K.PERK_SELL = { fails = 0, disabled = false }

-- The verdict has to OUTLIVE THE MISSION.
--
-- Every mission is a separate server, so the Lua VM — and with it
-- K.PERK_SELL.fails and _G.VCP_PerkSellDisabled — is destroyed between runs.
-- The breaker would trip in the lobby, the bot would teleport into a mission
-- with a clean slate, decide "perk storage 30/30, go and sell", and make the
-- whole round-trip again. Observed live: Delete returned nothing 30 times, bulk
-- and individual, and the bot still left for the lobby every few runs to repeat
-- it. Writing it to disk is what makes the breaker mean anything.
local function perkSellBlock()
    _G.VCP_PerkSellDisabled = true
    K.PERK_SELL.disabled = true
    pcall(function() if EXEC.writefile then EXEC.writefile(K.PERK_FILE, "off") end end)
end

local function sellPerks(reason)
    if K.PERK_SELL.disabled or K.perkSellBlocked() then return 0 end

    local uuids = STATE.perkUUIDs
    if type(uuids) ~= "table" or #uuids == 0 then return 0 end
    local wanted = #uuids

    setAction("Selling %d perks", wanted)
    log("PERK", ("selling %d (%s)"):format(wanted, reason or "threshold"))

    local bulkOK = eqInvoke(4, "Delete", "Perk", uuids) ~= nil

    -- Wait for the delete to REPLICATE, not merely to dent the count. The old
    -- predicate was `perksSellable < wanted`, which a partially-replicated
    -- success satisfies — so a bulk delete that was working fell straight
    -- through into the fallback below and did the whole job again by hand.
    waitUntil(function()
        refreshState(true)
        -- A READABLE Storage with nothing left in it is authoritative here.
        --
        -- refreshState refuses to write a zero over a known-good perk count
        -- ("never let a momentarily-empty read wipe a known-good count") --
        -- and that guard is right, it defends against a blank Cache.Data
        -- candidate. But it keys on the TOTAL, and on an account with no perk
        -- equipped a FULLY SUCCESSFUL sale is exactly what drives the total to
        -- zero. So the best possible outcome read back as the worst one:
        -- STATE.perksSellable stayed stale at `wanted`, `sold` computed to 0,
        -- and two of those trip the circuit breaker that disables perk selling
        -- on disk for the account. Accounts with >=1 perk equipped never saw
        -- it, because that entry keeps the total above zero.
        --
        -- The type checks are what keep the §15 guard meaningful: only a
        -- Storage that reads back as a real, empty table counts. A failed or
        -- partial save read leaves it nil and falls through unchanged.
        local s = getSlot()
        if type(s) == "table" and type(s.Perks) == "table"
           and type(s.Perks.Storage) == "table"
           and next(s.Perks.Storage) == nil then
            STATE.perksTotal    = 0
            STATE.perksSellable = 0
            STATE.perkUUIDs     = {}
            return true
        end
        return STATE.perksSellable == 0
    end, 3, 0.25)

    if STATE.perksSellable > 0 and bulkOK then
        -- BOUNDED BY WALL CLOCK, AND CHUNKED.
        --
        -- invoke polls with a bare task.wait(), so every eqInvoke costs at
        -- least one whole FRAME — 200ms at the 5fps cap — even when the server
        -- answers instantly, and jwait costs another. That is ~400ms per call
        -- against ~20ms at 60fps: a twentyfold change in the cost of this loop
        -- caused purely by the frame cap. PerkSellTarget derives to 1000 on
        -- Severe and above, and runLobby is single-threaded, so one uuid per
        -- call was up to ~400 SECONDS parked in the lobby creating no missions.
        --
        -- Six seconds, twenty-five uuids a call, and resume on the next pass:
        -- the lobby loop re-enters every second, so even a full storage drains
        -- inside one visit rather than one visit per fifty perks.
        local remaining = STATE.perkUUIDs
        log("PERK", ("bulk left %d — retrying in chunks"):format(#remaining))
        local deadline, misses, i = os.clock() + 6, 0, 1
        while i <= #remaining and os.clock() < deadline do
            local batch = {}
            for j = i, math.min(i + 24, #remaining) do batch[#batch + 1] = remaining[j] end
            if eqInvoke(2, "Delete", "Perk", batch) == nil then
                misses = misses + 1
                -- Two rejected chunks is the endpoint refusing the call, not
                -- bad luck. Another forty repeats of an identical rejected
                -- remote cannot succeed where the first two did not.
                if misses >= 2 then break end
            else
                misses = 0
            end
            i = i + 25
            jwait(0.12, 0.08)
        end
        refreshState(true)
    elseif STATE.perksSellable > 0 then
        -- The bulk call was rejected outright. Repeating it per-uuid is the
        -- same remote with a shorter list; it fails identically and costs a
        -- frame each time. Let the circuit breaker below count this instead.
        log("PERK", ("bulk Delete was rejected (ns=%s) — not retrying per-uuid")
            :format(eqNamespace()))
    end

    local sold = wanted - STATE.perksSellable
    log("PERK", ("done — %d remaining"):format(STATE.perksSellable))

    if sold <= 0 then
        -- Count across VMs, not within one: see K.perkFailsLoad.
        K.PERK_SELL.fails = math.max(K.PERK_SELL.fails, K.perkFailsLoad()) + 1
        K.perkFailsSave(K.PERK_SELL.fails)
        if K.PERK_SELL.fails >= 2 then
            -- Also stop LEAVING for perks. Otherwise the mission side keeps
            -- deciding "storage full -> go sell", the lobby cannot sell, and
            -- every single run ends in a pointless round-trip to the lobby
            -- instead of a free Retry. Written to disk so it survives the
            -- teleport into the next mission.
            perkSellBlock()
            log("PERK", ("delete is being rejected (ns=%s) — disabling perk selling AND "
                .. "the leave-for-perks trigger for this session. Farming continues on Retry.")
                :format(eqNamespace()))
        end
    else
        K.PERK_SELL.fails = 0
        K.perkFailsSave(0)
    end

    return sold
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 33 · EQUIPMENT UPGRADES
--     GET("Equipment","Upgrade", <list>) steps EVERY affordable stat in the
--     non-nil; nil means capped or out of gold. Loop until it stops paying.
-- ═══════════════════════════════════════════════════════════════════════════
-- The hardcoded 8-name list is gone. Upgrades are PER WEAPON — the save holds
-- Upgrades.Blades and Upgrades.Spears with eight stats each, and Get_Stat_Total
-- only ever indexes Upgrades[Weapon] — so a fixed blade list is wrong the
-- moment the loadout changes. Read the stat names out of the save instead.
--
-- Note also what a damage-first ORDER would have been worth: nothing. The
-- game's own Equipment UI sorts the array ASCENDING BY CURRENT LEVEL before
-- sending it (cheapest first), the server consumes the whole array as a batch,
-- and a POTENTIAL GATE locks any stat at level >= floor(mean of all eight) + 2.
-- Uniform buying is structurally forced; you cannot starve ODM_Gas to fund
-- ODM_Damage, because doing so would lock ODM_Damage.
local function weaponUpgrades()
    local slot   = STATE.slot or getSlot()
    local weapon = (slot and slot.Weapon) or "Blades"
    local tbl    = slot and slot.Upgrades and slot.Upgrades[weapon]
    if type(tbl) ~= "table" then return nil, weapon end
    return tbl, weapon
end

local function runUpgrades()
    if not CFG.AutoUpgrade then return end

    local upg, weapon = weaponUpgrades()
    local names, maxed = {}, true
    local cap = num((MOD.Values or {}).Maximum_Upgrades, 15)

    if upg then
        for stat, lvl in pairs(upg) do
            names[#names + 1] = stat
            if (tonumber(lvl) or 0) < cap then maxed = false end
        end
        -- Cheapest-first, matching what the game's own "All" button sends.
        table.sort(names, function(a, b)
            return (tonumber(upg[a]) or 0) < (tonumber(upg[b]) or 0)
        end)
    else
        maxed = false
    end

    if #names == 0 then return end

    -- Every stat already at Maximum_Upgrades means this call can never succeed
    -- again. On the live account all eight Blades stats are at 15/15, so this
    -- was one guaranteed-nil remote per lobby visit forever.
    if maxed then
        if not _G.VCP_UpgradeMaxNoted then
            _G.VCP_UpgradeMaxNoted = true
            log("UPGRADE", ("%s fully capped at %d/%d on all %d stats — nothing left to buy")
                :format(weapon, cap, cap, #names))
        end
        return
    end

    setAction("Upgrading equipment")
    local applied = 0
    for _ = 1, 40 do
        if eqInvoke(3, "Upgrade", names) == nil then break end
        applied = applied + 1
        jwait(0.08, 0.05)
    end
    if applied > 0 then
        log("UPGRADE", ("%d batch steps applied to %s"):format(applied, weapon))
        refreshState(true)
    end
end

