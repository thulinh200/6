-- 11 · REMOTE BRIDGE
--     GET  (RemoteFunction) — request/response
--     POST (RemoteEvent)    — fire-and-forget combat and reload
--     Confirmed present on 2193 at ReplicatedStorage.Assets.Remotes.
-- ═══════════════════════════════════════════════════════════════════════════
local Assets  = waitChild(ReplicatedStorage, "Assets", 20)
local Remotes = Assets and waitChild(Assets, "Remotes", 20)
local GET     = Remotes and waitChild(Remotes, "GET", 12)
local POST    = Remotes and waitChild(Remotes, "POST", 12)

if not GET then
    log("BOOT", "GET remote missing — the game's remote layout changed. Halting.")
    return
end

-- A clean, un-hooked FireServer reference. Both executors and the game hook
-- the namecall path; holding a cloned pointer keeps combat traffic out of
-- whatever anyone else installed there.
local RAW_FIRE
pcall(function()
    if POST then RAW_FIRE = EXEC.clonefunction(POST.FireServer) end
end)

-- InvokeServer with a deadline. A bare invoke blocks its thread forever when
-- the server never answers, and on a busy server that wedges whichever
-- subsystem made the call. Polling a spawned thread is the only shape of this
-- that behaves identically across executors.
local function invoke(timeout, ...)
    local args = table.pack(...)
    local done, ok, res = false, false, nil
    task.spawn(function()
        local s, r = pcall(function() return GET:InvokeServer(EXEC.unpack(args, 1, args.n)) end)
        ok, res, done = s, r, true
    end)
    local deadline = os.clock() + (timeout or 5)
    while not done and os.clock() < deadline do task.wait() end
    -- SECOND RETURN VALUE: WHY it is nil.
    --
    -- A deadline that expired and a server that genuinely answered nil are
    -- completely different facts, and collapsing them into a bare nil is what
    -- lets createMission read a slow round trip as "this difficulty is not
    -- available" and then persist the downgrade. Callers that do not care take
    -- the first value and are unaffected.
    if not done then return nil, "timeout" end
    if not ok   then return nil, "error"   end
    return res, "ok"
end

-- The equipment namespace changed. Every Upgrade/Unlock/State/Delete call in
-- this game's own decompiled UI goes to "Equipment"; the string "S_Equipment"
-- does not appear in any of the 310 client scripts on the live build, even
-- though every version of this script has been sending it. That is the most
-- likely reason perk Delete was being silently rejected.
--
-- Rather than hardcode a guess, learn it: try "Equipment", fall back to
-- "S_Equipment" ONCE, and cache whichever the server actually answers. After a
-- single failed probe we stop double-firing, so a legitimately-nil result (out
-- of gold, already capped) never costs a second remote.
local EQ_NS, EQ_PROBED = nil, false

local function eqInvoke(timeout, action, ...)
    -- Deliberately NOT a tail call: invoke returns a reason alongside the
    -- result now, and forwarding two values out of here would change what
    -- every eqInvoke call site sees in an argument list or a constructor.
    if EQ_NS then
        local r = invoke(timeout, EQ_NS, action, ...)
        return r
    end

    local r = invoke(timeout, "Equipment", action, ...)
    if r ~= nil then
        EQ_NS = "Equipment"
        return r
    end
    if EQ_PROBED then return nil end

    local r2 = invoke(timeout, "S_Equipment", action, ...)
    if r2 ~= nil then
        EQ_NS = "S_Equipment"
        return r2
    end
    EQ_PROBED = true
    return nil
end

local function eqNamespace() return EQ_NS or (EQ_PROBED and "unresolved" or "unprobed") end

local function post(...)
    if not POST then return false end
    if RAW_FIRE then
        if pcall(RAW_FIRE, POST, ...) then return true end
    end
    -- pcall forwards the varargs itself, so no wrapper closure is needed —
    -- and a wrapper could not see `...` anyway.
    return (pcall(POST.FireServer, POST, ...))
end

