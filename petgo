            avatar_url = (type(CFG.WebhookAvatar) == "string") and CFG.WebhookAvatar or nil,
            embeds = { {
                author = {
                    name     = (disp == name) and ("@" .. name) or ("%s (@%s)"):format(disp, name),
                    icon_url = ("https://www.roblox.com/headshot-thumb/image"
                                .. "?userId=%d&width=150&height=150&format=png"):format(plr.UserId),
                },
