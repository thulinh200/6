-- 12 · GAME DATA MODULES
--     Everything the game knows about difficulties, items, quests, skills and
--     talents lives in ReplicatedStorage.Modules.Storage. Reading it is free
--     and always current, which is the whole reason v10 stops hardcoding.
-- ═══════════════════════════════════════════════════════════════════════════
local MOD = setmetatable({}, {
    __index = function(t, name)
        local v = nil
        pcall(function()
            local mods = ReplicatedStorage:FindFirstChild("Modules")
            local storage = mods and mods:FindFirstChild("Storage")
            local m = storage and storage:FindFirstChild(name)
            if m and m:IsA("ModuleScript") then v = require(m) end
        end)
        rawset(t, name, v or false)
        return v or false
    end,
})

