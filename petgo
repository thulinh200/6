-- One rolled family. kind: "roll" (WebhookRollRarity or rarer) | "wanted" | "stored"
function K.whRoll(kind, family, st, n, where)
    local rar   = K.famRarityOf(family) or "?"
    local title = (kind == "wanted") and ("⭐ %s (%s) — keeping it")
               or (kind == "stored") and ("📦 %s (%s) — stored, rolling on")
               or "🎲 Rolled %s (%s)"
    K.whCard(title:format(tostring(family), rar), {
        { "Prestige",   STATE.prestige },
        { "Spins left", comma(st.spins) },
        { "Gems",       comma(st.gems) },
        { "Pity",       ("%d / 400"):format(num(st.pity)) },
    }, K.WH_RARITY[rar:lower()] or 0x9CA3AF, ("Roll #%d this session · %s"):format(n, where))
end

K.WH_ROLL_END = {
