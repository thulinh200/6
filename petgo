                "Chờ Family Roll", U.C.ok, 13, Enum.Font.GothamMedium)
            U.new("Frame", { BackgroundColor3 = U.C.rule, BackgroundTransparency = 0.88,
                BorderSizePixel = 0, Position = UDim2.new(0, 20, 0, 79),
                Size = UDim2.new(1, -40, 0, 1), Active = false }, panel)
            local function metric(name, x, y, title)
                label(name .. "Label", UDim2.new(0, x, 0, y), UDim2.new(0, 120, 0, 17), title, U.C.dim, 11)
                return label(name, UDim2.new(0, x, 0, y + 17), UDim2.new(0, 150, 0, 23), "--", U.C.text, 16, Enum.Font.RobotoMono)
            end
            local family = metric("Family", 20, 94, "FAMILY HIỆN TẠI")
            local rarity = metric("Rarity", 315, 94, "ĐỘ HIẾM")
            local gems = metric("Gems", 20, 145, "GEMS CÒN")
            local spins = metric("Spins", 165, 145, "SPIN CÒN")
            local pity = metric("Pity", 315, 145, "PITY")
            local storage = metric("Storage", 445, 145, "KHO FAMILY")
            local rolled = metric("Rolled", 20, 196, "ĐÃ QUAY")
            local spent = metric("Spent", 165, 196, "GEMS ĐÃ CHI")
            label("HistoryTitle", UDim2.new(0, 20, 0, 247), UDim2.new(1, -40, 0, 22),
                "LỊCH SỬ FAMILY GẦN NHẤT", U.C.accent, 12, Enum.Font.GothamBold)
            local history = {}
            for i = 1, 12 do
                history[i] = label("History" .. i, UDim2.new(0, 20, 0, 272 + (i - 1) * 12),
                    UDim2.new(1, -40, 0, 12), "", U.C.text, 10, Enum.Font.RobotoMono)
                history[i].Visible = false
            end
            label("Footer", UDim2.new(0, 20, 1, -24), UDim2.new(1, -40, 0, 14),
                "UI dùng dữ liệu save/server thật · lịch sử tối đa 12 lượt", U.C.faint, 10)
            K.FAMUI.refs = { gui = gui, status = status, family = family, rarity = rarity,
                gems = gems, spins = spins, pity = pity, storage = storage,
                rolled = rolled, spent = spent, history = history }
            K.FAMUI.built = true
            K.famUIRefresh()
        end)
        if not ok then log("UI", "family roll panel failed: " .. tostring(err)) end
    end

    function K.buildStatusUI()
        if K.UI.built or CFG.StatusUI == false then return end
        K.UI.built = true

        local ok, buildErr = pcall(function()
            local host
            if typeof(gethui) == "function" then host = gethui() end
            host = host or plr:FindFirstChildOfClass("PlayerGui")
            if not host then return end

            local gui = U.new("ScreenGui", {
                Name = "VCP_Field",
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
                DisplayOrder = 999,
            }, host)

            -- NOTHING in here is Active and nothing is a button. The bot drives
            -- the game's own summary screen with synthesised mouse input at
            -- real screen coordinates, and an overlay that captured a click
            -- would break the farm rather than merely look wrong.
            local veil = U.new("Frame", {
                BackgroundColor3 = U.C.veil,
                -- Nearly opaque on purpose. The scene behind is bright ice and
                -- fog; at 0.22 every label on top of it was grey-on-grey. The
                -- bot is playing the game, not the reader, so the view behind
                -- is worth less than being able to read this at a glance.
                BackgroundTransparency = 0.12,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 1, 0),
                Active = false,
            }, gui)
            -- Darkest through the middle band, where the content sits, easing
            -- off at the very top and bottom so the frame does not read as a
            -- hard-edged box laid over the screen.
            U.new("UIGradient", {
                Rotation = 90,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.22),
                    NumberSequenceKeypoint.new(0.5, 0),
                    NumberSequenceKeypoint.new(1, 0.22),
                }),
            }, veil)

            local root = U.new("Frame", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.new(0, U.W, 0, U.H),
                Active = false,
