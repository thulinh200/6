-- ═══════════════════════════════════════════════════════════════════════════
-- Seed the RNG PER CLIENT, not per boot. Thirty clients started together read
-- near-identical os.clock() values, so a clock-only seed hands all of them the
-- same "random" jitter and they stay in lockstep — which is exactly what every
-- jitter in this file exists to prevent. UserId is the one value guaranteed to
-- differ, so it is what decorrelates the fleet.
local plr = Players.LocalPlayer
if not plr then
    waitUntil(function() plr = Players.LocalPlayer; return plr end, 12)
end
if not plr then return end

pcall(function()
    local uid = tonumber(plr.UserId) or 0
    math.randomseed((math.floor(os.clock() * 1e6) % 1000003) + (uid % 100003) * 1013)
    for _ = 1, 3 do math.random() end   -- discard the first draws of a fresh seed
end)

local STATE = {
    startedAt   = os.time(),
    action      = "Booting",
    placeId     = game.PlaceId,
    level       = 0, prestige = 0, xp = 0, maxXp = 0,
