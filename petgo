-- 40 · TITLE SCREEN
--     Click through to slot select and teleport to the lobby.
-- ═══════════════════════════════════════════════════════════════════════════
local function runTitle()
    setAction("Title screen")

    local function reallyVisible(gui)
        local cur = gui
        while cur and cur:IsA("GuiObject") do
            if not cur.Visible then return false end
            cur = cur.Parent
        end
        return true
    end

    local function clickGui(element)
        if not element then return false end
        local btn = element
        if not btn:IsA("GuiButton") then
            local cur = element.Parent
            for _ = 1, 3 do
                if not cur then break end
                if cur:IsA("GuiButton") then btn = cur break end
                cur = cur.Parent
            end
        end
        if btn:IsA("GuiButton") then
            for _, c in ipairs(safeConns(btn.MouseButton1Click)) do pcall(function() c:Fire() end) end
            for _, c in ipairs(safeConns(btn.Activated))        do pcall(function() c:Fire() end) end
        end
        pcall(function()
            local inset = GuiService:GetGuiInset()
            VirtualUser:ClickButton1(Vector2.new(
                element.AbsolutePosition.X + element.AbsoluteSize.X / 2,
                element.AbsolutePosition.Y + element.AbsoluteSize.Y / 2 + inset.Y))
        end)
        return true
    end

    -- The lobby sends the bot here when rolls only work on the title screen.
    pcall(K.famTitle)

    while alive() and game.PlaceId == PLACE.TITLE do
        pcall(function()
            local gui = plr:FindFirstChild("PlayerGui")
            if gui then
                for _, v in ipairs(gui:GetDescendants()) do
                    if (v:IsA("TextButton") or v:IsA("TextLabel")) and reallyVisible(v) then
                        local txt = tostring(v.Text):upper():match("^%s*(.-)%s*$") or ""
                        if txt == "PLAY" or txt == "SELECT" then
                            clickGui(v)
                            task.wait(0.4)
                            break
                        end
                    end
                end
            end
            invoke(4, "Functions", "Select", CFG.TargetSlot)
            task.wait(0.8)
            invoke(4, "Functions", "Teleport", "Lobby")
        end)
        -- Poll for the place change rather than sleeping a flat 10s.
        waitUntil(function() return game.PlaceId ~= PLACE.TITLE end, 12, 0.4)
        task.wait(2)
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 41 · TELEMETRY
--     Disk-backed so a teleport never shows zeroes, and rate-derived so the
--     speed change is measurable instead of assumed.
-- ═══════════════════════════════════════════════════════════════════════════
K.CACHE_FILE = "VCPlusHub_Cache_" .. tostring(plr.UserId) .. ".json"

-- ── Account status, decided in the lobby and carried into missions ─────────
--
-- WHY THIS LIVES HERE. Whether the account is active or banned cannot be judged
-- reliably inside a mission: the save arrives late through the actor bridge if
-- at all, and several of the player attributes that carry moderation state are
-- simply not set on the mission DataModel. The lobby has the full save and every
-- attribute replicated normally, so the verdict is DECIDED there, stamped with a
-- time and a source, and written to disk. A mission then reports the saved value
-- instead of guessing from data it does not have. Both tables are declared before
-- saveCache/loadCache so those can persist and restore them.
K.STATUS = { at = 0, src = nil, saved = 0 }
-- The earnings checkpoint. Used only for an informational "gold has not moved"
-- LOG line now — it no longer sets the account status. Ban status is decided by
-- the blacklist alone (see K.assessLobby).
K.EARN = { gold = nil, missions = nil }

local function saveCache()
    if not EXEC.writefile then return end
    pcall(function()
        EXEC.writefile(K.CACHE_FILE, HttpService:JSONEncode({
            Level    = STATE.level,
            Prestige = STATE.prestige,
            Gold     = STATE.gold,
            Gems     = STATE.gems,
            TS       = spearsComplete(STATE.inventory) or false,
            SB       = STATE.accountOk,
            SBAt     = K.STATUS.at,       -- when the verdict was last decided
            SBSrc    = K.STATUS.src,      -- "lobby" | "menu" | "earnings"
            EarnGold = K.EARN.gold,       -- earnings-log checkpoint (informational)
            EarnMiss = K.EARN.missions,
            Family   = STATE.family,
            Spins    = STATE.spins,
        }))
    end)
end

local function loadCache()
    if not (EXEC.isfile and EXEC.readfile) then return end
    pcall(function()
        if not EXEC.isfile(K.CACHE_FILE) then return end
        local d = HttpService:JSONDecode(EXEC.readfile(K.CACHE_FILE))
        if STATE.level    == 0 then STATE.level    = num(d.Level)    end
        if STATE.prestige == 0 then STATE.prestige = num(d.Prestige) end
        if STATE.gold     == 0 then STATE.gold     = num(d.Gold)     end
        if STATE.gems     == 0 then STATE.gems     = num(d.Gems)     end
        if STATE.spins    == 0 then STATE.spins    = num(d.Spins)    end
        -- The account-status verdict and its metadata. A verdict is only trusted
        -- if it carries PROVENANCE (a real SBAt timestamp from this build's lobby
        -- check). A cached "flagged" written by an older build — which flagged on
        -- Trades==0 / a non-Player Role from inside a mission, where those reads
        -- are unreliable — has no SBAt, so restoring it would carry a stale false
        -- positive forever (an account that clearly earns gold reading FLAGGED).
        -- Without provenance, start Unknown and let the lobby decide fresh.
        if STATE.accountOk == nil and tonumber(d.SBAt) then STATE.accountOk = d.SB end
        if tonumber(d.SBAt) then K.STATUS.at = tonumber(d.SBAt); K.STATUS.saved = K.STATUS.at end
        if type(d.SBSrc) == "string" then K.STATUS.src = d.SBSrc end
        if tonumber(d.EarnGold) then K.EARN.gold     = tonumber(d.EarnGold) end
        if tonumber(d.EarnMiss) then K.EARN.missions = tonumber(d.EarnMiss) end
        if (STATE.family == "None" or not STATE.family) and d.Family then
            STATE.family = tostring(d.Family)
        end
    end)
end
loadCache()

-- Session rates. Gold and XP baselines are captured on the first read that
-- actually has data, not at boot, so a slow save load does not inflate them.
local function rates()
    local elapsed = math.max(1, os.time() - STATE.startedAt)
    local hours   = elapsed / 3600
    if STATE.goldAtStart == nil and STATE.gold > 0 then STATE.goldAtStart = STATE.gold end
    local goldGained = (STATE.goldAtStart and STATE.gold > STATE.goldAtStart)
        and (STATE.gold - STATE.goldAtStart) or 0
    return {
        elapsed  = elapsed,
        goldHr   = goldGained / hours,
        killsHr  = STATE.kills / hours,
        missionHr= STATE.missions / hours,
    }
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 41a · STATUS LINE
--     One comma-joined line, field order fixed, each field individually
--     switchable through CFG.Display. Counts are printed in full with
--     thousands separators rather than abbreviated, because these are numbers
--     people compare between accounts.
--
--     🛡️ Status: Active, 🧬 Family: Ackerman, 🎖️ Level: 150,
--     👑 Prestige: 2, 💰 Gold: 62,610,738, 💎 Gems: 3,397, 🎰 Spins: 0,
--     🚀 Thunder Spear: Ready, 📦 Emperor's Key: 3
-- ═══════════════════════════════════════════════════════════════════════════

-- Account status.
--
--     v9 read plr:GetAttribute("Blacklisted") and ("Trades"). Neither exists
--     in this build. The live attribute set is: Added, Extra, First_Time,
--     Group, Level, Max_Refills, Refills, Role, Shield, Slot, Stat, Streak,
--     Title, Weapon. So v9's ban indicator was never reading anything — it
--     showed "normal" because both lookups returned nil and its expression
--     defaulted that way.
--
--     Those two names are still checked first, costing nothing, so this starts
--     working by itself if the game ever adds them. Failing that, Role is a
--     real attribute and a non-Player value is a genuine signal. Otherwise the
--     honest statement is "the save loaded and the account is playing", which
--     is what Active means here — not "verified unbanned".
--
--     The actual earnings check lives in checkEarnings() below; that is the
--     thing this field was always pretending to be.
-- BLACKLIST ONLY. The only thing that marks an account BANNED is the blacklist:
-- a "Blacklisted" player attribute set true, or a Blacklisted field in the save.
-- Every other heuristic (Role, other moderation fields, the earnings behaviour
-- check) was too eager and flagged healthy accounts that were plainly earning,
-- so it is gone. Returns (false, reason) if blacklisted, (true, "clear") when the
-- save is loaded and it is not, or (nil, ...) when there is not enough data yet
-- to judge — in which case the caller leaves the last verdict alone.
function K.assessLobby()
    local bl = plr:GetAttribute("Blacklisted")
    if bl == true then return false, "Blacklisted" end
    if type(bl) == "number" and bl > 0 then return false, "Blacklisted" end

    -- Same name inside the save, checked in the lobby where STATE.slot is fully
    -- populated (in a mission it arrives late through the actor bridge if at all).
    local slot = STATE.slot
    if type(slot) == "table" then
        local v = deepFind(slot, "Blacklisted")
        if v == true then return false, "save.Blacklisted" end
        if type(v) == "number" and v > 0 then return false, "save.Blacklisted" end
    end

    -- Save loaded, not on the blacklist: not banned.
    if STATE.level > 0 then return true, "clear" end
    return nil, "no-data"
end

-- Commit a verdict: update the live status, log/alert on a change, and persist
-- (throttled). ok == nil means "no data" and is ignored.
function K.recordStatus(ok, reason, source)
    if ok == nil then return end
    local changed = (STATE.accountOk ~= ok)
    STATE.accountOk = ok
    K.STATUS.at  = os.time()
    K.STATUS.src = source
    if changed then
        log("SB", (ok and "status ACTIVE" or "status BANNED")
            .. (" (%s · %s)"):format(tostring(reason), tostring(source)))
        if not ok then
            K.whAlert("banned", "🚫 Account BANNED",
                ("On the blacklist (%s). The farm is still running — check this account.")
                :format(tostring(reason)))
        end
    end
    -- Persist on a change, or at most every 30s to refresh the timestamp, so
    -- thirty clients are not each writing the cache file once a second.
    if changed or (K.STATUS.at - (K.STATUS.saved or 0)) >= 30 then
        K.STATUS.saved = K.STATUS.at
        saveCache()
    end
end

-- The lobby/menu status check. Skipped in a mission: there the verdict is the
-- one loadCache restored from the last lobby visit.
function K.checkStatusLobby()
    if isMissionPlace() then return end
    local ok, reason = K.assessLobby()
    K.recordStatus(ok, reason, (placeKind() or "lobby"):lower())
end

-- Account status is a LOBBY decision (see K.assessLobby / K.checkStatusLobby).
-- In a mission the save and attributes needed to judge it are not reliably
-- present, so recomputing here would overwrite the good lobby value with
-- Unknown or a false flag. Trust the persisted verdict instead.
local function refreshFlagState()
    if isMissionPlace() then return end
    K.checkStatusLobby()
end

-- Earnings watchdog — the behavioural shadow-ban signal: runs keep completing
-- but gold stops moving.
--
-- RUNS IN THE LOBBY ONLY, and for the same reason the whole status feature does:
-- gold is only a LIVE read where the save replicates. Inside a mission getSlot
-- returns nil, refreshState leaves STATE.gold pinned at the cached value, and on
-- a fresh VM that pinned value equals the restored checkpoint EXACTLY — so a
-- mission-side comparison reads "no gold gained" for a perfectly healthy account
-- and false-flags it. The lobby has the true balance; the checkpoint is taken
-- and compared there. It still catches a real shadow-ban at the next lobby visit,
-- which a farming bot reaches regularly. The baseline is persisted (K.EARN,
-- restored by loadCache) so it survives the teleport between checks.
local function checkEarnings()
    if isMissionPlace() then return end
    -- Seed the checkpoint the first time we see this VM with no persisted one.
    if K.EARN.missions == nil then
        K.EARN.missions = STATE.missions
        K.EARN.gold     = STATE.gold
        saveCache()
        return
    end
    local elapsed = STATE.missions - K.EARN.missions
    if elapsed < 3 then return end

    -- INFORMATIONAL ONLY. This no longer sets the account status — ban status is
    -- the blacklist alone. It just logs a heads-up if gold has not moved across
    -- several missions, which can mean a shadow-ban OR simply that the runs are
    -- stalling (titans not dying, blades out). Advance the window either way.
    if STATE.gold <= (K.EARN.gold or 0) then
        if not K.EARN.warned then
            K.EARN.warned = true
            log("EARN", ("no gold gained in %d missions (still %s) — runs may not be paying")
                :format(elapsed, comma(STATE.gold)))
        end
    else
        K.EARN.warned = false
        K.EARN.gold   = STATE.gold
    end
    K.EARN.missions = STATE.missions
    saveCache()
end

-- Thunder Spear display counts all three parts, unlike the farm logic, which
-- treats Thruster + Base as done because Handle's Escort quest has no server
-- handler. The status line reports what you actually own; the router decides
-- what is worth chasing. Those are different questions.
local function spearParts()
    local inv = STATE.inventory
    local have, total = 0, 0
    for _, part in ipairs({ "Handle", "Thruster", "Base" }) do
        total = total + 1
        if hasSpearPart(part, inv) then have = have + 1 end
    end
    return have, total
end

local function statusLine()
    local D = CFG.Display or {}
    local parts = {}

    if D.ShowStatus then
        -- accountOk is nil until the server reports; show it as unknown rather
        -- than guessing either way.
        local status = (STATE.accountOk == nil) and "Unknown"
                    or (STATE.accountOk and "Active" or "Banned")
        parts[#parts + 1] = "🛡️ Status: " .. status
    end
    if D.ShowFamily   then parts[#parts + 1] = "🧬 Family: "   .. tostring(STATE.family or "None") end
    if D.ShowLevel    then parts[#parts + 1] = "🎖️ Level: "    .. tostring(STATE.level)    end
    if D.ShowPrestige then parts[#parts + 1] = "👑 Prestige: " .. tostring(STATE.prestige) end
    if D.ShowGold     then parts[#parts + 1] = "💰 Gold: "     .. comma(STATE.gold)  end
    if D.ShowGems     then parts[#parts + 1] = "💎 Gems: "     .. comma(STATE.gems)  end
    if D.ShowSpins    then parts[#parts + 1] = "🎰 Spins: "    .. comma(STATE.spins) end

    -- Thunder Spear, always shown with a clear ✅ / ❌ so a client that is NOT
    -- making the spear is visible at a glance rather than the line simply being
    -- absent. ✅ complete · a fraction while collecting · ❌ nothing yet.
    local have, total = spearParts()
    local ts
    if have >= total then
        ts = "✅"
    elseif have > 0 then
        ts = ("%d/%d ⏳"):format(have, total)
    else
        ts = "❌"
    end
    parts[#parts + 1] = "🚀 Thunder Spear: " .. ts

    -- Tracked items, only when the count is above zero.
    if type(CFG.TrackItems) == "table" then
        local items = {}
        for itemName, label in pairs(CFG.TrackItems) do
            local count = invCount(itemName)
            if count > 0 then
                items[#items + 1] = ("📦 %s: %d"):format(tostring(label), count)
            end
        end
        table.sort(items)
        if #items > 0 then parts[#parts + 1] = table.concat(items, ", ") end
    end

    local line = table.concat(parts, ", ")
    -- The panel reserves these two as separators.
    return (line:gsub("|", "·"):gsub(";", ":"))
end

-- The structured payload the panel stores alongside the display string.
local function statusPayload()
    local items = {}
    if type(CFG.TrackItems) == "table" then
        for itemName in pairs(CFG.TrackItems) do
            items[itemName] = invCount(itemName)
        end
    end
    for _, part in ipairs({ "Handle", "Thruster", "Base" }) do
        local name = TS_ITEM[part]
        if name then items[name] = invCount(name) end
    end
    return {
        Family   = STATE.family,
        Level    = STATE.level,
        Prestige = STATE.prestige,
        Gold     = STATE.gold,
        Gems     = STATE.gems,
        Spins    = STATE.spins,
        Items    = items,
    }
end

_G.VCP_STATUS = statusLine

task.spawn(function()
    K.stagger(num(CFG.StatsInterval, 60))
    while alive() do
        task.wait(num(CFG.StatsInterval, 60))
        if CFG.ShowStats then
            refreshFlagState()
            local r = rates()
            log("STATS", statusLine())
            log("RATE", ("%s · %s gold/hr · %d kills (%.0f/hr) · %d missions (%.1f/hr) · %s · %s")
                :format(fmtDur(r.elapsed), shortNum(r.goldHr),
                        STATE.kills, r.killsHr,
                        STATE.missions, r.missionHr,
                        GOV.mode,
                        STATE.action))
        end
    end
end)

-- ═══════════════════════════════════════════════════════════════════════════
-- 41d · DISCORD REPORTER
--
--     One embed at the end of every mission: who the account is, what it is
--     worth now, how long the run took, what dropped, and whether the account
--     still looks healthy. It exists so a farm can be left alone — the two
--     things that actually need a human (the account being flagged, a run
--     abandoning itself) arrive as alerts rather than being found hours later
--     in a log ring nobody read.
--
--     THREE RULES IT IS BUILT TO.
--
--     · It never blocks the farm. Every post is queued and sent from its own
--       thread; the combat loop never waits on a network round trip, and a
--       webhook that is down or slow costs the run nothing at all.
--     · It never reports a number it does not have. The baseline for "what
--       dropped" is taken at mission start, and inside a mission the save
--       arrives through the actor bridge several seconds AFTER the character
--       does — so the snapshot waits for real data, and the Drops field is
--       omitted outright rather than filled with a difference against a zero,
--       which would post the account's entire balance as a drop on the first
--       run of every session.
--     · It defends the webhook. Discord allows roughly 5 requests per 2s per
--       webhook and disables one that is hammered. Thirty clients posting every
--       mission is ~135 requests a minute, so the queue honours Discord's own
--       retry_after, spaces itself afterwards, and DOUBLES WebhookEvery on
--       repeated throttling — persisted across teleports, because the VM dies
--       every mission and a lesson re-learned every thirteen seconds is not a
--       lesson.
-- ═══════════════════════════════════════════════════════════════════════════

-- Difficulty rank 0-5: unknown, Easy, Normal, Hard, Severe, Aberrant.
K.WH_COLOR = { [0] = 0x9CA3AF, 0x4ADE80, 0x38BDF8, 0xA78BFA, 0xFB923C, 0xF87171 }

function K.whEnabled()
    local url = CFG.Webhook
    if type(url) ~= "string" or not url:find("/api/webhooks/", 1, true) then return false end
    if not EXEC.request then
        if not K.whNoHttp then
            K.whNoHttp = true
            log("HOOK", "Webhook is set but this executor exposes no request() — reporter off")
        end
        return false
    end
    return true
end

-- mm:ss. fmtDur is for session uptime and reads "1m02s"; a run that lasts
-- twelve seconds wants the clock format the summary screen itself uses.
function K.whClock(sec)
    sec = math.max(0, math.floor(tonumber(sec) or 0))
    return ("%02d:%02d"):format(math.floor(sec / 60), sec % 60)
end

-- A monospaced block with the values in one column. Discord renders embed text
-- proportionally, so without the padding every row starts somewhere different
-- and the card cannot be read at a glance — which is the only way anyone reads
-- one of these.
function K.whBlock(rows)
    local w = 0
    for _, r in ipairs(rows) do
        if r[1] and #r[1] > w then w = #r[1] end
    end
    local out = {}
    for _, r in ipairs(rows) do
        if r[1] then
            out[#out + 1] = ("%s:%s %s"):format(r[1], (" "):rep(w - #r[1]), tostring(r[2]))
        else
            out[#out + 1] = tostring(r[2])
        end
    end
    return "```\n" .. table.concat(out, "\n") .. "\n```"
end

function K.whPush(payload)
    if not K.whEnabled() then return end
    local W = K.WH
    -- Bounded. A queue that grows while the webhook is down is a memory leak
    -- that ends the session, and stale mission summaries are worthless anyway.
    while #W.q >= 12 do table.remove(W.q, 1) end
    W.q[#W.q + 1] = { p = payload, t = 0 }
    if not W.busy then
        W.busy = true
        task.spawn(function()
            local ok, err = pcall(K.whPump)
            W.busy = false
            if not ok then log("HOOK", "reporter thread errored: " .. tostring(err)) end
        end)
    end
end

function K.whPump()
    local W = K.WH
    while alive() and #W.q > 0 do
        local wait = W.nextAt - os.clock()
        if wait > 0 then
            -- Cap the single yield at 30s so alive() is re-checked during a long
            -- backoff -- but LOOP and re-measure, never fall through and send
            -- early. A 60s Discord retry_after must be waited out in full;
            -- sending at 30s just fires straight back into the still-active rate
            -- limit and re-triggers the 429 we were told to wait out.
            task.wait(math.min(wait, 30))
            continue
        end

        local item = table.remove(W.q, 1)
        if not item then break end

        local body
        if pcall(function() body = HttpService:JSONEncode(item.p) end) then
            local ok, res = pcall(EXEC.request, {
                Url     = CFG.Webhook,
                Method  = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body    = body,
            })
            local code = 0
            if ok and type(res) == "table" then
                code = tonumber(res.StatusCode or res.Status_Code or res.status_code) or 0
            end

            if code >= 200 and code < 300 then
                W.s429   = 0
                W.nextAt = os.clock() + math.max(W.floor or 0, 0.6)

            elseif code == 429 then
                -- Discord says how long to wait. Believe it rather than guess,
                -- and remember that this webhook is oversubscribed, so the posts
                -- after this one are spaced too.
                local retry = 2
                pcall(function()
                    local d = HttpService:JSONDecode(tostring(res.Body or res.body or "{}"))
                    local ra = tonumber(d.retry_after)
                    if ra then retry = (ra > 1000) and (ra / 1000) or ra end
                end)
                W.s429   = W.s429 + 1
                W.floor  = math.min(30, math.max((W.floor or 0.6) * 2, 1.5))
                W.nextAt = os.clock() + math.min(60, retry + 0.25)
                if item.t < 2 then
                    item.t = item.t + 1
                    table.insert(W.q, 1, item)
                end
                -- Three throttles running is not a blip, it is too many clients
                -- pointed at one webhook. Halve the traffic rather than keep
                -- arguing with Discord about it.
                if W.s429 >= 3 then
                    local cur = math.max(1, math.floor(W.every or num(CFG.WebhookEvery, 1)))
                    if cur < 30 then
                        W.every = math.min(30, cur * 2)
                        W.s429  = 0
                        log("HOOK", ("Discord is throttling this webhook — posting every "
                            .. "%d missions from now on"):format(W.every))
                        K.sessionSave()
                    end
                end

            elseif code == 401 or code == 403 or code == 404 then
                log("HOOK", ("webhook rejected the post (HTTP %d) — check the URL")
                    :format(code))
                W.q = {}
                W.nextAt = os.clock() + 300

            else
                -- Network blip or a 5xx. One retry, then let it go: a mission
                -- summary is stale by the time it is worth retrying twice.
                if item.t < 1 then
                    item.t = item.t + 1
                    table.insert(W.q, 1, item)
                end
                W.nextAt = os.clock() + 5
            end
        end
    end
end

-- ── Mission baseline ───────────────────────────────────────────────
function K.whStart()
    K.WH.run    = { at = os.clock(), have = false }
    K.WH.posted = false
    if not K.whEnabled() or CFG.WebhookMissions == false then return end

    task.spawn(function()
        local deadline = os.clock() + 30
        repeat
            local R = K.WH.run
            if not R then return end
            -- Nothing else refreshes STATE inside a mission until the rewards
            -- screen, and the router's boot read runs before setupBridge, so
            -- this poller pulls the save itself. getSave is single-flight, so a
            -- 1s cadence leaves at most one round trip outstanding.
            pcall(refreshState, true)
            -- DO NOT gate on level/gold: loadCache restores BOTH from disk
            -- before this runs, so the old test passed on stale cached values
            -- and every difference below was measured against them — which
            -- posted the account's whole XP bar as this run's gain and a random
            -- slice of its balance as gold. Max_XP is the cache-proof witness:
            -- it is written ONLY by refreshState from a real slot and is never
            -- restored by loadCache.
            local slot = STATE.slot
            if type(slot) == "table" and STATE.maxXp > 0 then
                R.gold, R.gems  = STATE.gold, STATE.gems
                R.xp,   R.maxXp = STATE.xp,   STATE.maxXp
                R.level = STATE.level
                if type(slot.Perks) == "table" and type(slot.Perks.Storage) == "table" then
                    local seen, any = {}, false
                    for uuid in pairs(slot.Perks.Storage) do seen[uuid], any = true, true end
                    if any then R.perks, R.perksN = seen, STATE.perksTotal end
                end
                R.have = true
                return
            end
            task.wait(1)
        until os.clock() > deadline
    end)
end

-- ── End-of-mission embed ────────────────────────────────────────
function K.whMission(choice, why)
    if not K.whEnabled() or CFG.WebhookMissions == false then return end
    if K.WH.posted then return end
    K.WH.posted = true

    -- Every N missions. Keyed on STATE.missions, which is carried on disk —
    -- NOT on a counter in this VM, because the VM dies on every teleport, so a
    -- local counter would restart at one each mission and the interval would
    -- silently never take effect at all.
    local every = math.max(1, math.floor(K.WH.every or num(CFG.WebhookEvery, 1)))
    if every > 1 and (STATE.missions % every) ~= 0 then return end

    local ok, err = pcall(function()
        local R = K.WH.run or {}

        local diff, map, obj
        pcall(function()
            diff = Workspace:GetAttribute("Difficulty")
            obj  = Workspace:GetAttribute("Objective")
            -- Workspace carries no "Map" attribute on this build. Measured live,
            -- the whole set is Player_Count, Type, Leader, Difficulty, Modifiers,
            -- Seconds, Objective, Detail. So this always fell through to
            -- CFG.MissionMap and every report claimed the CONFIGURED map even
            -- while the bot was on Outskirts or Forest for a Thunder Spear quest.
            -- The place registry knows where we actually are, and Loading_Screen
            -- (13 maps) is present inside mission places, not just the hubs.
            map  = Workspace:GetAttribute("Map") or MAP_OF[game.PlaceId]
        end)
        diff = tostring(diff or CFG.MissionDifficulty or "?")
        map  = tostring(map  or CFG.MissionMap or "?")
        obj  = tostring(obj  or CFG.MissionObjective or "?")

        local fields = {}

        fields[#fields + 1] = {
            name  = "Player Stats",
            value = K.whBlock({
                { "Prestige", STATE.prestige },
                { "Level",    STATE.level },
                { "Gems",     comma(STATE.gems) },
                { "Gold",     comma(STATE.gold) },
            }),
            inline = false,
        }

        fields[#fields + 1] = {
            name  = "Mission Stats",
            value = K.whBlock({
                { "Time Taken", K.whClock(os.clock() - (R.at or os.clock())) },
                { "Difficulty", diff },
                { "Objective",  obj },
            }),
            inline = true,
        }

        -- Drops. Only when there is a real baseline to subtract from.
        if R.have then
            local rows = {}
            rows[#rows + 1] = { "Gold", comma(math.max(0, STATE.gold - (R.gold or 0))) }
            rows[#rows + 1] = { "Gems", comma(math.max(0, STATE.gems - (R.gems or 0))) }

            -- XP wraps on a level-up: the counter restarts from zero, so a raw
            -- difference goes NEGATIVE exactly when the run went best. Rebuild
            -- it from the level the run started at.
            local dXp    = STATE.xp - (R.xp or STATE.xp)
            local levels = STATE.level - (R.level or STATE.level)
            if levels > 0 or dXp < 0 then
                dXp = math.max(0, (R.maxXp or 0) - (R.xp or 0)) + STATE.xp
            end
            rows[#rows + 1] = { "XP", comma(dXp) .. ((levels > 1) and "  (approx)" or "") }
            if levels > 0 then
                rows[#rows + 1] = { "Level Up", ("+%d"):format(levels) }
            end

            if R.perks then
                local drops, slot = {}, STATE.slot
                local store = (type(slot) == "table" and type(slot.Perks) == "table")
                              and slot.Perks.Storage or nil
                -- Storage legitimately GROWS during a run — that is what a perk
                -- drop is — so a uuid absent from the baseline is a real drop
                -- UNLESS the baseline itself was short. The guard against a
                -- half-replicated baseline is not a count comparison (drops make
                -- the end count larger, so any such test either fires never or
                -- fires on real loot); it is plausibility. A mission drops a
                -- handful of perks, so a diff of dozens means the baseline missed
                -- uuids that then "arrived", and the whole list is suspect.
                -- Collect, then trust it only if it is a believable size.
                if type(store) == "table" then
                    local defs = loadPerkDefs()
                    for uuid, pk in pairs(store) do
                        if not R.perks[uuid] and type(pk) == "table" and pk.Name then
                            local nm = tostring(pk.Name)
                            local d  = (type(defs) == "table") and defs[nm] or nil
                            drops[#drops + 1] = d and ("%s (%s)"):format(nm, d.rarity) or nm
                        end
                    end
                end
                if #drops > 12 then
                    -- Implausible for one mission: the baseline under-counted.
                    -- Report the net storage change as a number and drop the
                    -- names rather than post a wall of phantoms.
                    local grew = STATE.perksTotal - (R.perksN or 0)
                    drops = { (grew > 0) and ("+%d to storage"):format(grew) or "storage updated" }
                else
                    table.sort(drops)
                    -- An embed field caps at 1024 characters, and a wall of perk
                    -- names stops being readable long before that.
                    if #drops > 6 then
                        local extra = #drops - 6
                        for i = #drops, 7, -1 do drops[i] = nil end
                        drops[#drops + 1] = ("+%d more"):format(extra)
                    end
                end
                for _, line in ipairs(drops) do rows[#rows + 1] = { nil, line } end
            end

            fields[#fields + 1] = { name = "Drops", value = K.whBlock(rows), inline = true }
        end

        local safeRows = { { nil,
            (STATE.accountOk == nil) and "Unknown"
            or (STATE.accountOk and "Safe" or "BANNED") } }
        -- Say when and where the verdict was decided. Inside a mission this is
        -- the last lobby check, restored from disk, so it reads e.g.
        -- "verified 2m ago (lobby)" — which is the whole point: the status is a
        -- lobby decision the mission is only reporting.
        if K.STATUS.at and K.STATUS.at > 0 then
            safeRows[#safeRows + 1] = { nil,
                ("verified %s ago (%s)"):format(fmtDur(os.time() - K.STATUS.at),
                                                tostring(K.STATUS.src or "?")) }
        end
        fields[#fields + 1] = {
            name  = "Safety Status",
            value = K.whBlock(safeRows),
            inline = false,
        }

        local r    = rates()
        local rank = diffRank(diff)
        local name = tostring(plr.Name)
        local disp = tostring(plr.DisplayName or name)

        K.whPush({
            username   = tostring(CFG.WebhookUsername or "VC+ AOTR"),
            avatar_url = (type(CFG.WebhookAvatar) == "string") and CFG.WebhookAvatar or nil,
            embeds = { {
                author = {
                    name     = (disp == name) and ("@" .. name)
                                              or ("%s (@%s)"):format(disp, name),
                    icon_url = ("https://www.roblox.com/headshot-thumb/image"
                                .. "?userId=%d&width=150&height=150&format=png")
                               :format(plr.UserId),
                },
                title       = ("%s  ·  %s"):format(map, diff),
                description = (choice == "leave")
                              and ("Left the run — " .. tostring(why or ""))
                              or nil,
                color       = K.WH_COLOR[rank] or K.WH_COLOR[0],
                fields      = fields,
                footer = { text = ("Mission #%s  ·  %.0f/hr  ·  %s gold/hr  ·  up %s")
                    :format(comma(STATE.missions), r.missionHr,
                            shortNum(r.goldHr), fmtDur(r.elapsed)) },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            } },
        })
    end)
    if not ok then log("HOOK", "mission embed failed to build: " .. tostring(err)) end
end

-- ── Alerts ─────────────────────────────────────────────────────────
-- Rate-limited PER KIND, because the conditions that raise an alert are
-- conditions that persist: a flagged account stays flagged, and a map the bot
-- cannot make progress on will abandon run after run. One line an hour per kind
-- says the same thing without spending the webhook's whole allowance saying it.
-- Drop cooldown entries older than the window so the persisted map cannot
-- grow without bound (kinds are code-supplied today, but the file is editable).
function K.whAlertPrune()
    if type(K.whAlertAt) ~= "table" then return nil end
    local now, kept, any = os.time(), {}, false
    for kind, at in pairs(K.whAlertAt) do
        if tonumber(at) and (now - tonumber(at)) < 3600 then kept[kind], any = at, true end
    end
    K.whAlertAt = kept
    return any and kept or nil
end

function K.whAlert(kind, title, text)
    if CFG.WebhookAlerts == false or not K.whEnabled() then return end
    K.whAlertAt = K.whAlertAt or {}
    -- os.time(), not os.clock(): the persisted timestamps and this comparison
    -- must share a base, and os.clock() resets to ~0 on every fresh VM.
    local now = os.time()
    if (now - (K.whAlertAt[kind] or -1e9)) < 3600 then return end
    K.whAlertAt[kind] = now
    -- Flush BEFORE the push. The alerting caller (the no-progress watchdog) is
    -- about to fire S_Missions/Leave, which teleports and kills this VM, so an
    -- in-memory-only stamp is lost and the next run re-alerts. This must also
    -- come before the push pcall so a throw in the embed builder cannot leave
    -- the timestamp unwritten.
    if K.sessionSave then pcall(K.sessionSave) end
    pcall(function()
        K.whPush({
            username = tostring(CFG.WebhookUsername or "VC+ AOTR"),
            embeds = { {
                author      = { name = ("@%s"):format(tostring(plr.Name)) },
                title       = tostring(title),
                description = tostring(text),
                color       = 0xF87171,
                timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            } },
        })
    end)
end

-- ── Family roll posts (§35b) ──────────────────────────────────────
-- Separate switch from the mission report: WebhookMissions = false keeps the
