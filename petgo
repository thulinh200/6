-- ═══════════════════════════════════════════════════════════════════════════
-- 18 · MOVEMENT
--     BodyPosition holds an exact point; BodyVelocity at zero has to fight
--     gravity every frame and jitters the character loose. Holding position
--     matters because the whole combat model is "park above the target and let
--     the hitbox radius do the work" — drifting costs hits.
-- ═══════════════════════════════════════════════════════════════════════════
K.HOVER = { lastTarget = Vector3.new(0, 0, 0) }

local function ensureHover(hrp)
    if not hrp then return nil, nil end

    local bp = hrp:FindFirstChild("VCP_HoverBP")
    if not bp or not bp.Parent then
        local stale = hrp:FindFirstChild("VCPlusAntiFall") or hrp:FindFirstChild("VCPlusHoverBP")
        if stale then stale:Destroy() end
        bp = Instance.new("BodyPosition")
        bp.Name     = "VCP_HoverBP"
        bp.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bp.P        = 3000
        bp.D        = 1500
        bp.Position = hrp.Position
        bp.Parent   = hrp
    end

    local bg = hrp:FindFirstChild("VCP_HoverBG")
    if not bg or not bg.Parent then
        local stale = hrp:FindFirstChild("VCPlusHoverBG")
        if stale then stale:Destroy() end
        bg = Instance.new("BodyGyro")
        bg.Name      = "VCP_HoverBG"
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.P         = 3000
        bg.D         = 500
        bg.CFrame    = CFrame.new(hrp.Position, hrp.Position + Vector3.new(0, 0, -1))
        bg.Parent    = hrp
    end

    return bp, bg
end

-- Physics move: used when the destination itself is moving (escort carts).
local function moveTo(hrp, pos)
    if not hrp then return end
    if hrp.Anchored then hrp.Anchored = false end
    local bp = ensureHover(hrp)
    if not bp then return end
    if (hrp.Position - pos).Magnitude > 500 then
        hrp.CFrame = CFrame.new(pos)
        K.HOVER.lastTarget = pos
    end
    if (K.HOVER.lastTarget - pos).Magnitude > 30 then
        bp.Position = pos
        K.HOVER.lastTarget = pos
    end
end

-- Follow a target that is moving CONTINUOUSLY.
--
-- moveTo only re-commands the BodyPosition once the destination has drifted 30
-- studs from the last commanded point, and only teleports past 500. That is a
-- sensible economy for a titan cluster whose centroid jitters, but it is wrong
-- for the escort convoy: the carts move every frame, so the commanded point is
-- always up to 30 studs stale AND the spring is still settling toward it. The
-- result is a character that trails the convoy instead of covering it -- which
-- is exactly the wrong side to be on, because the titans that matter reach the
-- carts before they reach us.
--
-- So re-command every tick, and close a gap that has grown too large discretely
-- rather than trying to out-accelerate it.
K.followTo = function(hrp, pos, snapAt)
    if not hrp then return end
    if hrp.Anchored then hrp.Anchored = false end
    local bp = ensureHover(hrp)
    if not bp then return end

    -- BodyPosition is a spring, and a spring always lags a target that never
    -- stops moving: it only pulls harder as the error grows, so the error is
    -- what it feeds on. Re-commanding every tick removed the 30-stud deadband
    -- but not the lag itself, and the convoy still walked away from the guard.
    --
    -- Ride it rigidly instead. A discrete reposition is the same mechanism the
    -- titan lock already uses across the whole map, and the file's own note on
    -- snapTo is that a reposition reads fine server-side where an impossible
    -- interpolated velocity would not. The BodyPosition stays attached
    -- underneath so the character holds station between ticks.
    local gap = (hrp.Position - pos).Magnitude
    if CFG.ConvoyRigid ~= false then
        if gap > num(CFG.ConvoyRigidGap, 8) then hrp.CFrame = CFrame.new(pos) end
    elseif gap > num(snapAt, 150) then
        hrp.CFrame = CFrame.new(pos)
    end
    bp.Position = pos
    K.HOVER.lastTarget = pos
end

-- Snap move: used when locking onto a new titan. Interpolating across the map
-- reads as an impossible velocity server-side; a discrete reposition followed
-- by a held BodyPosition does not.
local function snapTo(hrp, pos)
    if not hrp then return end
    if hrp.Anchored then hrp.Anchored = false end
    local bp, bg = ensureHover(hrp)
    hrp.CFrame = CFrame.new(pos)
    if bp then bp.Position = pos end
    if bg then bg.CFrame = CFrame.new(pos, pos + Vector3.new(0, 0, -1)) end
    K.HOVER.lastTarget = pos
end

-- Character parts must not collide with the world or the hover fights terrain.
task.spawn(function()
    K.stagger(0.5)
    while alive() do
        pcall(function()
            local c = plr.Character
            if c then
                for _, part in ipairs(c:GetChildren()) do
                    if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
                end
            end
        end)
        task.wait(0.5)
    end
end)

-- ═══════════════════════════════════════════════════════════════════════════
-- 19 · BLADE + GAS
--     Reload rules, unchanged in substance from v9 because they match the
--     game's actual behaviour:
--       broken + Sets == 0  →  POST("Attacks","Reload", refillPart), wait ~4s
--       broken + Sets  > 0  →  GET("Blades","Reload"),               wait ~2s
--     The waits are real: the game plays a reload animation and re-firing or
--     moving mid-way cancels it. v10 polls for completion instead of sleeping
--     the full duration, which usually returns early.
-- ═══════════════════════════════════════════════════════════════════════════
-- `byRemote` / `byKey` / `byStation` count which path actually cleared a break.
-- The ladder's order is a guess until these say otherwise: if the key is
-- clearing most of them, the remote is not worth trying first.
local BLADE = {
    busy = false, gui = nil, tank = nil, noRefill = false, noTank = false,
    byRemote = 0, byKey = 0, byStation = 0, byRefresh = 0,
    clearedBy = nil, keyNoted = false, refreshNoted = false, refreshAt = 0,
    -- When the current reload worker started. `busy` gates every hit send in
    -- the combat loop, so a worker that dies without clearing it silences the
    -- client for the rest of the mission; this is what lets anyone notice.
    busyAt = 0,
    -- Do not re-enter the ladder the instant it gives up.
    nextTry = 0,
    -- Synthetic keyboard input is not guaranteed to reach an unfocused window,
    -- and on a box running thirty clients exactly one window is focused. Two
    -- key attempts that clear nothing, with the remote and station paths still
    -- working, is enough evidence to stop spending seconds on it every break.
    keyTries = 0, keyDead = false, keyBadNoted = false,
    -- Which path last cleared a break on THIS client, remembered across the
    -- teleport that wipes the VM. See K.bladePathLoad below.
    firstPath = nil, firstNoted = false,
}

-- WHICHEVER RELOAD PATH ACTUALLY WORKS HERE GOES FIRST.
--
-- The ladder is remote -> key -> station and it re-learned nothing: every
-- break paid the remote's round trip and a 0.9s confirmation poll before
-- reaching the key it was always going to need. Measured live on Chapel, this
-- account: byRemote 0, byKey 2 inside a single mission, with the combat gate
-- shut for 20-30% of every run (one sample hit 69%) -- and the gate is real,
-- because 60 hand-fired sends while broken moved the Slay counter by zero.
--
-- The counters that prove it already existed; they just died with the VM on
-- every teleport, so the lesson was re-learned from scratch once a mission and
-- never applied. Persist it per client, like the difficulty and click-path
-- memories above.
K.BLADE_FILE = ("VCPlus_BladePath_%s_%s.txt"):format(tostring(game.GameId), tostring(plr.UserId))

function K.bladePathLoad()
    if BLADE.firstPath ~= nil then return BLADE.firstPath end
    BLADE.firstPath = "remote"
    pcall(function()
        if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.BLADE_FILE) then
            local v = EXEC.readfile(K.BLADE_FILE)
            if v == "key" or v == "remote" or v == "station" then BLADE.firstPath = v end
        end
    end)
    return BLADE.firstPath
end

function K.bladePathSave(path)
    if path ~= "key" and path ~= "remote" and path ~= "station" then return end
    if BLADE.firstPath == path then return end
    BLADE.firstPath = path
    pcall(function()
        if EXEC.writefile then EXEC.writefile(K.BLADE_FILE, path) end
    end)
    log("BLADE", ("'%s' is the path that clears breaks on this client — trying it first from now on")
        :format(path))
end

local function bladeGui()
    if BLADE.gui and BLADE.gui.Parent then return BLADE.gui end
    BLADE.gui = nil
    pcall(function()
        local gui = plr:FindFirstChild("PlayerGui")
        local iface = gui and gui:FindFirstChild("Interface")
        local hud  = iface and iface:FindFirstChild("HUD")
        local top  = hud and hud:FindFirstChild("Main") and hud.Main:FindFirstChild("Top")
        if not top then return end
        for _, v in ipairs(top:GetDescendants()) do
            if v.Name == "Blades" and v:FindFirstChild("Inner") and v:FindFirstChild("Sets") then
                BLADE.gui = v
                return
            end
        end
    end)
    return BLADE.gui
end

local function readSets()
    local g = bladeGui()
    if not g then return nil end
    local s = g:FindFirstChild("Sets")
    if s and s:IsA("TextLabel") then return tonumber(s.Text:match("%d+")) end
    return nil
end

-- Blade durability, read off the rig.
--
-- Each hand carries Blade_1 .. Blade_7 and they are consumed one at a time by
-- being made invisible. Sampled live across a fight the visible count walks
-- 6 → 5 → 4 → 3, so it is a genuine 0..7 durability gauge, not a binary.
--
-- The old check was wrong in three ways:
--   * it tested `Blade_1:GetAttribute("Broken")`, and the rig parts carry NO
--     attributes at all — that branch could never be true;
--   * it treated Blade_1 alone as the whole weapon, so depending on which slot
--     is consumed first it either declared a break with six blades left or
--     missed a real one entirely;
--   * it returned true whenever the parts were invisible, which is also what a
--     respawn and a mission transition look like — firing a reload into a map
--     change (observed live as vis=0/7 while Sets still read 3/3).
--
-- Counting instead gives both a correct broken test AND the headroom number the
-- preemptive reload needs.
-- MEMOISED FOR ONE FRAME.
--
-- Every call walks the rig: two hands x seven FindFirstChild("Blade_N") plus a
-- Transparency read each. The combat loop asked for the same answer three times
-- per tick — once directly, once inside ensureBlade, once more in the preemptive
-- branch — which at ~30 ticks a second is roughly 1,260 FindFirstChild calls a
-- second for a number that cannot change between them.
local function bladeCount()
    local now = os.clock()
    if BLADE.cAt and (now - BLADE.cAt) < 0.05 then return BLADE.cVis, BLADE.cTot end
    local char = plr.Character
    if not char then BLADE.cAt = nil return nil end
    local rig = char:FindFirstChild("Rig_" .. plr.Name)
    if not rig then return nil end

    local vis, total = 0, 0
    for _, hand in ipairs(rig:GetChildren()) do
        if hand.Name == "RightHand" or hand.Name == "LeftHand" then
            for i = 1, 7 do
                local b = hand:FindFirstChild("Blade_" .. i)
                if b and b:IsA("BasePart") then
                    total = total + 1
                    if b.Transparency == 0 then vis = vis + 1 end
                end
            end
        end
    end
    if total == 0 then BLADE.cAt = nil return nil end   -- rig not built; not a break
    BLADE.cAt, BLADE.cVis, BLADE.cTot = now, vis, total
    return vis, total
end

local function bladeBroken()
    -- The server just answered a swap with `true`: believe it over a rig that
    -- has not redrawn yet, or the ladder spends a second set on the same break.
    if BLADE.trustUntil and os.clock() < BLADE.trustUntil then return false end
    -- ...and the opposite: swinging with nothing credited (K.focusStarved)
    -- means spent server-side even while the rig still draws blades.
    if BLADE.forceUntil and os.clock() < BLADE.forceUntil then return true end
    local vis, total = bladeCount()
    if vis == nil then return false end
    -- Everything invisible during a transition reads the same as a real break,
    -- so require the character to actually be alive and settled before
    -- believing it.
    if vis == 0 and total > 0 then
        local hum = plr.Character and plr.Character:FindFirstChildWhichIsA("Humanoid")
        return (hum and hum.Health > 0) and true or false
    end
    return false
end

-- The NEAREST station to `from` when given. It used to return whichever came
-- first in the folder -- on Chapel that is 2,800 studs from where the bot
-- fights, and the server only honours a refill close to the station (measured:
-- OK from 304 studs, refused from 5,082).
local function findRefillPart(from)
    if not from and BLADE.tank and BLADE.tank.Parent then return BLADE.tank end
    BLADE.tank = nil
    pcall(function()
        local unc = Workspace:FindFirstChild("Unclimbable")
        local reloads = unc and unc:FindFirstChild("Reloads")
        if not reloads then return end
        local bd = math.huge
        for _, station in ipairs(reloads:GetChildren()) do
            local r = station:FindFirstChild("Refill")
            if r and r:IsA("BasePart") then
                local d = from and (r.Position - from).Magnitude or 0
                if d < bd then BLADE.tank, bd = r, d end
                if not from then return end
            end
        end
    end)
    if not BLADE.tank then
        pcall(function()
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d.Name == "Refill" and d:IsA("BasePart") then BLADE.tank = d return end
            end
        end)
    end
    return BLADE.tank
end

-- Cheap swap first, station refill only if that failed.
--
-- On the Sets label: an earlier read of "0 / 3" with blades visibly intact led
-- to the conclusion that the leading number was not sets-remaining. Re-sampled
-- live in a mission it reads "3 / 3" and "2 / 3" and decrements with use, so it
-- IS sets-remaining and that earlier read was a lobby/transition artifact —
-- the same all-invisible state that used to make bladeBroken() misfire.
--
-- It is still not branched on. Swapping is free and idempotent, so it is always
-- tried first and the station stays the fallback for when a swap does not clear
-- the break. Branching on Sets would risk spending one of the mission's Refill
-- charges (Aberrant grants only two) on a misread, and the swap-first order
-- costs nothing when Sets is genuinely 0.
-- `idleHint` is the number of titans currently inside hit range, passed down
-- from the combat loop. Zero means we are travelling, and travel is when a
-- reload is free.
-- REAL KEYBOARD INPUT — two different keys, for two different problems.
--
--   R  is the game's reload key. Used when the blades really are spent and the
--      reload remote did not take.
--   E  is the grapple. It is NOT a reload, and it is here for a different bug
--      entirely: reported from the seat, the blades sometimes come back
--      server-side while the CLIENT never redraws them, and firing the grapple
--      is what makes the rig catch up.
--
-- That second case matters more than it looks. bladeCount() infers durability
-- from the Transparency of Blade_1..7 on the rig, so a rig that has not
-- redrawn reads as ZERO BLADES — and everything downstream believes it: the
-- reload ladder burns rounds and refills on blades that are already full, and
-- the combat loop's blade gate stops firing entirely. A cosmetic desync turns
-- into a stalled run.
--
-- Reported from the seat and consistent with what the summary screen already
-- taught us: firing the remote sometimes does not reload, and pressing the
-- game's own reload key does. The same asymmetry showed up on the Retry
-- button, where forging the handler did nothing and a real
-- VirtualInputManager event worked — the client-side state machine has to run
-- for the server to accept the result, and only real input runs it.
--
-- So this is a fallback in the ladder rather than a replacement: the remote is
-- faster when it works, and BLADE.clearedBy records which path actually
-- cleared the break so the order can be revisited on evidence rather than
-- on feel.
-- Any deliberate reload invalidates the memo: the whole point of pressing the
-- key is to change the number the cache is holding.
local function bladeForget() BLADE.cAt = nil end

local function pressKey(name, hold)
    -- Enum.KeyCode["Foo"] RAISES; it does not return nil. So the guard that
    -- used to be on the next line was unreachable for every name that is not
    -- an exact KeyCode member — "r", "Mouse1", "Reload", a trailing space —
    -- and the throw escaped into the reload worker, which had no pcall, which
    -- left BLADE.busy latched true and silenced combat for the rest of the
    -- mission. A mistyped config key was a fleet-wide outage with no log line.
    local okCode, code = pcall(function() return Enum.KeyCode[tostring(name or "E")] end)
    if not okCode or typeof(code) ~= "EnumItem" then
        if not BLADE.keyBadNoted then
            BLADE.keyBadNoted = true
            log("BLADE", ("%q is not a KeyCode name — the key fallback is disabled")
                :format(tostring(name)))
        end
        return false
    end
    local ok = pcall(function()
        local c = plr.Character
        local h = c and c:FindFirstChildWhichIsA("Humanoid")
        if not (h and h.Health > 0) then error("no character") end
        VirtualInputManager:SendKeyEvent(true,  code, false, game)
        task.wait(hold or 0.06)
        VirtualInputManager:SendKeyEvent(false, code, false, game)
    end)
    bladeForget()
    return ok
end

-- Press the reload key and wait for the break to clear.
-- BUDGETS ARE SPENT WHETHER OR NOT THE KEY LANDS, so size them for the case
-- where it does. A keypress that is going to work clears the break within a
-- frame or two; the old 1.6-1.8s budgets only ever paid out for a client that
-- never gets them at all. At a 200ms frame period that budget is ~9 polls of
-- pure dead air, and the combat loop's blade gate holds every send for the
-- whole of it — up to four rounds of it, inside a mission that lasts ~13s.
local function keyReload(budget, sets)
    if CFG.BladeReloadKey == false or BLADE.keyDead then return false end
    local key = CFG.BladeReloadKey
    if type(key) ~= "string" then key = "R" end
    setAction("Blade reload (key %s)", key)
    if not pressKey(key) then return false end
    local ok = waitUntil(function() return not bladeBroken() end,
                         num(budget, 1.0), 0.03)
    -- One last look. waitUntil tests the condition BEFORE its final sleep, so a
    -- break that cleared during that sleep reads as a failure — and a false
    -- failure here is what latches K.keyPathDead against a client whose keys
    -- work fine.
    if not ok and not bladeBroken() then ok = true end
    -- Only COUNT the failure as evidence about input delivery when a keypress
    -- could actually have cleared the break. At Sets 0 there is no set to draw
    -- from, so the reload cannot succeed however cleanly the key lands — and
    -- counting that toward keyPathDead's threshold was latching the "keys don't
    -- reach this window" verdict on a client whose keys work fine. An
    -- unreadable label (sets == nil) is counted, so a broken GUI cannot silently
    -- disable the latch; only a confirmed empty rack is exculpatory.
    if not ok and (sets == nil or sets > 0) then
        BLADE.keyTries = BLADE.keyTries + 1
    end
    return ok
end

-- Kick the rig into redrawing itself. Rate-limited: it is a movement input,
-- and firing the grapple every loop tick would be both useless and visible.
local function bladeRefresh(budget)
    if CFG.BladeRefreshKey == false or BLADE.keyDead then return false end
    local key = CFG.BladeRefreshKey
    if type(key) ~= "string" then key = "E" end
    if os.clock() < (BLADE.refreshAt or 0) then return false end
    BLADE.refreshAt = os.clock() + num(CFG.BladeRefreshCooldown, 2.5)
    setAction("Blade display refresh (key %s)", key)
    if not pressKey(key) then return false end
    local ok = waitUntil(function() return not bladeBroken() end,
                         num(budget, 1.0), 0.03)
    if not ok and not bladeBroken() then ok = true end
    -- Deliberately does NOT touch keyTries. A grapple that changes nothing means
    -- the blades were not display-desynced — the overwhelmingly common case —
    -- and says nothing about whether the E key reached the window. Only SUCCESS
    -- is recorded (BLADE.byRefresh, at the call site), because a refresh that
    -- works still proves keys land and keyPathDead reads byRefresh as such.
    return ok
end

-- Stop paying for synthetic input this client cannot deliver.
--
-- byKey and byRefresh have been counted since v10 shipped and never read. They
-- are the evidence: two key attempts that cleared nothing, and no key path has
-- EVER cleared a break on this client, means the window is not receiving the
-- input — which is the normal state for twenty-nine of thirty windows on a
-- farm box. The remote and the refill station both work regardless of focus,
-- so the honest move is to stop spending seconds on the keys and go there.
--
-- Deliberately per-VM, i.e. re-probed once per mission. It is one cheap attempt
-- to find out, and it self-corrects the moment the operator focuses a window.
function K.keyPathDead()
    if BLADE.keyDead then return true end
    -- Three, not two. A reload is an ANIMATION: the rig can take most of a
    -- second to redraw, so a keypress that IS landing can miss its poll window
    -- and be scored a failure. Two of those is ordinary; three, with no key path
    -- having EVER cleared a break on this client, is a window that is not
    -- receiving input.
    if BLADE.keyTries >= 3 and BLADE.byKey == 0 and BLADE.byRefresh == 0 then
        BLADE.keyDead = true
        log("BLADE", "keypresses are not reaching this window — falling back to the "
            .. "remote and the refill station, which do not need focus")
        return true
    end
    return false
end

-- Wait out the live swing before asking for a swap. Measured: Blades/Reload
-- answered nil twice straight after the farm's last Slash and true half a
-- second later. The combat loop stops slashing the moment the rig reads broken
-- (or BLADE.busy is up), so this is at most one swing long.
function K.reloadQuiet()
    local left = num(CFG.ReloadQuietSeconds, 0.55) - (os.clock() - (K.lastSlashAt or 0))
    if left > 0 then task.wait(left) end
end

-- One swap, judged by the SERVER's answer rather than by the rig. `true` is a
-- fresh set; anything else is a refusal (swing still live, or the rack empty).
function K.bladeSwap(timeout)
    K.reloadQuiet()
    local r = invoke(timeout or 2.5, "Blades", "Reload")
    bladeForget()
    if r == true then
        -- The rig can lag the server by a frame or two; trust the reply.
        BLADE.trustUntil = os.clock() + 1.2
        BLADE.forceUntil = nil
        return true
    end
    return false
end

-- THE STATION RUN. When the rack is empty the only way back to a working blade
-- is a Refill, and the server honours one only near a station: measured OK
-- from 304 studs (2.6s, Refills 3 -> 2) and refused from 5,082. The old ladder
-- fired it from wherever the fight was -- on Chapel that is 2,700-2,800 studs
-- from every station -- so the Refill never landed, all four rounds timed out
-- and the run sat with no blades until the stall watchdog gave up on it.
--
-- So go there: snap to a hover point straight above the NEAREST station
-- (RefillHoverHeight, inside the measured radius and out of grab reach), let
-- the position reach the server, refill, and let the combat loop pull the
-- character back to the fight. BLADE.tripTo is what the combat loop parks on
-- while this runs, so it does not drag the character back mid-refill.
function K.stationRefill()
    local refills = num(plr:GetAttribute("Refills"))
    if refills <= 0 then
        if not BLADE.noRefill then
            BLADE.noRefill = true
            log("BLADE", "out of Refills — cannot restock until the mission ends")
        end
        return false
    end
    local ch  = plr.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local tank = findRefillPart(hrp.Position)
    if not tank then
        if not BLADE.noTank then
            BLADE.noTank = true
            log("BLADE", "no Refill station found on this map")
        end
        return false
    end

    local t0    = os.clock()
    local hover = tank.Position + Vector3.new(0, math.clamp(num(CFG.RefillHoverHeight, 150), 20, 280), 0)
    local ok    = false
    BLADE.tripTo = hover
    pcall(function()
        setAction("Refill — flying to the station (%d left)", refills)
        snapTo(hrp, hover)
        waitUntil(function() return (hrp.Position - hover).Magnitude < 30 end, 1.5, 0.05)
        -- One round trip for the new position to land server-side before the
        -- request is judged against it.
        task.wait(math.clamp(num(CFG.RefillSettle, 0.35), 0.1, 1.5))
        K.reloadQuiet()
        setAction("Refill at the station (%d left)", refills)
        post("Attacks", "Reload", tank)
        ok = waitUntil(function()
            return num(plr:GetAttribute("Refills")) < refills or (readSets() or 0) > 0
        end, 4.0, 0.05)
    end)
    BLADE.tripTo = nil
    if ok then
        BLADE.byStation = BLADE.byStation + 1
        log("BLADE", ("refilled at the station %.0f studs out in %.1fs (%d refills left)")
            :format((hover - tank.Position).Magnitude, os.clock() - t0, num(plr:GetAttribute("Refills"))))
    else
        log("BLADE", ("station refill did not take in %.1fs"):format(os.clock() - t0))
    end
    return ok
end

local function ensureBlade(idleHint, brokenHint)
    -- Belt and braces for the flag that gates all of combat. The worker below
    -- is pcall'd and clears `busy` on every path, but a thread can also be
    -- killed from outside (task.cancel, a DataModel teardown mid-yield), and
    -- the cost of being wrong here is a client that farms nothing for the rest
    -- of the mission. The whole ladder is bounded by its own timeouts at well
    -- under 40s even at a 200ms frame period, so anything past that is not slow,
    -- it is gone.
    if BLADE.busy and (os.clock() - (BLADE.busyAt or 0)) > 40 then
        BLADE.busy = false
        log("BLADE", "reload worker never finished — releasing the combat gate")
    end
    if BLADE.busy then return false end

    -- The caller already asked; taking its answer saves a rig walk per tick.
    local broken = brokenHint
    if broken == nil then broken = bladeBroken() end

    -- ── Preemptive reload ────────────────────────────────────────────────
    -- The expensive part of a reload is not the remote, it is the animation:
    -- the game plays it out and re-firing or moving mid-way cancels it. Doing
    -- that in the middle of a fight costs the whole animation in lost DPS.
    --
    -- But the bot spends most of its time in transit — measured live, the
    -- median titan is ~2,489 studs away and usually only one is inside the
    -- credited radius at a time. Reloading during that flight costs nothing at
    -- all, because there was nothing to hit anyway.
    --
    -- So: once durability is down to the last blade or two AND nothing is in
    -- range, top up now rather than breaking mid-swing on the next target.
    --
    -- CORRECTION to the first version of this: it fired only while travelling,
    -- on the belief that the bot spends most of its time in transit. Measured
    -- properly on Chapel that is false -- the nearest titan sat at 113-153
    -- studs for 100% of a 20-second sample, i.e. the bot is in permanent
    -- contact and an idle-only trigger would essentially never fire.
    --
    -- So idle is now the PREFERRED window, not the only one. At one blade left
    -- the reload is coming within a swing or two regardless, and taking it
    -- deliberately beats swinging into a break and discovering it late.
    local preempt = false
    if not broken and CFG.PreemptiveBladeReload then
        local vis = bladeCount()
        local thr = math.max(1, num(CFG.PreemptiveBladeThreshold, 2))
        if vis and vis > 0 then
            if (idleHint or 1) <= 0 and vis <= thr then
                preempt = true          -- free window: top up early
            elseif vis <= 1 and not K.focusOn() then
                -- About to break anyway; do it on our terms. Not under focus
                -- fire: a swap costs a whole set whatever is left on the blade,
                -- and swinging the last blade out then swapping takes the same
                -- 0.5s -- a mid-fight top-up only throws that hit away.
                preempt = true
            end
        end
        -- A top-up draws from the reserve set rack; with the rack DEFINITELY
        -- empty it cannot raise the count, and the preempt path records no
        -- backoff, so it would re-fire Blades/Reload every worker cycle for the
        -- whole travel leg. Suppress only on a hard 0 -- a nil read is "unknown",
        -- leave that to try (the label can misread during transitions). A real
        -- break later routes through the full ladder, which handles empty racks.
        if preempt and readSets() == 0 then preempt = false end
    end

    if not broken and not preempt then return true end
    -- A ladder that just gave up must not be re-entered on the very next frame.
    -- Without this the loop re-runs the whole sequence every ~200ms, BLADE.busy
    -- sits true at essentially 100% duty, and the no-progress watchdog (which
    -- samples every 3s) can never land a sample with the flag down.
    if os.clock() < (BLADE.nextTry or 0) then return false end
    BLADE.busy   = true
    BLADE.busyAt = os.clock()

    task.spawn(function()
        -- EVERY EXIT FROM THIS THREAD MUST CLEAR `busy`.
        --
        -- It is set on the calling thread and cleared at the end of this one,
        -- and the body calls bladeCount, readSets, findRefillPart, pressKey,
        -- post and invoke. Any throw in there killed the thread before the
        -- clear, and from then on ensureBlade's own `if BLADE.busy then return`
        -- made it a permanent no-op while the combat loop's blade gate held
        -- every hit send — the client hovers in the mission sending nothing
        -- until the map times out, and the comment claiming this "can never
        -- wedge the loop" was true only if the thread always reached its last
        -- line. One pcall and one guaranteed clear is the whole fix; it is the
        -- same shape the rewards worker already uses for the same reason.
        local okWorker, workerErr = pcall(function()
        if preempt then
            local vis = bladeCount()
            setAction("Topping up blades (%s left)", tostring(vis or "?"))
            -- The server's `true` IS the verification now; the count poll
            -- below only runs when it said anything else.
            local start = vis or 0
            local rose = K.bladeSwap(2.5) or waitUntil(function()
                local v = bladeCount()
                return v ~= nil and v > start
            end, 0.6, 0.03)
            -- A top-up does not clear a break flag, so the only signal is the
            -- count going back up. If it did not, try the key before giving up:
            -- a top-up that silently did nothing is what turns into a mid-swing
            -- break a second later.
            if not rose and CFG.BladeReloadKey ~= false and not K.keyPathDead() then
                local key = type(CFG.BladeReloadKey) == "string" and CFG.BladeReloadKey or "R"
                setAction("Blade top-up (key %s)", key)
                if pressKey(key) then
                    -- Count a miss as input-delivery evidence only if there was
                    -- a set to draw from; a top-up on an empty rack cannot raise
                    -- the count no matter how well the key landed.
                    local s = readSets()
                    if not waitUntil(function()
                        local v = bladeCount()
                        return v ~= nil and v > start
                    end, 1.0, 0.03) and (s == nil or s > 0) then
                        BLADE.keyTries = BLADE.keyTries + 1
                    end
                end
            end
            return
        end

        -- THE REPAIR LADDER, rebuilt 2026-09-23 on measured behaviour.
        --
        --   swap   Blades/Reload answers `true` in ~0.07s -- but ONLY once the
        --          last swing has ended; while one is live it answers nil. The
        --          old ladder kept slashing straight through its own reload,
        --          read that nil as "the remote does not work on this client",
        --          and went on to a key press, a grapple "redraw" and a Refill
        --          fired from the middle of the map. Measured: 6-9s with zero
        --          hits per break, several breaks a mission. K.bladeSwap waits
        --          the swing out and trusts the server's answer.
        --   refill only lands near a station -- see K.stationRefill.
        for round = 1, 3 do
            if not alive() or not bladeBroken() then break end
            local sets = readSets()
            if sets ~= 0 then
                setAction("Blade swap (sets %s)", tostring(sets or "?"))
                if K.bladeSwap(2.5) then
                    BLADE.clearedBy = "remote"
                    BLADE.byRemote  = BLADE.byRemote + 1
                    break
                end
                -- Refused. One short look in case it was only the rig drawing
                -- late; from round two a refused swap means an empty rack.
                if waitUntil(function() return not bladeBroken() end, 0.3, 0.03) then break end
            end
            -- Only an EMPTY rack goes to the station (an unreadable label counts
            -- once the swap has been refused twice). A Refill spent on a rack
            -- that still holds sets is a Refill the end of the run will miss.
            if sets == 0 or (sets == nil and round >= 2) then
                if not K.stationRefill() then break end
                -- A Refill restocks the rack; a set still has to be drawn, and
                -- the server refuses the draw for a moment while it finishes
                -- the refill (measured: the first draw after a 0.6s refill came
                -- back refused, the lagging label still read 0/3, and the ladder
                -- flew a second, pointless trip). Keep drawing instead.
                if waitUntil(function() return K.bladeSwap(1.5) or not bladeBroken() end, 3.0, 0.1) then
                    BLADE.clearedBy = "station"
                    break
                end
            end
        end

        -- Last resort for a client whose swap never answers true: the game's
        -- own reload key, which runs the same remote after its animation.
        if alive() and bladeBroken() and (readSets() or 1) > 0
           and CFG.BladeReloadKey ~= false and not K.keyPathDead()
           and keyReload(1.0, readSets()) then
            BLADE.clearedBy = "key"
            BLADE.byKey     = BLADE.byKey + 1
        end

        end)
        if not okWorker then
            log("BLADE", "reload worker died: " .. tostring(workerErr))
        end
        if not bladeBroken() then
            BLADE.noRefill = false
        elseif not preempt then
            -- Still broken after the whole REPAIR ladder. Give the world five
            -- seconds to change before trying again, so the flag is observably
            -- down and the stall detectors can see the state we are in.
            --
            -- Not for the preempt path. A preempt only runs while NOT broken, so
            -- a break reading true right after one is almost always the rig
            -- redraw desync this file documents — blades full server-side, the
            -- rig showing empty — and the fix for that is to run the repair
            -- ladder on the next pass, immediately, not to sit out five seconds
            -- of guaranteed silence before even attempting it.
            BLADE.nextTry = os.clock() + 5
        end
        -- Remember what worked, so the next mission does not re-derive it.
        -- "refresh" is excluded on purpose: it is a rig redraw, not a reload,
        -- so it says nothing about which reload path this client honours.
        -- Only the paths the ladder can start from are worth remembering.
        if BLADE.clearedBy == "key" or BLADE.clearedBy == "remote" then
            K.bladePathSave(BLADE.clearedBy)
        end
        BLADE.busy = false          -- single clear point, always reached
    end)
    return false
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 20 · ACTOR BRIDGE
--
--     v9 routed EVERY combat call through a BindableFunction into the actor
--     VM: one Invoke for the slash plus one Invoke per titan per tick. An
--     Invoke yields the calling thread until the other VM answers, so at
--     cap=6 that is seven cross-VM round-trips every 0.28s purely to fire
--     remotes the main VM could have fired itself.
--
--     v10 sends combat straight from the main VM through a cloned
--     POST.FireServer reference. The actor is retained only for the two jobs
--     that genuinely require its VM:
--       · suppressing camera shake (Modules.Effects lives inside the actor, so
--         a require() from outside gets a different copy and setting it there
--         has no effect — v9 documented this after it silently never worked)
--       · publishing Zones.Time_Difference, which the hit payload carries
--     Both are low-frequency and neither is on the hot path.
-- ═══════════════════════════════════════════════════════════════════════════
K.ACTOR_SRC = [[
    local MPS = game:GetService('MarketplaceService')
    local RunService = game:GetService('RunService')

    local CoreTable
    local t0 = os.clock()
    while not CoreTable and os.clock() - t0 < 30 do
        for _, v in pairs(getgc(true)) do
            if type(v) == 'table' and rawget(v, 'Cache')
            and type(v.Cache) == 'table' and rawget(v.Cache, 'Data') then
                CoreTable = v
                break
            end
        end
        if not CoreTable then task.wait(0.05) end
    end
    if not CoreTable then return end

    local Modules = CoreTable.Modules

    -- Camera shake accumulator. Zones adds 3 per nape hit, Char adds 10 on
    -- land and on roll, Ragdoll adds 5. At aura hit rates that is a permanent
    -- screen shake and a real frame cost. Swallowing writes through a
    -- metatable costs nothing per frame; the polling loop is the fallback for
    -- when the table already has a metatable we must not replace.
    task.spawn(function()
        local Effects = Modules and Modules.Effects
        if not Effects then return end
        local hasMT = false
        pcall(function() hasMT = getmetatable(Effects) ~= nil end)
        local installed = false
        if not hasMT then
            installed = pcall(function()
                Effects.Shake_Amount = nil
                setmetatable(Effects, {
                    __index = function(_, k)
                        if k == 'Shake_Amount' then return 0 end
                        return nil
                    end,
                    __newindex = function(t, k, v)
                        if k == 'Shake_Amount' then return end
                        rawset(t, k, v)
                    end,
                })
            end)
        end
        if not installed then
            while true do
                pcall(function()
                    Effects.Shake_Amount = 0
                    Effects.Small = false
                end)
                task.wait()
            end
        end
    end)

    -- Publish Time_Difference so the main VM can attach it to hit payloads
    -- without a cross-VM call on the hot path.
    local td = MPS:FindFirstChild('VCP_TD')
    if td then
        RunService.Heartbeat:Connect(function()
            local z = Modules and Modules.Zones
            if z and z.Time_Difference then
                td.Value = tonumber(z.Time_Difference) or 0
            end
        end)
    end

    -- Serve the player save to the main VM.
    --
    -- Inside a mission place the save is ONLY reachable from here. Measured on
    -- a live Chapel run: a main-VM getgc(true) walk over 4,946 values found
    -- zero CoreTable candidates, and ReplicatedStorage.VEVOsShared has no
    -- ReplicaController at all in mission places. Without this bridge the main
    -- VM has no local source and falls back to a server round-trip every few
    -- seconds for the entire mission.
    -- IMPORTANT: return a rebuilt PLAIN table, never CoreTable.Cache.Data itself.
    --
    -- A BindableFunction deep-copies its return value across the VM boundary and
    -- refuses anything it cannot marshal — metatables, functions, cyclic
    -- references. The live save contains such values, so returning it raw makes
    -- Invoke throw, the caller falls through to the server round-trip, and the
    -- bridge reports "live" while delivering nothing. That is exactly what was
    -- observed: actorBridge = true and saveSource = "remote" at the same time.
    --
    -- Copying only the fields the script reads is also far cheaper than deep-
    -- copying the entire save every few seconds.
    local data = MPS:FindFirstChild('VCP_DATA')
    if data then
        local function plainCopy(src, depth)
            if depth > 5 or type(src) ~= 'table' then return nil end
            local out = {}
            for k, v in pairs(src) do
                local tk = type(k)
                if tk == 'string' or tk == 'number' then
                    local tv = type(v)
                    if tv == 'string' or tv == 'number' or tv == 'boolean' then
                        out[k] = v
                    elseif tv == 'table' then
                        out[k] = plainCopy(v, depth + 1)
                    end
                end
            end
            return out
        end

        data.OnInvoke = function(what)
            if what == 'stats' then
                -- Hits per swing (Strike) and swing speed, straight off the
                -- game's own computed Loadout -- perks and skills included.
                local ok, r = pcall(function()
                    local L = rawget(CoreTable, 'Loadout') or CoreTable.Loadout
                    local S = type(L) == 'table' and L.Stats
                    if type(S) ~= 'table' then return nil end
                    return { Strike = tonumber(S.Strike), Swing = tonumber(S.Swing_Duration) }
                end)
                return ok and r or nil
            end
            if what ~= 'save' then return nil end
            local ok, result = pcall(function()
                local d = CoreTable.Cache.Data
                if type(d) ~= 'table' or type(d.Slots) ~= 'table' then return nil end
                local key = d.Current_Slot
                    or game:GetService('Players').LocalPlayer:GetAttribute('Slot')
                    or 'A'
                local slot = d.Slots[key]
                if type(slot) ~= 'table' then return nil end
                return {
                    Current_Slot = key,
                    -- Data.Extra is the live roll count; Data.Spins is dead.
                    -- Same finding as refreshState -- see the note there.
                    Spins = tonumber(d.Extra) or tonumber(d.Spins),
                    Slots = { [key] = plainCopy(slot, 0) },
                }
            end)
            return ok and result or nil
        end
    end

    -- Low-frequency commands from the main VM.
    local cmd = MPS:FindFirstChild('VCP_CMD')
    if cmd then
        cmd.Event:Connect(function(what, arg)
            if what == 'reset' then
                pcall(function()
                    local V = CoreTable.Cache.Variables
                    if V then
                        if V.Reloading ~= nil then V.Reloading = false end
                        if V.Action    ~= nil then V.Action    = false end
                        if V.HitLag    ~= nil then V.HitLag    = false end
                        if V.KillCam   ~= nil then V.KillCam   = false end
                        if V.Slash then V.Slash.Slashing = false; V.Slash.Active = false end
                    end
                end)
            elseif what == 'refill' then
                pcall(function() CoreTable:Send('Attacks', 'Reload', arg) end)
                pcall(function() CoreTable:Send('Equipment', 'Reload', arg) end)
            elseif what == 'bladereload' then
                pcall(function() CoreTable:Invoke('Blades', 'Reload') end)
                pcall(function() CoreTable:Invoke('Spears', 'Reload') end)
            end
        end)
    end
]]

local BRIDGE = { td = nil, cmd = nil, data = nil, started = false }

local function setupBridge(actorInstance)
    if BRIDGE.started then return end
    BRIDGE.started = true

    for _, name in ipairs({ "VCP_TD", "VCP_CMD", "VCP_DATA", "Remote" }) do
        local old = MarketplaceService:FindFirstChild(name)
        if old then pcall(function() old:Destroy() end) end
    end

    local data = Instance.new("BindableFunction")
    data.Name = "VCP_DATA"
    data.Parent = MarketplaceService
    BRIDGE.data = data

    local td = Instance.new("NumberValue")
    td.Name = "VCP_TD"
    td.Value = 0
    td.Parent = MarketplaceService
    BRIDGE.td = td

    local cmd = Instance.new("BindableEvent")
    cmd.Name = "VCP_CMD"
    cmd.Parent = MarketplaceService
    BRIDGE.cmd = cmd

    if actorInstance and EXEC.runOnActor then
        task.spawn(function()
            pcall(EXEC.runOnActor, actorInstance, K.ACTOR_SRC)
        end)
        log("ACTOR", "combat actor attached")

        -- Hand the save reader to §14. Invoke is only attempted once the actor
        -- has actually installed its handler — invoking a BindableFunction
        -- with no OnInvoke set raises, and getSave calls this on a timer.
        task.spawn(function()
            local ready = waitUntil(function()
                local ok, res = pcall(function() return data:Invoke("save") end)
                return ok and type(res) == "table" and res.Slots ~= nil
            end, 30, 0.5)
            if ready then
                ACTOR_SAVE_READER = function() return data:Invoke("save") end
                log("ACTOR", "save bridge live — mission save reads are local again")
            else
                log("ACTOR", "save bridge did not come up; missions will use the remote")
            end
        end)
    else
        log("ACTOR", "run_on_actor unavailable — main-VM combat path only")
    end
end

local function actorCmd(what, arg)
    if BRIDGE.cmd then pcall(function() BRIDGE.cmd:Fire(what, arg) end) end
end

local function timeDifference()
    return BRIDGE.td and BRIDGE.td.Value or 0
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 21 · OUTBOUND COMBAT RATE LIMITER
--     Hard ceiling on combat remotes per second, enforced at the send site so
--     no bug anywhere upstream can turn into a flood. A ring of timestamps is
--     cheaper than a table of them because it never allocates or shifts.
-- ═══════════════════════════════════════════════════════════════════════════
local RATE = {
    ring = table.create and table.create(128, 0) or {},
    n    = 0,          -- total sends ever; ring slot is ((n - 1) % size) + 1
    size = 128,
    dropped = 0,
}
for i = 1, RATE.size do RATE.ring[i] = 0 end

local function rateAllow()
    local now = os.clock()
    local ceiling = math.min(COMBAT.sendCeiling, RATE.size)
    if RATE.n >= ceiling then
        -- Timestamp of the send `ceiling` sends ago. If it is less than a
        -- second old then `ceiling` sends have already happened this second.
        local slot = ((RATE.n - ceiling) % RATE.size) + 1
        if now - RATE.ring[slot] < 1.0 then
            RATE.dropped = RATE.dropped + 1
            return false
        end
    end
    RATE.n = RATE.n + 1
    RATE.ring[((RATE.n - 1) % RATE.size) + 1] = now
    return true
end

-- ════════════════════════════════════════════════════════════════════════════
-- 21a · FRAME CLOCK  +  WALL-CLOCK SEND BUDGET
--
--     THE PROBLEM THIS SOLVES.
--     Every loop in this file yields with task.wait(), and task.wait() resumes
--     on the first Heartbeat AFTER its delay. Heartbeat is once per RENDERED
--     FRAME. So at the 5 fps cap a multi-window box runs at, one frame is
--     200 ms and *every* task.wait under 0.2s costs a full 200 ms — the combat
--     loop gets five opportunities a second, not sixty.
--
--     That was fatal to the old pacing, which scheduled the next pulse at
--     `nextHit = now + fired / hitBudget`. Worked example, 30 titans in range,
--     one-shot, sendCeiling 96 after the multi-instance derate:
--
--         hitBudget = 96 - 1/0.11        = 86.9 sends/s
--         burst     = max(cap 10, 24)    = 24 napes in the pulse
--         pace      = 24 / 86.9          = 0.276 s
--
--     0.276s is not a frame boundary. At 200 ms frames the next pulse can only
--     land at 0.400s, so the client sent 24 every 0.4s = 60/s against an 86.9/s
--     budget. Thirty-one percent of the allowance was unspendable, and the
--     harder the run the more it cost: at ~23 sends per kill on Aberrant that
--     is a 15.3s clear where 10.6s was available.
--
--     THE FIX. Pace in seconds, not in frames. A token bucket refills at
--     `rate` tokens per WALL-CLOCK second and the pulse spends whole tokens out
--     of it, so the sends-per-second is identical at 5 fps and at 60 fps — only
--     the clumping changes (≈17 sends once per 200ms frame instead of ≈1.5
--     sends sixty times a second). The fractional remainder carries, so the
--     average is exact rather than rounded down every frame.
--
--     `burst` caps how much a stalled frame may cash out at once, so a hitch
--     cannot turn into a spike the server reads as a flood; rateAllow() below
--     remains the hard rolling-second backstop underneath it.
-- ════════════════════════════════════════════════════════════════════════════
K.FRAME = { dt = 1 / 60 }

-- One connection, an EMA so a single hitched frame does not move the estimate,
-- and an alive() guard so re-executing the script leaves the old one inert
-- rather than stacking a second writer on a dead K.
RunService.Heartbeat:Connect(function(step)
    if not alive() then return end
    K.FRAME.dt = K.FRAME.dt * 0.85 + math.clamp(step, 1 / 240, 1) * 0.15
end)

K.BUCKET = { tokens = 0, at = 0, rate = 0, burst = 0 }

-- Refill to `now` and return how many sends are available. Idempotent within a
-- tick: called twice with the same `now` the second call adds nothing.
function K.budget(now)
    local B   = K.BUCKET
    local dtF = math.clamp(K.FRAME.dt, 1 / 240, 1)
    -- What the slash actually costs, which is NOT 1/COMBAT.slash at a low frame
    -- rate: a schedule finer than the frame period cannot fire more than once a
    -- frame, so at 5 fps the slash spends 5/s, not 9.1/s. Charging the pulse for
    -- sends the slash never made would leave four a second permanently unused.
    local slashHz = math.min(1 / math.max(0.01, COMBAT.slash), 1 / dtF)
    local rate    = math.max(1, COMBAT.sendCeiling - slashHz)
    B.rate  = rate
    -- One frame's worth plus half, floored at COMBAT.cap so a 60fps client can
    -- still put out a normal pulse, ceilinged at 0.4s so a two-second stall
    -- cannot cash out into a 190-send burst when the frame finally lands.
    B.burst = math.max(COMBAT.cap, rate * math.min(0.4, dtF * 1.5))
    if B.at == 0 then
        B.at, B.tokens = now, math.min(B.burst, rate * dtF)
    else
        local d = now - B.at
        if d > 0 then
            B.at     = now
            B.tokens = math.min(B.burst, B.tokens + rate * math.min(d, 1.0))
        end
    end
    return B.tokens
end

function K.spend(n)
    K.BUCKET.tokens = math.max(0, K.BUCKET.tokens - (tonumber(n) or 0))
end

-- Pool comparator, hoisted out of the pulse. It used to be an inline closure
-- over WORK_RANGE and ONE_SHOT, i.e. one closure allocated per pulse per client
-- — sixty a second at 60 fps, times thirty clients, for a function whose body
-- never changes. The two captured values live on K.SORT instead.
K.SORT = { range = 0, mode = "oneshot" }   -- "oneshot" | "grind"

function K.poolLess(a, b)
    local ar = a.dist <= K.SORT.range
    local br = b.dist <= K.SORT.range
    if ar ~= br then return ar end
    -- A nape still inside its cooldown park is refused by the server, so it goes
    -- last in EITHER mode — never spend a slot on one while a fresh nape waits.
    if a.spent ~= b.spent then return not a.spent end
    if K.SORT.mode == "oneshot" then
        -- One send each kills one titan each, so breadth is the point; within a
        -- tier, nearest wins — it is the most likely to be credited.
        return a.dist < b.dist
    end
    -- GRIND: a single hit does not kill (titan HP scaled up by difficulty), so
    -- concentrate on the WEAKEST reachable nape. Spreading here only chips every
    -- titan a little and finishes none — which reads as damage numbers with no
    -- deaths. Each hit is still parked for the cooldown, so this cannot
    -- over-send one nape; it just re-hits whatever is closest to dying first.
    return a.hp < b.hp
end

local function sendSlash()
    if not rateAllow() then return false end
    -- Stamped for the reloader: the server refuses Blades/Reload while a swing
    -- is still live (measured: two nil replies straight after slashing, then
    -- true half a second later), so a swap has to wait this out.
    K.lastSlashAt = os.clock()
    return post("Attacks", "Slash", true)
end

-- The second argument of the Register payload is the player's speed at the
-- moment of the hit, not a range. v9 shipped a constant 400 there for a long
-- time, which is a perfect fingerprint: a character that is always moving at
-- exactly 400 studs/s is not a character. Read the real velocity, and when
-- parked (the normal case for aura farming) synthesise a plausible ODM speed.
--
-- One value per swing cycle, not per nape: a single character has exactly one
-- velocity at any instant, so six different speeds inside one frame is
-- physically impossible and stands out more than a constant would.
K.SWING = { vel = nil, at = 0 }

-- One-shot mode: when KillVelMin/Max are set the payload carries the kill
-- multiplier instead of a plausible ODM speed. Redrawn once per swing cycle so
-- a randomised range still shows one velocity per instant.
local function killVelocity()
    local lo = tonumber(CFG.KillVelMin)
    local hi = tonumber(CFG.KillVelMax) or lo
    if not lo then return nil end
    if not hi or hi < lo then hi = lo end
    if hi == lo then return lo end
    return lo + math.random() * (hi - lo)
end

-- One hit is one kill, so every extra send aimed at the same nape is thrown
-- away. ONE_SHOT switches targeting from "finish the weakest" to "touch as many
-- distinct titans as possible", and STRUCK remembers who already took a hit so
-- the next pulse spreads onto fresh napes instead of re-killing a corpse whose
-- Health has not replicated back yet.
local ONE_SHOT     = (tonumber(CFG.KillVelMin) or 0) > 0
local STRUCK       = {}
-- The server enforces a per-target hit cooldown, and this is our estimate of
-- it. Proven live rather than assumed: on Normal, spreading one send per nape
-- and parking it for 0.45s cleared 20 titans on 380 sends in 14s, while
-- ignoring the park and hammering the same napes took 1961 sends and 42s for
-- 22. Nine out of ten of those extra sends bought nothing, which is only
-- possible if the server was refusing them. Lower this only with the sends-per-
-- kill figure in front of you: below the real cooldown it rises sharply.
K.STRUCK_TTL   = math.clamp(num(CFG.HitCooldown, 0.45), 0.1, 2.0)

-- ── Is one send actually one kill? ─────────────────────────────────────────
--
-- "One-shot" is an assumption about the server's damage formula, not a fact,
-- and it stops being true as soon as the difficulty raises titan health.
-- Measured live on Chapel: Easy cleared 17 titans on 65 sends (~4 per kill,
-- slashes included), while Normal needed 380 sends for 20 (~19 per kill). The
-- spreading logic is built on the assumption -- STRUCK parks a nape for 0.45s
-- after one hit so the next pulse moves on -- which is exactly right when the
-- hit killed and exactly wrong when it did not. On Normal that capped
-- throughput at ~27 sends/s against a 96/s ceiling, i.e. a run three times
-- longer than the budget could serve.
--
-- So measure it instead. Each pulse's targets are re-checked a beat later; if
-- they are mostly still alive, stop spreading and go back to finishing the
-- weakest titan first.
local SHOT = { fired = 0, died = 0, grind = false, noted = false }

-- NB: `buf` is a RECYCLED SLOT POOL — the combat loop overwrites
-- slot.model/.nape/.hum/.hp/.dist in place every tick — so holding a reference
-- to targets[i] and reading it a beat later reads whichever titan now occupies
-- that slot, not the one we hit. Snapshot the two fields we care about.
local function shotObserve(targets, n)
    if n <= 0 then return end
    local watch = table.create and table.create(n) or {}
    for i = 1, n do
        local t = targets[i]
        watch[i] = { model = t and t.model, hum = t and t.hum }
    end
    task.spawn(function()
        task.wait(0.45)
        local dead = 0
        for i = 1, n do
            local t = watch[i]
            local gone = false
            pcall(function()
                gone = (not t.hum) or (not t.hum.Parent) or t.hum.Health <= 0
                    or (not t.model) or (not t.model.Parent)
            end)
            if gone then dead = dead + 1 end
        end
        SHOT.fired = SHOT.fired + n
        SHOT.died  = SHOT.died + dead
        if SHOT.fired < 40 then return end
        local rate = SHOT.died / SHOT.fired
        local was  = SHOT.grind
        if rate < 0.45 then SHOT.grind = true
        elseif rate > 0.75 then SHOT.grind = false end
        SHOT.fired, SHOT.died = 0, 0
        if SHOT.grind ~= was or not SHOT.noted then
            SHOT.noted = true
            log("COMBAT", ("%.0f%% of hits killed outright (%s)")
                :format(rate * 100,
                        SHOT.grind and "multi-hit titans" or "one-shot titans"))
        end
    end)
end

local function swingVelocity()
    local now = os.clock()
    if K.SWING.vel and (now - K.SWING.at) < 0.2 then return K.SWING.vel end
    local kv = killVelocity()
    if kv then
        K.SWING.vel = kv
        K.SWING.at  = now
        return kv
    end
    local v = 0
    pcall(function()
        local c = plr.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if h then v = h.AssemblyLinearVelocity.Magnitude end
    end)
    if v < 20 then v = 80 + math.random() * 220 end
    K.SWING.vel = v * (0.95 + math.random() * 0.1)
    K.SWING.at  = now
    return K.SWING.vel
end

local function sendHit(part, vel, td)
    if not rateAllow() then return false end
    return post("Hitboxes", "Register", part, vel, td)
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 21c · VOLLEY FIRE
--     Measured live 2026-09-23 (Chapel / Aberrant, place v98) by pausing the
--     farm mid-mission and counting the server's own damage receipts
--     (POST "Zones","Damage_Check"(damage, _, crit, finisher, killed) -- the
--     call the game uses to draw its damage numbers):
--
--       · The server accepts about ONE Attacks/Slash per second, and each
--         accepted slash credits up to NINE Registers, each on a DIFFERENT
--         titan. Sending twenty after the slash still credits nine; a Register
--         with no accepted slash in front of it credits nothing.
--       · Slash + 20 napes every 0.6s at the 5fps cap: 27 credited and 20
--         kills in 3.2s -- bursts of exactly 9,9,9. The whole 41-titan
--         Aberrant map died in about six seconds.
--       · The same titan hit on every frame is refused (0.25 credited/s), and
--         one Register per slash can never beat ~1/s. That is what the old
--         flood got wrong: ninety Registers a second behind one Slash per
--         frame, most of them following slashes the server had refused.
--       · Distance does not matter (credited at 4,654 studs, refused at 123
--         when the slash was not accepted). The speed argument is ignored
--         (99999 / 300 / 3999960 all ~41-51K) but must be a number.
--       · Blade wear is per accepted slash, not per titan hit: ~2 blades per
--         volley, so one set covers roughly sixty kills.
--
--     So: a VOLLEY = one Slash then up to VolleySize Registers on distinct
--     titans, sent the moment the server can accept a slash again. The
--     receipts come back in Register order, so each one is matched to the
--     titan it hit -- a titan that survived its hit is first in line for the
--     next volley, and a killed one is never hit again.
-- ═══════════════════════════════════════════════════════════════════════════
K.FOCUS = {
    volley = nil,           -- { at=, list={models}, got= } the last volley sent
    lastAccept = 0,         -- send time of the last volley the server credited
    nextAt = 0,             -- earliest time for the next volley
    gap = nil,              -- learned slash-accept interval (seconds)
    armed = nil,            -- first volley since the last credit (starvation clock)
    lastCredit = os.clock(),
    starvedAt = 0,
    credited = 0, kills = 0, dmgTotal = 0, volleys = 0, accepted = 0,
    maxBurst = 0,
    rateAt = os.clock(), rateN = 0, rate = 0,
    dmg  = setmetatable({}, { __mode = "k" }),   -- model -> damage it has taken from us
    dead = setmetatable({}, { __mode = "k" }),   -- model -> when its kill receipt came
}

function K.focusOn()
    return CFG.VolleyFire ~= false
end

-- The server's hit receipts, matched to the volley that earned them.
function K.focusHook()
    local F = K.FOCUS
    if F.conn or not POST then return end
    F.conn = POST.OnClientEvent:Connect(function(a, b, dmg, _, _, _, killed)
        if a ~= "Zones" or b ~= "Damage_Check" then return end
        if not alive() then
            if F.conn then F.conn:Disconnect(); F.conn = nil end
            return
        end
        local now = os.clock()
        local d = tonumber(dmg) or 0
        F.credited   = F.credited + 1
        F.dmgTotal   = F.dmgTotal + d
        F.lastCredit = now
        F.armed      = nil
        local v = F.volley
        if v then
            if v.got == 0 then
                -- First receipt of this volley: its slash was accepted. The next
                -- one cannot be accepted for about a gap, so hold volleys until
                -- then. The gap is learned from accepted-to-accepted spacing.
                F.accepted = F.accepted + 1
                if F.lastAccept > 0 then
                    local g = v.at - F.lastAccept
                    if g > 0.3 and g < 3 then
                        F.gap = F.gap and math.min(F.gap * 0.8 + g * 0.2, g + 0.05) or g
                    end
                end
                F.lastAccept = v.at
                F.nextAt = math.max(F.nextAt,
                    v.at + math.max(0.4, (F.gap or num(CFG.VolleyGap, 0.95)) - 0.08))
            end
            v.got = v.got + 1
            if v.got > F.maxBurst then F.maxBurst = v.got end
            local m = v.list[v.got]
            if m then
                F.dmg[m] = (F.dmg[m] or 0) + d
                if killed == true then F.dead[m] = now end
            end
        end
        if killed == true then F.kills = F.kills + 1 end
    end)
end

-- A pool entry still worth a Register: parented, humanoid still attached (the
-- server detaches it at death, before the model leaves the folder), and no
-- kill receipt for it in the last few seconds.
function K.focusValid(e, now)
    local m = e and e.model
    if not (m and m.Parent and e.nape and e.nape.Parent) then return false end
    if e.hum and not e.hum.Parent then return false end
    local dt = K.FOCUS.dead[m]
    -- Short on purpose: receipts are matched to titans by order, and one
    -- refused Register shifts the match -- a live titan wrongly marked dead
    -- must not sit out the tail of the run. The detached humanoid above is
    -- the real death signal; this only covers its replication delay.
    if dt and now - dt < 1.2 then return false end
    return true
end

-- Up to `k` distinct targets: titans that already took a hit and survived
-- first (the next hit finishes them), then the nearest.
function K.focusPick(pool, pn, now, k)
    local F = K.FOCUS
    local out, on = {}, 0
    local cand, cn = {}, 0
    for i = 1, pn do
        local e = pool[i]
        if K.focusValid(e, now) then cn = cn + 1; cand[cn] = e end
    end
    if cn == 0 then return out, 0 end
    if cn > k then
        table.sort(cand, function(x, y)
            local dx, dy = F.dmg[x.model] or 0, F.dmg[y.model] or 0
            if dx ~= dy then return dx > dy end
            return x.dist < y.dist
        end)
    end
    for i = 1, math.min(k, cn) do on = on + 1; out[on] = cand[i] end
    return out, on
end

-- One volley. Returns the Registers sent.
function K.focusPulse(pool, pn, now, vel, td)
    local F = K.FOCUS
    if now < F.nextAt then return 0 end
    -- Wait for the previous volley's receipts before judging it: a new volley
    -- inside the round trip would both mis-attribute the receipts and hand
    -- the server a slash it is about to refuse.
    local v = F.volley
    if now - (F.pingAt or 0) > 5 then
        F.pingAt = now
        local ms
        pcall(function() ms = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        ms = tonumber(ms)
        -- A full round trip plus a frame of slack; never shorter than the config.
        F.replyWait = math.max(num(CFG.VolleyReplyWait, 0.3),
                               math.min(1.2, (ms and ms > 0) and (ms / 1000 * 1.3 + 0.05) or 0))
    end
    if v and v.got == 0 and (now - v.at) < (F.replyWait or num(CFG.VolleyReplyWait, 0.3)) then
        return 0
    end
    local size = math.clamp(math.floor(num(CFG.VolleySize, 12)), 1, 40)
    local targets, tn = K.focusPick(pool, pn, now, size)
    if tn == 0 then return 0 end
    if not sendSlash() then return 0 end
    local list, sent = {}, 0
    for i = 1, tn do
        if sendHit(targets[i].nape, vel, td) then
            sent = sent + 1
            list[sent] = targets[i].model
        end
    end
    F.volley  = { at = now, list = list, got = 0 }
    F.volleys = F.volleys + 1
    -- A refused volley is retried right after the reply window; an accepted
    -- one pushes nextAt out by the learned gap (see focusHook).
    F.nextAt = now + num(CFG.VolleyRetry, 0.2)
    if sent > 0 and not F.armed then F.armed = now end
    return sent
end

-- Volleys going out and not ONE credited hit: the blades are spent
-- server-side even though the rig still draws them. Treat it as a break, at
-- most once per 20s so a genuinely unkillable phase cannot eat every set.
function K.focusStarved(now)
    local F = K.FOCUS
    if not F.armed then return false end
    if (now - F.lastCredit) < 5 or (now - F.armed) < 4 then return false end
    if (now - F.starvedAt) < 20 then return false end
    F.starvedAt = now
    log("COMBAT", "no credited hit in 5s of volleys — treating the blades as spent")
    return true
end

-- Credited hits per second over the last few seconds, for the status line.
function K.focusRate(now)
    local F = K.FOCUS
    local dt = now - F.rateAt
    if dt >= 3 then
        F.rate = (F.credited - F.rateN) / dt
        F.rateAt, F.rateN = now, F.credited
    end
    return F.rate
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 21b · HITALL SWEEP
--     Reach was never the real problem -- PRESENCE was. The server judges a
--     Register against where the character actually is, and the character can
--     only be in one place. So stop trying to reach further and start being
--     everywhere, one frame at a time.
--
--     Why a frame per nape rather than a burst inside one frame: repeated
--     CFrame writes in a single frame do not replicate individually. The
--     server only ever sees the LAST position of that frame, so a burst of
--     forty teleports would arrive as one teleport and thirty-nine hits judged
--     from the wrong place. Yielding to Heartbeat is what makes each position
--     real to the server before the hit that depends on it.
--
--     The cost is bounded and small: one frame per titan, ~1.3s to visit forty
--     napes, against most of a minute spent flying between them.
-- ═══════════════════════════════════════════════════════════════════════════
local SWEEP = {
    next = 0, running = false, visited = 0, at = 0, hurt = false, lift = nil,
    -- Adaptive dwell: how long to sit at a stop before firing, in seconds.
    -- Nothing about this is guessable up front -- it is a network property, not
    -- a game one -- so it starts from the measured ping and is then tuned
    -- against how many of the titans we hit actually died.
    dwell = nil, fired = 0, landed = 0, rounds = 0, stops = 0,
}

-- One-way latency, in seconds. The server judges a Register against the
-- position it currently holds for the character, and a teleport does not reach
-- it for at least one network step plus the trip. Measured live on this
-- account: Data Ping ~190ms, against a sweep that waited a single 60fps frame
-- (16ms) before firing -- so the server was still being asked to credit a hit
-- from wherever the character stood six napes ago. That is the whole reason the
-- sweep visited ten napes a second and killed almost none of them.
local function oneWayLatency()
    local ms
    pcall(function() ms = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    ms = tonumber(ms)
    if not ms or ms <= 0 then return 0.09 end
    return math.clamp((ms / 1000) * 0.5, 0.02, 0.30)
end

local function sweepDwell()
    local fixed = tonumber(CFG.HitAllSweepDwell)
    if fixed then return math.clamp(fixed, 0.016, 0.6) end
    if not SWEEP.dwell then
        -- One trip for the CFrame to arrive, plus a network step of slack.
        SWEEP.dwell = math.clamp(oneWayLatency() + 0.05, 0.06, 0.35)
    end
    return SWEEP.dwell
end

-- Grade the last sweep and move the dwell toward whatever is landing. Called a
-- beat after the sweep so the deaths have had time to replicate back.
local function sweepGrade(batch, fired)
    if fired <= 0 or CFG.HitAllSweepAdapt == false then return end
    local dead = 0
    for _, t in ipairs(batch) do
        local gone = true
        pcall(function()
            gone = (not t.hum) or (not t.hum.Parent) or t.hum.Health <= 0
                or (not t.model) or (not t.model.Parent)
        end)
        if gone then dead = dead + 1 end
    end
    SWEEP.fired  = SWEEP.fired + fired
    SWEEP.landed = SWEEP.landed + dead
    SWEEP.rounds = SWEEP.rounds + 1
    if SWEEP.rounds < 3 then return end

    local rate = SWEEP.landed / math.max(1, SWEEP.fired)
    local was  = sweepDwell()

    -- Give up on touring entirely when it is not paying.
    --
    -- Measured live on Chapel at ~190ms ping: 4-28% of sweep sends were ever
    -- credited, even sitting 350ms on each nape. Meanwhile the ordinary pulse
    -- — stand still, let the pack walk in, fire at what is inside the radius —
    -- was killing one titan per second at three sends per kill. The sweep runs
    -- INLINE, so every second it spends touring is a second the pulse is not
    -- firing: with the sweep on, an 18-titan Easy run took 28-70s; with it off,
    -- the same run took 16.6s. A mechanism that cannot beat standing still is
    -- worse than nothing, so measure it and switch it off rather than assuming
    -- either way.
    SWEEP.graded = (SWEEP.graded or 0) + 1
    if rate < 0.25 and was >= 0.2 and SWEEP.graded >= 2 and not SWEEP.dead then
        SWEEP.dead = true
        log("SWEEP", ("only %.0f%% credited at %.0fms dwell — touring is losing to "
            .. "standing still, sweep off for this run"):format(rate * 100, was * 1000))
    end

    if tonumber(CFG.HitAllSweepDwell) == nil then
        if rate < 0.45 then
            -- Most sends are not being credited: the character is not where the
            -- server thinks it is yet, so buy more time per stop.
            SWEEP.dwell = math.min(0.35, was * 1.3 + 0.01)
        elseif rate > 0.85 then
            -- Nearly everything lands; spend the surplus on visiting more.
            SWEEP.dwell = math.max(0.05, was * 0.9)
        end
    end
    local now = SWEEP.dwell or was
    if math.abs(now - was) > 0.004 then
        log("SWEEP", ("%d/%d credited (%.0f%%) - dwell %.0fms -> %.0fms")
            :format(SWEEP.landed, SWEEP.fired, rate * 100, was * 1000, now * 1000))
    end
    SWEEP.fired, SWEEP.landed, SWEEP.rounds = 0, 0, 0
end

-- Pick stop points that cover the most napes at once.
--
-- The old sweep treated one nape as one stop, which is only correct if the
-- server credits a hit at zero range. It does not: the ordinary in-range pulse
-- fires `cap` napes from a single standing position every pulse and they are
-- credited, which is direct proof that one stop can serve every nape inside the
-- working radius rather than only the one underneath it. Greedy max-coverage
-- over that radius turns a forty-stop tour into a handful of stops, and the
-- tour is where the time was going.
local function sweepStops(targets, count, reach)
    local taken, stops = {}, {}
    local remaining = count
    -- Snapshot every nape position ONCE. This function never yields, so the
    -- positions are invariant for its whole run. Instance.Position is a
    -- cross-boundary property read; the greedy loop below would otherwise
    -- re-read each nape O(count) times per pass (worst case ~24*count*count
    -- boundary reads). Snapshotting leaves only cheap Vector3 math in the loop.
    local pos = table.create and table.create(count) or {}
    for i = 1, count do pos[i] = targets[i].nape.Position end
    while remaining > 0 and #stops < 24 do
        local best, bestN = nil, -1
        for i = 1, count do
            if not taken[i] then
                local n  = 0
                local pi = pos[i]
                for j = 1, count do
                    if not taken[j] and (pos[j] - pi).Magnitude <= reach then
                        n = n + 1
                    end
                end
                if n > bestN then best, bestN = i, n end
            end
        end
        if not best then break end
        local members, pi = {}, pos[best]
        for j = 1, count do
            if not taken[j] and (pos[j] - pi).Magnitude <= reach then
                taken[j]  = true
                remaining = remaining - 1
                members[#members + 1] = targets[j]
            end
        end
        stops[#stops + 1] = { at = pi, members = members }
    end
    return stops
end

local function hitAllSweep(hrp, hum, targets, count, vel, td, home, reach)
    if SWEEP.running or SWEEP.dead then return 0 end
    SWEEP.running = true

    local sent  = 0
    local dwell = sweepDwell()
    -- Firing radius: how far a stop can credit. Grouping radius: how tightly to
    -- cluster the stops. They are NOT the same number — with the working range
    -- now 6000 studs, using it to group collapses every titan on the map into
    -- one stop and the tour stops touring.
    reach = math.max(80, num(reach, 380))
    local group = math.min(reach, math.max(80, num(CFG.HitAllSweepGroup, 380)))
    -- Never closer than 90 studs, whatever the config says. SWEEP.lift climbs
    -- on evidence: if we get hit while sweeping, the working height was too low
    -- for this map's titans, so the next sweep sits higher rather than
    -- repeating the same mistake at every stop.
    SWEEP.lift  = SWEEP.lift or math.max(90, num(CFG.HitAllSweepOffset, 140))
    local base  = math.max(90, num(CFG.HitAllSweepOffset, 140))
    local lift  = SWEEP.lift
    local hp0   = (hum and hum.Health) or 0
    -- The sweep runs INLINE in the combat loop: while it tours, slashes stop
    -- and the stuck detector is blind. Bound it in wall-clock so a map with a
    -- hundred titans cannot hand the loop away for ten seconds.
    local t0     = os.clock()
    local budget = num(CFG.HitAllSweepBudget, 2.5)
    local batch  = {}

    -- Frame rate IS stop rate here, so uncap for the duration.
    -- Only lift the cap if we are the one who set it. Raising an operator's
    -- own cap for the duration of a sweep is the same overreach as setting it
    -- at boot.
    local fps = tonumber(CFG.HitAllSweepFPS)
    if not tonumber(CFG.AntiLagFPS) then fps = nil end
    if fps and EXEC.setfpscap then pcall(function() EXEC.setfpscap(fps) end) end

    -- pcall the body, but restore the anchor unconditionally afterwards: a
    -- sweep that errors halfway must not leave the character parked on top of
    -- whichever titan it happened to be visiting.
    pcall(function()
        local stops = sweepStops(targets, count, group)
        SWEEP.stops = #stops
        for si = 1, #stops do
            local stop = stops[si]
            -- Blades break DURING a sweep, and a broken blade turns every
            -- remaining send into a rejected one. Checked per stop rather than
            -- per nape: bladeCount walks the rig, and one walk per nape is a
            -- cost of its own.
            if bladeBroken() then break end
            if (os.clock() - t0) > budget then break end
            -- Taking damage at all means something reached us, and continuing
            -- the tour would walk the character past thirty more of them.
            if hum and (hum.Health <= 0 or hum.Health < hp0) then
                SWEEP.hurt = true
                SWEEP.lift = math.min(420, lift + 80)
                log("SWEEP", ("took damage at %d studs - sweeping from %d next")
                    :format(lift, SWEEP.lift))
                break
            end

            local p = stop.at
            snapTo(hrp, Vector3.new(p.X, p.Y + lift, p.Z))
            -- Sit still long enough for that position to reach the server. This
            -- is the load-bearing line of the whole sweep.
            local deadline = os.clock() + dwell
            repeat RunService.Heartbeat:Wait() until os.clock() >= deadline or not hrp.Parent
            if not hrp.Parent or (hum and hum.Health <= 0) then break end

            -- Everything this stop can reach, in one burst from one position --
            -- the same shape as the ordinary pulse, which is known to be
            -- credited.
            for _, t in ipairs(stop.members) do
                if t.nape and t.nape.Parent and t.hum and t.hum.Parent and t.hum.Health > 0 then
                    if sendHit(t.nape, vel, td) then
                        sent = sent + 1
                        -- snapshot, not the live buf slot (see shotObserve)
                        batch[#batch + 1] = { model = t.model, hum = t.hum }
                    end
                end
            end
            -- One more frame before leaving: the hit is judged a beat after it
            -- is sent, and teleporting away in between is what would make it
            -- miss.
            RunService.Heartbeat:Wait()
        end
    end)

    if fps and EXEC.setfpscap then
        -- Back to whatever this client normally runs at: 15 under anti-lag,
        -- 30 otherwise (see the boot-time cap).
        pcall(function()
            local cap = tonumber(CFG.AntiLagFPS)
            if cap then EXEC.setfpscap(math.floor(cap)) end
        end)
    end

    -- Unprotected before: snapTo -> ensureHover parents a BodyPosition, which
    -- throws if the character is destroyed in the window after the hrp.Parent
    -- test. That threw out of the function with SWEEP.running still true, and
    -- the sweep then refused to run for the rest of the session.
    pcall(function()
        if home and hrp and hrp.Parent then snapTo(hrp, home) end
    end)
    SWEEP.running = false
    SWEEP.visited = sent
    SWEEP.at      = os.clock()
    -- A tour that finished untouched may sit lower next time, so one bad map
    -- does not pin the sweep at 420 studs for the rest of the run.
    if not SWEEP.hurt and SWEEP.lift > base then
        SWEEP.lift = math.max(base, SWEEP.lift - 20)
    end
    if sent > 0 then
        task.spawn(function()
            task.wait(0.7)
            pcall(sweepGrade, batch, sent)
        end)
    end
    return sent
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 22 · TITAN REGISTRY
--     v9 called TitansFolder:GetChildren() every combat tick and rebuilt the
--     alive list from scratch, allocating two tables per tick per client. v10
--     maintains the set incrementally from ChildAdded/ChildRemoved and only
--     re-reads health, which is the part that actually changes.
-- ═══════════════════════════════════════════════════════════════════════════
local TITANS = { folder = nil, set = {}, count = 0, blacklist = {} }

local function titanNape(model)
    return model:FindFirstChild("Nape", true)
end

local function trackTitan(model)
    if TITANS.set[model] then return end
    TITANS.set[model] = { model = model, nape = nil, hum = nil, root = nil }
    TITANS.count = TITANS.count + 1
    -- Nape and Humanoid stream in a beat after the model does.
    task.spawn(function()
        for _ = 1, 40 do
            if not model.Parent then return end
            local e = TITANS.set[model]
            if not e then return end
            e.nape = e.nape or titanNape(model)
            e.hum  = e.hum  or model:FindFirstChildWhichIsA("Humanoid")
            e.root = e.root or model:FindFirstChild("HumanoidRootPart") or e.nape
            if e.nape and e.hum and e.root then return end
            task.wait(0.1)
        end
    end)
end

local function untrackTitan(model)
    local e = TITANS.set[model]
    if e then
        TITANS.set[model] = nil
        TITANS.count = math.max(0, TITANS.count - 1)
        -- Kills are NOT scored here, and the old test that tried to could never
        -- once have fired. Titan health is not replicated to this client: every
        -- Humanoid under Workspace.Titans reads 100/100 for its whole life, and
        -- the server detaches the Humanoid (Parent = nil, Health STILL 100)
        -- before the model leaves the folder. Measured on 7/7 removals on a live
        -- Chapel/Aberrant run. So `died = e.hum.Health <= 0` was false every
        -- time and STATE.kills sat at 0 for entire sessions -- the panel read
        -- "Titans killed 0", kills/hr never left "measuring", and every Discord
        -- report carried a zero. K.killAccrue reads the server's Slay counter.
    end
    TITANS.blacklist[model] = nil
end

local function bindTitans(folder)
    TITANS.folder = folder
    if not folder then return end
    for _, t in ipairs(folder:GetChildren()) do trackTitan(t) end
    folder.ChildAdded:Connect(trackTitan)
    folder.ChildRemoved:Connect(untrackTitan)
end

-- Ice Burst titans carry a Fake model containing Blue_Lines. Used by the
-- Utgard Thunder Spear objective.
local function isIceBurst(model)
    local fake = model and model:FindFirstChild("Fake")
    return fake ~= nil and fake:FindFirstChild("Blue_Lines") ~= nil
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 23 · ADAPTIVE RATE TUNER
--     Walks the live hit interval down toward the preset floor while the
--     server keeps crediting damage, and backs off the moment it stops. That
--     covers both server-side rate limiting and a shadow-ban style silent
--     drop, without needing to know the exact limit in advance.
--
--     Damage credited is measured as total titan health lost per window, which
--     is the only signal the client can observe that actually proves the
--     server processed a hit.
-- ═══════════════════════════════════════════════════════════════════════════
local TUNER = {
    lastHealth  = nil,
    windowStart = 0,
    windowHits  = 0,
    windowDmg   = 0,
    scale       = 1.0,      -- multiplier on the interval; 1.0 = preset speed
    lastAdjust  = 0,
    lastDPS     = nil,      -- previous window's credited damage per second
    lastRate    = nil,      -- previous window's sends per second
}

-- ═══════════════════════════════════════════════════════════════════════════
-- 23b · THROUGHPUT GOVERNOR
--
--     Farm rate is gold-per-run divided by time-per-run. Raising the hit rate
--     only shortens time-per-run while the run is KILL-LIMITED — while there
--     is always another titan in range waiting to die. Once the bot clears
--     them faster than the map spawns them, the run becomes SPAWN-LIMITED:
--     time-per-run is fixed by the spawn schedule, and every extra hit remote
--     buys exactly nothing. It just adds traffic and risk.
--
--     Aberrant spawns 44-57 titans against a Slay requirement in the high 30s,
--     so this is not hypothetical — a fast build hits the spawn wall.
--
--     Each tick is classified:
--       idle    no titans alive at all      -> waiting on spawns
--       travel  titans alive, none in range -> repositioning
--       busy    at least one nape in range  -> actually killing
--
--     A high idle fraction means the ceiling is the map, not the client. The
--     governor then eases the rate back (free, costs nothing) and flags the
--     lobby to escalate the modifier profile instead, because per-run reward
--     is the only remaining lever.
-- ═══════════════════════════════════════════════════════════════════════════
local GOV = {
    idle = 0, travel = 0, busy = 0,
    at = 0,
    mode = "unknown",
    spawnLimitedRuns = 0,
}

-- THE VERDICT HAS TO CROSS A VM BOUNDARY.
--
-- govObserve runs inside a MISSION VM. Its only real consumer, chooseModifiers,
-- runs in the LOBBY VM -- a different place, and so a different Lua state.
-- Measured directly: a value stamped into _G AND into getgenv() at the menu
-- reads back nil after a single teleport. Both tables are rebuilt.
--
-- So `_G.VCP_SpawnLimited` was always nil at the point it was read, the
-- escalation test could never be true, and AutoModifierEscalate has never once
-- fired for anyone. Same shape of bug as the boost throttle, same fix: put the
-- verdict on disk, keyed per account, with a freshness window so a stale one
-- from a run that ended long ago cannot steer the next lobby.
K.GOV_FILE = ("VCPlus_Gov_%s_%s.txt"):format(tostring(game.GameId), tostring(plr.UserId))

K.govPublish = function(spawnLimited)
    pcall(function()
        if EXEC.writefile then
            EXEC.writefile(K.GOV_FILE, ("%d|%d"):format(os.time(), spawnLimited and 1 or 0))
        end
    end)
end

K.govSpawnLimited = function()
    local v = false
    pcall(function()
        if not (EXEC.isfile and EXEC.readfile and EXEC.isfile(K.GOV_FILE)) then return end
        local at, flag = tostring(EXEC.readfile(K.GOV_FILE)):match("^(%d+)|(%d)$")
        at = tonumber(at)
        -- Older than ten minutes describes a run that is long over.
        if at and os.time() - at <= 600 then v = (flag == "1") end
    end)
    return v
end

local function govObserve(alive_n, inRange_n)
    -- Cheapest reliable heartbeat in the combat loop: it is called on every
    -- tick from both the fighting branch and the nothing-in-range branch, so
    -- hanging kill accounting off it covers the whole run. Defined later (it
    -- needs objectiveValue), hence the K lookup rather than a direct call.
    if K.killAccrue then K.killAccrue() end
    if alive_n == 0 then
        GOV.idle = GOV.idle + 1
    elseif inRange_n == 0 then
        GOV.travel = GOV.travel + 1
    else
        GOV.busy = GOV.busy + 1
    end

    local now = os.clock()
    if now - GOV.at < 15 then return end
    GOV.at = now

    local total = GOV.idle + GOV.travel + GOV.busy
    -- Sized in TICKS, and a tick is a frame. 40 was two thirds of a second at
    -- 60fps and eight seconds at the 5fps cap — and if the combat loop spends
    -- part of the window blocked (a blade swap, an objective step) the count can
    -- miss it entirely and the governor then never reports at all. What it
    -- actually reads are FRACTIONS, which twenty samples estimate perfectly well.
    if total < 20 then return end            -- not enough signal yet

    local idleFrac   = GOV.idle / total
    local travelFrac = GOV.travel / total
    GOV.idle, GOV.travel, GOV.busy = 0, 0, 0

    local was = GOV.mode

    if idleFrac >= 0.35 then
        GOV.mode = "spawn-limited"
        -- Nothing to hit for a third of the time. Extra sends cannot help, so
        -- give some rate back rather than spending it on nothing.
        if CFG.AdaptiveRate then
            COMBAT.hit = math.min(COMBAT.baseHit * 1.35, COMBAT.hit * 1.15)
        end
        _G.VCP_SpawnLimited = true
        GOV.spawnLimitedRuns = GOV.spawnLimitedRuns + 1
    elseif idleFrac <= 0.12 then
        GOV.mode = "kill-limited"
        _G.VCP_SpawnLimited = false
    elseif travelFrac >= 0.40 then
        -- Titans exist but we spend most of the time flying to them. That is a
        -- positioning problem, not a rate problem — a wider hit radius or a
        -- tighter cluster choice helps, more remotes do not.
        GOV.mode = "travel-bound"
        _G.VCP_SpawnLimited = false
    else
        -- THE DEAD BAND. A healthy Chapel/Aberrant run measures idle 25-31%,
        -- which is above the kill-limited ceiling (0.12) and below the
        -- spawn-limited floor (0.35), with travel nowhere near 0.40. With no
        -- else branch the mode kept its initial "unknown" -- and since a
        -- teleport rebuilds GOV every mission, that meant EVERY mission. Live
        -- read after 4 completed runs and 536 sends: _G.VCP_GovMode = "unknown".
        -- The panel, the Discord report and VCP_INSPECT all showed it.
        GOV.mode = "balanced"
        _G.VCP_SpawnLimited = false
    end

    -- Exported so an external probe can read the throughput regime without
    -- calling VCP_INSPECT, which rebuilds the ladder and the modifier set.
    -- Published every classification rather than only on change: the reader
    -- treats a stale timestamp as "no verdict", so the file has to keep
    -- breathing while the regime holds steady.
    K.govPublish(GOV.mode == "spawn-limited")

    _G.VCP_GovMode  = GOV.mode
    _G.VCP_GovIdle  = idleFrac
    _G.VCP_GovTravel = travelFrac
    _G.VCP_Sends    = RATE.n
    _G.VCP_Drops    = RATE.dropped

    if GOV.mode ~= was then
        log("GOV", ("%s (idle %.0f%%, travel %.0f%%)%s")
            :format(GOV.mode, idleFrac * 100, travelFrac * 100,
                    GOV.mode == "spawn-limited"
                        and " — hit rate eased; raising reward per run instead"
                        or ""))
    end
end

local function tunerObserve(totalHealth, hits)
    if not CFG.AdaptiveRate then return end
    local now = os.clock()
    if TUNER.lastHealth and totalHealth < TUNER.lastHealth then
        TUNER.windowDmg = TUNER.windowDmg + (TUNER.lastHealth - totalHealth)
    end
    TUNER.lastHealth = totalHealth
    TUNER.windowHits = TUNER.windowHits + hits


    local elapsed = now - TUNER.windowStart
    if elapsed < 4 then return end
    local hitsThisWindow = TUNER.windowHits
    local dmgThisWindow  = TUNER.windowDmg
    TUNER.windowStart, TUNER.windowHits, TUNER.windowDmg = now, 0, 0
    if hitsThisWindow < 8 then return end   -- too little signal to judge

    local credited = dmgThisWindow > 0

    -- What we actually care about is damage per SECOND, not sends per second.
    -- Those two stop being the same thing as soon as the server declines to
    -- credit every send -- a per-target registration cooldown, a validation
    -- reject, anything. Past that point extra sends add traffic and no damage,
    -- and the old rule ("credited at all and nothing dropped -> speed up") could
    -- not see it, because a single credited hit in the window looked identical
    -- to a window where every hit landed.
    --
    -- So hill-climb on observed DPS instead. Each window is compared against the
    -- previous one: if we sped up and DPS did not follow, that direction is not
    -- paying and we give the step back. This can only ever spend LESS than the
    -- ceiling allows -- it never raises one -- and it converges on the rate
    -- where damage stops improving, which is exactly the rate worth sending.
    local dps  = dmgThisWindow / elapsed
    local rate = hitsThisWindow / elapsed

    if not credited then
        -- Nothing registered across a full window: back off hard.
        TUNER.scale = math.min(2.0, TUNER.scale + 0.25)
        log("RATE", ("no damage credited — backing off to x%.2f"):format(TUNER.scale))
    elseif RATE.dropped > 0 then
        -- Brushing our own limiter: the sends are being thrown away client-side.
        TUNER.scale = math.min(2.0, TUNER.scale + 0.05)
    elseif TUNER.lastDPS and TUNER.lastRate and rate > TUNER.lastRate * 1.05 then
        -- We are sending meaningfully faster than last window. Did it pay?
        if dps > TUNER.lastDPS * 1.03 then
            TUNER.scale = math.max(0.7, TUNER.scale - 0.05)   -- yes: keep going
        else
            -- No. The extra sends are not becoming damage, so stop buying them.
            TUNER.scale = math.min(2.0, TUNER.scale + 0.05)
            if not TUNER.plateauNoted then
                TUNER.plateauNoted = true
                log("RATE", ("DPS plateau at ~%.0f/s (%.0f dmg/s) — extra sends "
                    .. "are not being credited, holding here"):format(rate, dps))
            end
        end
    else
        -- Not faster than last window and everything is landing: try a step up.
        TUNER.scale = math.max(0.7, TUNER.scale - 0.05)
    end

    TUNER.lastDPS, TUNER.lastRate = dps, rate
    RATE.dropped = 0

    -- Hard-clamp the scale before it is applied anywhere.
    --
    -- `scale` multiplies the INTERVAL, so a large value is a large slowdown, not
    -- a speedup -- an easy thing to get backwards when reading the field name.
    -- At scale 9999 this would set hit = 0.10 * 9999 = 999.9s and cap = 2, and
    -- the damage is delayed rather than obvious: budget pacing uses
    -- fired/hitBudget whenever something was hit, so it looks normal right up
    -- until the first pulse with nothing in range schedules the next one ~17
    -- minutes out. Recovery is worse -- the tuner only steps down 0.05 per 4s
    -- window, so climbing back from 9999 to the 0.7 floor takes about nine days.
    --
    -- The adaptive band is [0.7, 2.0] by construction, so anything outside it is
    -- a typo or a misreading. Fold it back in rather than honouring it.
    TUNER.scale = math.clamp(tonumber(TUNER.scale) or 1.0, 0.7, 2.0)

    COMBAT.hit = COMBAT.baseHit * TUNER.scale
    COMBAT.cap = math.max(2, math.floor(COMBAT.baseCap / math.max(0.5, TUNER.scale)))

    -- Clamp to what the rate limiter can actually pass.
    --
    -- cap targets fired every `hit` seconds demands cap/hit sends per second.
    -- Anything above sendCeiling is discarded by rateAllow() before it leaves
    -- the client — so driving the pair past that point does not add throughput,
    -- it just burns CPU building pools and pumps the drop counter. Measured on
    -- a live run the tuner had reached cap 25 at hit 0.084s, asking for ~298/s
    -- against a 110/s ceiling: roughly 63% of intended sends thrown away, and
    -- both parameters 2.7x past the point where they could change anything.
    --
    -- Holding the pair inside the feasible region also stops the tuner reading
    -- its own clamping as "the server is not crediting" and backing off.
    -- Slashes come out of the same budget, so subtract them before dividing the
    -- remainder among hit targets. Ignoring that overspends by 1/slash per
    -- second — about 9/s at Nitro — and the overspend is silently discarded.
    local slashCost = 1 / math.max(0.01, COMBAT.slash)
    local hitBudget = math.max(1, COMBAT.sendCeiling - slashCost)
    local demand = COMBAT.cap / math.max(0.01, COMBAT.hit)
    if demand > hitBudget then
        COMBAT.cap = math.max(2, math.floor(hitBudget * COMBAT.hit))
        if not TUNER.clampNoted then
            TUNER.clampNoted = true
            log("RATE", ("cap clamped to %d — %d/s ceiling with a %.3fs interval "
                .. "cannot pass more"):format(COMBAT.cap, COMBAT.sendCeiling, COMBAT.hit))
        end
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 24 · MISSION OBJECTIVE READERS
--     ReplicatedStorage.Objectives holds one value per active objective, each
--     with a Requirement attribute. Reading it is how the bot knows when to
--     switch behaviour mid-mission instead of guessing from titan counts.
-- ═══════════════════════════════════════════════════════════════════════════
local function objectiveValue(name)
    local f = ReplicatedStorage:FindFirstChild("Objectives")
    local v = f and f:FindFirstChild(name)
    if not v then return nil, nil end
    local req = v:GetAttribute("Requirement")
    return num(v.Value), req and num(req) or nil
end

-- Kill accounting.
--
-- The client is never told a titan's health (see untrackTitan), so the only
-- honest kill count available is the server's own: ReplicatedStorage.Objectives
-- .Slay, the same NumberValue the mission HUD renders as "39 / 39".
--
-- Slay restarts at 0 every mission while STATE.kills is cumulative for the
-- session, so accrue the DELTA. A value that went DOWN means a new run started,
-- and re-baselining there (rather than subtracting) is what keeps the session
-- total from walking backwards. Missions with no Slay objective at all -- Escort,
-- Retrieve Missing Supplies -- simply do not move it, which is honest: on those
-- the client has no kill signal to read.
K.slayLast = nil
K.killAt   = 0
K.killAccrue = function()
    local now = os.clock()
    if now - K.killAt < 0.25 then return end   -- called per frame; this is plenty
    K.killAt = now
    local cur = objectiveValue("Slay")
    if not cur then return end
    if K.slayLast and cur > K.slayLast then
        STATE.kills = STATE.kills + (cur - K.slayLast)
    end
    K.slayLast = cur
end

-- Every objective's value in one comparable string.
--
-- The stall watchdog used to watch the Slay counter alone. That is fine on a
-- Skirmish, but an ESCORT mission has no Slay objective at all -- its objective
-- list is literally { Escort = 0/1 } -- so objectiveValue("Slay") returns nil on
-- every tick, `slay ~= lastSlay` is false forever, and the watchdog declared the
-- run dead and abandoned it about 46 seconds in. The carriage needs far longer
-- than that to reach the Wall, which is why Escort sat at 0/1 no matter how well
-- the guarding went.
K.objectiveSignature = function()
    local f = ReplicatedStorage:FindFirstChild("Objectives")
    if not f then return "" end
    local parts = {}
    for _, v in ipairs(f:GetChildren()) do
        parts[#parts + 1] = v.Name .. "=" .. tostring(v.Value)
    end
    table.sort(parts)
    return table.concat(parts, ",")
end

local function objectiveDone(name)
    local cur, req = objectiveValue(name)
    if not cur or not req then return false end
    return cur >= req
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 25 · ESCORT CONVOY
--     workspace.Unclimbable.Objective holds several models named "Escort".
--     Exactly one of them is the real convoy — it has roughly double the max
--     health of the decoys (41 vs 21 on the maps this was measured on). If the
--     main convoy dies the Escort objective can never complete, so it is
--     always guarded first and the low-health cart is guarded next.
-- ═══════════════════════════════════════════════════════════════════════════
local ESCORT_RADIUS = 400   -- only engage titans this close to the convoy

local CART_CACHE = { list = nil, at = 0 }

local function findCarts()
    local now = os.clock()
    if CART_CACHE.list and (now - CART_CACHE.at) < 0.5 then return CART_CACHE.list end

    local carts = {}
    local unc = Workspace:FindFirstChild("Unclimbable")
    local objf = unc and unc:FindFirstChild("Objective")
    if objf then
        for _, model in ipairs(objf:GetChildren()) do
            if model.Name == "Escort" and not model:GetAttribute("Dead") then
                local cart   = model:FindFirstChild("Cart")
                local health = model:FindFirstChild("Health")
                local maxHP  = health and num(health:GetAttribute("Max_Health")) or 0
                local base   = cart and (cart:FindFirstChild("Main")
                                     or cart:FindFirstChild("LPCartBase")
                                     or cart:FindFirstChildWhichIsA("BasePart", true))
                if base and base:IsA("BasePart") then
                    carts[#carts + 1] = {
                        part   = base,
                        maxHP  = maxHP,
                        curHP  = health and num(health.Value) or 0,
                        isMain = maxHP > 25,
                    }
                end
            end
        end
    end

    table.sort(carts, function(a, b)
        if a.isMain ~= b.isMain then return a.isMain end
        return a.curHP < b.curHP
    end)

    CART_CACHE.list, CART_CACHE.at = carts, now
    return carts
end

local function convoyCentre(carts)
    if not carts or #carts == 0 then return nil end
    local sum = Vector3.new(0, 0, 0)
    for _, c in ipairs(carts) do sum = sum + c.part.Position end
    return sum / #carts
end

local function nearConvoy(entry, carts)
    local root = entry.root or entry.nape
    if not root then return false end
    for _, c in ipairs(carts) do
        if (root.Position - c.part.Position).Magnitude <= ESCORT_RADIUS then return true end
    end
    return false
end

