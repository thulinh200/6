-- 41b · STATUS PANEL
--
--     A field report, not a dashboard. Everything on it is something you would
--     actually look at while deciding whether to leave the bot running: what
--     it is doing right now, how far through the current contract it is, and
--     what the session has earned. Nothing decorative, nothing that needs a
--     legend.
--
--     Three rules it is built to:
--
--     · Numbers are monospaced. A proportional font re-flows the whole row
--       every time a digit changes, so a live counter jitters. RobotoMono
--       holds its columns still, which is the difference between a readout you
--       can glance at and one you have to re-read.
--     · It costs four redraws a second, and each one writes only the
--       properties whose value actually moved. The combat loop advances once
--       per frame; a panel that repainted every frame would be spending kills
--       on itself.
--     · One accent colour, used three times. The eye needs somewhere to land,
--       and it cannot land anywhere if everything is lit up.
-- ═══════════════════════════════════════════════════════════════════════════
K.UI = { built = false, refs = {}, last = {} }

do
    -- Eleven module-level helpers would be eleven of the main chunk's 200
    -- Luau registers, and the chunk is already at the ceiling — see the K
    -- table at the top of the file. One namespace costs one.
    local U = {}
    U.C = {
        veil     = Color3.fromRGB(6, 8, 11),
        panel    = Color3.fromRGB(13, 15, 20),
        panelTop = Color3.fromRGB(21, 24, 31),
        accent   = Color3.fromRGB(198, 160, 74),
        text     = Color3.fromRGB(234, 230, 220),
        dim      = Color3.fromRGB(132, 140, 151),
        faint    = Color3.fromRGB(92, 99, 109),
        rule     = Color3.fromRGB(255, 255, 255),
        track    = Color3.fromRGB(30, 34, 42),
        ok       = Color3.fromRGB(126, 176, 116),
        warn     = Color3.fromRGB(214, 165, 78),
        bad      = Color3.fromRGB(196, 88, 78),
    }

    -- Difficulty is the one field that should be readable across the room, so
    -- it carries colour rather than only a word.
    U.TIER = {
        easy     = Color3.fromRGB(118, 126, 136),
        normal   = Color3.fromRGB(104, 148, 158),
        hard     = Color3.fromRGB(198, 160, 74),
        severe   = Color3.fromRGB(206, 124, 74),
        aberrant = Color3.fromRGB(190, 74, 74),
    }

    -- The whole thing is drawn at one fixed size and then scaled to the
    -- viewport. Laying out against a live resolution means every gap is an
    -- expression and nothing ever lines up; laying out against a fixed canvas
    -- means it is a drawing, and the drawing is simply resized.
    U.W, U.H = 1120, 566

    function U.new(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do o[k] = v end
        if parent then o.Parent = parent end
        return o
    end

    function U.corner(o, r)
        U.new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
    end

    -- Roblox has no letter-spacing. Section headings are small and need the
    -- air or they read as a smudge, so it is done by hand.
    function U.spaced(str)
        return (str:gsub("(.)", "%1 "):gsub("%s+$", ""))
    end

    function U.label(parent, props)
        props.BackgroundTransparency = 1
        return U.new("TextLabel", props, parent)
    end

    -- One line of a U.column: name on the left, value hard right in mono so the
    -- digits hold their columns instead of re-flowing every time one changes.
    function U.dashRow(col, order, name)
        local row = U.new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 30),
            LayoutOrder = order,
            Active = false,
        }, col)
        U.label(row, {
            Size = UDim2.new(0.5, 0, 1, 0),
            Font = Enum.Font.Gotham,
            Text = name,
            TextSize = 12,
            TextColor3 = U.C.dim,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
        })
        return U.label(row, {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.new(0.62, 0, 1, 0),
            Font = Enum.Font.RobotoMono,
            Text = "--",
            TextSize = 16,
            TextColor3 = U.C.text,
            TextXAlignment = Enum.TextXAlignment.Right,
            TextYAlignment = Enum.TextYAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
    end

    function U.column(parent, x, width, title)
        local col = U.new("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, x, 0, 0),
            Size = UDim2.new(0, width, 1, 0),
            Active = false,
        }, parent)
        U.label(col, {
            Size = UDim2.new(1, 0, 0, 14),
            Font = Enum.Font.Gotham,
            Text = U.spaced(title),
            TextSize = 10,
            TextColor3 = U.C.accent,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        local body = U.new("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 30),
            Size = UDim2.new(1, 0, 1, -30),
            Active = false,
        }, col)
        U.new("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 0),
        }, body)
        return body
    end

    -- Write only what moved. Property writes are not free and this runs four
    -- times a second for as long as the farm is up.
    function U.put(key, obj, prop, value)
        local L = K.UI.last
        local id = key .. "." .. prop
        if L[id] == value then return end
        L[id] = value
        obj[prop] = value
    end

    -- Dedicated Family Roll overlay. It is independent of StatusUI so it can
    -- be shown even when the general dashboard is disabled. Values are fed by
    -- the existing save reader and the actual Family/Roll server response.
    K.FAMUI = K.FAMUI or { history = {}, total = 0, status = "Chờ Family Roll" }

    function K.famUIAddHistory(name, rarity, spins, pity)
        local H = K.FAMUI
        table.insert(H.history, 1, {
            name = tostring(name or "?"), rarity = tostring(rarity or "?"),
            spins = num(spins), pity = num(pity), at = os.date("%H:%M:%S"),
        })
        while #H.history > 12 do table.remove(H.history) end
        H.total = H.total + 1
        K.famUIRefresh()
    end

    function K.famUIRefresh(st, status, rolled, spent)
        local R = K.FAMUI and K.FAMUI.refs
        if not R then return end
        st = st or K.famRead() or {}
        if status then K.FAMUI.status = status end
        if rolled ~= nil then K.FAMUI.sessionRolls = rolled end
        if spent ~= nil then K.FAMUI.sessionSpent = spent end
        local function put(obj, value)
            if obj then obj.Text = tostring(value) end
        end
        put(R.status, K.FAMUI.status or "Đang xử lý")
        put(R.family, st.family or "?")
        put(R.rarity, K.famRarityOf(st.family) or "?")
        put(R.gems, comma(num(st.gems)))
        put(R.spins, comma(num(st.spins)))
        put(R.pity, tostring(num(st.pity)))
        put(R.storage, ("%s / %s"):format(comma(num(st.stored)), comma(num(st.cap))))
        put(R.rolled, comma(num(K.FAMUI.sessionRolls)))
        put(R.spent, comma(num(K.FAMUI.sessionSpent)))
        for i = 1, 12 do
            local item = K.FAMUI.history[i]
            local row = R.history[i]
            if row then
                row.Visible = item ~= nil
                if item then
                    row.Text = ("%s  %s  ·  %s  ·  còn %s Spin  ·  pity %s")
                        :format(item.at, item.name, item.rarity, comma(item.spins), tostring(item.pity))
                end
            end
        end
    end

