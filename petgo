-- 34 · SKILL TREE  ·  damage-first, solved against the real data model
--
--     Two bugs, stacked, meant this system had never once fired.
--
--     1. The module is Modules.Storage.Skill — SINGULAR. Every previous
--        version looked up MOD.Skills, which does not exist on this build, so
--        loadSkillTable() returned false and runSkills() took its
--        "unreadable — skipping" branch on every single level-up. Zero skills
--        were ever bought. Verified live: Storage's 22 children are
--        Animations, Perks, Skill, Families, Drops, Modifiers, Titles,
--        Artifacts, Frames, Shifters, Pass, Quest, Sounds, Values,
--        Side_Objectives, Items, Actions, RegimentsInfo, Responses, Inputs,
--        Blessings, Memories. There is no "Skills".
--
--     2. The node model it solved for does not exist either. Skill.Info has
--        182 entries and NOT ONE has Previous, Lock_Skill, Families, Stat or
--        Path. The real fields are Alternate, Cooldown, Description, Frames,
--        IFrames, Icon, Rarity, Shift_Skill, Tag, Disable. So there is no
--        prerequisite graph to walk and no exclusivity to avoid — the frontier
--        solver was solving an imaginary problem.
--
--        `Alternate` is NOT a lock. It is the blade-spear mirror pointer,
--        offset by exactly +112, and BOTH halves stack: Get_Stat_Total keys on
--        the unprefixed stat name and adds every owned entry. The designed
--        totals (Crit_Chance 36, Crit_Damage 70) are only reachable by owning
--        both trees.
--
--     Family locks are real but irrelevant here: every id in Storage.Families
--     is an active ability, and none appears in Skill_Values for any stat.
--
--     What replaces it: a greedy walk on ACTUAL EXPECTED DAMAGE. Skill_Gold_Cost
--     and Skill_Gold_Multiplier are both nil on this build, so the old
--     1850 * 1.063^n budget check was inventing a number the game does not
--     publish. We cannot price a node, but we can rank one — so buy strictly in
--     descending order of the damage it actually adds and let the server's own
--     rejection serve as the budget check.
-- ═══════════════════════════════════════════════════════════════════════════
K.SKILLS = { info = nil }

local function loadSkillTable()
    if K.SKILLS.info ~= nil then return K.SKILLS.info end
    -- Singular first (live build), plural kept as a forward-compatible fallback.
    local S = MOD.Skill
    if type(S) ~= "table" then S = MOD.Skills end
    local info = type(S) == "table" and S.Info or nil
    if type(info) ~= "table" then
        -- Some builds flatten it; accept a bare id-keyed table too.
        if type(S) == "table" and S["1"] ~= nil then info = S end
    end
    K.SKILLS.info = (type(info) == "table") and info or false
    return K.SKILLS.info
end

local function unlockedSkillSet()
    local set, n = {}, 0
    local slot = STATE.slot or getSlot()
    local list = slot and slot.Skills and slot.Skills.Unlocked
    if type(list) == "table" then
        for _, id in pairs(list) do
            set[tostring(id)] = true
            n = n + 1
        end
    end
    return set, n
end

-- Which stat name carries melee damage depends on the equipped weapon, and the
-- weapon-scoped stats differ too: Weapon_Stats binds Blade_Durability and
-- Swing_Duration to Blades, Blast_Radius and Conserve_Chance to Spears. A
-- Blades account buying Blast_Radius nodes is buying nothing.
local function weaponContext()
    local slot   = STATE.slot or getSlot()
    local weapon = (slot and slot.Weapon) or "Blades"
    local spears = (tostring(weapon) == "Spears")
    return weapon, (spears and "TS_Damage" or "ODM_Damage")
end

-- Current damage state, reconstructed from the save exactly the way
-- Utilities.Shared.Get_Stat_Total does it:
--   * Upgrade_Values[stat][level+1] is the ABSOLUTE base, not an increment
--   * an ODM_Damage/TS_Damage/Blast_Radius skill adds a PERCENT of that base
--   * every other stat, crit included, adds FLAT points
local function damageState(owned)
    local V      = MOD.Values or {}
    local UV     = V.Upgrade_Values or {}
    local slot   = STATE.slot or getSlot()
    local weapon, dmgStat = weaponContext()
    local upg    = (slot and slot.Upgrades and slot.Upgrades[weapon]) or {}

    local function upgVal(stat)
        local series = UV[stat]
        if type(series) ~= "table" then return 0 end
        local lvl = tonumber(upg[stat]) or 0
        return tonumber(series[lvl + 1]) or 0
    end

    local st = {
        stat = dmgStat,
        base = upgVal(dmgStat),
        cc   = upgVal("Crit_Chance"),
        cd   = upgVal("Crit_Damage"),
        pct  = 0,
    }

    local SV = V.Skill_Values or {}
    for stat, nodes in pairs(SV) do
        if type(nodes) == "table" then
            for id, val in pairs(nodes) do
                if owned[tostring(id)] then
                    local v = tonumber(val) or 0
                    if stat == dmgStat then
                        st.pct = st.pct + v
                    elseif stat == "Crit_Chance" then
                        st.cc = st.cc + v
                    elseif stat == "Crit_Damage" then
                        st.cd = st.cd + v
                    end
                end
            end
        end
    end
    return st
end

-- Expected damage per hit. The crit roll itself is server-authoritative, so the
-- multiplier form here is the standard one and is UNVERIFIED — but it is only
-- used to ORDER purchases, and that ordering is stable under any sane crit
-- formula, since more chance and more crit damage are always worth more
-- together than either is alone.
local function expectedDamage(st)
    return st.base * (1 + st.pct / 100) * (1 + (st.cc / 100) * (st.cd / 100))
end

local function applyStat(st, stat, v)
    if stat == st.stat then
        st.pct = st.pct + v
    elseif stat == "Crit_Chance" then
        st.cc = st.cc + v
    elseif stat == "Crit_Damage" then
        st.cd = st.cd + v
    else
        return false
    end
    return true
end

local function runSkills()
    if not CFG.AutoUpgrade then return end

    local info = loadSkillTable()
    if not info then
        log("SKILL", "Storage.Skill unreadable — skipping")
        return
    end

    local V  = MOD.Values or {}
    local SV = V.Skill_Values
    if type(SV) ~= "table" then
        log("SKILL", "Values.Skill_Values unreadable — skipping")
        return
    end

    local owned, ownedN = unlockedSkillSet()

    -- id -> { stat, value } for every node that grants a stat at all.
    local grant = {}
    for stat, nodes in pairs(SV) do
        if type(nodes) == "table" then
            for id, val in pairs(nodes) do
                grant[tostring(id)] = { stat = stat, value = tonumber(val) or 0 }
            end
        end
    end

    local st     = damageState(owned)
    local before = expectedDamage(st)
    local budget = math.max(1, num(CFG.MaxSkillUnlocks, 40))
    local bought, misses = 0, 0

    -- ── Phase 1 · damage core, greedily ──────────────────────────────────
    -- Re-scoring after every purchase matters: crit chance and crit damage
    -- multiply each other, so the best next node genuinely changes as we buy.
    while bought < budget do
        local bestId, bestGain, bestG = nil, 0, nil
        local baseline = expectedDamage(st)
        for id, g in pairs(grant) do
            if not owned[id] and info[id] ~= nil then
                local probe = { stat = st.stat, base = st.base, cc = st.cc,
                                cd = st.cd, pct = st.pct }
                if applyStat(probe, g.stat, g.value) then
                    local gain = expectedDamage(probe) - baseline
                    if gain > bestGain then bestId, bestGain, bestG = id, gain, g end
                end
            end
        end
        if not bestId then break end

        if eqInvoke(2.5, "Unlock", { bestId }) == nil then
            misses = misses + 1
        else
            misses = 0
        end
        jwait(0.06, 0.05)

        -- Advance optimistically so the next score is right; the server is
        -- reconciled against below.
        owned[bestId] = true
        applyStat(st, bestG.stat, bestG.value)
        bought = bought + 1

        -- Out of gold looks exactly like a rejected call. Stop on a short run
        -- of them rather than firing the whole tree at a wall.
        if misses >= 3 then
            log("SKILL", "three unlocks in a row returned nothing — out of gold, stopping")
            break
        end
    end

    -- ── Phase 2 · everything else, only once damage is exhausted ─────────
    -- Deliberately second. Whatever the real cost curve is, it is monotonic in
    -- how many skills are already owned, so buying a Health node before a
    -- damage node makes that damage node more expensive.
    if CFG.SkillsBuyAll and misses < 3 and bought < budget then
        local rest = {}
        for id in pairs(info) do
            if not owned[tostring(id)] then rest[#rest + 1] = tostring(id) end
        end
        table.sort(rest, function(a, b) return (tonumber(a) or 0) < (tonumber(b) or 0) end)
        for _, id in ipairs(rest) do
            if bought >= budget or misses >= 3 then break end
            if eqInvoke(2.5, "Unlock", { id }) == nil then
                misses = misses + 1
            else
                misses = 0
            end
            jwait(0.06, 0.05)
            owned[id] = true
            bought = bought + 1
        end
    end

    -- Reconcile against what the server actually granted, so a rejected call
    -- does not leave our model optimistic.
    refreshState(true)
    local realOwned, realN = unlockedSkillSet()

    if bought > 0 then
        local after = expectedDamage(damageState(realOwned))
        log("SKILL", ("%d calls · %d → %d owned · expected dmg %.0f → %.0f (%+.1f%%) · ns=%s")
            :format(bought, ownedN, realN, before, after,
                    before > 0 and ((after / before) - 1) * 100 or 0, eqNamespace()))
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 34b · PERK EQUIPPING  ·  the largest damage gain available, and it is free
--
--     Every version of this script until now only ever DELETED perks. It never
--     equipped one. Read live: all six slots empty, 92 perks in storage.
--
--         slot.Perks.Equipped = { Body="", Defense="", Extra="",
--                                 Family="", Offense="", Support="" }
--
--     Six Type-keyed slots, every one an empty string. Utilities.Stats builds
--     Perks.Active from ONLY the non-empty entries of that table, and
--     Get_Stat_Total iterates ONLY Perks.Active — so a perk sitting in storage
--     contributes literally nothing. The account was carrying a Legendary
--     Eviscerate (Crit_Damage +30) and five Critical Hunters and getting zero
--     from all of them.
--
--     Perk capacity is gated on upgrade grade, not level or prestige
--     (Values.Equipment_Capacity, walked while Grade <= Get_Potential). At
--     grade 15 that is 7 perk slots — already maxed, so every Type slot is
--     available right now.
--
--     Value formula, confirmed at five separate call sites in Utilities.Shared
--     and Waves.Info:   value = (Base + Level * Increment)
--     and the same percent-vs-flat split as skills applies: for the stats in
--     Shared.Convert_Stats the number is a PERCENT of the raw upgrade base;
--     everything else, crit included, is flat.
--
--     A perk whose stat is "All" applies to Shared.All_Stats — Blade_Durability,
--     Crit_Chance, Crit_Damage, ODM_Control, ODM_Damage, ODM_Gas, ODM_Range,
--     ODM_Speed — which is why an All perk is worth so much more than its
--     number suggests.
-- ═══════════════════════════════════════════════════════════════════════════
K.PERK_DEF = nil        -- perk name -> { type, rarity, stats }

local function loadPerkDefs()
    if K.PERK_DEF ~= nil then return K.PERK_DEF end
    local P = MOD.Perks
    if type(P) ~= "table" then
        K.PERK_DEF = false
        return false
    end
    local defs = {}
    for rarity, tbl in pairs(P) do
        -- Storage.Perks also carries three functions (Setup, Check,
        -- Get_Converted_Stat); only the rarity tables are perk maps.
        if type(tbl) == "table" and type(rarity) == "string" then
            for name, def in pairs(tbl) do
                if type(def) == "table" and type(def.Stats) == "table" then
                    defs[tostring(name)] = {
                        type   = tostring(def.Type or "Extra"),
                        rarity = rarity,
                        stats  = def.Stats,
                        ignore = def.Ignore == true,
                    }
                end
            end
        end
    end
    K.PERK_DEF = defs
    return defs
end

-- Expected-damage delta from adding one perk on top of the current state.
-- Uses the same damageState/expectedDamage model as the skill solver, so a
-- perk and a skill are scored on one comparable scale.
local function perkDamageScore(def, level, st)
    local baseline = expectedDamage(st)
    local probe = { stat = st.stat, base = st.base, cc = st.cc, cd = st.cd, pct = st.pct }

    local ALL = { "Crit_Chance", "Crit_Damage", st.stat }

    for statName, spec in pairs(def.stats) do
        if type(spec) == "table" then
            local v = (tonumber(spec.Base) or 0) + (tonumber(level) or 0) * (tonumber(spec.Increment) or 0)
            if statName == "All" then
                for _, s in ipairs(ALL) do applyStat(probe, s, v) end
            else
                applyStat(probe, statName, v)
            end
        end
    end
    return expectedDamage(probe) - baseline
end

local function equipPerks()
    if not CFG.AutoEquipPerk then return 0 end

    local defs = loadPerkDefs()
    if not defs then return 0 end

    local slot = STATE.slot or getSlot(true)
    local perks = slot and slot.Perks
    if type(perks) ~= "table" or type(perks.Storage) ~= "table" then return 0 end
    local equipped = perks.Equipped
    if type(equipped) ~= "table" then return 0 end

    local owned = unlockedSkillSet()
    local st    = damageState(owned)

    -- What is in each Type slot now, and what that perk is currently worth.
    -- Slots are considered even when occupied: a perk's value depends on the
    -- state it is added to, so the best Offense perk BEFORE the crit-chance
    -- skills are bought is not the best one after. Eviscerate (+30 Crit_Damage)
    -- is worth +3.5k at 16% crit chance and far more at 51%. Fill-empty-only
    -- would lock in the early answer forever.
    local current, emptyN = {}, 0
    for slotType, uuid in pairs(equipped) do
        local key = tostring(slotType)
        if uuid == "" or uuid == nil then
            current[key] = { uuid = nil, score = 0, name = "<empty>" }
            emptyN = emptyN + 1
        else
            local entry = perks.Storage[uuid]
            local def   = entry and entry.Name and defs[tostring(entry.Name)]
            current[key] = {
                uuid  = uuid,
                name  = entry and tostring(entry.Name) or "?",
                score = def and perkDamageScore(def, entry.Level or 0, st) or 0,
            }
        end
    end

    -- Best candidate per Type slot, scored on expected damage.
    local best = {}
    for uuid, entry in pairs(perks.Storage) do
        if type(entry) == "table" and entry.Name then
            local def = defs[tostring(entry.Name)]
            if def and current[def.type] and uuid ~= current[def.type].uuid then
                local skip = false
                -- Heavenly Restriction grants a big All bonus but its own
                -- Effects string is "ALL equipped skills are disabled", and
                -- Storage.Perks.Check really does flag all five hotbar skill
                -- slots Restricted while it is on. With the damage core of the
                -- skill tree bought, turning every skill off is a large net
                -- loss, so it is opt-in only.
                if tostring(entry.Name) == "Heavenly Restriction"
                    and not CFG.AllowHeavenlyRestriction then
                    skip = true
                end
                if not skip then
                    local score = perkDamageScore(def, entry.Level or 0, st)
                    local cur = best[def.type]
                    if not cur or score > cur.score
                        or (score == cur.score and (entry.Level or 0) > cur.level) then
                        best[def.type] = {
                            uuid  = uuid,
                            name  = tostring(entry.Name),
                            level = entry.Level or 0,
                            score = score,
                        }
                    end
                end
            end
        end
    end

    local done = {}
    for slotType, pick in pairs(best) do
        local cur = current[slotType]
        -- Equip an empty slot unconditionally; replace an occupied one only for
        -- a real improvement, so the bot does not churn remotes swapping between
        -- two near-identical perks every lobby visit.
        local worthIt = (cur.uuid == nil)
            or (pick.score > cur.score + math.max(1, math.abs(cur.score) * 0.02))
        if worthIt then
            setAction("Equipping %s", pick.name)
            -- Waves.Info: Invoke("Equipment","State",Category,"Equip",ID,HotbarIndex,extra)
            -- HotbarIndex is nil for anything that is not Category "Skills".
            -- Equipping into an occupied slot swaps; the reply carries .Swap
            -- with the uuid that came out.
            local r = eqInvoke(4, "State", "Perks", "Equip", pick.uuid)
            jwait(0.25, 0.15)
            if r ~= nil then
                done[#done + 1] = ("%s%s → %s%s"):format(
                    pick.name,
                    pick.level > 0 and ("+" .. tostring(pick.level)) or "",
                    slotType,
                    cur.uuid and (" (was " .. cur.name .. ")") or "")
            end
        end
    end

    if #done > 0 then
        refreshState(true)
        local after = expectedDamage(damageState(unlockedSkillSet()))
        log("PERK", ("equipped %d — %s · expected dmg now %.0f")
            :format(#done, table.concat(done, ", "), after))
    elseif emptyN > 0 and not _G.VCP_PerkEquipNoted then
        _G.VCP_PerkEquipNoted = true
        log("PERK", ("%d empty slots but no equip succeeded (ns=%s)")
            :format(emptyN, eqNamespace()))
    end
    return #done
end

