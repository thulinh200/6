-- 35 · PRESTIGE
--     Two calls, not thirty-three. GET("Equipment","Talents") makes the
--     server write the offered talent keys into slot.Next_Talents; those are
--     numeric keys, not names, and Modules.Storage.Memories maps key → Tag.
--     v9's original bug was comparing keys against names, never matching, and
--     falling through to firing the entire talent list one by one.
--
--     The human-paced delays are deliberate. Prestige is a rare, high-value
--     event and firing its whole sequence inside 200ms is exactly the shape a
--     server-side heuristic looks for.
-- ═══════════════════════════════════════════════════════════════════════════
K.FALLBACK_TALENTS = {
    "Guardian", "Aegisurge", "Deflectra", "Thanatophobia", "Necromantic",
    "Steel Frame", "Resilience", "Riposte", "Vengeflare", "Blitzblade",
    "Swiftshot", "Crescendo", "Furyforge", "Stalwart", "Quakestrike",
    "Stormcharged", "Supernova", "Gambler", "Overslash", "Amputation",
    "Surgeshot", "Assassin", "Afterimages", "Bloodthief", "Apotheosis",
    "Lifefeed", "Vitalize", "Flashstep", "Gem Fiend", "Cooldown Blitz",
    "Mendmaster", "Tactician", "Omnirange",
}

-- Memories has NO .Talents key. Its top level IS the rarity partition —
-- Common / Uncommon / Rare / Epic — each holding numeric-string ids "1".."33".
-- Guarding on `type(M.Talents) == "table"` was therefore always false, the map
-- came back empty, `offered` was always empty, and every prestige logged
-- "no offer returned" and fired the entire 33-entry fallback list one at a
-- time: precisely the behaviour §35's own comment says it was written to stop.
--
-- Walk whichever shape is present so this survives either layout.
local function talentKeyToTag()
    local map, meta = {}, {}
    local M = MOD.Memories
    if type(M) ~= "table" then return map, meta end

    local root = (type(M.Talents) == "table") and M.Talents or M

    for rarity, category in pairs(root) do
        if type(category) == "table" then
            for k, v in pairs(category) do
                if type(v) == "table" and v.Tag then
                    local key = tostring(k)
                    map[key] = v.Tag
                    meta[v.Tag] = {
                        rarity = tostring(rarity),
                        desc   = tostring(v.Description or ""),
                    }
                end
            end
        end
    end
    return map, meta
end

-- Rank offered talents by whether their own description says they raise
-- damage. Talent effects are resolved server-side and only the Description
-- strings are readable client-side, so this is a text match rather than a
-- computed value — but taking the first card offered, which is what this did
-- before, is strictly worse. Live: both of this account's prestige talents went
-- to Swiftshot ("Refilling your gas and blades is 25.0% faster"), which is
-- worth exactly zero damage.
K.TALENT_PRIORITY = {
    { pat = "damage",   w = 100 },
    { pat = "critical", w =  90 },
    { pat = "crit",     w =  90 },
    { pat = "attack",   w =  60 },
    { pat = "speed",    w =  25 },
    { pat = "cooldown", w =  20 },
    { pat = "health",   w =  10 },
}

local function talentScore(tag, meta)
    local info = meta and meta[tag]
    local text = ((tag or "") .. " " .. ((info and info.desc) or "")):lower()
    local score = 0
    for _, rule in ipairs(K.TALENT_PRIORITY) do
        if text:find(rule.pat, 1, true) then score = score + rule.w end
    end
    -- Percentages in the description scale the value a little.
    local pct = tonumber(text:match("(%d+%.?%d*)%%"))
    if pct then score = score + math.min(pct, 100) / 10 end
    return score
end

local function doPrestige()
    local key = "P" .. (STATE.prestige + 1)
    local ps  = (CFG.VCPlusPrestige and CFG.VCPlusPrestige[key]) or { TargetBoost = "Gold Boost" }
    local boost = ps.TargetBoost or "Gold Boost"

    _G.IsPrestigeing = true
    setAction("Prestige %d → %d", STATE.prestige, STATE.prestige + 1)

    -- Pace like a player opening the menu and choosing a boost.
    task.wait(1.5 + math.random() * 1.5)
    eqInvoke(4, "Talents")
    task.wait(0.4)

    local keyMap, keyMeta = talentKeyToTag()
    local offered = {}
    local seen    = {}
    local slot    = getSlot(true)
    local next_   = slot and slot.Next_Talents

    local function push(k)
        local tag = keyMap[tostring(k)]
        if not tag and type(k) == "string" and #k > 2 then tag = k end
        if tag and not seen[tag] then
            seen[tag] = true
            offered[#offered + 1] = tag
        end
    end

    if type(next_) == "table" then
        for _, v in pairs(next_) do
            if type(v) == "table" then
                for _, v2 in pairs(v) do push(v2) end
            else
                push(v)
            end
        end
    end

    local order = offered
    if #order == 0 then
        log("PRESTIGE", "no offer returned — falling back to the full talent list")
        order = K.FALLBACK_TALENTS
    else
        log("PRESTIGE", ("offered: %s"):format(table.concat(offered, ", ")))
    end

    -- Best damage talent first, so the one that actually gets taken is the one
    -- worth taking. Prestige talents are PERMANENT and accumulate (slot.Talents
    -- is an append-only list, one per prestige, duplicates allowed), so this is
    -- an irreversible choice being made once per prestige.
    if CFG.PreferDamageTalents ~= false and #order > 1 then
        local scored = {}
        for i, tag in ipairs(order) do
            scored[i] = { tag = tag, score = talentScore(tag, keyMeta), i = i }
        end
        table.sort(scored, function(a, b)
            if a.score ~= b.score then return a.score > b.score end
            return a.i < b.i
        end)
        local ranked = {}
        for i, e in ipairs(scored) do ranked[i] = e.tag end
        order = ranked
        log("PRESTIGE", ("damage-ranked: %s (top score %.0f)")
            :format(table.concat(ranked, " > ", 1, math.min(#ranked, 4)), scored[1].score))
    end

    -- Pace like a player reading three cards.
    task.wait(2.5 + math.random() * 2.5)

    local before = STATE.prestige
    for i, tag in ipairs(order) do
        eqInvoke(4, "Prestige", { Boosts = boost, Talents = tag })
        task.wait(0.6 + math.random() * 0.5)
        refreshState(true)
        if STATE.prestige > before then
            log("PRESTIGE", ("succeeded on call %d (talent '%s')"):format(i, tag))
            break
        end
    end

    if STATE.prestige <= before then
        log("PRESTIGE", "all talent calls exhausted without a prestige")
    end

    -- Prestige resets the skill tree and level, so every cached decision built
    -- on them is now wrong.
    K.SKILLS.info = nil
    _G.VCP_LastUpgrade = nil
    _G.IsPrestigeing = false
    task.wait(4)
end

