local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local RunService         = game:GetService("RunService")
local StarterGui         = game:GetService("StarterGui")
local HttpService        = game:GetService("HttpService")
local GuiService         = game:GetService("GuiService")
local MarketplaceService = game:GetService("MarketplaceService")
local VirtualUser        = game:GetService("VirtualUser")
local VirtualInputManager= game:GetService("VirtualInputManager")
local Lighting           = game:GetService("Lighting")
local Stats              = game:GetService("Stats")
local UserInputService   = game:GetService("UserInputService")
local SoundService       = game:GetService("SoundService")
local Workspace          = workspace

pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)

-- Wait for the DataModel to finish loading before reading anything out of it.
-- Bounded, because a bare game.Loaded:Wait() will hang forever on a client that
-- never finishes, and 40 of those wedged at boot is worse than starting early.
do
    local t0 = os.clock()
    if not game:IsLoaded() then
        task.spawn(function() pcall(function() game.Loaded:Wait() end) end)
        while not game:IsLoaded() and os.clock() - t0 < 20 do task.wait(0.1) end
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
--  3 · EXECUTOR COMPATIBILITY SHIMS
--     Everything optional is probed once and wrapped so the rest of the file
--     never has to branch on executor capability.
-- ═══════════════════════════════════════════════════════════════════════════
local EXEC = {}
EXEC.unpack        = table.unpack or unpack
EXEC.getgc         = getgc         or function() return {} end
EXEC.getconnections= getconnections or get_signal_cons or function() return {} end
EXEC.firesignal    = firesignal    or nil
EXEC.firetouch     = firetouchinterest or nil
EXEC.clonefunction = clonefunction or function(f) return f end
EXEC.setfpscap     = setfpscap     or nil
EXEC.runOnActor    = run_on_actor  or (getgenv and getgenv().run_on_actor) or nil
EXEC.writefile     = writefile     or nil
EXEC.readfile      = readfile      or nil
EXEC.isfile        = isfile        or nil
EXEC.hookfunction  = hookfunction  or nil
EXEC.appendfile    = appendfile    or nil

-- Outbound HTTP. HttpService:PostAsync is server-only, so the Discord reporter
-- has to go through the executor's own request function — and every executor
-- spells it differently. Probe once, in a pcall because half of these names are
-- globals that may not exist at all.
EXEC.request = nil
pcall(function()
    EXEC.request = (syn and syn.request)
        or (http and http.request)
        or http_request
        or request
        or (fluxus and fluxus.request)
end)

local function safeConns(signal)
    local ok, r = pcall(EXEC.getconnections, signal)
    return (ok and type(r) == "table") and r or {}
end

