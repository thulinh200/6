getgenv().VCPlus_Config = getgenv().VCPlus_Config or {}
local CFG = getgenv().VCPlus_Config
-- Which UI keys the USER actually supplied, captured BEFORE the defaults are
-- merged. Once the merge runs every key is non-nil and "did they ask for this?"
-- can no longer be answered -- which is exactly what broke StatusUI below.
K.userSetShowUI   = CFG.ShowUI   ~= nil
K.userSetStatusUI = CFG.StatusUI ~= nil
for k, v in pairs(K.DEFAULTS) do
    if CFG[k] == nil then CFG[k] = v end
end

-- Display is filled key-by-key rather than all-or-nothing. The top-level merge
-- is shallow, so `Display = { ShowGold = false }` would otherwise leave every
-- other toggle nil — and nil reads as "hide", silently blanking the line.
if type(CFG.Display) == "table" then
    for k, v in pairs(K.DEFAULTS.Display) do
        if CFG.Display[k] == nil then CFG.Display[k] = v end
    end
end

-- v9 compatibility aliases: old blobs used _SlotCacheTTL / _DisableInternalHorst
if CFG._SlotCacheTTL         ~= nil then CFG.SlotCacheTTL = CFG._SlotCacheTTL end
if CFG._DisableInternalHorst ~= nil then CFG.DisableInternalHorst = CFG._DisableInternalHorst end

-- ShowUI is the master switch; StatusUI is the internal flag the panel, intro
-- and toggle all gate on. Fold one into the other so callers only ever set
-- ShowUI, and let ShowUI win when the user gave both.
--
-- The old test was `if CFG.ShowUI ~= nil`, which ran AFTER the defaults merge --
-- so CFG.ShowUI was never nil and the branch fired every single time. A user who
-- set StatusUI = false and nothing else had it overwritten back to true by a
-- default they never wrote: the documented way to turn the panel off did not
-- turn the panel off. Gate on what the user actually supplied instead.
if K.userSetShowUI or not K.userSetStatusUI then
    CFG.StatusUI = CFG.ShowUI and true or false
end

-- ═══════════════════════════════════════════════════════════════════════════
--  5 · AGGRESSION PRESETS
--     Every combat rate in the file resolves through here. A preset sets the
--     *ceiling*; AdaptiveRate then walks the live rate up toward it and backs
--     off the moment the server stops crediting hits.
--
--     sendCeiling is the hard cap on outbound combat remotes per second. The
--     actor enforces it independently as a last line of defence, so a bug in
--     the tuner can never turn into a remote flood.
-- ═══════════════════════════════════════════════════════════════════════════
--     Nitro is the ceiling. Two things to know before using it:
--
--     · The 110/s cap is NOT a verified server limit. The only limiter found
--       in the game's code is ReplicaService's (default 120/s), and it governs
--       Replica traffic — there is no evidence it applies to Assets.Remotes.
--       110 is chosen to sit under that number in case it does. The real
--       combat limit is unknown, so Nitro leans on AdaptiveRate to find the
--       wall by backing off when damage stops being credited.
--     · If the run is spawn-limited rather than kill-limited, Nitro buys
--       nothing at all — see the throughput governor in §23b, which detects
--       this and stops wasting the sends.
-- `loop` is the combat loop's sleep, and it is NOT a rate control -- rateAllow
-- and sendCeiling are. It was previously sized like one (0.05s at Nitro), which
-- made it the binding constraint by accident: nextHit is scheduled at
-- math.max(COMBAT.loop, pace), so a one-target pulse that the budget could
-- serve every 0.010s was still only served every 0.050s. Measured live that is
-- ~20 sends/s against a ~101/s budget, i.e. 80% of the allowance never spent.
--
-- Each `loop` below is now set to the pace of a SINGLE-target pulse at that
-- preset's own ceiling, (sendCeiling - 1/slash)^-1, so the scheduler stops
-- truncating the budget and the ceiling is what actually binds. Nothing here
-- raises a ceiling; it only stops leaving the existing one unspent.
K.PRESETS = {
    Safe     = { slash = 0.34, hit = 0.36, cap =  4, loop = 0.065, sendCeiling =  18 },
    Balanced = { slash = 0.22, hit = 0.24, cap =  8, loop = 0.028, sendCeiling =  40 },
    Turbo    = { slash = 0.16, hit = 0.17, cap = 12, loop = 0.016, sendCeiling =  72 },
    -- Nitro sits exactly on the feasible frontier rather than above it.
    -- Slash and hits share ONE budget (both go through rateAllow), so the real
    -- constraint is  cap/hit + 1/slash <= sendCeiling.
    --   1/0.11 = 9.1 slashes/s, leaving 100.9/s for hits
    --   10/0.10 = 100/s of hits
    --   total 109.1/s against a 110/s ceiling
    -- The old 18-at-0.12s asked for 158/s, so a third of every pulse was thrown
    -- away by the client's own limiter before it ever reached the network.
    -- loop 0.015 is one frame at 60fps -- the floor task.wait can actually
    -- honour -- and matches the 1/100.9 = 0.0099s single-target pace as closely
    -- as the scheduler permits.
    Nitro    = { slash = 0.11, hit = 0.10, cap = 10, loop = 0.015, sendCeiling = 110 },
}

K.TUNE = K.PRESETS[tostring(CFG.Aggression)] or K.PRESETS.Balanced
-- explicit per-key overrides always beat the preset
local COMBAT = {
    slash       = tonumber(CFG.CombatSlashInterval) or K.TUNE.slash,
    hit         = tonumber(CFG.CombatHitInterval)   or K.TUNE.hit,
    cap         = tonumber(CFG.CombatHitCap)        or K.TUNE.cap,
    loop        = tonumber(CFG.CombatLoopInterval)  or K.TUNE.loop,
    sendCeiling = K.TUNE.sendCeiling,
}
-- the adaptive tuner scales these two at runtime; base values are the ceiling
-- Multi-instance derate. Twenty clients hitting the same ceiling on the same
-- frame is what turns a stable box into a stall: the sends still leave, but the
-- scheduler on every client misses its window together. Trimming the shared
-- budget ~12% and holding the loop at a period the scheduler can honour under
-- load costs a few kills per run and buys a farm that does not need a babysit.
if CFG.MultiInstance then
    COMBAT.sendCeiling = math.floor(COMBAT.sendCeiling * 0.88)
    COMBAT.loop        = math.max(COMBAT.loop, 0.02)
end

COMBAT.baseHit = COMBAT.hit
COMBAT.baseCap = COMBAT.cap
COMBAT.preset  = tostring(CFG.Aggression)

-- Nitro opts into modifier escalation by default: at that rate the run is far
-- more likely to be spawn-limited than kill-limited, and when it is, per-run
-- reward is the only thing left to raise.
-- Previously defaulted ON for Nitro. Measured against the tier it would fire
-- on: "max" buys +97.5% reward against "safe"'s +52.5%, i.e. +29.5% gold, by
-- adding Oddball (+50% titan stats) to a tier that already needs ~23 sends a
-- kill. A ~50% longer clear does not pay for a 29.5% larger purse.
if CFG.AutoModifierEscalate == nil then
    CFG.AutoModifierEscalate = false
end

