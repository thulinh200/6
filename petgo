-- 13 · DIFFICULTY LADDER
--
--     Values.Difficulty_Potential is the ordered gate list. Live on 2193:
--         Easy 0 · Normal 2 · Hard 5 · Severe 9 · Aberrant 12
--     Note what is absent: "Aberrant+" and "Aberrant++". v9 shipped
--     "Aberrant++" as its default, Create rejected it every time, and the
--     fallback list it walked began at Severe — so that build never once ran
--     the top tier. Values.Difficulty_Spawns puts the cost of that at 35-43
--     titans per run instead of 44-57.
-- ═══════════════════════════════════════════════════════════════════════════
K.DIFF = { ladder = nil, rank = {} }

local function buildDifficultyLadder()
    if K.DIFF.ladder then return K.DIFF.ladder end
    local ladder = {}
    pcall(function()
        local V = MOD.Values
        if not V or type(V.Difficulty_Potential) ~= "table" then return end
        for i = 1, 32 do
            local row = V.Difficulty_Potential[i]
            if type(row) ~= "table" then break end
            local name = row[1] or row.Name or row.Difficulty
            local need = tonumber(row[2] or row.Potential or row.Required) or 0
            if type(name) == "string" then
                ladder[#ladder + 1] = { name = name, need = need }
            end
        end
    end)
    if #ladder == 0 then
        ladder = {
            { name = "Easy",     need = 0  },
            { name = "Normal",   need = 2  },
            { name = "Hard",     need = 5  },
            { name = "Severe",   need = 9  },
            { name = "Aberrant", need = 12 },
        }
        log("DIFF", "Difficulty_Potential unreadable — using the built-in ladder")
    end
    table.sort(ladder, function(a, b) return a.need < b.need end)
    for i, d in ipairs(ladder) do K.DIFF.rank[d.name:lower()] = i end
    K.DIFF.ladder = ladder
    return ladder
end

local function diffRank(name)
    if not name then return 0 end
    buildDifficultyLadder()
    return K.DIFF.rank[tostring(name):lower()] or 0
end

-- Highest tier the account's Potential clears, never below the configured
-- floor. When Potential is unreadable the caller probes instead of guessing.
local function bestDifficulty(potential)
    local ladder = buildDifficultyLadder()
    local floorName = tostring(CFG.MissionDifficulty or "Aberrant")
    if not CFG.AutoDifficulty or not potential then return floorName end
    local pick = ladder[1] and ladder[1].name or floorName
    for _, d in ipairs(ladder) do
        if potential >= d.need then pick = d.name end
    end
    if diffRank(floorName) > diffRank(pick) then return floorName end
    return pick
end


-- ── Difficulty memory, across teleports ────────────────────────────────────
--
-- Difficulty is fixed at Create time and RETRY INHERITS IT. The rewards screen
-- only ever chose between Retry and Leave on perk and prestige grounds, so a
-- run that began on the wrong tier stayed on the wrong tier for as long as the
-- bot kept retrying — and every mission is a fresh server, so nothing in memory
-- survives to notice. Observed live on this account: chooseStartDifficulty()
-- returned "Aberrant" while workspace.Difficulty read "Easy" for an entire
-- session, at roughly a fifth of the gold per run.
--
-- The target is the tier Create last ACCEPTED, not the configured floor. Create
-- is the only authority on what the account can actually run; comparing against
-- the floor instead would make an account that cannot reach Aberrant leave on
-- every single run forever.
-- KEYED BY ACCOUNT, NOT JUST BY GAME.
-- Thirty clients on one box share ONE executor workspace folder, so a path
-- keyed only on GameId is thirty accounts writing the same file. That is not
-- merely untidy here, it is a livelock: this file holds the tier Create last
-- accepted, and decideEndOfMission leaves for the lobby whenever the tier it is
-- replaying is BELOW it. An account parked on Hard reading an Aberrant account's
-- file therefore abandons every single run, forever, for a lobby trip that can
-- never raise it. UserId is the only value guaranteed to differ per client.
K.DIFF_FILE = ("VCPlus_Diff_%s_%s.txt"):format(tostring(game.GameId), tostring(plr.UserId))

local function rememberDifficulty(name)
    if not name then return end
    K.lastDiff = tostring(name)
    pcall(function()
        if EXEC.writefile then EXEC.writefile(K.DIFF_FILE, K.lastDiff) end
    end)
end

-- Same shape as the difficulty memory above, for the same reason: the perk
-- Delete endpoint can be flatly rejected by the server, and the circuit breaker
-- that notices lives in a VM that is destroyed on the next teleport. Without a
-- persisted verdict the mission side keeps deciding "storage full, go and sell"
-- and paying a lobby round-trip for something that cannot work.
K.PERK_FILE = ("VCPlus_PerkSell_%s_%s.txt"):format(tostring(game.GameId), tostring(plr.UserId))

function K.perkSellBlocked()
    if _G.VCP_PerkSellDisabled then return true end
    if K.perkChecked then return false end
    K.perkChecked = true
    pcall(function()
        if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.PERK_FILE) then
            if EXEC.readfile(K.PERK_FILE) == "off" then
                _G.VCP_PerkSellDisabled = true
                log("PERK", "selling was proven broken earlier — staying on Retry")
            end
        end
    end)
    return _G.VCP_PerkSellDisabled == true
end

-- THE COUNTER HAS TO OUTLIVE THE VM TOO.
--
-- The breaker's VERDICT is persisted above, but its COUNT was not -- and the
-- breaker only trips on the SECOND failure. That worked while the lobby called
-- sellPerks twice a pass (an early sell plus the pre-mission safety sell). The
-- early sell has since been removed, because it deleted the whole perk storage
-- before equipPerks could read it, so there is now exactly ONE sellPerks call
-- per VM -- and the VM dies at the next teleport. K.PERK_SELL.fails could
-- therefore never get past 1 and the breaker could never trip again, which puts
-- back the exact failure it exists to stop: a rejected Delete retried on every
-- lobby visit forever, each one paying a round-trip out of a mission.
--
-- Stored in the same file as the verdict, which still wins: perkSellBlock
-- overwrites it with "off", and perkSellBlocked only treats "off" as blocked.
function K.perkFailsLoad()
    local n = 0
    pcall(function()
        if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.PERK_FILE) then
            local raw = tostring(EXEC.readfile(K.PERK_FILE))
            if raw ~= "off" then n = tonumber(raw:match("^fail:(%d+)$")) or 0 end
        end
    end)
    return n
end

function K.perkFailsSave(n)
    pcall(function()
        if EXEC.writefile then EXEC.writefile(K.PERK_FILE, ("fail:%d"):format(n)) end
    end)
end

-- Returns nil when there is NO memory, and the caller must treat that as
-- "do not judge this run".
--
-- Falling back to CFG.MissionDifficulty here would be the worst possible
-- default: the configured floor is "Aberrant", so on any executor without
-- readfile — or the very first run, or one unparseable file — every mission
-- would compare Hard against Aberrant, return "leave", pay a lobby round-trip,
-- come back on Hard again and leave again. Forever. A guard whose failure mode
-- is an infinite loop has to fail closed.
-- ── Session totals, across teleports ──────────────────────────────────────
--
-- Every mission is a separate server, so STATE is rebuilt from zero every
-- ~13 seconds. Uptime, missions, kills and gold-per-hour are all measured
-- against STATE.startedAt, which means without this they read "1 mission,
-- 14s" forever and the per-hour figures are extrapolated from a window too
-- short to mean anything.
--
-- Carried on disk, and only picked up if the file is recent: a stale one from
-- yesterday would silently inflate the session it is reporting on.
K.SESS_FILE = ("VCPlus_Session_%s_%s.json"):format(tostring(game.GameId), tostring(plr.UserId))

-- Declared here rather than beside the reporter itself, because sessionLoad
-- below restores K.WH.every and runs long before that section.
K.WH = { q = {}, busy = false, nextAt = 0, s429 = 0, every = nil, run = nil, posted = false }

function K.sessionLoad()
    if K.sessLoaded then return end
    K.sessLoaded = true
    pcall(function()
        if not (EXEC.isfile and EXEC.readfile and EXEC.isfile(K.SESS_FILE)) then return end
        local raw = EXEC.readfile(K.SESS_FILE)
        local okj, t = pcall(function() return HttpService:JSONDecode(raw) end)
        if not okj or type(t) ~= "table" then return end
        -- Restore the alert cooldowns ABOVE the stale-session gate. The alert
        -- window (1 hour) is deliberately longer than the resume window (15
        -- min), so "one stall alert an hour" must survive a restart that resets
        -- the session counters. Without this, K.whAlertAt is empty on every
        -- fresh VM and the once-an-hour guard never fires — so a broken map
        -- posts one alert per abandoned run, ~one a minute per client.
        if type(t.whAlerts) == "table" then
            K.whAlertAt = K.whAlertAt or {}
            for kind, at in pairs(t.whAlerts) do
                if tonumber(at) then K.whAlertAt[kind] = tonumber(at) end
            end
        end
        -- ONCE PER SITTING, NOT ONCE PER PLACE.
        --
        -- The boot intro paints a full-screen opaque veil, and its only guard,
        -- K.UI.introDone, is per-VM state -- so on a farm that teleports every
        -- ~45 seconds it replayed on EVERY mission, blacking the screen out for
        -- ~3s of each run. Restored ABOVE the stale-session gate on purpose, for
        -- the same reason the alert cooldowns are: "once per sitting" is only
        -- meaningful if it survives the teleport. A genuinely new sitting -- a
        -- gap longer than SessionResumeGap -- still gets the intro.
        local introAt = tonumber(t.introAt)
        if introAt and (os.time() - introAt) <= num(CFG.SessionResumeGap, 900) then
            K.introSuppress = true
            -- CARRY IT FORWARD. playIntro is the only other writer of K.introAt,
            -- and in a VM where the intro is suppressed it returns before setting
            -- it -- so without this line the very next sessionSave writes
            -- introAt = nil, JSONEncode drops the key entirely, and the VM after
            -- that finds nothing to suppress on. The flag would survive exactly
            -- one teleport and the intro would be back on every third mission.
            K.introAt = introAt
        end
        -- A gap this long is a new sitting, not the same one.
        local gap = os.time() - (tonumber(t.at) or 0)
        if gap < 0 or gap > num(CFG.SessionResumeGap, 900) then return end
        STATE.startedAt   = tonumber(t.startedAt) or STATE.startedAt
        STATE.missions    = tonumber(t.missions) or 0
        STATE.kills       = tonumber(t.kills) or 0
        STATE.goldAtStart = tonumber(t.goldAtStart) or nil
        K.lobbyAtMission  = tonumber(t.lobbyAtMission) or 0
        -- The Discord reporter derates itself when Discord throttles it, and
        -- that lesson is worth more than the mission it was learned in.
        if tonumber(t.whEvery) then K.WH.every = tonumber(t.whEvery) end
    end)
end

function K.sessionSave()
    pcall(function()
        if not EXEC.writefile then return end
        EXEC.writefile(K.SESS_FILE, HttpService:JSONEncode({
            at          = os.time(),
            startedAt   = STATE.startedAt,
            missions    = STATE.missions,
            kills       = STATE.kills,
            goldAtStart = STATE.goldAtStart,
            lobbyAtMission = K.lobbyAtMission or 0,
            whEvery     = K.WH.every,
            whAlerts    = K.whAlertPrune and K.whAlertPrune() or K.whAlertAt,
            introAt     = K.introAt,
        }))
    end)
end

-- WHICH SUMMARY-CLICK PATH ACTUALLY WORKS ON THIS CLIENT.
--
-- Same shape and same reason as the two memories above: the VM dies on every
-- teleport, so anything learned during a mission is re-learned from scratch on
-- the next one — and this particular lesson costs seconds of turnaround every
-- time it has to be re-learned. See clickButton for what the two paths are and
-- why only one forged attempt is ever allowed.
K.CLICK_FILE = ("VCPlus_Click_%s_%s.txt"):format(tostring(game.GameId), tostring(plr.UserId))

function K.clickForgeFirst()
    if K.clickPath == nil then
        K.clickPath = "real"
        pcall(function()
            if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.CLICK_FILE) then
                local v = EXEC.readfile(K.CLICK_FILE)
                if v == "forge" or v == "real" then K.clickPath = v end
            end
        end)
    end
    return K.clickPath == "forge"
end

function K.clickLearn(wasForged)
    local want = wasForged and "forge" or "real"
    if K.clickPath == want then return end
    K.clickPath = want
    log("CLICK", ("summary closes on the %s path — trying it first from now on")
        :format(want == "forge" and "forged-handler" or "real-input"))
    pcall(function()
        if EXEC.writefile then EXEC.writefile(K.CLICK_FILE, want) end
    end)
end

local function targetDifficulty()
    if K.lastDiff == nil and not K.diffChecked then
        K.diffChecked = true
        pcall(function()
            if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.DIFF_FILE) then
                local v = EXEC.readfile(K.DIFF_FILE)
                if type(v) == "string" then
                    v = v:match("^%s*(.-)%s*$")          -- trailing newline
                    if #v > 0 and #v < 32 and diffRank(v) > 0 then K.lastDiff = v end
                end
            end
        end)
    end
    return K.lastDiff
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 14 · SAVE LAYER  ·  the single biggest remote saving in v10
--
--     v9 read the player's save with:
--         GET:InvokeServer("Functions", "Settings", "Blur", "Off")
--     which is the settings-toggle endpoint that happens to return the whole
--     save as a side effect. It called that from six places on a 4s TTL. On a
--     40-client farm that is a continuous stream of identical round-trips, and
--     every one of them can time out on a busy server and stall its caller.
--
--     The same table already exists on the client: the game keeps it in
--     CoreTable.Cache.Data, which getgc can reach for free and instantly.
--     v10 reads locally, falls back to the Replica cache, and only falls back
--     to the remote when both fail. Steady state is zero remotes.
--
--     All three paths return the same shape, so callers never branch.
-- ═══════════════════════════════════════════════════════════════════════════
local SAVE = {
    data     = nil,    -- last known full save table
    at       = 0,      -- os.clock() of last successful read
    source   = "none",
    inflight = false,
    coreTable= nil,    -- memoised CoreTable reference
}

local SAVE_TTL = math.max(1, num(CFG.SlotCacheTTL, 4))

-- Locate the game's CoreTable once and hold it. It is the object that owns
-- Cache.Data (the save) and Cache.Variables (combat state), and it is stable
-- for the lifetime of the place, so re-scanning gc on every read would be pure
-- waste — gc walks are the expensive part, not the lookup.
local function findCoreTable()
    if SAVE.coreTable and rawget(SAVE.coreTable, "Cache") then return SAVE.coreTable end
    SAVE.coreTable = nil
    local best, bestSlots = nil, -1
    pcall(function()
        for _, v in pairs(EXEC.getgc(true)) do
            if type(v) == "table" and rawget(v, "Cache") and type(v.Cache) == "table" then
                local d = rawget(v.Cache, "Data")
                if type(d) == "table" and type(d.Slots) == "table" then
                    -- Several stale Cache.Data tables can linger after a
                    -- teleport. The live one is the one with real content, so
                    -- score candidates instead of taking the first hit.
                    local score = 0
                    for _, slot in pairs(d.Slots) do
                        if type(slot) == "table" then
                            score = score + 1
                            if slot.Progression then score = score + 5 end
                            if slot.Perks then score = score + 3 end
                        end
                    end
                    if score > bestSlots then best, bestSlots = v, score end
                end
            end
        end
    end)
    SAVE.coreTable = best
    return best
end

local function slotKey()
    return plr:GetAttribute("Slot") or CFG.TargetSlot or "A"
end

-- Read the save straight out of the client's own cache. Free and instant.
local function readSaveLocal()
    local ct = findCoreTable()
    if not ct then return nil end
    local ok, data = pcall(function() return ct.Cache.Data end)
    if ok and type(data) == "table" and type(data.Slots) == "table" then
        return data
    end
    return nil
end

-- Actor bridge reader. Assigned by setupBridge (§20) once the combat actor is
-- attached; nil everywhere else. Declared here because getSave needs it and
-- the bridge is defined further down the file.
--
-- This is the ONLY local source inside a mission place. Measured live on
-- Chapel: a main-VM getgc(true) over 4,946 values found zero CoreTable
-- candidates, and mission places ship no ReplicaController. Without it every
-- save read in a mission is a server round-trip.
local ACTOR_SAVE_READER = nil

local ACTOR_READ_FAILS = 0

local function readSaveActor()
    if not ACTOR_SAVE_READER then return nil end
    local ok, res = pcall(ACTOR_SAVE_READER)
    if ok and type(res) == "table" and type(res.Slots) == "table" then
        ACTOR_READ_FAILS = 0
        return res
    end
    -- Say so once rather than silently paying for a remote round-trip every
    -- few seconds while reporting the bridge as live.
    ACTOR_READ_FAILS = ACTOR_READ_FAILS + 1
    if ACTOR_READ_FAILS == 3 then
        log("ACTOR", ("save bridge is up but returning %s — falling back to the remote")
            :format(ok and typeof(res) or ("error: " .. tostring(res):sub(1, 80))))
    end
    return nil
end

-- Replica fallback. ReplicaController holds the same document when the game
-- has migrated a value off CoreTable. Wrapped defensively because the
-- controller's accessor names are the part most likely to move between patches.
local function readSaveReplica()
    local out = nil
    pcall(function()
        local shared = ReplicatedStorage:FindFirstChild("VEVOsShared")
        local mod    = shared and shared:FindFirstChild("ReplicaController")
        if not mod then return end
        local RC = require(mod)
        local reps = rawget(RC, "Replicas")
        if type(reps) ~= "table" then return end
        for _, rep in pairs(reps) do
            local d = type(rep) == "table" and rawget(rep, "Data")
            if type(d) == "table" and type(d.Slots) == "table" then out = d; return end
        end
    end)
    return out
end

-- Remote fallback — the v9 path, kept only as a last resort.
local function readSaveRemote()
    local res = invoke(5, "Functions", "Settings", "Blur", "Off")
    if type(res) == "table" and type(res.Slots) == "table" then return res end
    return nil
end

-- Public accessor. `force` skips the TTL but still respects single-flight, so
-- ten callers forcing at once produce one fetch, not ten.
local function getSave(force)
    local now = os.clock()
    if not force and SAVE.data and (now - SAVE.at) < SAVE_TTL then
        return SAVE.data
    end

    if SAVE.inflight then
        -- Someone else is already fetching: wait for their result instead of
        -- firing a duplicate. This is what stops the six v9 call sites from
        -- turning one logical read into six remotes.
        waitUntil(function() return not SAVE.inflight end, 6)
        return SAVE.data
    end

    SAVE.inflight = true
    local got, src = nil, "none"

    if CFG.LocalDataFirst ~= false then
        -- Lobby and title reach CoreTable directly; missions only reach it
        -- through the actor. Try both before paying for a round-trip.
        --
        -- Skip the local scan in a mission though: mission places ship no
        -- ReplicaController and a getgc(true) walk finds zero CoreTable
        -- candidates there (see readSaveActor's notes), yet findCoreTable never
        -- caches that miss -- so unguarded it re-walks the entire heap on every
        -- TTL-miss for a result that is always nil. The actor bridge is the
        -- mission reader; go straight to it and save the doomed walk.
        if not isMissionPlace() then
            got = readSaveLocal(); if got then src = "local" end
        end
        if not got then got = readSaveActor();   if got then src = "actor"   end end
        if not got then got = readSaveReplica(); if got then src = "replica" end end
    end
    if not got then
        got = readSaveRemote(); if got then src = "remote" end
    end

    if got then
        SAVE.data, SAVE.at, SAVE.source = got, os.clock(), src
    end
    SAVE.inflight = false
    return SAVE.data
end

local function getSlot(force)
    local d = getSave(force)
    if not d or type(d.Slots) ~= "table" then return nil end
    return d.Slots[d.Current_Slot or slotKey()] or d.Slots[slotKey()]
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 15 · DERIVED SAVE READS
-- ═══════════════════════════════════════════════════════════════════════════

-- Find a key anywhere in the save without knowing its path. Used only for the
-- handful of status fields whose location is not pinned down (Family, Spins) —
-- the known paths are always read directly first, because a direct read is
-- exact and this is a guess. Depth-capped and cycle-guarded: the save is a
-- large nested table and an uncapped walk on every telemetry tick is not free.
local function deepFind(tbl, key, maxDepth, seen)
    if type(tbl) ~= "table" then return nil end
    maxDepth = maxDepth or 6
    seen = seen or {}
    if seen[tbl] or maxDepth < 0 then return nil end
    seen[tbl] = true
    local direct = rawget(tbl, key)
    if direct ~= nil then return direct end
    for _, v in pairs(tbl) do
        if type(v) == "table" then
            local found = deepFind(v, key, maxDepth - 1, seen)
            if found ~= nil then return found end
        end
    end
    return nil
end

-- Refresh STATE from the save. Cheap now that the save itself is local, so it
-- can run far more often than v9's 15-second remote poll.
local function refreshState(force)
    local slot = getSlot(force)
    if not slot then
        -- Attributes are the only source that survives a place transition
        -- before the save replicates, so keep them as a floor.
        STATE.level    = num(plr:GetAttribute("Level"),    STATE.level)
        STATE.prestige = num(plr:GetAttribute("Prestige"), STATE.prestige)
        return false
    end

    local prog = slot.Progression
    if type(prog) == "table" then
        STATE.level    = num(prog.Level,    STATE.level)
        STATE.prestige = num(prog.Prestige, STATE.prestige)
        STATE.xp       = num(prog.XP,       STATE.xp)
        STATE.maxXp    = num(prog.Max_XP,   STATE.maxXp)
        STATE.potential= tonumber(prog.Potential) or STATE.potential
    end
    if type(slot.Currency) == "table" then
        STATE.gold = num(slot.Currency.Gold, STATE.gold)
        if slot.Currency.Gems then STATE.gems = num(slot.Currency.Gems, STATE.gems) end
    end
    if type(slot.Currencies) == "table" and slot.Currencies.Gems then
        STATE.gems = num(slot.Currencies.Gems, STATE.gems)
    end

    -- Perks: count storage and collect the UUIDs of anything not equipped.
    -- Equipped perks cannot be sold, and v9 had a live bug where the LEAVE
    -- decision counted all perks while the SELL decision counted only
    -- sellable ones — so a full-but-mostly-equipped storage would leave the
    -- mission, fail to sell anything, and immediately re-enter. Same number
    -- both places here.
    --
    -- The `not p.Equipped` test below used to be the whole filter, and it was
    -- broken by construction: a Perks.Storage entry has EXACTLY three fields —
    -- Name, Level, XP. There is no Equipped boolean, so `not p.Equipped` was
    -- always true and every perk counted as sellable, equipped ones included.
    -- Live proof before the fix: perksTotal 76, perksSellable 76, identical.
    --
    -- Equipped-ness lives in slot.Perks.Equipped, a table of SIX Type-keyed
    -- slots (Body/Defense/Extra/Family/Offense/Support) whose VALUES are the
    -- uuids, empty string meaning empty. That is also exactly what
    -- Utilities.Stats reads to build Perks.Active, so it is the authority.
    if type(slot.Perks) == "table" and type(slot.Perks.Storage) == "table" then
        local equippedUUID, equippedN = {}, 0
        if type(slot.Perks.Equipped) == "table" then
            for _, uuid in pairs(slot.Perks.Equipped) do
                if type(uuid) == "string" and uuid ~= "" then
                    equippedUUID[uuid] = true
                    equippedN = equippedN + 1
                end
            end
        end
        STATE.perksEquipped = equippedN

        local total, uuids = 0, {}
        for uuid, p in pairs(slot.Perks.Storage) do
            total = total + 1
            if type(p) == "table" and p.Name and not equippedUUID[uuid] and not p.Equipped then
                uuids[#uuids + 1] = uuid
            end
        end
        -- Never let a momentarily-empty read wipe a known-good count.
        if total > 0 or STATE.perksTotal == 0 then
            STATE.perksTotal    = total
            STATE.perkUUIDs     = uuids
            STATE.perksSellable = #uuids
        end
    end

    -- Family, Spins: known paths first, deep scan only as a fallback.
    -- Avatar.Family first: a blind deepFind can land on Extra_Slots.Family,
    -- which is a slot COUNT, and report the family as "3".
    local fam = (type(slot.Avatar) == "table" and slot.Avatar.Family)
        or slot.Family or (type(slot.Progression) == "table" and slot.Progression.Family)
    if fam == nil then fam = deepFind(slot, "Family") end
    if type(fam) == "table" then fam = fam.Name or fam.Tag end
    if fam ~= nil and fam ~= "" then STATE.family = tostring(fam) end

    -- The roll counter the in-game FAMILY STATS panel shows as "ROLL (n)" lives
    -- at the SAVE ROOT, as Data.Extra. Data.Spins also exists and is dead in this
    -- build -- it never moves off 0 -- and the only other Spins keys in the save
    -- are weekly-quest REWARD amounts, which are not a balance and must not be
    -- read as one. Measured live: panel "ROLL (45)" <-> Data.Extra 45 while
    -- Data.Spins was 0. Reading Spins first is what pinned STATE.spins (and so
    -- _G.VCP.spins, the panel row and the Discord report) at 0 on every account.
    local save  = SAVE.data
    -- "ROLL (n)" is Spins + Extra (Customisation.Rolling). Spins sat at 0 on
    -- every account measured, but bought spins may land there.
    local spins = save and rawget(save, "Extra")
    if spins ~= nil then spins = num(spins) + num(rawget(save, "Spins")) end
    if spins == nil then
        spins = slot.Spins
            or (type(slot.Currencies) == "table" and slot.Currencies.Spins)
            or (type(slot.Currency)   == "table" and slot.Currency.Spins)
            or (save and rawget(save, "Spins"))
            or deepFind(slot, "Spins")
    end
    if tonumber(spins) then STATE.spins = tonumber(spins) end

    STATE.inventory = slot.Inventory or STATE.inventory
    STATE.slot      = slot

    -- v9 compatibility globals — external panels still read these.
    _G.LastLevel, _G.LastPrestige = STATE.level, STATE.prestige
    _G.LastXP, _G.LastMaxXP       = STATE.xp, STATE.maxXp
    _G.LastGold, _G.LastGems      = STATE.gold, STATE.gems
    _G.TotalPerksCount, _G.PerksUUIDs = STATE.perksTotal, STATE.perkUUIDs
    _G.LastInventory              = STATE.inventory
    return true
end

local function levelCap()      return 100 + (STATE.prestige * 25) end
local function isMaxed()
    -- "Maxed" means level cap AND xp bar full. v9 originally checked only the
    -- level, which made the mission side think it was ready to prestige while
    -- the lobby side disagreed — the bot then bounced between creating a
    -- mission and leaving it forever.
    if STATE.level < levelCap() or STATE.level <= 0 then return false end
    local maxXp = STATE.maxXp
    if maxXp <= 0 then return false end     -- not loaded yet: assume not maxed
    return STATE.xp >= maxXp
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 16 · INVENTORY / THUNDER SPEAR
-- ═══════════════════════════════════════════════════════════════════════════
-- How many of an item the slot holds. The inventory is two levels deep
-- (category -> {itemName = qty}), and the category an item lives in is not
-- fixed, so both helpers scan rather than assuming "Items".
local function invCount(itemName, inventory)
    inventory = inventory or STATE.inventory
    if type(inventory) ~= "table" then return 0 end
    for _, category in pairs(inventory) do
        if type(category) == "table" then
            local amount = tonumber(category[itemName])
            if amount then return amount end
        end
    end
    return 0
end

local function invHas(itemName, inventory)
    inventory = inventory or STATE.inventory
    if type(inventory) ~= "table" then return false end
    for _, category in pairs(inventory) do
        if type(category) == "table" then
            local amount = category[itemName]
            if amount and num(amount) > 0 then return true end
        end
    end
    return false
end

local function hasSpearPart(part, inventory)
    local item = TS_ITEM[part]
    return item and invHas(item, inventory) or false
end

-- Handle is chased last and under a session budget. Its two gating quests are
-- Towers then Escort, both of which credit on the OUTSKIRTS SKIRMISH objective
-- at Aberrant difficulty — Escort auto-starts inside the same run once the
-- three towers are up. v9 concluded Escort had no server-side handler, but it
-- was staging the map's separate "Escort" objective, which the questline does
-- not watch; the router now always asks for Skirmish. The budget stays as a
-- backstop: after CFG.HandleMaxMissions Outskirts runs with no Handle in the
-- inventory, K.TS.handleDone latches and the router treats Thruster + Base as
-- complete rather than looping the map forever. Owning the Handle clears the
-- latch implicitly because hasSpearPart wins.
-- Note Escort is fail-and-restart: a lost carriage costs a whole attempt.
K.TS = { tries = 0, handleDone = false, lastLine = nil }

-- Every Roblox teleport is a new server and a new Lua VM, so the in-memory log
-- ring (§6) cannot answer "did the Outskirts run actually happen?" — it is
-- wiped between missions. This appends the same lines to disk instead, keyed
-- per UserId so multi-instance boxes do not interleave. Read it from outside
-- the game with readfile(K.TS_FILE); it is trimmed at TS_FILE_MAX bytes.
K.TS_FILE = ("VCPlus_TS_%s.log"):format(tostring(plr.UserId))
local TS_FILE_MAX = 96 * 1024

-- The attempt budget has to live on disk for the same reason the log does:
-- every mission is a teleport, every teleport is a new Lua VM, and the lobby
-- pass that increments the counter runs in a VM that is gone by the time the
-- next one starts. Kept in memory it read "attempt 1/10" forever and the cap
-- never bound anything.
K.TRIES_FILE = ("VCPlus_TSTries_%s.txt"):format(tostring(plr.UserId))

K.saveTsTries = function()
    if not EXEC.writefile then return end
    pcall(EXEC.writefile, K.TRIES_FILE,
        ("%d|%s"):format(K.TS.tries, K.TS.handleDone and "1" or "0"))
end

K.loadTsTries = function()
    pcall(function()
        if not (EXEC.isfile and EXEC.readfile and EXEC.isfile(K.TRIES_FILE)) then return end
        local raw = EXEC.readfile(K.TRIES_FILE) or ""
        local n, done = raw:match("^(%d+)|([01])$")
        if n then
            K.TS.tries = tonumber(n) or 0
            K.TS.handleDone = (done == "1")
        end
    end)
end

K.loadTsTries()

K.tsBreadcrumb = function(line)
    if not EXEC.writefile then return end
    pcall(function()
        -- os.date is unavailable in some executor sandboxes; os.time always is.
        local stamp = ("%d @%s"):format(os.time(), tostring(game.PlaceId))
        local entry = ("%s | %s"):format(stamp, line) .. string.char(10)
        -- Potassium's appendfile ERRORS on a missing file rather than
        -- creating it, and this whole body is inside a pcall — so without the
        -- seed write the first breadcrumb of every session vanished silently.
        local exists = EXEC.isfile and EXEC.isfile(K.TS_FILE)
        if EXEC.appendfile and exists then
            EXEC.appendfile(K.TS_FILE, entry)
        elseif not exists then
            EXEC.writefile(K.TS_FILE, entry)
        else
            local prev = ""
            if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.TS_FILE) then
                prev = EXEC.readfile(K.TS_FILE) or ""
            end
            EXEC.writefile(K.TS_FILE, prev .. entry)
        end
        -- Trim from the front so the file cannot grow without bound.
        if EXEC.isfile and EXEC.readfile and EXEC.isfile(K.TS_FILE) then
            local all = EXEC.readfile(K.TS_FILE) or ""
            if #all > TS_FILE_MAX then
                EXEC.writefile(K.TS_FILE, all:sub(#all - (TS_FILE_MAX // 2)))
            end
        end
    end)
end

-- On K, not a local: the main chunk sits at Luau's 200-local ceiling.
-- True when the account has nothing better to do than finish the spears:
-- prestige target reached and the level bar capped.
K.spearFocus = function()
    if CFG.SpearFocusWhenDone == false then return false end
    return STATE.prestige >= num(CFG.PrestigeTarget, 5) and isMaxed()
end

K.chasingHandle = function()
    if CFG.ChaseSpearHandle == false then return false end
    -- The attempt budget exists to stop a broken quest from eating farm time.
    -- In focus mode there is no farm time to protect, so it does not apply.
    if K.spearFocus() then return true end
    return not K.TS.handleDone
end

local function spearsComplete(inventory)
    if not (hasSpearPart("Thruster", inventory) and hasSpearPart("Base", inventory)) then
        return false
    end
    if K.chasingHandle() and not hasSpearPart("Handle", inventory) then return false end
    return true
end

local function nextSpearMap(inventory)
    if not hasSpearPart("Base", inventory)     then return "Forest" end
    if not hasSpearPart("Thruster", inventory) then return "Utgard" end
    if K.chasingHandle() and not hasSpearPart("Handle", inventory) then return "Outskirts" end
    return nil
end

-- Called once per Outskirts mission the router stages for the Handle. Latches
-- the give-up flag when the budget runs out so the next lobby pass routes to a
-- normal farm map instead.
K.noteHandleAttempt = function()
    K.TS.tries = K.TS.tries + 1
    K.saveTsTries()
    local cap = math.max(1, math.floor(num(CFG.HandleMaxMissions, 10)))
    log("TS", ("Handle attempt %d/%d"):format(K.TS.tries, cap))
    K.tsBreadcrumb(("Handle attempt %d/%d"):format(K.TS.tries, cap))
    if K.TS.tries >= cap and not K.spearFocus() then
        K.TS.handleDone = true
        K.saveTsTries()
        log("TS", "Handle budget spent (Escort quest looks server-side broken) — "
                .. "treating 2/3 as complete for this session")
    end
end

local function spearsQuestState()
    local slot = STATE.slot or getSlot()
    local out = {}
    if not slot or type(slot.Quests) ~= "table" or type(slot.Quests.Spears) ~= "table" then
        return out
    end
    for k, q in pairs(slot.Quests.Spears) do
        if type(q) == "table" then
            out[tostring(k)] = {
                Tag      = tostring(q.Tag or ""),
                Current  = num(q.Current),
                Rewarded = q.Rewarded == true,
            }
        end
    end
    return out
end

local function spearQuestClaimed(tag)
    for _, q in pairs(spearsQuestState()) do
        if q.Tag == tag then return q.Rewarded end
    end
    return false
end

-- Spell out the Thunder Spear state: which parts are owned, which are missing,
-- where each missing one comes from, and how its gating quests stand. Deduped
-- on the rendered line, so the lobby loop can call it every pass and it only
-- prints when something actually moved.
--
-- `gate` is an optional string naming the reason the router is NOT chasing
-- spears right now (level not maxed, prestige too low, ...). Without it the
-- line ends with the map the router is heading to instead.
K.logSpears = function(gate, inventory)
    local inv = inventory or STATE.inventory
    -- Early in a place the save has not arrived and every part reads as
    -- missing, which printed "have nothing ... next: Forest" on an account
    -- holding two of the three parts. Say nothing rather than something wrong.
    if type(inv) ~= "table" or next(inv) == nil then return end
    local have, missing = {}, {}
    for _, part in ipairs({ "Handle", "Thruster", "Base" }) do
        if hasSpearPart(part, inv) then
            have[#have + 1] = part
        else
            missing[#missing + 1] = part
        end
    end

    -- Quest progress for the missing parts only — the owned ones are noise.
    local detail = {}
    for _, part in ipairs(missing) do
        local tags = {}
        for _, tag in ipairs(TS_QUESTS[part] or {}) do
            tags[#tags + 1] = tag .. (spearQuestClaimed(tag) and " ✅" or " ❌")
        end
        local from = nil
        for map, mapPart in pairs(TS_PART_OF) do
            if mapPart == part then from = map break end
        end
        detail[#detail + 1] = ("%s (%s: %s)")
            :format(part, tostring(from), table.concat(tags, ", "))
    end

    local line
    if #missing == 0 then
        line = "all 3 parts owned"
    else
        line = ("have %s · missing %s")
            :format(#have > 0 and table.concat(have, "+") or "nothing",
                    table.concat(detail, " · "))
        if gate then
            line = line .. " — not chasing: " .. gate
        else
            local nxt = nextSpearMap(inv)
            line = line .. (nxt and (" — next: " .. nxt) or " — nothing left to chase")
        end
    end

    if line ~= K.TS.lastLine then
        K.TS.lastLine = line
        log("TS", line)
        K.tsBreadcrumb(line)
    end
end

-- Claim the five Spears quests. Rate-limited because v9 had seven call sites
-- that could all fire in the same second.
local LAST_SPEAR_CLAIM = 0
local function claimSpears()
    local now = os.clock()
    if now - LAST_SPEAR_CLAIM < 3 then return false end
    LAST_SPEAR_CLAIM = now
    local any = false
    for _, tag in ipairs(ALL_TS_TAGS) do
        if not spearQuestClaimed(tag) then
            if invoke(3, "Functions", "Quest", tag, "Spears") ~= nil then any = true end
            jwait(0.1, 0.06)
        end
    end
    if any then getSave(true) end
    return any
end

-- UI fallback: some claims only register through the button handler. Scans for
-- visible CLAIM buttons and fires their connections directly.
local function clickClaimButtons()
    local clicked = 0
    pcall(function()
        local gui = plr:FindFirstChild("PlayerGui")
        if not gui then return end
        local function scan(root, depth)
            if depth > 8 then return end
            for _, ch in ipairs(root:GetChildren()) do
                if (ch:IsA("TextButton") or ch:IsA("TextLabel"))
                and ch.Visible
                and tostring(ch.Text):upper() == "CLAIM"
                and ch.AbsolutePosition.X > 10 and ch.AbsolutePosition.Y > 10 then
                    local btn = ch
                    if not btn:IsA("GuiButton") then
                        local p = ch.Parent
                        for _ = 1, 3 do
                            if not p then break end
                            if p:IsA("GuiButton") then btn = p break end
                            p = p.Parent
                        end
                    end
                    if btn:IsA("GuiButton") then
                        for _, c in ipairs(safeConns(btn.MouseButton1Click)) do pcall(function() c:Fire() end) end
                        for _, c in ipairs(safeConns(btn.Activated))        do pcall(function() c:Fire() end) end
                        if EXEC.firesignal then
                            pcall(EXEC.firesignal, btn.MouseButton1Click)
                            pcall(EXEC.firesignal, btn.Activated)
                        end
                        clicked = clicked + 1
                    end
                end
                scan(ch, depth + 1)
            end
        end
        scan(gui, 0)
    end)
    return clicked
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 17 · ANTI-LAG
--     Strips rendering cost so 30-40 clients fit on one machine. Two rules
--     learned the hard way and preserved from v9:
--       · never touch CanCollide — killing world collision drops titans and
--         escort carts through the map and objectives stop counting
--       · skip this entirely on Thunder Spear maps — hiding objective geometry
--         there stops the mission summary from appearing
-- ═══════════════════════════════════════════════════════════════════════════
local function applyAntiLag()
    if not CFG.AutoAntiLag then return end

    -- THE FRAME CAP IS NOT PART OF THE PART-HIDING PASS, and must not be
    -- skipped along with it. It used to sit inside the block below, so a
    -- Thunder Spear map returned early and left that client rendering at full
    -- rate — on a box with thirty clients, one uncapped client is enough to
    -- take frames off the other twenty-nine. Hiding geometry is what breaks TS
    -- objectives; capping the frame rate has nothing to do with them.
    pcall(function()
        local cap = tonumber(CFG.AntiLagFPS)
        if cap and EXEC.setfpscap then EXEC.setfpscap(math.floor(cap)) end
    end)

    -- Silence the audio engine by MOVING THE LISTENER, not by walking the
    -- DataModel. Mixing and decoding positional sound is real CPU, and on a
    -- farm client it buys nothing at all; but muting it the obvious way means
    -- a full GetDescendants walk plus a handler for every Sound created
    -- afterwards, which on thirty clients costs more than it saves. Parking the
    -- listener a million studs up attenuates every positional sound in the game
    -- to nothing with a single call, and there is nothing to maintain.
    if CFG.AntiLagAudio ~= false then
        -- SetListener, not SetListenerType — the latter is not a member of
        -- SoundService, so indexing it RAISES, and the whole call sat inside a
        -- bare pcall that swallowed the error while AntiLagAudio reported
        -- success. The audio engine kept mixing on every client and the saving
        -- never happened. Keep the pcall (some sandboxes proxy SoundService),
        -- but capture the error so a future rename is visible instead of silent.
        local ok, err = pcall(function()
            SoundService:SetListener(Enum.ListenerType.CFrame,
                                     CFrame.new(0, 1e6, 0))
        end)
        if not ok then log("LAG", "audio listener park failed: " .. tostring(err)) end
    end

    if _G.VCP_AntiLag then return end
    if select(1, currentTSMap()) then
        log("LAG", "Thunder Spear map — part hiding skipped so objectives still register")
        return
    end
    _G.VCP_AntiLag = true

    task.spawn(function()
        pcall(function()
            settings().Rendering.QualityLevel        = Enum.QualityLevel.Level01
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        end)
        pcall(function()
            Lighting.GlobalShadows = false
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") then v.Enabled = false end
            end
        end)
        -- (The frame cap moved to the top of applyAntiLag, above the Thunder
        -- Spear early-return, so it is applied on every map. It is no longer a
        -- throughput setting either: the pulse is paced by wall-clock tokens,
        -- not by frames — see §21a.)
        pcall(function()
            Workspace.Terrain.WaterWaveSize   = 0
            Workspace.Terrain.WaterWaveSpeed  = 0
            Workspace.Terrain.WaterReflectance= 0
            Workspace.Terrain.WaterTransparency = 0
            Workspace.Terrain:Clear()
        end)

        local function hide(v)
            pcall(function()
                if v:IsA("BasePart") then
                    if v.Transparency ~= 1 then v.Transparency = 1 end
                    v.Material   = Enum.Material.SmoothPlastic
                    v.Reflectance= 0
                    v.CastShadow = false
                    if v:IsA("MeshPart") then v.TextureID = "" end
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 1
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
                    or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    v.Enabled = false
                    v:Destroy()
                end
            end)
        end

        local roots = {}
        for _, name in ipairs({ "World", "Climbable", "Unclimbable", "Debris",
                                "Hooks", "Points", "Map", "Props" }) do
            local f = Workspace:FindFirstChild(name)
            if f then roots[#roots + 1] = f end
        end

        -- ONE queue and ONE worker for every root folder, not one of each per
        -- folder. DescendantAdded fires per part and one spawning titan is 50+
        -- parts, so the batching is essential — but the previous version span
        -- a thread per folder, each waking twice a second: eight threads and
        -- sixteen scheduler wakeups a second per client, times thirty clients,
        -- to do work that batches perfectly into one.
        --
        -- `qn` is tracked explicitly rather than read as `#queue`, because the
        -- length operator on a table being appended to from an event handler is
        -- a scan, and this handler runs on the hot path of a titan spawn wave.
        local queue, qn = {}, 0
        for _, rootFolder in ipairs(roots) do
            for _, v in ipairs(rootFolder:GetDescendants()) do hide(v) end
            rootFolder.DescendantAdded:Connect(function(v)
                -- Gate on alive(): a soft re-exec (the single-instance guard)
                -- bumps VCP_RUN_ID and the drain worker below exits, but this
                -- handler would otherwise keep appending forever to a queue that
                -- nothing drains. This makes the leak impossible without having
                -- to store and disconnect every connection.
                if not alive() then return end
                qn = qn + 1
                queue[qn] = v
            end)
        end
        task.spawn(function()
            K.stagger(0.5)
            while alive() do
                task.wait(0.5)
                if qn > 0 then
                    local batch, bn = queue, qn
                    queue, qn = {}, 0
                    for i = 1, bn do hide(batch[i]) end
                end
            end
        end)

        task.spawn(function()
            K.stagger(120)
            while alive() do
                task.wait(120)
                pcall(function() Workspace.Terrain:Clear() end)
            end
        end)
    end)
end

