-- 10 · INSTANT LIFT
--
--     A freshly spawned character stands on the mission spawn for the several
--     seconds the rest of the script takes to wire up, which is long enough
--     for a titan to eat it. Lifting on CharacterAdded removes that window.
--
--     The gate is the presence of a Titans folder rather than a hardcoded
--     "these places are social hubs" list. v9 maintained such a list and it
--     was already wrong — it classified Docks and Stohess as hubs when the
--     game's own Friends.Places calls both of them Mission maps. Waiting for
--     Titans is self-correcting: real combat maps have it, hubs never do.
-- ═══════════════════════════════════════════════════════════════════════════
local function shouldLift()
    if CFG.AutoLift == false then return false end
    if not isMissionPlace() then return false end
    return Workspace:FindFirstChild("Titans") ~= nil
end

task.spawn(function()
    local function lift(char)
        if not char then return end
        if CFG.AutoLift == false or not isMissionPlace() then return end
        task.spawn(function()
            local hrp = char:FindFirstChild("HumanoidRootPart")
                     or waitChild(char, "HumanoidRootPart", 25)
            if not hrp then return end

            local spawnY = hrp.Position.Y
            local function raise()
                pcall(function()
                    hrp.Anchored = false
                    local p = hrp.Position
                    hrp.CFrame = CFrame.new(p.X, math.max(p.Y + 300, 500), p.Z)
                end)
            end

            -- Lift NOW. isMissionPlace() already confirmed a combat map from the
            -- game's own Friends.Places table, so do NOT block on workspace.Titans
            -- first. On Thunder Spear / Escort maps the Titans folder arrives late
            -- (it spawns after the start cutscene), and the old 12s wait left the
            -- fresh character standing at the spawn exactly long enough for a titan
            -- to eat it -- the reported "dies on join during Thunder Spear". A
            -- rare mis-classified hub just gets a harmless float instead.
            task.wait(0.05)                     -- one beat for the rig to assemble
            raise()

            -- HOLD it out of grab range until the combat hover owns the character
            -- (VCP_HoverBP), or a few seconds pass. A single CFrame falls straight
            -- back to the ground before the hover engages on the slower objective
            -- maps -- the second way it died. Re-lift ONLY when it has dropped back
            -- near its spawn height, so this never fights the escort/tower logic
            -- parking it at guard height well above the ground.
            local deadline = os.clock() + 6
            while os.clock() < deadline do
                task.wait(0.2)
                if not (hrp and hrp.Parent) then return end
                if hrp:FindFirstChild("VCP_HoverBP") then break end
                if hrp.Position.Y < spawnY + 150 then raise() end
            end
        end)
    end
    if plr.Character then lift(plr.Character) end
    plr.CharacterAdded:Connect(lift)
end)

