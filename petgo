--  1 · SINGLE-INSTANCE GUARD
--     Every long-lived loop in this file checks `RUN_ID == _G.VCP_RUN_ID`.
--     Re-executing the script bumps the id, so the previous instance's loops
--     all fall out on their next iteration instead of doubling up.
-- ═══════════════════════════════════════════════════════════════════════════
_G.VCP_RUN_ID = (_G.VCP_RUN_ID or 0) + 1
local RUN_ID  = _G.VCP_RUN_ID

local function alive() return RUN_ID == _G.VCP_RUN_ID end

-- Luau allows at most 200 simultaneously-live locals per function, and the
-- main chunk is one function. Constant tables and small module-level state
-- that used to be top-level locals live here instead, which buys back the
-- registers the combat code needs.
local K = {}

