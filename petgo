end

-- Give the queue a moment before a teleport kills this VM with posts in it.
function K.whFlush(timeout)
    if not K.whEnabled() then return end
    waitUntil(function() return #K.WH.q == 0 and not K.WH.busy end, timeout or 6, 0.2)
end

-- ═══════════════════════════════════════════════════════════════════════════
-- 41e · VC+ ACCOUNT TRACKER
--
--     Reports this account to the Accounts page on vcplus.xyz: level, gold,
--     gems, spins, family, perks, Thunder Spear parts, the items and the
--     session rates. One POST to /api/aotr with the licence key in the body;
--     the site files the report under the VC+ account registered with that key.
--
--     WHEN. Once shortly after the save is readable, then every VCPlusEvery
--     seconds. Every mission is its own server and its own VM, so the boot
--     report IS how the site sees each teleport — a report that waited out the
--     first interval would never leave a 45-second mission at all.
--
--     FOUR RULES IT IS BUILT TO.
--
--     · It never blocks the farm. The POST runs in its own thread under a
--       pcall, at most one is in flight, nothing waits for the answer, and
--       one that never answers is given up on after 60s.
--     · It never reads the save itself. STATE is kept current by the lobby and
--       mission code; a read from here would be a doomed main-VM getgc walk in
--       the lobby (CoreTable is actor-only since the Aug-2026 patch) and, in a
--       mission before the actor bridge is up, a server round trip through
--       readSaveRemote. Thirty clients at 5 fps cannot afford either once a
--       minute for a status report, so it sends what STATE already holds.
--     · What it has to remember is on disk. getgenv() and _G die with the VM,
--       so a "stop for 30 min" or a backoff kept in memory would be forgotten
--       at the next teleport and retried by the next mission — a whole box
--       hammering a site that already said no.
--     · The key is never printed. It comes from the config, the loader or the
--       copy saved on this PC, and it only ever leaves in the request body.
-- ═══════════════════════════════════════════════════════════════════════════
K.VC = {
    VERSION = "aotr-v10",
    -- Per account: the off / backoff verdicts, the item cadence and the XP
    -- counter. Keyed by UserId like every other file here, because thirty
    -- clients share one workspace folder. NOT keyed by GameId: the Thunder
    -- Spear maps are a second universe (TS_ALT_IDS), and the site's verdict,
    -- its item list and the XP this account earned are the same in both.
    file    = ("VCPlus_Track_AOTR_%s.json"):format(tostring(plr.UserId)),
    -- Per PC: the licence key. Luarmor clears script_key once its own check has
    -- run, and the owner's local build has no loader at all, so a place that
    -- starts with no key in sight reads it back from here. No GameId either, so
    -- a place in the second universe finds the key the lobby saved.
    keyFile = "VCPlus_Key_AOTR.txt",
    pcFile  = "VCPlus_PC.txt",
    bootAt  = os.clock(),
    said    = {},
    busy    = false,
    seq     = 0,        -- which send owns the in-flight slot (see K.vcAbandon)
}

-- Log a line once per VM. The conditions it reports (no key, no request(),
-- the site refusing) hold for the whole place, so repeating them is noise.
function K.vcSay(msg)
    local V = K.VC
    if V.said[msg] then return end
    V.said[msg] = true
    log("TRACK", msg)
end

-- A string the site will take: no control characters, trimmed, valid UTF-8,
-- at most `max` BYTES. Bytes, not characters, because a byte cap can never
-- exceed the site's character cap, and a cut through a multi-byte character
-- is what would leave invalid UTF-8 for the JSON encoder to choke on.
function K.vcStr(v, max)
    local s = (v == nil) and "" or tostring(v)
    s = s:gsub("%c", " ")
    s = s:match("^%s*(.-)%s*$") or ""
    if not utf8.len(s) then s = s:gsub("[\128-\255]", "?") end
    if #s > max then
        s = s:sub(1, max)
        for _ = 1, 3 do
            if utf8.len(s) then break end
            s = s:sub(1, -2)
        end
    end
    return s
end

-- A whole, finite, non-negative number. NaN and infinity are not JSON, and a
-- save value mid-replication can be either, so every number goes through here.
function K.vcInt(v, hi)
    local n = tonumber(v)
    if not n or n ~= n then return 0 end
    hi = hi or 1e15
    if n > hi then return hi end
    if n < 0 then return 0 end
    return math.floor(n)
end

-- A per-hour figure: finite, non-negative, one decimal.
function K.vcRate(v)
    local n = tonumber(v)
    if not n or n ~= n or n <= 0 then return 0 end
    if n > 1e13 then return 1e13 end
    return math.floor(n * 10 + 0.5) / 10
end

function K.vcBase()
    local u = CFG.VCPlusURL
    if type(u) ~= "string" or not u:match("^https?://[%w%.%-]+") then return nil end
    return (u:gsub("/+$", ""))
end

-- The licence key: the config, then the loader's getgenv().VCPlusKey, then a
-- script_key Luarmor has not cleared yet, then the copy saved on this PC. A key
-- found anywhere but the file is written to it, so the next place — whose
-- getgenv() starts empty — still has one. Only written when it differs, so a
-- box of clients sharing one key does not rewrite the file every boot.
function K.vcKey()
    local V = K.VC
    local function clean(k)
        if type(k) ~= "string" then return nil end
        k = k:gsub("%s+", "")
        if #k < 8 or #k > 200 then return nil end
        return k
    end
    local key = clean(CFG.VCPlusKey)
    if not key then pcall(function() key = clean(getgenv().VCPlusKey) end) end
    if not key then pcall(function() key = clean(getgenv().script_key) end) end
    if not key then pcall(function() key = clean(script_key) end) end
    if V.keyDisk == nil then
        V.keyDisk = false
        pcall(function()
            if EXEC.isfile and EXEC.readfile and EXEC.isfile(V.keyFile) then
                V.keyDisk = clean(EXEC.readfile(V.keyFile)) or false
            end
        end)
    end
    if key then
        if key ~= V.keyDisk then
            V.keyDisk = key
            pcall(function() if EXEC.writefile then EXEC.writefile(V.keyFile, key) end end)
        end
        return key
    end
    return V.keyDisk or nil
end

-- Which machine this is, for the site's per-PC grouping. Not a hardware id: a
-- short name made up once. The Blox Fruits bot keeps this PC's name in
-- bfkaitun/pc.txt, and renaming that file renames the machine everywhere, so
-- it is read first, fresh every VM and never copied: a copy would keep the old
-- name after a rename. A name that has to be made up is written there too, so
-- whichever bot runs first both show this PC under one name. VCPlus_PC.txt is
-- only the fallback for an executor that cannot write into that folder.
function K.vcPC()
    local V = K.VC
    if V.pc then return V.pc end
    local function read(f)
        local s = ""
        pcall(function()
            if EXEC.isfile and EXEC.readfile and EXEC.isfile(f) then
                s = tostring(EXEC.readfile(f) or ""):match("^%s*(.-)%s*$") or ""
            end
        end)
        return s
    end
    local raw = read("bfkaitun/pc.txt")
    if raw == "" then
        local made = false
        raw = read(V.pcFile)
        if raw == "" then raw, made = ("PC-%04X"):format(math.random(0, 0xFFFF)), true end
        pcall(function()
            if isfolder and makefolder and not isfolder("bfkaitun") then makefolder("bfkaitun") end
        end)
        pcall(function() if EXEC.writefile then EXEC.writefile("bfkaitun/pc.txt", raw) end end)
        if made then
            pcall(function() if EXEC.writefile then EXEC.writefile(V.pcFile, raw) end end)
        end
    end
    -- What the Blox Fruits bot sends (trimmed, 24 bytes), put through the same
    -- filter the site's /api/partners puts it through, so both games file this
    -- PC under the same string, a non-ASCII name included.
    V.pc = (raw:sub(1, 24):gsub("[^%w _%.%-]", ""))
    return V.pc
end

-- The per-account memory, read once per VM.
function K.vcLoad()
    local V = K.VC
    if V.d then return V.d end
    local d = {}
    pcall(function()
        if EXEC.isfile and EXEC.readfile and EXEC.isfile(V.file) then
            local t = HttpService:JSONDecode(EXEC.readfile(V.file))
            if type(t) == "table" then d = t end
        end
    end)
    V.d = d
    return d
end

function K.vcSave()
    pcall(function()
        if EXEC.writefile and K.VC.d then
            EXEC.writefile(K.VC.file, HttpService:JSONEncode(K.VC.d))
        end
    end)
end

-- Max_XP is the witness that STATE came from a real save read: loadCache
-- restores level and gold from disk but never Max_XP (see K.whStart).
function K.vcReady()
    return (tonumber(STATE.maxXp) or 0) > 0
end

-- The session key of STATE.startedAt, a string because it is a JSON object key.
function K.vcSessKey()
    return ("%d"):format(math.floor(tonumber(STATE.startedAt) or 0))
end

-- XP gained this session, as summed by K.vcXpTick.
function K.vcSessXp(d)
    return (type(d.xpS) == "table" and tonumber(d.xpS[K.vcSessKey()])) or 0
end

-- XP gained this session. The bar resets every level and the level every
-- prestige, so XP cannot be subtracted the way gold is; the gain is summed
-- sample to sample instead. The samples straddle teleports, so they live in
-- the per-account file.
--
-- ONE chain of samples, but one sum per session (STATE.startedAt). The Thunder
-- Spear universe keeps its own session file and so its own startedAt: a chain
-- per universe would each count the XP earned while the other was away, and a
-- single sum keyed to startedAt would reset at every crossing. A gain is only
-- counted when the sample before it was taken inside this session, so the gap
-- before a new session (overnight, say) is never counted into it.
function K.vcXpTick(d)
    if not K.vcReady() then return end
    local started = tonumber(STATE.startedAt) or 0
    local sk = K.vcSessKey()
    if type(d.xpS) ~= "table" then d.xpS = {} end
    local cur = {
        lv = K.vcInt(STATE.level), p = K.vcInt(STATE.prestige),
        xp = K.vcInt(STATE.xp),    mx = K.vcInt(STATE.maxXp),
        t  = os.time(),
    }
    local L = d.last
    if type(L) == "table" and (tonumber(L.t) or 0) >= started then
        local lv, p = tonumber(L.lv) or 0, tonumber(L.p) or 0
        local xp, mx = tonumber(L.xp) or 0, tonumber(L.mx) or 0
        local gain = 0
        if cur.p == p and cur.lv == lv then
            gain = cur.xp - xp
        elseif cur.p == p and cur.lv > lv then
            -- The rest of the old bar, any whole bars in between (priced at the
            -- old bar's size, which is close enough), and what is on the new one.
            gain = math.max(0, mx - xp) + (cur.lv - lv - 1) * mx + cur.xp
        elseif cur.p > p then
            -- A prestige resets both. What is on the new bar is the least that
            -- was earned since.
            gain = cur.xp
        end
        if gain > 0 then d.xpS[sk] = K.vcInt((tonumber(d.xpS[sk]) or 0) + gain) end
    end
    d.last = cur
    -- Keep this session's sum and the three most recent others (the other
    -- universe's, a sitting or two back); older ones are never read again.
    local n, oldest = 0, nil
    for k in pairs(d.xpS) do
        n = n + 1
        if k ~= sk and (oldest == nil or (tonumber(k) or 0) < (tonumber(oldest) or 0)) then oldest = k end
    end
    if n > 4 and oldest then d.xpS[oldest] = nil end
end

-- The inventory as a flat list, skipping zero counts, sorted and capped at
-- 300, plus a signature of WHICH items it holds. The signature is a sum of
-- per-name hashes, so it does not depend on pairs() order and costs no sort.
function K.vcInv()
    local inv = STATE.inventory
    if type(inv) ~= "table" then return nil, nil end
    local list, n, sig = {}, 0, 0
    for cat, items in pairs(inv) do
        if type(items) == "table" then
            local c = K.vcStr(cat, 30)
            for name, qty in pairs(items) do
                local q = tonumber(qty)
                if q and q >= 1 and q < math.huge then   -- also false for NaN
                    local nm = K.vcStr(name, 60)
                    if nm ~= "" then
                        n = n + 1
                        list[n] = { c = c, n = nm, q = K.vcInt(q, 1e12) }
                        local h, s = 5381, c .. "\0" .. nm
                        for i = 1, #s do h = (h * 33 + s:byte(i)) % 4294967296 end
                        sig = (sig + h) % 4294967296
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b)
        if a.c ~= b.c then return a.c < b.c end
        return a.n < b.n
    end)
    for i = #list, 301, -1 do list[i] = nil end
    return list, ("%d:%x"):format(n, sig)
end

-- The report, per the site's contract (vcplus lib/aotr-store.ts). Every string
-- is capped and every number made finite here, so the site never has to
-- refuse a report for its shape. `inv` is passed in: it only rides along every
-- few minutes. A nil field (mission outside a mission, spear before the
-- inventory is known, inv between sends) is simply absent from the JSON.
function K.vcPayload(action, key, inv)
    local kind  = placeKind()
    local where = (kind == "Mission" and "mission") or (kind == "Menu" and "loading") or "lobby"
    local r     = rates()
    local d     = K.vcLoad()
    local hours = math.max(1, tonumber(r.elapsed) or 1) / 3600
    local xpSess = K.vcSessXp(d)
    local goldSess = 0
    if tonumber(STATE.goldAtStart) and STATE.gold > STATE.goldAtStart then
        goldSess = STATE.gold - STATE.goldAtStart
    end
    -- "None" is STATE's placeholder for "not read yet", and a report sent before
    -- the save arrived only has the cache's guess. The site keeps its last
    -- family on an empty one, so neither can log a false "Rolled X (was None)".
    local family = ""
    if K.vcReady() and STATE.family ~= "None" then family = K.vcStr(STATE.family, 40) end

    local mission = nil
    if where == "mission" then
        local diff, obj
        pcall(function()
            diff = Workspace:GetAttribute("Difficulty")
            obj  = Workspace:GetAttribute("Objective")
        end)
        -- The place registry, not CFG.MissionMap: a Thunder Spear run is on
        -- Outskirts / Utgard / Forest whatever the config says (see 41d).
        local map = MAP_OF[game.PlaceId] or currentTSMap()
        local run = K.WH and K.WH.run
        mission = {
            map        = K.vcStr(map or "?", 40),
            difficulty = K.vcStr(diff or "?", 40),
            objective  = K.vcStr(obj or "?", 60),
            elapsedSec = K.vcInt(os.clock() - ((run and run.at) or K.VC.bootAt), 86400),
        }
    end

    local spear = nil
    if type(STATE.inventory) == "table" then
        local owned = {}
        for _, part in ipairs({ "Handle", "Thruster", "Base" }) do
            if hasSpearPart(part) then owned[#owned + 1] = part end
        end
        spear = { owned = owned, complete = #owned == 3 }
    end

    return {
        key        = key,
        action     = action,
        robloxUser = tostring(plr.Name),
        userId     = K.vcInt(plr.UserId),
        jobId      = K.vcStr(game.JobId, 64),
        placeId    = K.vcInt(game.PlaceId),
        placeName  = K.vcStr(MAP_OF[game.PlaceId] or kind or "?", 40),
        where      = where,
        status     = K.vcStr(STATE.action, 140),
        mission    = mission,
        level      = K.vcInt(STATE.level),
        prestige   = K.vcInt(STATE.prestige),
        xp         = K.vcInt(STATE.xp),
        maxXp      = K.vcInt(STATE.maxXp),
        levelCap   = K.vcInt(levelCap()),
        gold       = K.vcInt(STATE.gold),
        gems       = K.vcInt(STATE.gems),
        spins      = K.vcInt(STATE.spins),
        family     = family,
        perks      = {
            total    = K.vcInt(STATE.perksTotal),
            equipped = K.vcInt(STATE.perksEquipped),
            sellable = K.vcInt(STATE.perksSellable),
        },
        spear      = spear,
        inv        = inv,
        rates      = {
            goldHr     = K.vcRate(r.goldHr),
            xpHr       = K.vcRate(xpSess / hours),
            killsHr    = K.vcRate(r.killsHr),
            missionsHr = K.vcRate(r.missionHr),
        },
        session    = {
            uptimeSec = K.vcInt(r.elapsed),
            missions  = K.vcInt(STATE.missions),
            kills     = K.vcInt(STATE.kills),
            gold      = K.vcInt(goldSess),
            xp        = K.vcInt(xpSess),
        },
        pc         = K.vcPC(),
        version    = K.VC.VERSION,
    }
end

-- JSON, kept under the site's 24 KB cap. An over-size body is refused whole,
-- which would silently stop the account updating; only the item list can get
-- near the cap, so it is what gets cut.
function K.vcEncode(p)
    local ok, body = pcall(function() return HttpService:JSONEncode(p) end)
    if not ok or type(body) ~= "string" then return nil end
    local limit = 23 * 1024
    for _ = 1, 6 do
        if #body <= limit or type(p.inv) ~= "table" then break end
        local keep = math.floor(#p.inv * (limit / #body) * 0.9)
        if keep < 1 then
            p.inv = nil
        else
            for i = #p.inv, keep + 1, -1 do p.inv[i] = nil end
        end
        ok, body = pcall(function() return HttpService:JSONEncode(p) end)
        if not ok or type(body) ~= "string" then return nil end
    end
    return body
end

-- Send one report from its own thread. `commit` runs only on a 2xx, so an item
-- list the site never received is sent again next time rather than marked done.
function K.vcSend(p, commit)
    local V = K.VC
    if V.busy then return false end
    V.seq = (V.seq or 0) + 1
    local seq = V.seq
    V.busy, V.busyAt = true, os.clock()
    task.spawn(function()
        local ok, err = pcall(function()
            local body = K.vcEncode(p)
            if not body then
                K.vcSay("VC+ tracking: the report would not encode - skipped")
                return
            end
            local okr, res = pcall(EXEC.request, {
                Url     = K.vcBase() .. "/api/aotr",
                Method  = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body    = body,
            })
            -- Given up on while it waited (K.vcAbandon): the answer is stale.
            if seq ~= V.seq then return end
            local code = 0
            if okr and type(res) == "table" then
                code = tonumber(res.StatusCode or res.Status_Code or res.status_code) or 0
            end
            K.vcAnswer(code, (okr and type(res) == "table") and res or nil, commit)
        end)
        if seq == V.seq then V.busy = false end
        if not ok then K.vcSay("VC+ tracking: report thread errored - " .. tostring(err):sub(1, 120)) end
    end)
    return true
end

-- Give up on the request in flight. Some executors' request() has no timeout
-- of its own, so a site that takes the connection and never answers would hold
-- the slot for the life of the VM: a mission recovers at the next teleport,
-- but a long lobby stay (a parked account, a family-rolling session) would go
-- silent and show offline. Moving the sequence on orphans the old thread, so
-- an answer that does arrive late can neither clear a backoff nor mark an item
-- list delivered that a newer report is now responsible for.
function K.vcAbandon()
    local V = K.VC
    V.seq = (V.seq or 0) + 1
    V.busy = false
    K.vcSay("VC+ tracking: a report got no answer in 60s - dropped it")
end

-- What the site's answer means for the next report.
--   2xx          accepted: clear any backoff.
--   401-404      no key / licence expired / banned / no VC+ account uses this
--                key. Asking again in a minute changes nothing, so reporting
--                stops for 30 min — on disk, or every mission would re-ask.
--   429 / 5xx / no answer / anything else
--                back off, doubling from 60s up to 10 min, and never sooner
--                than the site's own Retry-After.
function K.vcAnswer(code, res, commit)
    local V, d, now = K.VC, K.vcLoad(), os.time()
    if code >= 200 and code < 300 then
        d.boff, d.bUntil, d.at = nil, nil, now
        if commit then pcall(commit, d) end
        if V.failing then
            V.failing = false
            log("TRACK", "VC+ tracking: the site is answering again")
        end
        K.vcSave()
        return
    end

    local msg, retry
    pcall(function()
        local t = HttpService:JSONDecode(tostring(res.Body or res.body or ""))
        if type(t) == "table" and type(t.error) == "string" then msg = t.error end
    end)
    pcall(function()
        for k, v in pairs(res.Headers or res.headers or {}) do
            if tostring(k):lower() == "retry-after" then retry = tonumber(v) end
        end
    end)
    msg = K.vcStr(msg or ((code > 0) and ("HTTP " .. code) or "no answer from the site"), 120)

    if code == 401 or code == 402 or code == 403 or code == 404 then
        d.off = now + 1800
        log("TRACK", ("VC+ tracking: %s - off for 30 min"):format(msg))
    else
        d.boff   = math.min(600, math.max(60, (tonumber(d.boff) or 30) * 2))
        d.bUntil = now + math.max(d.boff, math.min(retry or 0, 600))
        if not V.failing then
            V.failing = true
            log("TRACK", ("VC+ tracking: %s - retrying in %ds"):format(msg, d.bUntil - now))
        end
    end
    K.vcSave()
end

-- One step of the reporter. Cheap until a report is due: a few comparisons.
function K.vcTick()
    local V = K.VC
    if V.stopped or CFG.VCPlusTrack == false then return end
    -- The finish hand-off (§41c): the host is about to swap this Roblox account
    -- out, so say "gone" now rather than leave it online on the site for five
    -- more minutes. Only with a host to hand off to: without one, DONE_SENT is
    -- just a log line and the farm carries on.
    if K.DONE_SENT and _G.Horst_AccountChangeDone then return K.vcGone() end
    if V.busy then
        if os.clock() - (tonumber(V.busyAt) or 0) < 60 then return end
        -- A site that hangs is a site to back off from, like one that errors.
        K.vcAbandon()
        return K.vcAnswer(0, nil, nil)
    end
    if not EXEC.request then
        return K.vcSay("VC+ tracking: this executor exposes no request() - off")
    end
    if not K.vcBase() then
        return K.vcSay("VC+ tracking: VCPlusURL is not an http(s) address - off")
    end
    local key = K.vcKey()
    if not key then
        return K.vcSay("VC+ tracking: no licence key - add getgenv().VCPlusKey = script_key to the loader")
    end

    local d, now = K.vcLoad(), os.time()
    if (tonumber(d.off) or 0) > now or (tonumber(d.bUntil) or 0) > now then return end

    if V.sentAt then
        if os.clock() - V.sentAt < math.clamp(num(CFG.VCPlusEvery, 60), 20, 600) then return end
    else
        -- The first report of this place: a moment after the save is readable,
        -- or after 30s with whatever the cache holds rather than not at all.
        -- The jitter spreads a box of clients that all loaded together.
        if not V.readyAt then
            if not K.vcReady() and os.clock() - V.bootAt < 30 then return end
            V.readyAt = os.clock() + math.random() * 2.5
        end
        if os.clock() < V.readyAt then return end
        -- The place before this one reported moments ago (a short lobby stop).
        if now - (tonumber(d.at) or 0) < 8 then return end
    end

    K.vcXpTick(d)
    local inv, sig = K.vcInv()
    local send = nil
    if inv and #inv > 0
       and (sig ~= d.invSig or now - (tonumber(d.invAt) or 0) >= 240) then
        send = inv
    end
    V.sentAt = os.clock()
    K.vcSend(K.vcPayload("report", key, send), send and function(dd)
        dd.invAt, dd.invSig = now, sig
    end or nil)
end

-- "gone": this account is stopping, so the site shows it offline now rather
-- than five minutes from now. Never sent on a teleport, because the next place
-- reports within seconds. Sent by K.vcTick at the DoneTarget hand-off, and
-- exported for whatever else closes a client on purpose: _G.VCP_TrackGone()
-- (running this file again is a restart, not a stop). Reporting from this VM
-- ends with it.
function K.vcGone()
    local V = K.VC
    if V.stopped then return end
    V.stopped = true
    if CFG.VCPlusTrack == false or not EXEC.request or not K.vcBase() then return end
    local key = K.vcKey()
    if not key or (tonumber(K.vcLoad().off) or 0) > os.time() then return end
    task.spawn(function()
        -- Let a report in flight land first, or it could mark the account
        -- online again after the "gone". Ten seconds is more than a real answer
        -- takes; past that it is not coming, and this is the last word.
        local t0 = os.clock()
        while V.busy and os.clock() - t0 < 10 do task.wait(0.25) end
        if V.busy then K.vcAbandon() end
        pcall(function() K.vcSend(K.vcPayload("gone", key, nil), nil) end)
    end)
end

_G.VCP_TrackGone = K.vcGone

task.spawn(function()
    local V = K.VC
    -- sessionLoad (§42) restores STATE.startedAt, which the XP counter is keyed
    -- on, and it runs further down the main chunk than this.
    local t0 = os.clock()
    while alive() and not K.sessLoaded and os.clock() - t0 < 15 do task.wait(0.5) end
    while alive() and not V.stopped do
        local ok, err = pcall(K.vcTick)
        if not ok then K.vcSay("VC+ tracking: " .. tostring(err):sub(1, 120)) end
        -- Every second while the boot report is pending (it should leave within
        -- a few seconds of the save arriving), every five after that.
        task.wait((V.sentAt == nil and os.clock() - V.bootAt < 45) and 1 or 5)
    end
end)

