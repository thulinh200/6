-- ═══════════════════════════════════════════════════════════════════════════
--  0 · OUTPUT SILENCER — must be the first executable block in the file
--     Kills every print/warn variant an executor might inject. error() and
--     rconsoleprint() are deliberately left alive.
-- ═══════════════════════════════════════════════════════════════════════════
do
    local noop = function() end
    local function silence(name)
        pcall(function() getfenv(0)[name] = noop end)
        pcall(function() if typeof(getgenv) == "function" then getgenv()[name] = noop end end)
        pcall(function() if typeof(getrenv) == "function" then getrenv()[name] = noop end end)
        pcall(function()
            if typeof(hookfunction) == "function" then
                local original = (getrenv and getrenv()[name]) or (getfenv and getfenv(0)[name])
                if typeof(original) == "function" then hookfunction(original, noop) end
            end
        end)
    end
    print = noop
    warn  = noop
    _G.print = noop
    _G.warn  = noop
    silence("print")
    silence("warn")
end

-- ═══════════════════════════════════════════════════════════════════════════
--  0.5 · TOPBAR HIDER — ซ่อน topbar ของ Roblox (ปุ่มโลโก้ / เมนู / ไมค์)
--     CoreGui.TopBarApp เป็น Folder ไม่ใช่ ScreenGui — ต้องปิด ScreenGui
--     ข้างในมันเอง (TopBarApp + TopBarScrim) ตั้ง .Enabled ที่ Folder ไม่ติด
--     ปิดด้วย getgenv().VCPlus_Config = { HideTopbar = false }
-- ═══════════════════════════════════════════════════════════════════════════
do
    local cfg = (typeof(getgenv) == "function" and getgenv().VCPlus_Config) or {}
    if cfg.HideTopbar ~= false then
        task.spawn(function()
            local CoreGui = game:GetService("CoreGui")
            local StarterGui = game:GetService("StarterGui")
            local folder = CoreGui:FindFirstChild("TopBarApp")
            if not folder then
                local t0 = os.clock()
                repeat
                    task.wait(0.25)
                    folder = CoreGui:FindFirstChild("TopBarApp")
                until folder or os.clock() - t0 > 15
            end
            local function hideAll()
                if not folder then return end
                for _, d in ipairs(folder:GetDescendants()) do
                    if d:IsA("ScreenGui") then
                        pcall(function() d.Enabled = false end)
                    end
                end
            end
            hideAll()
            if folder then
                folder.DescendantAdded:Connect(function(d)
                    if d:IsA("ScreenGui") then
                        task.wait()
                        pcall(function() d.Enabled = false end)
                    end
                end)
            end
            pcall(function()
                StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
            end)
        end)
    end
end

