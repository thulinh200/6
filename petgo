-- 41c · FINISH CONDITIONS
--     When CFG.DoneTarget is set and one of its conditions is met, hand off to
--     the host once. Fires at most once per session.
-- ═══════════════════════════════════════════════════════════════════════════
K.DONE_SENT = false

local function checkDoneTarget()
    if K.DONE_SENT then return end
    local T = CFG.DoneTarget
    if type(T) ~= "table" then return end

    local reason = nil

    if tonumber(T.Gems) and STATE.gems >= tonumber(T.Gems) then
        reason = ("gems target reached (%s)"):format(comma(STATE.gems))
    end

    if not reason and type(T.Items) == "table" then
        local all, missing = true, nil
        for itemName, needed in pairs(T.Items) do
            local have = invCount(itemName)
            if have < (tonumber(needed) or 1) then
                all, missing = false, itemName
                break
            end
        end
        if all then reason = "item requirements met" end
    end

    if not reason and T.ThunderSpear then
        local have, total = spearParts()
        if have >= total then reason = "thunder spear complete" end
    end

    if not reason then return end

    K.DONE_SENT = true
    log("DONE", reason)
    if _G.Horst_AccountChangeDone then
        local ok, err = pcall(_G.Horst_AccountChangeDone)
        log("DONE", ok and "host confirmed account change" or ("host error: " .. tostring(err)))
    end
end

-- External panel reporter (Horst). Pushes the display string plus the JSON
-- payload; hosts that only take one argument ignore the second.
task.spawn(function()
    if CFG.DisableInternalHorst then return end
    K.stagger(8)
    while alive() do
        pcall(function()
            refreshFlagState()
            checkEarnings()
            local line = statusLine()
            if _G.Horst_SetDescription then
                local json = HttpService:JSONEncode(statusPayload())
                pcall(_G.Horst_SetDescription, line, json)
            end
            checkDoneTarget()
        end)
        -- Throttle the cache write. recordStatus/checkEarnings already persist on
        -- real change; writing here unconditionally every 8s made that throttle
        -- moot and had every client rewriting VCPlusHub_Cache_<UserId>.json
        -- constantly. Refresh the timestamp at most every 30s instead. (K is
        -- wiped on teleport, so cacheAt starts nil and the first pass writes.)
        local nowc = os.clock()
        if nowc - (K.cacheAt or 0) >= 30 then
            K.cacheAt = nowc
            saveCache()
        end
        task.wait(8)
    end
end)

-- Periodic GC. Long multi-hour sessions across dozens of clients accumulate
-- dead references faster than Lua reclaims them on its own.
task.spawn(function()
    K.stagger(600)
    while alive() do
        task.wait(600)
        pcall(function()
            local n = 0
            for _ in pairs(K.QUEST_DONE) do n = n + 1 end
            if n > 300 then K.QUEST_DONE = {} end
            CART_CACHE.list = nil
            collectgarbage("collect")
        end)
    end
end)

