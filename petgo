-- WaitForChild with a real timeout, so a missing instance degrades instead of
-- hanging the whole script the way a bare :WaitForChild() would.
local function waitChild(parent, name, timeout)
    if not parent then return nil end
    local ok, child = pcall(function() return parent:WaitForChild(name, timeout or 12) end)
    return ok and child or nil
end

-- Jittered wait. Fixed cadences are the single clearest bot fingerprint in a
-- remote log, so every repeated server call goes through this.
local function jwait(base, spread)
    task.wait((base or 0.1) + math.random() * (spread or 0.08))
end

-- ── MULTI-INSTANCE STAGGER ────────────────────────────────────────────────
-- Thirty clients launched from one script run every background loop on the SAME
-- wall-clock tick: the CoreGui sweep, the terrain clear, the session write, the
-- GC pass, the telemetry encode. Each is cheap alone and a visible stall when
-- thirty land together — and because each loop then re-arms on a FIXED period
-- they stay phase-locked for the whole session, so the stall repeats forever at
-- that period. One random offset at the head of a loop breaks the phase for good
-- and costs a single wait.
--
-- Call this as the first statement inside the loop's thread, passing the loop's
-- own period, so the spread matches the cadence being decorrelated.
function K.stagger(period)
    if CFG.MultiInstance == false then return end
    task.wait(math.random() * math.clamp(tonumber(period) or 1, 0.05, 30))
end

-- Poll until cond() is truthy or the deadline passes. Returns whether it fired.
-- This is what replaces v9's fixed task.wait(N) sleeps: it returns the instant
-- the world actually changed instead of always burning the worst case.
local function waitUntil(cond, timeout, step)
    local deadline = os.clock() + (timeout or 5)
    repeat
        local ok, res = pcall(cond)
        if ok and res then return true, res end
        task.wait(step or 0.05)
    until os.clock() >= deadline
    return false
end

local function num(v, fallback)
    return tonumber(v) or fallback or 0
end

local function shortNum(n)
    n = tonumber(n) or 0
    if n >= 1e9 then return ("%.2fB"):format(n / 1e9) end
    if n >= 1e6 then return ("%.2fM"):format(n / 1e6) end
    if n >= 1e3 then return ("%.1fK"):format(n / 1e3) end
    return tostring(math.floor(n))
end

-- Thousands separators: 62610738 -> "62,610,738". The status line uses this
-- rather than shortNum because a currency figure people compare across
-- accounts wants to be exact, not "62.61M".
local function comma(n)
    n = math.floor(tonumber(n) or 0)
    local s = tostring(n):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (s:gsub("^,", ""))
end

local function fmtDur(sec)
    sec = math.max(0, math.floor(sec))
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    if h > 0 then return ("%dh%02dm"):format(h, m) end
    if m > 0 then return ("%dm%02ds"):format(m, sec % 60) end
    return ("%ds"):format(sec)
end

